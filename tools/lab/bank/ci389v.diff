+bool kite_now();                     // bit 128: Cassi, melee foe within G, stun on cooldown
+bool entry_ok();                     // bit 512: this body may open a fight
+bool entry2_ok();                    // bit 4096 (+ 8192 FRONT): ENTRY v2
+bool nuke_first(const Kit& k, int d); // bit 1024: both spells ready and the nuke reaches: skip the stun this turn
+// ---- Decision 3: who stands on a capture
+bool yield_capture(int gi);     // true: my partner stands on the region and takes it, so I leave
