+// RTS bit 8 (econ_flags.h, bank rts): step_greedy without the tile I stood on last turn (prev_pos is last turn's tile only when I moved
+// onto this one last turn).
+bool step_greedy_fresh(vec2 target, int ignore_group)
+{
+	if (!W.can_move() || !inb(target))
+		return false;
+	const vec2 me = W.me.pos;
+	const int cur = cheb(me, target);
+	const bool back = prev_round == W.round;
+	CandList cands;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!free_tile(n) || (back && n == prev_pos))
+			continue;
+		const int v = cheb(n, target);
+		if (v >= cur)
+			continue;
+		const int lin = iabs(n.x - target.x) + iabs(n.y - target.y);
+		cands.push_back({ n, v * tune::GREEDY_TILE + lin * tune::GREEDY_AXIS + static_cast<int>(camp_threat(n, ignore_group)) });
+	}
+	if (cands.empty())
+		return false;
+	return move_best(cands);
+}
