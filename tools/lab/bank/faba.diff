+// FAB: the shared-altar class (draft-time features: every altar's two walks within FAB_SH_PCT %, spawn walk <= FAB_S2S), once.
+bool fab_class()
+{
+	static int v = -1;
+	if (v >= 0)
+		return v != 0;
+	if (!M.has_altar || M.altars.empty() || P.s2s < 0)
+		return false; // not decided yet (decided once both are known)
+	bool ok = P.s2s <= FAB_TAB[3];
+	for (const auto& al : M.altars)
+	{
+		if (al.d_home == UNREACH || al.d_enemy == UNREACH)
+		{
+			ok = false;
+			break;
+		}
+		const int dh = static_cast<int>(al.d_home), de = static_cast<int>(al.d_enemy);
+		if (std::abs(dh - de) * 100 > FAB_TAB[4] * std::max(dh, de))
+			ok = false;
+	}
+	v = ok ? 1 : 0;
+	return ok;
+}
