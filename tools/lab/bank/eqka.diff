+// b2335 EQK (brain_turn eqr_carry_note; callers read EQK_BITS): here for shards_of (this file's unnamed namespace).
+namespace nova::econ {
+// b2361 EQK bit 4 (caller read the flag): the map's als class (als_share >= EQK_TAB[2] %) from the finished static map, once
+// (off-class until M.done()); a copy of b2387's rwg_als_class (tools/lab/mapclass.d/als1.py, 938/938 maps).
+bool eqk_als_class()
+{
+	static int c = -1;
+	if (c >= 0)
+		return c == 1;
+	if (!M.done())
+		return false;
+	int tot = 0, near = 0;
+	for (const auto& g : M.groups)
+	{
+		tot += g.gems;
+		bool by = false;
+		for (std::size_t i = 0; i < g.members.size() && !by; ++i)
+		{
+			const vec2 p = M.camps[static_cast<std::size_t>(g.members[i])].pos;
+			for (const auto& a : M.altars)
+				if (cheb(p, a.pos) <= 6)
+				{
+					by = true;
+					break;
+				}
+		}
+		near += by ? g.gems : 0;
+	}
+	c = (tot > 0 && 100 * near >= EQK_TAB[2] * tot) ? 1 : 0;
+	return c == 1;
+}
+// RC C858b F1: spend = 30 x shards_of (Ryth's and Prism's passives taken out). A foe Prism's bag is read only within 9 (world.cc): there
+// her Focus counts less 1.5 a gem; elsewhere Health and Strength only (shards_of's unread fallback).
+int eqr_spend_foe(const Body& e)
+{
+	float n = shards_of(e);
+	if (e.kit && e.kit->valid && e.kit->foc_g > 0 && prism_layer::focus_from_bag(*e.kit) && cheb(e.pos, W.me.pos) <= 9)
+		n += std::max(0.0f, e.foc - e.kit->foc - 1.5f * static_cast<float>(e.gems)) / e.kit->foc_g;
+	return static_cast<int>(30.0f * n);
+}
+// F2: our primary carry = my spend >= every mate's last-seen spend (mul_mate_ls, my own sightings; never-seen mates skipped).
+bool eqr_primary(int mine)
+{
+	for (int s = 0; s < P.n; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		float st = 0, fo = 0, mh = 0;
+		bool died = false;
+		if (!mul_mate_ls(s, st, fo, mh, died))
+			continue;
+		Body mb;
+		mb.ally = true;
+		mb.slot = -1; // no slot: shards_of then never reads (or caches) a bag for it; a Prism mate counts Health and Strength only
+		mb.type = P.type[static_cast<std::size_t>(s)];
+		mb.kit = &kit_of(mb.type);
+		mb.maxhp = mh;
+		mb.str = st;
+		mb.foc = fo;
+		if (static_cast<int>(30.0f * shards_of(mb)) > mine)
+			return false;
+	}
+	return true;
+}
+int eqr_spend_me() { return static_cast<int>(30.0f * shards_of(W.me)); }
