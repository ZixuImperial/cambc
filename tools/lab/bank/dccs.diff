+// DCC (b1769, Econ spec_dcc_1109): contest a decisive foe capture. GR:196: one of our bodies on any spawn tile of the group's region
+// at a capture phase (round start, GR:124) makes it contested and resets the foe's timer; the body must end its turn there. While the
+// group's camps live, its region is inside their reach (monolith 5, 200 a turn): hold at reach + 1 until they are dead.
+bool dcc_turn(const Assessment& a)
+{
+	(void)a;
+	// Cheap precondition first (rare-lane maps must stay turn-identical): a foe in my or my ward's sight and a 150+ gem group on the map.
+	if (W.enemies.empty() && W.enemies_far.empty())
+		return false;
+	const int gmin = DCC_TAB[2];
+	static int big_n = -1; // the groups with gmin+ gems (static map data), counted once
+	static int big_g[16];
+	if (big_n < 0)
+	{
+		big_n = 0;
+		for (int gi = 0; gi < M.ng && big_n < 16; ++gi)
+			if (M.groups[static_cast<std::size_t>(gi)].gems >= gmin)
+				big_g[big_n++] = gi;
+	}
+	if (big_n == 0)
+		return false;
+	if (W.me.frac() < 0.5f || W.me.channeling() || W.me.stunned || econ::bag_wins_with_mates(static_cast<int>(W.me.gems)))
+		return false;
+	int best = -1, bd = BIG;
+	for (int bi = 0; bi < big_n; ++bi)
+	{
+		const int gi = big_g[bi];
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		const bool decisive = W.tributed_them + g.gems >= 1000 - DCC_TAB[3] || (W.round >= 500 && g.gems >= 200);
+		if (!decisive)
+			continue;
+		bool foe_near = false;
+		for (const auto* lst : { &W.enemies, &W.enemies_far })
+			for (const auto& e : *lst)
+				for (int ci : g.members)
+					foe_near = foe_near || cheb(e.pos, M.camps[static_cast<std::size_t>(ci)].pos) <= 1;
+		if (!foe_near)
+			continue;
+		bool worked = false;
+		cambc::detail::camp_group_capture_state cs{};
+		if (cambc::detail::sdk_camp_group_capture_state(g.handle, &cs) == 0 && (cs.state == 3 || cs.state == 2 || cs.state == 4))
+			worked = true; // enemy_capturing, contested, capture_available
+		for (const auto& vc : W.camps)
+			if (!worked && vc.ci >= 0 && M.camps[static_cast<std::size_t>(vc.ci)].group == gi && vc.hp < vc.maxhp)
+				worked = true; // a member under fire
+		if (!worked)
+			continue;
+		int d = BIG;
+		for (int ci : g.members)
+			d = std::min(d, cheb(W.me.pos, M.camps[static_cast<std::size_t>(ci)].pos));
+		if (d < bd)
+		{
+			bd = d;
+			best = gi;
+		}
+	}
+	if (best < 0)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(best)];
+	// Already on a spawn tile of it: stay to the round start (the contest is judged then).
+	for (int ci : g.members)
+		if (M.camps[static_cast<std::size_t>(ci)].pos == W.me.pos)
+		{
+			W.no_move = true;
+			return true;
+		}
+	int reach = 0;
+	bool alive = false;
+	for (const auto& vc : W.camps)
+		if (vc.ci >= 0 && M.camps[static_cast<std::size_t>(vc.ci)].group == best)
+		{
+			alive = true;
+			reach = std::max(reach, M.camps[static_cast<std::size_t>(vc.ci)].reach);
+		}
+	cambc::detail::camp_group_capture_state cs{};
+	const bool cs_ok = cambc::detail::sdk_camp_group_capture_state(g.handle, &cs) == 0;
+	// Bit 2: their capture lands within DCC_T rounds: step onto a free spawn tile if the burst there is below my health.
+	if (DCC_ON(2) && !alive && cs_ok && cs.state == 3 && cs.timer <= DCC_TAB[4] && W.can_move())
+	{
+		vec2 t{ -1, -1 };
+		int td = BIG;
+		for (int ci : g.members)
+		{
+			const vec2 p = M.camps[static_cast<std::size_t>(ci)].pos;
+			bool occ = false;
+			for (const auto* lst : { &W.enemies, &W.allies })
+				for (const auto& b : *lst)
+					occ = occ || b.pos == p;
+			const int d = cheb(W.me.pos, p);
+			if (!occ && d < td)
+			{
+				td = d;
+				t = p;
+			}
+		}
+		if (t.x >= 0 && td <= 1)
+		{
+			float burst = 0.0f;
+			for (const auto& e : W.enemies)
+				burst += burst::lethal_burst_hit(e, cheb(e.pos, t), 0, nullptr);
+			if (burst < W.me.hp + W.me.shield && mv::try_move(t))
+			{
+				W.no_move = true;
+				return true;
+			}
+		}
+		if (t.x >= 0 && td <= 3)
+		{
+			mv::step_to(t, 1, 40);
+			return true;
+		}
+	}
+	// Bit 1: approach and hold out of the living camps' reach (reach + 1 from the nearest member, outside every awake camp's reach).
+	vec2 near{ -1, -1 };
+	int dn = BIG;
+	for (int ci : g.members)
+	{
+		const vec2 p = M.camps[static_cast<std::size_t>(ci)].pos;
+		if (cheb(W.me.pos, p) < dn)
+		{
+			dn = cheb(W.me.pos, p);
+			near = p;
+		}
+	}
+	const int stop = alive ? reach + 1 : 2;
+	if (dn <= stop && mv::camp_threat(W.me.pos) <= 0)
+	{
+		W.no_move = true;
+		return true;
+	}
+	const mv::AvoidCampReach acr(true);
+	return mv::step_to(near, stop, 40);
+}
