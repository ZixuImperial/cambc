+// An orbit member: within R of the centre's field, never a carry's claimed group (ADAPTATION).
+bool orb_in(int gi)
+{
+	if (orb_ci < 0)
+		return false;
+	for (int i = 0; i < orb_nc; ++i)
+		if (gi == orb_mg[static_cast<std::size_t>(orb_car[static_cast<std::size_t>(i)])])
+			return false;
+	auto& b = orb_bits[static_cast<std::size_t>(orb_ci)][static_cast<std::size_t>(gi)];
