+// E8: the first two fielded of Prism, Vesper, Marcella (owner: never Vendetta or Varg); the same on every body.
+void orb_carries()
+{
+	if (orb_nc >= 0)
+		return;
+	orb_nc = 0;
+	const cambc::champion_type pri[3] = { cambc::champion_type::prism, cambc::champion_type::vesper_vale, cambc::champion_type::marcella };
+	for (const auto t : pri)
+		for (int s = 0; s < P.n && s < 8 && orb_nc < 2; ++s)
+			if (P.type[static_cast<std::size_t>(s)] == t)
