+// E1 (per turn, the caller reads ORB_ON(1)): ckind 2/3 set, 4/5 keep up to ORB_MEMO_A rounds, idle/dead clear; a carry channelling in sight clears.
+void orb_memo_update()
+{
+	const int r = now();
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		const auto i = static_cast<std::size_t>(s);
+		const int k = comms::ckind(s);
+		if (!siege_ally_alive(s) || k <= 1)
+		{
+			orb_mg[i] = -1;
+			orb_fk[i] = false;
+		}
+		else if (k == 2 || k == 3)
+		{
+			const int g = comms::cgroup(s);
+			if (((g >= 0 && g < M.ng) ? g : -1) != orb_mg[i])
+				orb_mc[i] = r; // ADAPTATION: the claim changed
+			orb_mg[i] = (g >= 0 && g < M.ng) ? g : -1;
+			orb_ms[i] = r;
+			orb_fk[i] = false;
+		}
+		else if (orb_mg[i] >= 0 && r - orb_ms[i] <= ORB_MEMO_A)
+			orb_fk[i] = true;
+		else
+		{
+			orb_mg[i] = -1;
+			orb_fk[i] = false;
+		}
+	}
+	for (const auto& al : W.allies)
+		if (al.slot >= 0 && al.slot < 8 && al.channeling())
+		{
