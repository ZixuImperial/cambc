+// E9 + ADAPTATION: the orbit of centre c (carry index i) as a lazy cache: 2 = not yet read; filled per group on its first query, once
+// per carry claim change (key: i, c, the claim's stamp). False while c has no field.
+bool orb_build(int i, int c)
+{
+	auto& bits = orb_bits[static_cast<std::size_t>(i)];
+	const int st = orb_mc[static_cast<std::size_t>(orb_car[static_cast<std::size_t>(i)])];
+	if (orb_cg[static_cast<std::size_t>(i)] == c && orb_ckey[static_cast<std::size_t>(i)] == st && bits.size() == static_cast<std::size_t>(M.ng))
+		return true;
+	if (!mv::group_field_raw(c))
+		return false;
+	bits.assign(static_cast<std::size_t>(M.ng), 2);
+	orb_cg[static_cast<std::size_t>(i)] = c;
+	orb_ckey[static_cast<std::size_t>(i)] = st;
+	return true;
