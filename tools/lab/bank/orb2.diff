+		}
+	}
+	if (orb_rated.size() != static_cast<std::size_t>(M.ng))
+		orb_rated.assign(static_cast<std::size_t>(M.ng), 0);
+	else
+		std::fill(orb_rated.begin(), orb_rated.end(), 0);
+	orb_ci = bi;
+	return true;
+}
