+// ORB (b2347, RC C879 E5; callers read ORB_ON first): the clustered-map feature x 1000: the median over groups of the share of all
+// group value (gems + gold) whose anchors lie within Chebyshev ORB_R of the group's anchor (draft-time, M only).
+int orb_cluster_x1000()
+{
+	using namespace nova;
+	const int n = M.ng;
+	if (n <= 0)
+		return 0;
+	std::int64_t tot = 0;
+	for (const auto& g : M.groups)
+		tot += g.gems + g.gold;
+	if (tot <= 0)
+		return 0;
+	std::vector<int> sh;
+	sh.reserve(static_cast<std::size_t>(n));
+	for (const auto& g : M.groups)
+	{
+		std::int64_t v = 0;
+		for (const auto& h : M.groups)
+			if (std::max(std::abs(g.anchor.x - h.anchor.x), std::abs(g.anchor.y - h.anchor.y)) <= ORB_R)
+				v += h.gems + h.gold;
+		sh.push_back(static_cast<int>(1000LL * v / tot));
+	}
+	std::nth_element(sh.begin(), sh.begin() + n / 2, sh.end());
+	return sh[static_cast<std::size_t>(n / 2)];
+}
