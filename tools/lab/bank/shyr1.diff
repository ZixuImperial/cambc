+// (ally_capturing) or waits (capture_available) in my vision; no seen foe within SHY_TAB[2] of its region; a free member tile within
+// W = timer - SHY_TAB[3] - (the holder acts before me: 1; unseen: 1) steps (payment at round start, GR:124). I take the nearest as my
+// target (the claim says I come; the holder steps off only once it sees me on a member tile). Not while I clear or capture my own.
+bool shyp_prism_pick()
+{
+	if (!W.me.kit || !prism_layer::me() || T.engaged || T.capturing || W.me.channeling() || gmem_size(mem) != static_cast<std::size_t>(M.ng))
+		return false;
+	int best = -1, bd = BIG;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		const int gi = comms::cgroup(s);
+		if (gi < 0 || gi >= M.ng)
+			continue;
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		if (!shyp_scope(g) || mem[static_cast<std::size_t>(gi)].status == GS_RESPAWN)
+			continue;
+		cambc::detail::camp_group_capture_state cs{};
+		if (cambc::detail::sdk_camp_group_capture_state(g.handle, &cs) != 0)
+			continue; // the group is out of my vision
+		int t = -1;
+		if (cs.state == 1 && cs.timer >= 1)
+			t = static_cast<int>(cs.timer); // ally_capturing: paid at the start of round now + timer
+		else if (cs.state == 4)
+			t = group_capture_pay_rounds(g, -1) + 1; // capture_available: the holder steps on, the timer starts next round
+		else
