+		const int w = t - SHY_TAB[3] - (first ? 1 : 0);
+		int d = relay_free_spawn_dist(g, W.me.pos, vec2{ -1, -1 });
+		if (d < 1 || d > w || d >= bd)
+			continue;
+		bool foe = false;
+		for (const auto& e : W.enemies)
+			for (int ci : g.members)
+				foe |= cheb(e.pos, M.camps[static_cast<std::size_t>(ci)].pos) <= SHY_TAB[2];
+		if (foe)
+			continue;
+		if (const distance_field* f = mv::group_field_ready(gi))
+			d = std::max(d, static_cast<int>(dfget_me(*f)));
+		if (d > w)
+			continue;
+		bd = d;
+		best = gi;
+	}
+	if (best < 0)
+		return false;
+	const bool turned = T.target != best;
+	if (turned)
+		force_target_in(best);
+	if (T.target != best)
+		return false;
+	shyp_gi = best;
+	shyp_r = now();
+	return turned; // true: a new target (the firing count)
