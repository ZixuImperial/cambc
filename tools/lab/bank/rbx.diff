+// RBX bit 1 RBI1: a foe with two turns before my next reaches me with them (the test's terms: a stunned one hits from here with
+// cooldowns one on; a free one walks a tile on turn 1 and hits on turn 2).
+static __attribute__((noinline)) bool rbx_two_turn_reach()
+{
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 9 || reach_burst_turns(e) < 2)
+			continue;
+		if (e.stunned ? lethal_burst_hit(e, d, 1, nullptr) > 0.0f : (lethal_burst_hit(e, d, 0, nullptr) > 0.0f || (d > 1 && lethal_burst_hit(e, d - 1, 1, nullptr) > 0.0f)))
+			return true;
+	}
+	return false;
+}
 } // namespace
+int rbx_pin_r = -1000; // RBX bit 2 IRS1: the round the healed cap kept a FIGHT on my spawn (the fight acts from spawn tiles)
+// RBX bit 2: the healed cap kept this FIGHT (the test at my current HP would flee): it holds only on the spawn, so the fight pins there.
+static __attribute__((noinline)) bool rbx_pin_test(const Assessment& a, bool lethal_healed)
+{
+	if (lethal_healed || !W.on_spawn || a.stance != FIGHT)
+		return false;
+	const bool sv = irb_ed;
+	const bool v = reach_burst_test(eff_hp(W.me) * static_cast<float>(IRB_TAB[2]) / 100.0f);
+	irb_ed = sv;
+	RBX_CNT(2, v);
+	return v;
+}
 // The in-reach burst test for every body.
 void reach_burst_assess(Assessment& a, bool kill_now)
 {
 	irb_fired = false;
-	if (!a.in_reach || kill_now || !W.alive || !W.me.kit || W.me.channeling() || (linked_slot() >= 0 && !CI2_FIGHT())) // a kill-now turn with a bag and a stun on me keeps the test
+	if ((!a.in_reach && !(RBX_ON(1) && W.alive && rbx_two_turn_reach())) || kill_now || !W.alive || !W.me.kit || W.me.channeling() || (linked_slot() >= 0 && !CI2_FIGHT())) // a kill-now turn with a bag and a stun on me keeps the test
 		return;
 	if (a.stance == FLEE)
 		return; // already fleeing: nothing to flip
 	if (fuel() < IRB_TAB[3])
 		return; // a heavy turn keeps its stance (a new flee costs a flee() search: no flip below IRB_FUEL fuel left)
 	{
 		// assess() runs up to 3 times a turn: the test is cached per turn and state (my tile and HP, the visible foes' tiles and HP)
 		static int c_round = -1;
 		static std::uint32_t c_me = 0, c_key = 0;
 		static bool c_val = false, c_ed = false;
+		static bool c_pin = false; // RBX bit 2
 		std::uint32_t key = static_cast<std::uint32_t>(W.me.pos.x * 131 + W.me.pos.y) * 2654435761u ^ static_cast<std::uint32_t>(eff_hp(W.me) * 8.0f);
 		for (const auto& e : W.enemies)
 			key = key * 16777619u ^ (static_cast<std::uint32_t>(e.pos.x * 131 + e.pos.y) + static_cast<std::uint32_t>(eff_hp(e) * 8.0f) * 97u + (e.stunned ? 7u : 0u));
 		if (c_round != W.round || c_me != W.me.h || c_key != key)
 		{
-			c_val = reach_burst_test(eff_hp(W.me) * static_cast<float>(IRB_TAB[2]) / 100.0f);
+			c_val = reach_burst_test(((RBX_ON(2) && W.on_spawn && a.stance == FIGHT) ? flr_healed_ehp() : eff_hp(W.me)) * static_cast<float>(IRB_TAB[2]) / 100.0f); // RBX bit 2 IRS1: the healed cap for a FIGHT on my spawn
 			c_ed = irb_ed;
+			if (RBX_ON(2))
+				c_pin = rbx_pin_test(a, c_val);
 			c_round = W.round;
 			c_me = W.me.h;
 			c_key = key;
 		}
 		irb_fired = static_cast<bool>(c_val);
 		irb_ed = c_ed;
+		RBX_CNT(1, !a.in_reach && c_val);
+		if (RBX_ON(2) && c_pin)
+			rbx_pin_r = W.round; // RBX bit 2: this FIGHT stands on the healed cap, so it stays on the spawn
 	}
 	if (!irb_fired)
 		return;
 	if (a.stance != FLEE)
 		a.stance = FLEE;
 }
