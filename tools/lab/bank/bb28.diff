 // Local power = (sum of health) x (sum of strength + focus) within LOCAL_POWER_R, ours against the foes I know (seen, or seen a
 // moment ago). A fight starts only at POWER_ENGAGE or better, or with a kill this turn; a body already caught is exempt. A calm body
 // below POWER_LEAVE with a known foe within its reach + LOCAL_POWER_STEPS leaves before the contact. It stays while a.ratio reads
 // level or ahead.
+// BB28 EK3 (an enemy C&I pair's health counts once, the lower: one kill takes both) and EK4 (damage = body_dps, not str + foc: Issac and
+// Vendetta have no Focus ability, Varg's is a shield): the same bodies as assess_rule_local_power's sums.
+static void bb28_local_power_sums(const AssessCtx& c, const Assessment& a, float& us, float& th, float& ts)
+{
+	if (BB28_ON(8))
+	{
+		us = body_dps(W.me);
+		for (const auto& al : W.allies)
+			if (!al.channeling() && cheb(al.pos, c.me) <= tune::LOCAL_POWER_R && !nova::combat::retreating_mates::retreating(al))
+				us += body_dps(al);
+		float vis_s = 0;
+		int vis_n = 0;
+		for (const auto& f : a.foes)
+			if (f.idx >= 0)
+			{
+				vis_s += body_dps(assess_enemy(f.idx));
+				++vis_n;
+			}
+		const float avg_s = vis_n > 0 ? vis_s / static_cast<float>(vis_n) : body_dps(W.me);
+		ts = 0;
+		for (const auto& f : a.foes)
+			if (cheb(f.pos, c.me) <= tune::LOCAL_POWER_R)
+				ts += f.idx >= 0 ? body_dps(assess_enemy(f.idx)) : avg_s;
+	}
+	if (BB28_ON(4))
+	{
+		float hc = -1, hi = -1;
+		for (const auto& f : a.foes)
+			if (f.idx >= 0 && cheb(f.pos, c.me) <= tune::LOCAL_POWER_R && ci_layer::type(assess_enemy(f.idx).type))
+				(assess_enemy(f.idx).type == cambc::champion_type::cassi ? hc : hi) = std::max(1.0f, f.ehp);
+		if (hc > 0 && hi > 0)
+			th -= std::max(hc, hi);
+	}
+}
