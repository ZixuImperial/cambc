 // No lone 1v3+ unless the kill lands now and I outlast their summed bursts.
 static __attribute__((always_inline)) inline void assess_rule_no_lone_fight(const AssessCtx& c)
 {
 	Assessment& a = c.a;
+	if (BB28_ON(2) && c.kill_now && a.focus >= 0 && a.focus < static_cast<int>(W.enemies.size())) // BB28 EK2: the focus (and its C&I partner) die first
+	{
+		const Body& fe = W.enemies[static_cast<std::size_t>(a.focus)];
+		float b5 = 0;
+		for (const auto& f : a.foes)
+			if (cheb(f.pos, W.me.pos) <= 5 && f.idx != a.focus &&
+				!(f.idx >= 0 && ci_layer::type(fe.type) && W.enemies[static_cast<std::size_t>(f.idx)].type == ci_layer::partner(fe.type)))
+				b5 += f.burst;
+		if (eff_hp(W.me) > b5)
+			return; // the kill-now exception holds
+	}
 	if (a.stance != FLEE && c.efc.allies4 == 0 && c.efc.near5 >= tune::LONE_NEAR5_MIN && !(c.kill_now && eff_hp(W.me) > c.efc.burst5))
 		a.stance = FLEE;
 }
