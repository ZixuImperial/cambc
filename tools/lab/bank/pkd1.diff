diff --git a/src/combat_burst.cc b/src/combat_burst.cc
--- a/src/combat_burst.cc
+++ b/src/combat_burst.cc
@@ -181,8 +181,48 @@ static bool kills(const Body& f, int d, unsigned mode)
 {
 	const float h = eff_hp(f);
 	if (mode != 0)
 		return h <= kill_dmg(f, d, mode);
 	return (d <= kill_now_reach() && h <= kill_dmg(f, d, 0) && dash_kill_reachable(f, d)) || spell_alone_kills(f, d) || kills_ranged_knr(f, d, h);
 }
+// v751 PKD: the foe whose kill the channel is cancelled for (W.enemies index), or -1. bits: PKD's (1 = breakers only, 2 = any kill).
+int pkd_target(int bits)
+{
+	if (!W.me.kit || !(W.me.state & ST_TRIBUTE) || W.tributed_us + static_cast<int>(W.me.gems) < rs::WIN_TRIBUTE)
+		return -1;
+	std::int32_t left = -1;
+	if (cambc::detail::sdk_champion_channel_time(static_cast<std::uint32_t>(cambc::detail::sdk_my_champion()), &left) != 0 || left < 2)
+		return -1; // with 1 tick left it lands at my next turn start (PC_DOOM_LEFT)
+	if (nova::econ::win_channel::keep_cancel(static_cast<int>(W.me.gems)))
+		return -1;
+	// the kill test as after the cancel: she acts at once (INT:126), so walk, hit and cast are open while it runs
+	struct PkdState { std::uint32_t s; ~PkdState() { W.me.state = s; } } pkd_keep{ W.me.state };
+	W.me.state = (W.me.state & ~ST_TRIBUTE) | ST_CAN_MOVE | ST_CAN_ATTACK | ST_CAN_CAST;
+	vec2 alt{ -1, -1 };
+	int ad = BIG;
+	for (const auto& al : M.altars)
+		if (cheb(al.pos, W.me.pos) < ad)
+		{
+			ad = cheb(al.pos, W.me.pos);
+			alt = al.pos;
+		}
+	for (std::size_t i = 0; i < W.enemies.size(); ++i)
+	{
+		const Body& e = W.enemies[i];
+		const int d = cheb(e.pos, W.me.pos);
+		if (!kills(e, d, 0))
+			continue;
+		if (!(bits & 2))
+		{
+			const Kit* k = e.kit;
+			const bool stun = k && k->slot_cc >= 0 && foe_ready(e, k->slot_cc) && d <= foe_next_turn_reach(e);
+			const int mv = 1 + (k && k->slot_dash >= 0 && foe_ready(e, k->slot_dash) ? std::max(1, static_cast<int>(k->dash_range)) : 0);
+			const bool lock = alt.x >= 0 && cheb(e.pos, alt) <= 2 + mv;
+			if (!stun && !lock)
+				continue;
+		}
+		return static_cast<int>(i);
+	}
+	return -1;
+}
 } // namespace burst
 } // namespace nova::combat
