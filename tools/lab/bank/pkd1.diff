 // v716 ACX: class bits (1 CLUSTER, 2 GOLDFREE) and the largest walkable gem group, from map data once M is built.
 struct AcxMap
 {
 	int bits = -1, big = 0;
 };
 inline AcxMap acx_map;
+// PKD (b1838, Prism Improver spec_pkd_1111; behaviour). Runtime data flag, read first; 0 = v750. A channelling Prism with a game-ending
+// bag (exempt from every proximity cancel while healthy) cancels and lets the fight stage kill a visible foe the turn's own kill test
+// (burst::kills) says dies now, with 2+ ticks left and no known foe's two-turn burst killing her (win_channel::keep_cancel false).
+// Bit 1 KILL THE BREAKER: only a foe that can end the channel before it lands (its stun ready and I am inside its next-turn reach, or it
+// can stand within 2 of the altar after its move). Bit 2 ANY KILL IN RANGE: bit 1 without that test.
+#define PKD_BITS 0
+inline const volatile int PKD_TAB[2] = { 0x504B4431, PKD_BITS }; // slot 0 magic keeps it out of .bss
+#define PKD_ON(b) ((PKD_TAB[1] & (b)) != 0)
