+// v707 SBH bit 8 (the caller read the flag): Stellar's area one-shots camp ci, a cluster, so slot 0 waits for a better target while
+// slot 1 is ready or a non-cluster camp or a foe is within slot 0's range.
+__attribute__((noinline)) bool sbh_hold_nuke(const Kit& k, int ci)
+{
+	if (W.me.type != cambc::champion_type::stellar || ci < 0 || ci >= M.nc || k.slot_aoe < 0)
+		return false;
+	const auto& c = M.camps[static_cast<std::size_t>(ci)];
+	if (c.type != cambc::camp_type::gem_cluster && c.type != cambc::camp_type::gold_cluster)
+		return false;
+	const float pm = kit_rules::passive_mult(W.me); // as area_before_cc (R2B baked)
+	if (k.aoe_mod * W.me.foc * pm < c.hp)
