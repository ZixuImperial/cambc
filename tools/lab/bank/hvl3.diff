+// HVL: a free body: not capturing, clearing or channeling, bag under 30, HP + shield cover the seen foes' two-turn damage.
+__attribute__((noinline)) bool hvl_free()
+{
+	if (T.capturing || engaged_now() || W.me.channeling())
+		return false;
+	if ((CI2_FARM() ? nova::ci2::pair_bag() : static_cast<int>(W.me.gems)) >= 30)
+		return false;
+	float dmg = 0;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, W.me.pos);
+		dmg += nova::combat::burst::foe_two_turn_damage(e, d, nova::combat::burst::lethal_burst_hit(e, d, 0, nullptr));
+	}
+	return W.me.hp + W.me.shield >= dmg;
+}
