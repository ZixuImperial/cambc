+// CWF bit 1: consecutive sightings of each group with the engine timer at 0 (an occupied spawn tile holds it, GR:196).
+inline std::vector<std::uint8_t> cwf_zero;
+inline void cwf_zero_mark(int gi, bool zero)
+{
+	if (gi < 0 || gi >= M.ng)
+		return;
+	if (cwf_zero.size() != static_cast<std::size_t>(M.ng))
+		cwf_zero.assign(static_cast<std::size_t>(M.ng), 0);
+	auto& z = cwf_zero[static_cast<std::size_t>(gi)];
+	z = zero ? static_cast<std::uint8_t>(std::min(255, z + 1)) : 0;
+}
+inline bool cwf_held(int gi)
+{
+	return gi >= 0 && gi < static_cast<int>(cwf_zero.size()) && cwf_zero[static_cast<std::size_t>(gi)] >= CWF_TAB[2];
+}
+// CWF bit 2: a new wait episode when my target's status changed since my last target turn.
+inline void cwf_episode(int gi, int st)
+{
+	if (cwf_tg == gi && cwf_st != st && (T.wait_since >= 0 || T.engaged))
+	{
+		if (T.wait_since >= 0)
+			T.wait_since = now(); // a stale crew-wait start restarts; an unset one stays unset
+		T.engaged = false;
+	}
+	cwf_tg = gi;
+	cwf_st = st;
+}
 // The engine's own respawn timer of a group in sight.
 inline void mark_respawn_timer(GroupMem& m, const GroupI& g)
 {
 	std::int32_t timer = 0;
 	cambc::detail::sdk_camp_group_cooldown(g.handle, &timer);
 	mark_respawn(m, now() + std::max(1, static_cast<int>(timer)));
+	if (CWF_ON(1))
+		cwf_zero_mark(static_cast<int>(&g - M.groups.data()), timer == 0); // CWF bit 1: count timer-0 sightings in a row
 }
 // A crew mate captures it: it pays within capture_pay (a Capture holder there: 4), then respawns.
 inline void mark_mate_capture(GroupMem& m, const GroupI& g)
 {
 	m.handoff = now();
 	mark_respawn(m, now() + group_capture_pay_rounds(g, -1) + g.respawn);
