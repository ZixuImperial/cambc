+namespace {
+// v712 BLB bit 2 (BDD1 + LRT1, RC X218/X221): walk steps from p through free camp tiles (dead members of a blob) to the first tile the
+// field f reaches (f given: that tile's value is added) or, with f null, to the first free tile off every camp tile with no camp threat.
+// UNREACH past BLB_DEPTH steps. *first (if given): the first step from p. Groups respawn only once every spawn tile is free (GR:196).
+static __attribute__((noinline)) std::uint16_t blob_exit(vec2 p, const distance_field* f, vec2* first)
+{
+	constexpr int BLB_DEPTH = 10;
+	std::array<vec2, 96> q{};
+	std::array<vec2, 96> fs{};
+	std::array<std::uint8_t, 96> dq{};
+	int qh = 0, qt = 0;
+	q[qt] = p;
+	fs[qt] = p;
+	dq[qt++] = 0;
+	while (qh < qt)
+	{
+		const vec2 c = q[static_cast<std::size_t>(qh)];
+		const vec2 c1 = fs[static_cast<std::size_t>(qh)];
+		const int dc = dq[static_cast<std::size_t>(qh++)];
+		for (const vec2 d : DIRS)
+		{
+			const vec2 n = c + d;
+			if (!inb(n) || n == p)
+				continue;
+			bool seen = false;
+			for (int k = 0; k < qt && !seen; ++k)
+				seen = q[static_cast<std::size_t>(k)] == n;
+			if (seen)
+				continue;
+			const vec2 n1 = dc == 0 ? n : c1;
+			if (f)
+			{
+				const std::uint16_t v = dfget(*f, n);
+				if (v != UNREACH)
+				{
+					if (first)
+						*first = n1;
+					return static_cast<std::uint16_t>(dc + 1 + v);
+				}
+			}
+			else if (mv::free_tile(n) && !bbget(M.camp_tiles, n) && mv::camp_threat(n) <= 0)
+			{
+				if (first)
+					*first = n1;
+				return static_cast<std::uint16_t>(dc + 1);
+			}
+			if (bbget(M.camp_tiles, n) && mv::free_tile(n) && dc + 1 < BLB_DEPTH && qt < static_cast<int>(q.size()))
+			{
+				q[static_cast<std::size_t>(qt)] = n;
+				fs[static_cast<std::size_t>(qt)] = n1;
+				dq[static_cast<std::size_t>(qt++)] = static_cast<std::uint8_t>(dc + 1);
+			}
+		}
+	}
+	return UNREACH;
+}
