+// b2365 NCP helpers (callers read the flag).
+int ncp_point()
+{
+	static int v = -2;
+	if (v != -2)
+		return v;
+	if (!M.done())
+		return -1;
+	v = -1;
+	if (M.na > 2 || M.ng <= 0)
+		return v;
+	int top = -1;
+	float ts = -1.0f;
+	long tot = 0;
+	for (int g = 0; g < M.ng; ++g)
+	{
+		const GroupI& gr = M.groups[static_cast<std::size_t>(g)];
+		tot += gr.gems;
+		if (gr.contest < 0.4f || gr.contest > 0.6f)
+			continue;
+		const float sc = static_cast<float>(gr.gems) + static_cast<float>(gr.gold) / 10.0f;
+		if (sc > ts)
+		{
+			ts = sc;
+			top = g;
+		}
+	}
+	if (top < 0 || tot <= 0)
+		return v;
+	const vec2 pa = M.groups[static_cast<std::size_t>(top)].anchor;
+	long cg = 0;
+	for (int g = 0; g < M.ng; ++g)
+	{
+		const GroupI& gr = M.groups[static_cast<std::size_t>(g)];
+		if (gr.contest >= 0.4f && gr.contest <= 0.6f && cheb(gr.anchor, pa) <= 8)
+			cg += gr.gems;
+	}
+	if (cg * 100 >= tot * 35)
+		v = top;
+	return v;
+}
+bool ncp_live(bool me)
+{
+	if (!NCP_ON(4))
+		return true;
+	if (!me)
+		return false; // RC C1029: bit 4 reads my own sightings; a mate's row is not live
+	const int p = ncp_point();
+	if (p < 0)
+		return false;
+	static int r = -1000;
+	static bool lv = false;
+	if (r == now())
+		return lv;
+	r = now();
+	const vec2 pa = M.groups[static_cast<std::size_t>(p)].anchor;
+	lv = intel::count_near(pa, 8, NCP_TAB[4]) > 0;
+	if (!lv)
+		for (const auto& t : intel::team_table())
+			if (t.alive && now() - t.round <= NCP_TAB[4] && t.pos.x >= 0 && cheb(t.pos, pa) <= 8)
+			{
+				lv = true;
+				break;
+			}
+	return lv;
+}
+int ncp_dp(int gi)
+{
+	const int p = ncp_point();
+	if (p < 0 || gi < 0 || gi >= M.ng)
+		return -1;
+	const distance_field* f = mv::group_field_ready(p);
+	if (!f)
+		f = mv::group_field_build(p, 30000); // once: P's walk field
+	if (!f)
+		return -1;
+	if (gi == p)
+		return 0;
+	// P's field blocks every other group's camp tiles, so read it at gi's approach tiles (passable, next to its members)
+	std::uint16_t d = UNREACH;
+	for (const vec2 t : M.groups[static_cast<std::size_t>(gi)].approach)
+		d = std::min(d, dfget(*f, t));
+	return d == UNREACH ? -1 : static_cast<int>(d);
+}
+float ncp_mult(int gi, bool me)
+{
+	const int p = ncp_point();
+	if (p < 0 || gi < 0 || gi >= M.ng || M.groups[static_cast<std::size_t>(gi)].contest > 0.6f || !ncp_live(me))
+		return 1.0f;
+	const int d0 = static_cast<int>(M.groups[static_cast<std::size_t>(p)].d_home);
+	const int dp = ncp_dp(gi);
+	if (d0 <= 0 || d0 >= UNREACH || dp < 0)
+		return 1.0f;
+	const float x = std::clamp(static_cast<float>(d0 - dp) / static_cast<float>(d0), 0.0f, 1.0f);
+	return 1.0f + static_cast<float>(NCP_TAB[3]) * 0.01f * x;
+}
