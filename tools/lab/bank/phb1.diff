+constexpr int PHB_EDGE[8] = { 0, 600, 900, 1200, 1600, 2100, 2800, 2800 }; // a band's upper edge (band 7 uses 2,800)
+constexpr int PHB_HI = 1 << 20, PHB_LO = -(1 << 20);                      // C893: strictly beyond every mate value
+// a foe's two-shot on a fixed target (spec FPW row): its two best damage casts + two basics, its own multiplier; no term of the
+// writer's body, so every body computes the same value for the same foe
+float burst2(const Body& e)
+{
+	if (!e.kit || !e.kit->valid)
+		return 2.0f * e.str * kit_rules::passive_mult(e);
+	const Kit& k = *e.kit;
+	float c1 = 0.0f, c2 = 0.0f;
+	auto add = [&](int s, float v)
+	{
+		if (s < 0 || v <= 0.0f)
+			return;
+		if (v > c1)
+		{
+			c2 = c1;
+			c1 = v;
+		}
+		else if (v > c2)
+			c2 = v;
+	};
+	add(k.slot_dmg, k.dmg_mod * e.foc);
+	add(k.slot_cc, k.cc_mod * e.foc);
+	add(k.slot_aoe, k.aoe_mod * e.foc);
+	add(k.slot_dash, k.dash_mod * e.foc);
+	add(k.slot_reset, e.str);
+	return (c1 + c2 + 2.0f * e.str) * kit_rules::passive_mult(e);
+}
