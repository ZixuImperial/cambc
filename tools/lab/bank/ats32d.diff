+// b2445 ATS gate arms (bits 32-512): the stronger side with a visible foe near.
+__attribute__((noinline)) bool ats_lift(const Assessment& a)
+{
+	return a.ratio_fc * 100.0f >= static_cast<float>(ATS_TAB[3]) && a.nearest <= ATS_TAB[4];
+}
+// b2445 ATS bit 64: the stronger branch's sight radius + ATS_TAB[5] under the lift (with ATS_TAB[6] a mate within 6 of me too).
+static __attribute__((noinline)) bool ats_sight(const Assessment& a)
+{
+	if (a.nearest > stance::tune::ENGAGE_SIGHT_R + ATS_TAB[5] || !ats_lift(a))
+		return false;
+	if (ATS_TAB[6] == 0)
+		return true;
+	for (const auto& al : W.allies)
+		if (cheb(al.pos, W.me.pos) <= 6)
+			return true;
+	return false;
+}
