 }
+// b2445 ATS bit 1: healthy, no foe reaches me, my bag under the stake bar.
+static __attribute__((noinline)) bool ats_stay_healthy(const AssessCtx& c)
+{
+	return !c.a.in_reach && c.bag < tune::BAG_MIN && W.me.frac() >= static_cast<float>(ATS_TAB[2]) / 100.0f;
+}
+// b2445 ATS bits 4 / 1024: the focus is the enemy carry (bit 4 a Prism, bit 1024 a Vesper at most my shards),
+// the refit ratio is at least even and a squad mate covers her.
+// b2445 ATS bit 1024: shards bought, from Health and Strength against the kit's base and growth (econ shards_of without Focus).
+static float ats_shards(const Body& b)
+{
+	if (!b.kit || !b.kit->valid)
+		return 0;
+	const Kit& k = *b.kit;
+	float n = 0;
+	if (k.hp_g > 0)
+		n += std::max(0.0f, b.maxhp - k.hp) / k.hp_g;
+	if (k.str_g > 0 && !ryth_layer::str_from_health(k))
+		n += std::max(0.0f, b.str - k.str) / k.str_g;
+	return n;
+}
+static __attribute__((noinline)) bool ats_press_carry(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	if (a.focus < 0 || a.ratio_fc < tune::EVEN_RATIO)
+		return false;
+	const Body& f = assess_enemy(a.focus);
+	if (!f.kit || !f.kit->valid)
+		return false;
+	const bool carry = (ATS_ON(4) && prism_layer::kit(*f.kit)) || (ATS_ON(1024) && vesper_layer::kit(*f.kit) && ats_shards(f) <= ats_shards(W.me));
+	return carry && memory::squad_mate_covers_focus(f.pos);
+}
+// b2445 ATS bit 2048: the focus is committed: tributing, capturing (on a spawn tile of a group whose members are all within 9 of
+// me and none alive in W.camps) or in the reach of an awake attacking camp; in reach of a cheap approach and with a mate near me.
+static __attribute__((noinline)) bool ats_committed_go(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	if (a.focus < 0 || a.ratio_fc < tune::EVEN_RATIO)
+		return false;
+	const Body& f = assess_enemy(a.focus);
+	if (cheb(f.pos, W.me.pos) > tune::ENGAGE_SIGHT_R + ATS_TAB[7])
+		return false;
+	if (const int kd = ATS_TAB[8]; kd != 0) // carry-only (1) / non-carry-only (2)
+	{
+		const bool carry = f.kit && f.kit->valid && (prism_layer::kit(*f.kit) || vesper_layer::kit(*f.kit));
+		if (carry != (kd == 1))
+			return false;
+	}
+	const bool trib = (f.state & ST_TRIBUTE) != 0;
+	if (trib && c.bag >= tune::BAG_MIN)
+		return false;
+	bool mate = false;
+	for (const auto& al : W.allies)
+		mate |= cheb(al.pos, W.me.pos) <= 6;
+	if (!mate)
+		return false;
+	if (trib)
+		return true;
+	for (const auto& vc : W.camps)
+	{
+		const auto& cm = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (vc.awake && cm.attacks() && cheb(cm.pos, f.pos) <= cm.reach)
+			return true;
+	}
+	for (const auto& cm : M.camps)
+	{
+		if (cm.pos != f.pos || cm.group < 0 || cm.group >= M.ng)
+			continue;
+		bool seen_dead = true;
+		for (int ci : M.groups[static_cast<std::size_t>(cm.group)].members)
+		{
+			const vec2 mp = M.camps[static_cast<std::size_t>(ci)].pos;
+			if (cheb(mp, W.me.pos) > 9)
+				seen_dead = false;
+			for (const auto& vc : W.camps)
+				if (vc.ci == ci)
+					seen_dead = false;
+		}
+		return seen_dead;
+	}
+	return false;
+}
