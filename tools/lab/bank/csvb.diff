+// CSV: from a tile outside every heavy foe's one-turn reach, the step to dest closes into one's reach (heavy: burst >= b x my eff HP).
+static bool csv_test(vec2 dest, bool calm_ok, bool flee_ok, float b)
+{
+	if (csv_r != W.round)
+		return false;
+	const bool flee = csv_st == static_cast<int>(combat::FLEE);
+	if (!((csv_st == static_cast<int>(combat::CALM) && calm_ok) || (flee && flee_ok)))
+		return false;
+	const float lim = b * combat::eff_hp(W.me);
+	const vec2 me = W.me.pos;
+	int rr[16]; // dest-side reach per heavy foe: + 1 for a visible foe with two turns before my next (the paired double turn); -1: not heavy
+	bool safe = true; // my tile is outside every heavy foe's one-turn reach
+	for (int i = 0; i < csv_n; ++i)
+	{
+		const CsvFoe& f = csv_f[i];
+		rr[i] = -1;
+		if (f.reach < 0 || f.burst < lim)
+			continue;
+		const bool vis = f.idx >= 0 && f.idx < static_cast<int>(W.enemies.size()) && W.enemies[static_cast<std::size_t>(f.idx)].pos == vec2{ f.x, f.y };
+		rr[i] = f.reach + ((vis && combat::burst::reach_burst_turns(W.enemies[static_cast<std::size_t>(f.idx)]) >= 2) ? 1 : 0);
+		safe = safe && cheb(me, vec2{ f.x, f.y }) > f.reach;
+	}
+	if (!safe)
+		return false;
+	auto bad = [&](vec2 p) // the step closes into a heavy foe's reach
+	{
+		for (int i = 0; i < csv_n; ++i)
+		{
+			const vec2 fp{ csv_f[i].x, csv_f[i].y };
+			if (rr[i] >= 0 && cheb(p, fp) <= rr[i] && cheb(p, fp) < cheb(me, fp))
+				return true;
+		}
+		return false;
+	};
+	if (!bad(dest))
+		return false;
+	for (const auto& e : W.enemies) // kill_now: a foe I kill this turn from here (the assessment's test)
+		if (combat::burst::kills(e, cheb(e.pos, me), 0))
+			return false;
+	if (flee)
+	{
+		bool out = false; // every free step in reach: the flee keeps today's choice
+		for (const vec2 dd : DIRS)
+			if (free_tile(me + dd) && !bad(me + dd))
+			{
+				out = true;
+				break;
+			}
+		if (!out)
+			return false;
+	}
+	const auto pt = W.me.type == cambc::champion_type::cassi ? cambc::champion_type::issac : W.me.type == cambc::champion_type::issac ? cambc::champion_type::cassi : W.me.type;
+	if (pt != W.me.type)
+		for (const auto& al : W.allies)
+			if (al.type == pt && cheb(al.pos, dest) <= 1)
+				return false; // the C&I pair moves to the partner
+	return true;
+}
+static bool csv_veto(vec2 dest)
+{
