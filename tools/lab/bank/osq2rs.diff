+// OSQ (b2264, RC C726/C735): every group in either half is heavy (rule hp >= 2,500), and each side has one. Ours: our walk reaches it
+// and the enemy's does not or is longer (integer walks); theirs: the mirror; ties and groups neither spawn reaches are in neither half. Static M only (the draft's distances): read only through OSQ_ON(1).
+bool osq_class()
+{
+	using namespace nova;
+	int na = 0, nb = 0;
+	for (const auto& g : M.groups)
+	{
+		const bool ours = g.d_home != UNREACH && (g.d_enemy == UNREACH || g.d_home < g.d_enemy);
+		const bool theirs = g.d_enemy != UNREACH && (g.d_home == UNREACH || g.d_enemy < g.d_home);
+		if (!ours && !theirs)
+			continue;
+		if (g.hp < OSQ_HEAVY_HP)
+			return false;
+		(ours ? na : nb) += 1;
+	}
+	return na > 0 && nb > 0;
+}
+bool osq_own_heavy(int gi)
+{
+	using namespace nova;
+	if (gi < 0 || gi >= M.ng)
