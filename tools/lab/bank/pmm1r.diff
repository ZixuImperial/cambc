+namespace nova::econ {
+// PMM (econ_flags.h; the callers read the flag).
+static int pmm_g = -1; // this turn's joined group (-1 none)
+static int pmm_prism_slot()
+{
+	for (int s = 0; s < P.n && s < 8; ++s)
+		if (P.type[static_cast<std::size_t>(s)] == cambc::champion_type::prism)
+			return s;
+	return -1;
+}
+static int pmm_box_dist(const GroupI& g, vec2 t)
+{
+	const int dx = t.x < g.bx0 ? g.bx0 - t.x : (t.x > g.bx1 ? t.x - g.bx1 : 0);
+	const int dy = t.y < g.by0 ? g.by0 - t.y : (t.y > g.by1 ? t.y - g.by1 : 0);
+	return std::max(dx, dy);
+}
+void pmm_turn()
+{
+	pmm_g = -1;
+	if (P.n < 4 || !W.alive || W.me.channeling() || !M.groups_ready() || gmem_size(mem) != static_cast<std::size_t>(M.ng))
+		return;
+	const int ps = pmm_prism_slot();
+	if (ps < 0 || ps == P.my_slot || ps >= comms::CLAIM_SLOTS || cltf_kind(P.my_slot) != 0)
+		return;
+	const int gi = comms::cgroup(ps);
+	if (gi < 0 || gi >= M.ng)
+		return;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	if (g.access != ACC_WALK || g.gems < PMM_GEMS || g.contest < 0.35f || g.contest > 0.65f || m.status == GS_RESPAWN)
+		return;
+	if (!(PMM_ON(2) || (PMM_ON(1) && m.status == GS_CLEARED)))
+		return;
+	// one mate: another mate already on it
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+		if (s != ps && s != P.my_slot && comms::cgroup(s) == gi)
+			return;
+	bool foe = false;
+	for (const auto& e : W.enemies)
+		foe = foe || pmm_box_dist(g, e.pos) <= PMM_FOE_R;
+	for (const auto& e : intel::team_table())
+		foe = foe || (e.alive && e.round > now() - 4 && pmm_box_dist(g, e.pos) <= PMM_FOE_R);
+	if (!foe)
+		return;
+	if (T.target != gi)
+	{
+		if (W.me.gems >= 30 || tm2_stance != 0 || T.capturing || engaged_now())
+			return;
+		if (W.me.hp + W.me.shield <= combat::foe_damage_over_ticks_deliver(4, 2))
+			return; // RC C1323: state, not a share: my HP + shield must outlast the known foes' two turns of hits
+		int d = pmm_box_dist(g, W.me.pos);
+		if (const distance_field* f = mv::group_field_ready(gi))
+		{
+			const std::uint16_t fd = dfget(*f, W.me.pos);
+			if (fd != UNREACH)
+				d = static_cast<int>(fd);
+		}
+		if (d > PMM_WALK)
+			return;
+		NLOG("r%d slot %d pmm joins her group %d\n", now(), P.my_slot, gi);
+		set_target(gi, std::max(T.rate, 0.0f), 1);
+	}
+	pmm_g = gi;
+}
+bool pmm_keep()
+{
+	return pmm_g >= 0 && pmm_g == T.target;
+}
+// On the capture: hold beside the region (not on a member tile) unless a seen foe can reach the region next turn (RCR bit 16: she keeps
+// the whole reward when it is uncontested). True: this turn is spent beside the region.
+bool pmm_hold_beside(int gi)
+{
+	if (pmm_g < 0 || pmm_g != gi)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	for (const auto& e : W.enemies)
+		for (int ci : g.members)
+			if (cheb(e.pos, M.camps[static_cast<std::size_t>(ci)].pos) <= combat::foe_next_turn_reach(e) + 1)
+				return false; // contested: stand on the region with her
+	bool on = false;
+	for (int ci : g.members)
+		on = on || M.camps[static_cast<std::size_t>(ci)].pos == W.me.pos;
+	if (!on)
+		return pmm_box_dist(g, W.me.pos) <= 2; // beside it already: hold (further away: walk in as usual)
+	if (!W.can_move() || W.moved)
+		return false;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = W.me.pos + d;
+		if (!inb(n) || !mv::free_tile(n) || bbget(M.camp_tiles, n) || mv::camp_threat(n) > 0)
+			continue;
+		return mv::try_move(n);
+	}
+	return false;
+}
+} // namespace nova::econ
