+// v641 CHS: for Cassi's Durability-Health entry while her Power-Focus emblem is missing: how many more of her first N Health shards
+// to buy now (0 = hold, the next entry comes first); -1 = no limit (another entry, another body, or the emblem is done).
+// CKT bit 2 (caller read the flag): Cassi's Durability-Health shard once her max HP reached CKT_HP and her Power-Focus emblem is missing.
+static bool ckt_skip(std::size_t si, const decltype(cambc::self().item_count())& counts)
+{
+	if (!ci_layer::me_cassi() || si != static_cast<std::size_t>(static_cast<std::uint32_t>(itm_shard(I_DURABILITY, 2))) || W.me.maxhp < static_cast<float>(CKT_TAB[2]))
+		return false;
+	return counts[cambc::item_type(static_cast<std::uint32_t>(itm_shard(I_POWER, 1)) + 1u)] == 0;
+}
+static int chs_cap(std::size_t si, int have, const decltype(cambc::self().item_count())& counts)
+{
+	if (!ci_layer::me_cassi() || si != static_cast<std::size_t>(static_cast<std::uint32_t>(itm_shard(I_DURABILITY, 2))))
+		return -1;
+	if (counts[cambc::item_type(static_cast<std::uint32_t>(itm_shard(I_POWER, 1)) + 1u)] > 0)
+		return -1;
+	return std::max(0, std::min(5, static_cast<int>(CHS_TAB[2])) - have);
+}
