+// b2411 GZN (narrow GEZ, Deep spec_gez_1113 + owner 'Try these' 13 Nov; caller read GZN_TAB first): a foe bag that ends the game
+// (tributed_them + bag >= WIN_TRIBUTE), seen now or remembered within GZN_TAB[2] rounds. Only a lock holder ALREADY within lock range of
+// the altar nearest that foe acts: it places our lock when none of ours stands and holds the ring. No walk-in (gez's BIG cost).
+static __attribute__((noinline)) bool gzn_foe(vec2& at, bool& fresh)
+{
+	fresh = true; // a foe in my sight now
+	for (const auto& e : W.enemies)
+		if (W.tributed_them + static_cast<int>(e.gems) >= rs::WIN_TRIBUTE)
+		{
+			at = e.pos;
+			return true;
+		}
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		if (!tt[i].alive || tt[i].pos.x < 0 || intel::team_body_round(i) < W.round - GZN_TAB[2])
+			continue;
+		const Body* b = intel::team_body(i);
+		if (b && W.tributed_them + static_cast<int>(b->gems) >= rs::WIN_TRIBUTE)
+		{
+			at = tt[i].pos;
+			fresh = W.round - tt[i].round <= GZN_TAB[4]; // GZN bit 2: the table position (own or team-shared sighting) is fresh
+			return true;
+		}
+	}
+	return false;
+}
