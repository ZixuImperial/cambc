+++ b/src/feat_tdc.h
@@ -0,0 +1,14 @@
+#pragma once
+// feat_tdc (TDC MARGIN, b1608; spec_tdc_1108.md, Econ + Combat): game_deny_pick treats a foe channel as ending when their tributed + bag
+// >= 1000 - TDC_M (00collision 01a1b919 r758-765: 667 + 331 = 998 was not 'ending'). Flag TDC_BITS, 0 = nova_b2681_vsr4i (v617).
+// Bit 1 MARGIN. Hook: combat.cpp game_deny_pick; flag first.
+#include "common.h"
+#define TDC_BITS 0
+#define TDC_M 60
+inline const volatile int TDC_TAB[3] = { 0x54444331, TDC_BITS, TDC_M }; // slot 0 magic keeps it out of .bss
+#define TDC_ON(b) ((TDC_TAB[1] & (b)) != 0)
+constexpr int TDC_BIT_MARGIN = 1;
+namespace nova::feat::tdc
+{
+bool near_end(int sum); // MARGIN: sum >= 1000 - TDC_M (caller: sum < 1000)
+} // namespace nova::feat::tdc
