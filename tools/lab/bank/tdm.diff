new file mode 100644
--- /dev/null
+++ b/src/feat_tdc.cpp
@@ -0,0 +1,21 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_tdc.cpp (TDC MARGIN, b1608): see feat_tdc.h. Reached only when TDC_ON(TDC_BIT_MARGIN) is true at the hook. Unity build: after combat.cpp.
+#include "feat_tdc.h"
+namespace nova::feat::tdc
+{
+namespace
+{
+void m_fire()
+{
+}
+} // namespace
+bool near_end(int sum)
+{
+	if (sum < ::nova::combat::deny::tune::GD_WIN_TRIBUTE - std::max(0, static_cast<int>(TDC_TAB[2])))
+		return false;
+	m_fire();
+	return true;
+}
+} // namespace nova::feat::tdc
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_tdc.h b/src/feat_tdc.h
