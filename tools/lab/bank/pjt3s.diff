+// PJT bit 8 (b1756): the Prism's contest term shrinks by .25 per mate committed to group g within 8 of it (claim, seen there); off
+// when a visible foe's single cast or the summed burst on the group's tiles would kill her (Combat's gate). 1 = no change.
+float pjt_contest_scale(const GroupI& g, int self)
+{
+	const Body* pb = self == my_slot() ? &W.me : W.ally_by_slot(self);
+	if (!pb || !pb->kit)
+		return 1.0f;
+	const float ehp = combat::eff_hp(*pb);
+	float sum = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		if (combat::burst::lethal_burst_hit(e, std::max(1, e.range), 0, nullptr) >= ehp)
+			return 1.0f;
+		sum += combat::burst::lethal_burst_hit(e, cheb(e.pos, g.anchor), 0, nullptr);
+		if (sum >= ehp)
+			return 1.0f;
+	}
+	int m = 0;
+	for (int s = 0; s < TM.n; ++s)
+		if (s != self && TM.claim[static_cast<std::size_t>(s)] == g.idx)
+			if (const Body* a = s == my_slot() ? &W.me : W.ally_by_slot(s))
+				m += cheb(a->pos, g.anchor) <= 8 ? 1 : 0;
+	return std::max(0.0f, 1.0f - 0.25f * static_cast<float>(m));
