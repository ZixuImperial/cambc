 // v896 CHO: 7 verified bug fixes (TTCX TDP EAF OLK RFV NTG CHO)
 #define CHO_BITS 1
 inline constexpr int CHO_TAB[2] = { 0x43484F33, CHO_BITS }; // slot 0 magic keeps it out of .bss
+// VDG (b2388, Econ spec_vdg_1113 bit 1; owner: "Vendetta steals even when close to allies", carry order P > V > M). Runtime data flag
+// VDG_TAB[1], read first; 0 = v897. Bit 1 PKW ORDER: at a group with a roster lead (cltf_level == 1; RC C1298), a non-lead's per-kit gold weight in
