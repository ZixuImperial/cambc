 #include "strat.h"
 
 #include "mapinfo.h"
 #include "prism.h" // PRISM_CARRY
 #include "kit.h" // rf5: kit layers (Vesper)
 #include "kit.h" // rf5: kit layers
@@ -1379,12 +1380,14 @@ bool pack(const std::vector<std::uint8_t>& in, std::vector<std::uint8_t>& out)
 	{
 		if (end + xt_len > 1024)
 			return false;
 		std::memcpy(out.data() + end, in.data() + E, xt_len);
 		end += xt_len;
 	}
