+				{
+					if (og < 0 || og >= M.ng)
+						continue;
+					const std::uint8_t so = mem[static_cast<std::size_t>(og)].status;
+					if (so != rsb1_st[static_cast<std::size_t>(og)] && (so == GS_CLEARED || so == GS_RESPAWN))
+						open = true;
+				}
+		}
+	}
+	if (open)
+		rsb1_used = true;
+	return open;
