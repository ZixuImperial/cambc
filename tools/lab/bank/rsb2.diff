+// b2169 RSB1: the drops of my own pass, the statuses at its pause, and the opening test at the resume.
+__attribute__((noinline)) bool rsb1_mark(int gi, int kind)
+{
+	if (!gbr_want)
+		return true;
+	if (rsb1_drop.size() != static_cast<std::size_t>(M.ng))
+		rsb1_drop.assign(static_cast<std::size_t>(M.ng), 0);
+	rsb1_drop[static_cast<std::size_t>(gi)] |= static_cast<std::uint8_t>(kind);
+	return true;
+}
+__attribute__((noinline)) void rsb1_clear()
+{
+	if (rsb1_drop.size() != static_cast<std::size_t>(M.ng))
+		rsb1_drop.assign(static_cast<std::size_t>(M.ng), 0);
+	else
+		std::fill(rsb1_drop.begin(), rsb1_drop.end(), static_cast<std::uint8_t>(0));
+}
+__attribute__((noinline)) void rsb1_note()
+{
+	rsb1_st.assign(static_cast<std::size_t>(M.ng), 0);
+	for (int g = 0; g < M.ng && static_cast<std::size_t>(g) < mem.size(); ++g)
+		rsb1_st[static_cast<std::size_t>(g)] = mem[static_cast<std::size_t>(g)].status;
+}
+__attribute__((noinline)) bool rsb1_restart()
+{
+	if (rsb1_used || rsb1_drop.size() != static_cast<std::size_t>(M.ng) || rsb1_st.size() != static_cast<std::size_t>(M.ng) || mem.size() < static_cast<std::size_t>(M.ng))
+		return false;
+	bool open = rsb1_news_due();
+	const bool gt = gate_of.size() == static_cast<std::size_t>(M.ng);
+	for (int gi = 0; gi < gbr_gi && gi < M.ng && !open; ++gi)
+	{
+		const std::uint8_t k = rsb1_drop[static_cast<std::size_t>(gi)];
+		if (!k)
+			continue;
+		const auto& m = mem[static_cast<std::size_t>(gi)];
+		if ((k & 1) && m.fail_until <= now())
+			open = true;
+		else if (k & 2)
