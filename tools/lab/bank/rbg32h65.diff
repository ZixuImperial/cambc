+static void rbg_guard_stun(fight_turn::FightCtx& c)
+{
+	if (!fight_turn::fight_stun_castable(c.k) || W.me.gems >= 50u)
+		return;
+	const Body* w = rbg_ward();
+	if (!w)
+		return;
+	const Body* st = nullptr;
+	float tb = -1.0f;
+	for (std::size_t i = 0; i < W.enemies.size(); ++i)
+	{
+		const Body& e = W.enemies[i];
+		if (!fight_turn::fight_stunnable(e) || foe_model::unreachable(e) || cheb(e.pos, W.me.pos) > c.cc_r)
+			continue;
+		if (e.h == rbg_mby[w->slot] && W.round - rbg_mhit[w->slot] <= 2)
+		{
+			st = &e; // the foe that just hit her
+			break;
+		}
+		const Foe fo = foe_of(e, static_cast<int>(i));
+		if (cheb(fo.pos, w->pos) <= fo.reach && fo.burst > tb)
+		{
+			tb = fo.burst;
+			st = &e;
+		}
+	}
+	const std::uint32_t wh = w->h;
+	if (st && cast_on_champion(c.k.slot_cc, *st))
+	{
+		c.acted = true;
+		rbg_gr = W.round;
+		rbg_gw = wh;
+	}
+}
+// up to 3 rounds after a guard stun: back to within 1 of her (dash, else a step). True: the turn is taken.
+static bool rbg_guard_stay(fight_turn::FightCtx& c)
+{
+	if (rbg_gr >= W.round || W.round - rbg_gr > 3)
+		return false;
+	const Body* w = nullptr;
+	for (const auto& al : W.allies)
+		if (al.h == rbg_gw)
