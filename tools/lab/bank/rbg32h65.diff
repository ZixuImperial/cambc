+// RBG bit 32 (b1824, combat_flags.h): Ren the aggressive stunner. Callers read RBG_ON(32) first.
+static std::uint32_t rbg_h = 0; // the foe my bit-32 stun took
+static int rbg_r = -100;        // the round of that stun
+// a mate can follow up on t: within 4 of me, or t within its reach next turn
+static bool rbg_mate_near(const Body& t)
+{
+	for (const auto& al : W.allies)
+		if (!al.channeling() && (cheb(al.pos, W.me.pos) <= 4 || cheb(al.pos, t.pos) <= std::max(1, al.range) + 1))
+			return true;
+	return false;
+}
+// our frailest body within 4 of me (me included, or mates only)
+static const Body* rbg_frail(bool with_me)
+{
+	const Body* fr = with_me ? &W.me : nullptr;
+	float fh = with_me ? eff_hp(W.me) : 1e30f;
+	for (const auto& al : W.allies)
+		if (cheb(al.pos, W.me.pos) <= 4 && eff_hp(al) < fh)
+		{
+			fh = eff_hp(al);
+			fr = &al;
+		}
+	return fr;
+}
+static const Body* rbg_stun_pick(const fight_turn::FightCtx& c)
+{
+	if (!ren_layer::type(W.me.type) || W.me.gems >= 50u || W.me.frac() * 100.0f < static_cast<float>(RBG_TAB[2]))
+		return nullptr;
+	const Body* frail = rbg_frail(true);
+	const Body *ch = nullptr, *thr = nullptr, *fin = nullptr;
+	float tb = 0.0f;
+	for (std::size_t i = 0; i < W.enemies.size(); ++i)
+	{
+		const Body& e = W.enemies[i];
+		if (!fight_turn::fight_stunnable(e) || foe_model::unreachable(e) || cheb(e.pos, W.me.pos) > c.cc_r || !rbg_mate_near(e))
+			continue;
+		if (e.channeling())
+		{
+			ch = &e; // the stun cancels a recall, tribute or crystal channel
+			continue;
+		}
+		if (!fin && e.frac() < 0.40f)
+			for (const auto& al : W.allies)
+				if (cheb(al.pos, e.pos) <= std::max(1, al.range) + 1)
+					fin = &e;
+		const Foe fo = foe_of(e, static_cast<int>(i));
+		if (cheb(fo.pos, frail->pos) <= fo.reach && fo.burst > tb)
+		{
+			tb = fo.burst;
+			thr = &e;
+		}
+	}
+	if (ch)
+		return ch;
+	if (thr)
+		return thr;
+	if (fin)
+		return fin;
+	if (c.d <= c.cc_r && fight_turn::fight_stunnable(c.f) && !foe_model::unreachable(c.f) && rbg_mate_near(c.f))
+		return &c.f;
+	return nullptr;
+}
+// turn 1: the stun from range, no walk-in (the stun excludes walking)
+static void rbg_stun_first(fight_turn::FightCtx& c)
+{
+	if (!fight_turn::fight_stun_castable(c.k))
+		return;
+	const Body* st = rbg_stun_pick(c);
+	if (!st)
+		return;
+	const std::uint32_t h = st->h;
+	if (cast_on_champion(c.k.slot_cc, *st))
+	{
+		c.acted = true;
+		rbg_h = h;
+		rbg_r = W.round;
+	}
+}
+// later turns: dash and step next to the stunned foe and stay on it while the stun cools down. True: the turn is taken.
+static bool rbg_stick(fight_turn::FightCtx& c)
+{
+	if (rbg_r >= W.round || W.round - rbg_r > 8 || slot_up(c.k.slot_cc) || !ren_layer::type(W.me.type) ||
+		W.me.frac() * 100.0f < static_cast<float>(RBG_TAB[3]))
+		return false;
+	const Body* t = nullptr;
+	for (const auto& e : W.enemies)
+		if (e.h == rbg_h)
+			t = &e;
+	if (!t || foe_model::unreachable(*t))
+		return false;
+	const vec2 tp = t->pos;
+	if (cheb(W.me.pos, tp) > 1)
+	{
+		const Body* fm = rbg_frail(false);
+		bitboard goals;
+		vec2 bd{ -1, -1 };
+		int bs = 1 << 30;
+		for (int dx = -1; dx <= 1; ++dx)
+			for (int dy = -1; dy <= 1; ++dy)
+			{
+				const vec2 q{ tp.x + dx, tp.y + dy };
+				if ((dx == 0 && dy == 0) || !inb(q) || !mv::free_tile(q))
+					continue;
+				bbset(goals, q);
+				const int s = (fm ? 4 * cheb(q, fm->pos) : 0) + cheb(q, W.me.pos);
+				if (cheb(q, W.me.pos) <= c.dash_r && s < bs)
+				{
+					bs = s;
+					bd = q;
+				}
+			}
+		if (bd.x >= 0 && slot_up(c.k.slot_dash) && cast_at(c.k.slot_dash, bd))
+			fight_turn::fight_moved(c);
+		if (cheb(W.me.pos, tp) > 1 && W.can_move() && bbany(goals) && mv::step_to_set(goals, 20))
+			fight_turn::fight_moved(c);
+	}
+	if (cheb(W.me.pos, tp) > W.me.range)
+		return false;
+	if (W.can_attack())
+		attack_champion(*t);
+	c.d = cheb(W.me.pos, c.f.pos);
+	c.acted = true;
+	return true;
