+// the guarded mate: a frailer mate within 4 hit by a champion in the last 10 rounds (the frailest), or null
+static const Body* rbg_ward()
+{
+	if (!ren_layer::type(W.me.type))
+		return nullptr;
+	const Body* w = nullptr;
+	float wh = 1e30f;
+	for (const auto& al : W.allies)
