+		{
+			const vec2 q{ wp.x + dx, wp.y + dy };
+			if ((dx == 0 && dy == 0) || !inb(q) || !mv::free_tile(q))
+				continue;
+			bbset(goals, q);
+			const int s = cheb(q, c.f.pos); // nearer the foe: between her and it
+			if (cheb(q, W.me.pos) <= c.dash_r && s < bs)
+			{
+				bs = s;
+				bd = q;
+			}
+		}
+	bool mv_ok = false;
+	if (bd.x >= 0 && slot_up(c.k.slot_dash) && cast_at(c.k.slot_dash, bd))
