@@ -426,6 +426,29 @@ inline constexpr int BHW_TAB[2] = { 0x42485731, BHW_BITS }; // slot 0 magic keep
 // Bit 2 FRONT HOLD: fight_choose_hold gives her support_hold_back outside kill_window, only while a seen foe's one-turn burst >= her eff
 // HP (the glass test). Bit 4: bit 2 without the glass test.
 #define CFH_BITS 1
 // v697 CFH: CFH, Cassi steps to range 4 when slot ready
 #define CFH_R 4
 inline constexpr int CFH_TAB[3] = { 0x43464831, CFH_BITS, CFH_R }; // slot 0 magic keeps it out of .bss
+// RBG (b1824, spec_rbg_1110 amendments 1 and 3, CI Analyser; owner: Ren plays as Ren, a mobile stunner first). Runtime data flag,
+// read first; 0 = off. Bit 32 AGGRESSIVE STUNNER (Ren only, FIGHT, stun ready, unmoved, HP >= RBG_HP %, under 50 gems): the stun
+// goes out first from range 4 on a foe channelling, else the foe with the biggest one-turn burst on our frailest body within 4,
+// else a foe under 40% a mate reaches, else the focus; only with a mate within 4 or one that reaches the target. The next turns
+// (stun on cooldown, up to 8 rounds, HP >= RBG_STAY %) he dashes and steps next to that foe (the tile nearest our frailest mate)
+// and hits it. While a foe was seen within 8 of him in the last 3 rounds his stun is not spent on camps.
+// Bit 64 CAMP STUN + TRAVEL DASH (amendment 4): at his group, with no foe seen within 6 in the last 2 rounds, the stun goes on a camp
+// before the walk (it excludes walking, GameRules.md:756); a plain walk travel-dashes from 3 tiles left (not 4).
+// Bit 2 FRONT TILE (amendment 4): co-farming within 4 of a frailer mate (lower max HP) at HP >= RBG_FRONT %, he stands (or steps) on
+// a tile where he is strictly the nearest of us to every awake attacker of the group that has a mate in its reach (GameRules.md:192;
+// ties go by turn order, interactions.md:101), and hits from it.
+#define RBG_BITS 0
+#define RBG_HP 50
+#define RBG_STAY 35
+// Bit 4 GUARD STUN (amendment 4): only while a frailer mate (lower max HP) within 4 was hit by a champion in the last 10 rounds (a mate's
+// HP fell with a foe in its range): his stun is kept off camps while a foe was seen within RBG_GUARD_R of her in the last 3 rounds,
+// goes out first on the foe that hit her in the last 2 rounds or whose one-turn reach covers her, and for 3 rounds after it he
+// dashes or steps back to within 1 of her.
+#define RBG_FRONT 40
+#define RBG_GUARD_R 8
+#define RBG_SAFE 6 // bit 64: no foe seen within this in the last 2 rounds
+inline const volatile int RBG_TAB[7] = { 0x52424731, RBG_BITS, RBG_HP, RBG_STAY, RBG_FRONT, RBG_GUARD_R, RBG_SAFE }; // slot 0 magic keeps it out of .bss
+#define RBG_ON(b) ((RBG_TAB[1] & (b)) != 0)
