+// RBG bit 4 (b1824, combat_flags.h): the guard stun. Callers read RBG_ON(4) first.
+static int rbg_mhp[8] = { 0 }, rbg_mhit[8] = { -100, -100, -100, -100, -100, -100, -100, -100 }; // per mate slot: HP, last champion hit
+static std::uint32_t rbg_mby[8] = { 0 };                                                        // the foe that hit her
+static int rbg_gr = -100;          // the round of my guard stun
