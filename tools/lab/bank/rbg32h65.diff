+		{
+			wh = eff_hp(al);
+			w = &al;
+		}
+	return w;
+}
+// a foe seen within RBG_GUARD_R of the guarded mate in the last 3 rounds: the stun stays off camps
+bool rbg_guard_hold()
+{
+	const Body* w = rbg_ward();
+	if (!w)
+		return false;
+	for (const auto& s : seen)
