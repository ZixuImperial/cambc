+// b1841 AWK1: an altar spot's keys are its tribute tiles: one bush tile per ring bush cluster (a ward sees into a cluster only from
+// inside it, so one tile stands for the cluster), then open ring tiles spread out (farthest from the keys so far). None: unchanged.
+void awk1_ring_keys(Spot& s, vec2 ap)
+{
+	std::array<vec2, 8> ring{};
+	int n = 0;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 q = ap + d;
+		if (inb(q) && bbget(M.altar_adj_all, q))
+			ring[static_cast<std::size_t>(n++)] = q;
+	}
+	if (n == 0)
+		return;
+	// Ring bush tiles in one cluster: cardinal links along the ring (a ring cluster joins through the ring or outside it; outside
+	// links are rare and only cost a duplicate key).
+	std::array<std::int8_t, 8> cid{};
+	cid.fill(-1);
+	int nc = 0;
+	for (int i = 0; i < n; ++i)
+	{
+		if (!bbget(M.bushes, ring[static_cast<std::size_t>(i)]) || cid[static_cast<std::size_t>(i)] >= 0)
+			continue;
+		cid[static_cast<std::size_t>(i)] = static_cast<std::int8_t>(nc);
+		bool grew = true;
+		while (grew)
+		{
+			grew = false;
+			for (int j = 0; j < n; ++j)
+			{
+				if (cid[static_cast<std::size_t>(j)] >= 0 || !bbget(M.bushes, ring[static_cast<std::size_t>(j)]))
+					continue;
+				for (int k = 0; k < n; ++k)
+					if (cid[static_cast<std::size_t>(k)] == nc
+						&& iabs(ring[static_cast<std::size_t>(j)].x - ring[static_cast<std::size_t>(k)].x)
+								+ iabs(ring[static_cast<std::size_t>(j)].y - ring[static_cast<std::size_t>(k)].y) == 1)
+					{
+						cid[static_cast<std::size_t>(j)] = static_cast<std::int8_t>(nc);
+						grew = true;
+						break;
+					}
+			}
+		}
+		++nc;
+	}
+	int n_open = 0;
+	for (int i = 0; i < n; ++i)
+		n_open += bbget(M.bushes, ring[static_cast<std::size_t>(i)]) ? 0 : 1;
+	s.nk = 0;
+	const int max_bush = n_open > 0 ? 3 : 4;
+	for (int c = 0; c < nc && s.nk < max_bush; ++c)
+		for (int i = 0; i < n; ++i)
+			if (cid[static_cast<std::size_t>(i)] == c)
+			{
+				s.key[s.nk++] = ring[static_cast<std::size_t>(i)];
+				break;
+			}
+	while (s.nk < 4)
+	{
+		int bi = -1, bd = -1;
+		for (int i = 0; i < n; ++i)
+		{
+			const vec2 q = ring[static_cast<std::size_t>(i)];
+			if (bbget(M.bushes, q))
+				continue;
+			int dmin = BIG;
+			for (int k = 0; k < s.nk; ++k)
+				dmin = std::min(dmin, cheb(q, s.key[static_cast<std::size_t>(k)]));
+			if (dmin > 0 && dmin > bd)
+			{
+				bd = dmin;
+				bi = i;
+			}
+		}
+		if (bi < 0)
+			break;
+		s.key[s.nk++] = ring[static_cast<std::size_t>(bi)];
+	}
+	if (s.nk == 0)
+	{
+		s.key[0] = ap;
+		s.nk = 1;
+		return;
+	}
+	s.ext = 1;
+}
