+// v704 HPK bit 1: each camp's last seen health (-1: none) and the round of that sighting. A hidden camp keeps it for g.respawn +
+// HPK_RSP_PAD rounds (camps never regenerate, INT:106; a group respawns full only after its capture and timer, GR:202).
+static std::vector<float> hpk_hp;
+static std::vector<int> hpk_at;
+static void hpk_size()
+{
+	if (hpk_hp.size() != M.camps.size())
+	{
+		hpk_hp.assign(M.camps.size(), -1.0f);
+		hpk_at.assign(M.camps.size(), -100000);
+	}
+}
+// A hidden camp's health to count: its last seen health inside the window, else full.
+static float hpk_hidden(int ci, const GroupI& g)
+{
+	hpk_size();
+	const auto i = static_cast<std::size_t>(ci);
+	return (hpk_hp[i] >= 0.0f && now() - hpk_at[i] < g.respawn + HPK_TAB[2]) ? hpk_hp[i] : M.camps[i].hp;
+}
+// The group's living health from my sight now and the remembered hidden camps; refreshes the memory of the camps I see. A camp seen
+// dead is remembered only while a mate camp is seen alive (the group cannot have been captured then).
+static float hpk_group_hp(const GroupI& g)
+{
+	hpk_size();
+	bool alive_seen = false;
+	for (int ci : g.members)
+	{
+		const auto& c = M.camps[static_cast<std::size_t>(ci)];
+		alive_seen |= bbget(W.vis, c.pos) && bbget(W.occ_camps, c.pos);
+	}
+	float sum = 0.0f;
+	for (int ci : g.members)
+	{
+		const auto i = static_cast<std::size_t>(ci);
+		const auto& c = M.camps[i];
+		if (!bbget(W.vis, c.pos))
+		{
+			sum += hpk_hidden(ci, g);
+			continue;
+		}
+		float h = 0.0f;
+		if (bbget(W.occ_camps, c.pos))
+		{
+			const VisCamp* vc = visible_camp(ci);
+			if (!vc)
+			{
+				sum += hpk_hidden(ci, g); // alive but unread (my ward sees it beyond the 9-tile camp read): the memory, not full
+				continue;
+			}
+			h = vc->hp;
+		}
+		if (h > 0.0f || alive_seen)
+		{
+			hpk_hp[i] = h;
+			hpk_at[i] = now();
+		}
+		else
+			hpk_hp[i] = -1.0f;
+		sum += h;
+	}
+	return sum;
+}
