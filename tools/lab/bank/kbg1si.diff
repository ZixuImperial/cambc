+namespace
+{
+struct KbgMem
+{
+	bool alive = false;
+	int gems = 0, r = -1000, fd = 99, ti = -1, bag = 0, set = -1000, tt0 = 0;
+	std::uint32_t foe = 0;
+};
+KbgMem kbg;
+// v683 KBG bit 1 (called with the flag read first): my own death with a bag, credited to the nearest foe of my last live turn.
+void kbg_track()
+{
+	const int t = now();
+	if (kbg.alive && !W.alive && kbg.gems >= 30 && t - kbg.r <= 2 && kbg.fd <= 5)
+	{
+		kbg.ti = team_index(kbg.foe);
+		kbg.bag = kbg.gems;
+		kbg.set = t;
+		kbg.tt0 = W.tributed_them;
+	}
+	kbg.alive = W.alive;
+	if (W.alive)
+	{
+		kbg.gems = static_cast<int>(W.me.gems);
+		kbg.r = t;
+		kbg.fd = 99;
+		for (const auto& e : W.enemies)
+			if (const int d = cheb(e.pos, W.me.pos); d < kbg.fd)
+			{
+				kbg.fd = d;
+				kbg.foe = e.h;
+			}
+	}
+	if (kbg.ti >= 0)
+	{
+		const std::size_t i = static_cast<std::size_t>(kbg.ti);
+		if (i >= tk_tab.size() || !tk_tab[i].alive || (i < team_body_r.size() && team_body_r[i] > kbg.set) || W.tributed_them >= kbg.tt0 + kbg.bag)
+			kbg.ti = -1; // seen again (its real bag read), dead, or banked
+	}
+}
+} // namespace
+int kbg_extra(std::size_t i) { return kbg.ti >= 0 && static_cast<std::size_t>(kbg.ti) == i ? kbg.bag : 0; }
