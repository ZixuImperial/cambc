+// CTS (b2367): p is a spawn tile of a member of group gi.
+static bool cts_member_tile(int gi, vec2 p)
+{
+	for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+		if (M.camps[static_cast<std::size_t>(ci)].pos == p)
+			return true;
+	return false;
+}
+// CTS bit 1 (bit 2: >= 15 gems): the roster carry steps onto a free, camp-safe member tile when her group dies within her next 2 turns.
+static void cts_step_in(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	if (T.target != gi || !W.can_move() || cltf_level(P.my_slot, g) < 1 || (CTS_ON(2) && g.gems < 15) || cts_member_tile(gi, W.me.pos))
+		return;
+	const float left = mem[static_cast<std::size_t>(gi)].hp_left;
+	if (left < 0.0f || left > 2.0f * combat::body_dps(W.me))
+		return;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 8)
+			return;
+	if (combat::nearest_foe_distance_seen(1) <= 8)
+		return;
+	static bitboard cts_goals{ cambc::uninitialized };
+	nchk(cambc::detail::sdk_Bitboard_Zero(cts_goals.ptr()));
+	bool any = false;
+	for (int ci : g.members)
+	{
+		const vec2 t = M.camps[static_cast<std::size_t>(ci)].pos;
+		if (mv::free_tile(t) && mv::camp_threat(t) <= 0.0f)
+		{
+			bbset(cts_goals, t);
+			any = true;
+		}
+	}
+	if (any)
+		mv::step_to_set(cts_goals, 30, gi);
+}
+// CTS bit 4: a non-carry on a member tile whose hit would kill the group's last living member holds it one turn while a carry claiming gi
+// stands within 2 of a member tile.
+static int cts_hold_round = -1000;
+static bool cts_hold_last_hit(int gi, int focus)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
