+// b2023 XFL_BITS bit 1 EFR1 (RC X452): fd1p's goal field, handed over by escape_toward for its next step_to_set call only.
+const distance_field* sts_pre = nullptr;
+// EFR1: step_to_set's tail on fd1p's field (same roots and walls, radius 18 >= rad): the values below cur are final in both fields, and
+// only those are read when no dash can run.
+static bool sts_from_pre(const distance_field& pre, vec2 me, int rad, const bitboard& walls, const bitboard& roots, StsFails& fails,
+	int ignore_group)
+{
+	const std::uint16_t pc = dfget(pre, me);
+	const std::uint16_t cur = (pc == UNREACH || pc > rad) ? UNREACH : pc;
+	if (cur == UNREACH)
+	{
+		StsFail& sf = fails.list[static_cast<std::size_t>(fails.next)];
+		fails.next ^= 1;
+		sf.w = walls;
+		sf.r = roots;
+		sf.me = me;
+		sf.rad = rad;
+		return false;
+	}
+	CandList cands;
+	const FView fv = fview(pre);
+	const BView bw = bview(walls);
+	each_neighbour8(me, fv, bw,
+		[&](vec2 n, vec2, std::uint16_t v) __attribute__((always_inline))
+		{
+			if (v == UNREACH || v >= cur)
+				return;
+			cands.push_back({ n, (0) + static_cast<int>(camp_threat(n, ignore_group)) });
+		});
+	if (cands.empty())
+		return false;
+	skip_search_break_tie(cands, roots);
+	return move_best(cands);
+}
