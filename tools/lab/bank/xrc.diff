 // combat_recall.cc: Whether a recall is safe.
 #include "combat_internal.h"
 namespace nova::combat {
+// XRC bit 16 TPLAND: a foe in ST_TELEPORT counts at the nearer of where it stands and its visible landing tile (GR:273-275 teleport channel).
+int xrc_tp_dist(const Body& e, vec2 p)
+{
+	int d = cheb(e.pos, p);
+	std::array<cambc::detail::teleport_info, 16> tp{};
+	std::uint32_t n = 0;
+	if (cambc::detail::sdk_teleports(tp.data(), tp.size(), &n) != 0)
+		return d;
+	for (std::uint32_t i = 0; i < std::min<std::uint32_t>(n, 16u); ++i)
+		if (tp[i].champion == e.h)
+			d = std::min(d, cheb(vec2{ tp[i].destination.x, tp[i].destination.y }, p));
+	return d;
+}
