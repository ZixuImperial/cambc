@@ -904,6 +904,13 @@ inline constexpr int PFB_TAB[4] = { 0x50464231, PFB_BITS, 5, 20 }; // slot 0 mag
 #define PFB_CNT(k, c) ((void)0) // fire count: the diag copy records bit k when c; release: nothing, c unevaluated
 // VCR (b1823, Rule Checker VCDR1, minor bug). Runtime data flag VCR_TAB[1], read first; 0 = live. Bit 1: vcd_clear_dash_impl does not
 // dash onto its target group once it has respawned (captured: GS_RESPAWN).
 #define VCR_BITS 1
 inline const volatile int VCR_TAB[2] = { 0x56435231, VCR_BITS }; // slot 0 magic keeps it out of .bss
 #define VCR_ON(b) ((VCR_TAB[1] & (b)) != 0)
+
+// SRX (b1837, Planner param read of the siege bar, 11 Nov). Runtime data flag, read first; 0 = v725. Bit 1: the team siege call's
+// stat-ratio bar (SG_SR, and SG_CREW_SR for a crew call; both 1.1) becomes SRX_X100 / 100 (econ_team_ops.cc siege call test).
+#define SRX_BITS 0
+#define SRX_X100 110
+inline const volatile int SRX_TAB[3] = { 0x53525831, SRX_BITS, SRX_X100 }; // slot 0 magic keeps it out of .bss
+#define SRX_ON(b) ((SRX_TAB[1] & (b)) != 0)
