+// b2392 HLS bit 4 (SPZ 8a, RC C919b; the caller read the flag): the home balance at p is > 1: me + visible mates within HLS_SPZ_MATE_R of
+// p (eff_hp x (Str + Focus)) against the foes that could be home at full health by team intel (roster): alive and unseen for >=
+// HLS_SPZ_RECALL rounds (never seen counts), or respawned onto their spawn within HLS_SPZ_RECALL rounds (src 4); dead foes are out.
+bool spz_home_ok(vec2 p)
+{
+	float uh = combat::eff_hp(W.me), us = W.me.str + W.me.foc;
+	for (const auto& al : W.allies)
+		if (!al.channeling() && cheb(al.pos, p) <= HLS_SPZ_MATE_R)
+		{
+			uh += combat::eff_hp(al);
+			us += al.str + al.foc;
+		}
+	const auto& tt = intel::team_table();
+	int home = 0;
+	float sh = 0, sp = 0;
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		const auto& e = tt[i];
+		if (!e.alive)
+			continue;
+		const int age = now() - e.round;
+		if (!((e.src == 4 && age <= HLS_SPZ_RECALL) || age >= HLS_SPZ_RECALL))
+			continue;
+		const Body* b = intel::team_body(i);
+		++home;
+		sh += b ? b->maxhp + b->shield : W.me.maxhp;
+		sp += b ? b->str + b->foc : W.me.str + W.me.foc;
+	}
+	if (home == 0)
+		return true; // every foe seen elsewhere within its recall time
+	return uh * us > sh * sp;
+}
 } // namespace nova::econ
 
