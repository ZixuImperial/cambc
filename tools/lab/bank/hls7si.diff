+// HLS bit 1 (b2392, econ_flags.h): mate distress near a crystal landing, from team knowledge. Each turn (the caller read the flag): my
+// sight of each mate (HP, tile), its claimed group while alive, and the round I first read it dead (is_alive needs no sight).
+namespace memory
+{
+namespace
+{
+struct HlsMate
+{
+	bool dead = false;
+	int dead_r = -1000;  // the round I first read it dead
+	int seen_r = -1000;  // my last sight of it
+	vec2 seen_p{ -1, -1 };
+	int claim_g = -1;    // its last claimed group while alive
+	int nh = 0;          // ring of sightings: round, HP, max HP, tile
+	std::array<int, 12> hr{};
+	std::array<float, 12> hp{}, hm{};
+	std::array<vec2, 12> hpos{};
+};
+std::array<HlsMate, 8> hls_m{};
+int hls_r = -1;
+}
+} // namespace memory
+void hls_note()
+{
+	if (memory::hls_r == W.round)
+		return;
+	memory::hls_r = W.round;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		auto& m = memory::hls_m[static_cast<std::size_t>(s)];
+		const Body* a = W.ally_by_slot(s);
+		bool alive = a != nullptr;
+		if (!alive)
+		{
+			std::int32_t al = 1;
+			alive = !(cambc::detail::sdk_champion_is_alive(P.handle[static_cast<std::size_t>(s)], &al) == 0 && al == 0);
+		}
+		if (!alive)
+		{
+			if (!m.dead)
+				m.dead_r = W.round;
+			m.dead = true;
+			continue;
+		}
+		m.dead = false;
+		const int g = comms::cgroup(s);
+		if (g >= 0 && static_cast<std::size_t>(g) < M.groups.size())
+			m.claim_g = g;
+		if (a)
+		{
+			m.seen_r = W.round;
+			m.seen_p = a->pos;
+			const auto k = static_cast<std::size_t>(m.nh++ % 12);
+			m.hr[k] = W.round;
+			m.hp[k] = a->hp;
+			m.hm[k] = a->maxhp;
+			m.hpos[k] = a->pos;
+		}
+	}
+}
+bool hls_distress(vec2 t)
+{
+	hls_note();
+	const int r = W.round;
+	bool hit = false;
+	for (int s = 0; s < P.n && s < 8 && !hit; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		const auto& m = memory::hls_m[static_cast<std::size_t>(s)];
+		if (m.dead)
+		{
+			if (r - m.dead_r > 10)
+				continue;
+			hit = (m.seen_r >= m.dead_r - 10 && cheb(m.seen_p, t) <= 8) ||
+				  (m.claim_g >= 0 && cheb(M.groups[static_cast<std::size_t>(m.claim_g)].anchor, t) <= 8);
+			continue;
+		}
+		const int n = std::min(m.nh, 12);
+		for (int j = 0; j < n && !hit; ++j) // a later sighting within 8 of t, >= 25% of max HP under an earlier one, both in the last 10 rounds
+		{
+			if (r - m.hr[static_cast<std::size_t>(j)] > 10 || cheb(m.hpos[static_cast<std::size_t>(j)], t) > 8)
+				continue;
+			for (int i = 0; i < n && !hit; ++i)
+				hit = m.hr[static_cast<std::size_t>(i)] < m.hr[static_cast<std::size_t>(j)] && r - m.hr[static_cast<std::size_t>(i)] <= 10 &&
+					  m.hp[static_cast<std::size_t>(i)] - m.hp[static_cast<std::size_t>(j)] >= 0.25f * m.hm[static_cast<std::size_t>(j)];
+		}
+	}
+	if (!hit)
+		return false;
+	int ok = 0;
+	for (const auto& a : W.allies)
+		ok += a.frac() > 0.5f && cheb(a.pos, t) <= 5;
+	return ok < 2;
+}
 } // namespace nova::combat
