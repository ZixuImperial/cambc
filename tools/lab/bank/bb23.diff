+
+namespace nova {
+// BB23 SH4: a foe's finish share counts its shield, (hp + shield) / maxhp (the sure-kill test already uses eff_hp).
+inline float bb23_finish_frac(const Body& e)
+{
+	if (BB23_ON(4) && e.shield > 0.0f)
+		return e.maxhp > 0 ? mu::ehp(e) / e.maxhp : 0.0f; // eff_hp: hp + shield
+	return e.frac();
+}
+// BB23 DD3: a foe on its spawn is skipped unless this hit kills it (it heals at its turn end). bb23_dd3_kill counts the kept cases.
+inline bool bb23_dd3_kill() { return true; }
+inline bool bb23_spawn_skip(const Body& e, float dmg)
+{
+	if (!bbget(M.enemy_spawn, e.pos))
+		return false;
+	return !(mu::ehp(e) <= dmg && bb23_dd3_kill()); // mu::ehp = eff_hp
+}
+} // namespace nova
