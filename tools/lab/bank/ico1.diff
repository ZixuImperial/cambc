+++ b/src/econ_flags.h
@@ -853,6 +853,13 @@ inline const volatile int AHX_TAB[2] = { 0x41485831, AHX_BITS }; // slot 0 magic
 // b1802 XGV (Rule Checker X70): runtime data flag, 0 = off. Bit 1: the end-game gold-only value (rate_for's crew trip and the PEG1 pair
 // trip) applies group_value's gold terms: the slot's gold weight, holder_gold_mult (Vesper +33%, Treasure +10%, GR:532) and Prospector gold
 // (GR:297), instead of the bare team gold weight.
 // v695 XGV: 9 fixes fbbw3,tcs,x66j,bhw1,x65c,fgd1,pbq8,qmd1,xgv1
 #define XGV_BITS 1
 inline constexpr int XGV_TAB[2] = { 0x58475631, XGV_BITS }; // slot 0 magic keeps it out of .bss
+// XOB (b1808, X85 econ observe). Runtime data flag XOB_TAB[1], read first; 0 = v695. Bit 1 WLF: observe_lift_stale_threat's foe check
+// also scans W.enemies_far (foes only my ward sees, WARD_NEAR 0), so a guarded group keeps its flee/threat mark. Bit 2 WES: a ward-seen foe
+// within 5 of the anchor stamps m.enemy_seen too. Bit 4 ICO: intel_cleared keeps the exact RESPAWN timer early return when a mate
+// claimed the group recently (cnw_own), as it does otherwise.
+#define XOB_BITS 0
+inline const volatile int XOB_TAB[2] = { 0x584F4231, XOB_BITS }; // slot 0 magic keeps it out of .bss
+#define XOB_ON(b) ((XOB_TAB[1] & (b)) != 0)
