 // Gold in gem units. Early gold buys items that speed up every later clear (and wins fights), so it is worth a
 // third of a gem until round 400; late in the game it only breaks ties. Where monoliths hold most of the gems,
 // gems are scarce and gold counts for less.
+// LGR (econ_flags.h): the early weight x clamp(L / LGR_L0, 0, 1); L once per round.
+int lgr_r = -1;
+float lgr_w = 0.0f;
+float lgr_gold_weight()
+{
+	if (lgr_r != now())
