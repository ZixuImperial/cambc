 // econ_shop.cc: Buying at the shop.
 #include "econ_internal.h"
+#include "champ_vesper.h"
 namespace nova::econ {
+// b2420 VVH: the shard ids it writes (family x 6 + stat x 2) checked against the SDK
+static_assert(cambc::get_item_enum(cambc::item_family::power, cambc::item_stat::health, true) == cambc::item_type(static_cast<std::uint32_t>(1 * 6 + 4)));
+static_assert(cambc::get_item_enum(cambc::item_family::bruiser, cambc::item_stat::strength, true) == cambc::item_type(static_cast<std::uint32_t>(6 * 6 + 0)));
+// b2420 VVH: one unstarted tail entry changes stat (noinline: its entry is the firing count).
+static __attribute__((noinline)) cambc::item_type vvh_flip(bool hp)
+{
+	return cambc::item_type(hp ? (1u * 6u + 4u) : (6u * 6u + 0u)); // Power Health / Bruiser Strength
+}
+// b2420 VVH bit 1 / 2 (caller read the flag): Vesper's tail after her Strength head is bought (see econ_flags.h).
+static void vvh_pass(const decltype(cambc::self().item_count())& counts)
+{
+	if (!W.me.kit || !vesper_layer::me() || !vesper_layer::shop_build(*W.me.kit) || willow_layer::kit(*W.me.kit))
+		return;
+	const auto tail = [](std::uint32_t si) { const std::uint32_t fam = si / 6u; return fam == 6u || fam == 1u; }; // Bruiser / Power
+	std::size_t head_end = 0; // one past the last non-tail entry
+	for (std::size_t i = 0; i < build.size(); ++i)
+		if (!tail(static_cast<std::uint32_t>(build[i])))
+			head_end = i + 1;
+	std::array<int, 96> need{};
+	for (std::size_t i = 0; i < build.size(); ++i)
+	{
+		const auto si = static_cast<std::uint32_t>(build[i]);
+		if (si + 1 >= need.size())
+			return;
+		++need[si];
+		if (i < head_end && static_cast<int>(counts[cambc::item_type(si + 1)]) < need[si])
+			return; // the head is not bought yet: live's list
+	}
+	need.fill(0);
+	int k = 0;
+	for (std::size_t i = 0; i < build.size(); ++i)
+	{
+		const auto si = static_cast<std::uint32_t>(build[i]);
+		++need[si];
+		if (i < head_end)
+			continue;
+		const int kk = k++; // the entry's place among all tail entries (finished ones too)
+		if (static_cast<int>(counts[cambc::item_type(si + 1)]) >= need[si] || counts[build[i]] > 0)
+			continue; // finished or part-bought: never changed
+		const bool hp = VVH_ON(2) ? (kk % 3) != 0 : (kk & 1) != 0;
+		const std::uint32_t want = hp ? (1u * 6u + 4u) : (6u * 6u + 0u);
+		if (want == si)
+			continue;
+		--need[si];
+		build[i] = vvh_flip(hp);
+		++need[static_cast<std::size_t>(want)];
+	}
+}
