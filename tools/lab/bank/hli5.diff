+// v716 HLI bit 4 EGR1: the entry for value v: e itself unless it already holds v (same code, same parity: no reader would see the
+// refresh); then the other entry when k = 2 and it may be overwritten (empty or stood a round), else -1 (skip, retry next round).
+static int egr_entry(std::uint32_t all, int e, std::uint32_t v, int t)
+{
+	if (e < 0 || cmp_ent(all, e) != v)
+		return e;
+	if (CS.k != 2)
+		return -1;
+	const int o = 1 - e;
+	const std::uint32_t ov = cmp_ent(all, o);
+	return ((ov >> 1) == 0 || t - CS.first[static_cast<std::size_t>(o)] >= 1) ? o : -1;
+}
+// v716 HLI bit 1: the HELP image (comms::help_img).
