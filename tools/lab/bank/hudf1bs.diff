+// b2297 HUD1F: a foe's one-turn hit with every slot ready (basic hit plus the best one cast, GameRules), as foe_of_calc prices it.
+static float hud_kit_hit(const Body& e)
+{
+	if (!e.kit || !e.kit->valid)
+		return 60.0f; // foe_of_calc's unknown-kit burst
+	const Kit& k = *e.kit;
+	float c = k.slot_reset >= 0 ? e.str : 0.0f;
+	if (k.slot_dash >= 0)
+		c = std::max(c, k.dash_mod * e.foc);
+	if (k.slot_dmg >= 0)
+		c = std::max(c, k.dmg_mod * e.foc);
+	if (k.slot_cc >= 0)
+		c = std::max(c, k.cc_mod * e.foc);
+	if (k.slot_aoe >= 0)
+		c = std::max(c, k.aoe_mod * e.foc);
+	return (e.str + c) * combat::kit_rules::passive_mult(e);
