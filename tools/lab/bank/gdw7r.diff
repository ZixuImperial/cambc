diff --git a/src/combat_flags.h b/src/combat_flags.h
--- a/src/combat_flags.h
+++ b/src/combat_flags.h
@@ -542,6 +542,14 @@ inline constexpr int DTA_TAB[2] = { 0x44544131, DTA_BITS }; // slot 0 magic keep
 // channels at that altar and the walk to the lock ring fits its ticks; the lock way only. Bit 2 FLEE PASS (with 1): such a pick is
 // not dropped by FLEE when my HP >= 80% (dlf3c: the pre-stated adaptation, 60 -> 80), no visible foe's next-turn sum kills me and I carry no winning bag.
 #define DLF_BAG 40
 // v725 DLF: lock seen tribute, FLEE pass at 80% (DLF adapt)
 #define DLF_BITS 3
 inline constexpr int DLF_TAB[2] = { 0x444C4631, DLF_BITS }; // slot 0 magic keeps it out of .bss
+
+// GDW (b1836, spec_gdw_1111 Deep / RC MF3, and RC X318 DLS1): the game-ending deny walks run outside the foe walk guard (the BBM bake left
+// SuspendFoeGuard(false) at the three walks, so step_to_set fails while the lock way says the lock fits; 01corridors 01a1c894 r1320-1325).
+// Runtime data flag GDW_TAB[1], read first; 0 = v729. Bits: 1 GDW1 game_deny_slow's walk when ending; 2 GDW2 game_deny_follow_channel's
+// walk on a game-ending memory and deny_memory's walk; 4 DLS1 the step after a game-ending dash-lock landing (gdn_dash_lock_go).
+#define GDW_BITS 0
+inline const volatile int GDW_TAB[2] = { 0x47445731, GDW_BITS }; // slot 0 magic keeps it out of .bss
+#define GDW_ON(b) ((GDW_TAB[1] & (b)) != 0)
