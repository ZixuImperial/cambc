+// RCX bit 1: a known foe hits me before the recall completes, counting its turns in the ticks left.
+static __attribute__((noinline)) bool rcx_damage_lands(const Assessment& a)
+{
+	std::int32_t left = -1;
+	if (cambc::detail::sdk_champion_channel_time(static_cast<std::uint32_t>(cambc::detail::sdk_my_champion()), &left) != 0 || left < 0)
+		return a.in_reach;
+	for (const auto& f : a.foes)
+	{
+		if (f.reach < 0)
+			continue;
+		const bool vis = f.idx >= 0 && f.idx < static_cast<int>(W.enemies.size());
+		const int t = vis ? stance::foe_turns_within_rounds(W.enemies[static_cast<std::size_t>(f.idx)], left + 1) : left;
+		if (t >= 1 && cheb(f.pos, W.me.pos) <= f.reach + t - 1)
+			return true;
+	}
+	return false;
+}
