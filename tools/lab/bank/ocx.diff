+// v652 OCX bit 2: a body the opening simulation drafted as a crew extra within OCX_AGE rounds (spec_ocx_1109).
+static bool ocx_mate_claims(int gi, const Claims& cl)
+{
+	for (int s = 0; s < TM.n && s < 8; ++s)
+		if (s != my_slot() && cl[static_cast<std::size_t>(s)] == gi)
+			return true;
+	return false;
+}
+static bool ocx_keep_near(int best, const Claims& cl)
+{
+	if (now() - ocx_draft_r > OCX_TAB[2] || ocx_mate_claims(best, cl))
+		return false;
+	ocx_fire_hold();
+	return true;
+}
+static bool ocx_keep_escape(int best, const Claims& cl)
+{
+	if (now() - ocx_draft_r > OCX_TAB[2] || T.target < 0 ||
