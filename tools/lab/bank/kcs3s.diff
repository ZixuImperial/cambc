+		if (!have || M.altars[static_cast<std::size_t>(cur.alt)].pos != gd_mem.pos || (cur.bucket == 0 && lk <= 0) || (cur.bucket == 1 && lk <= 0 && !kcs_stun_ready())) // RC C728 K3/K2b: no tool left
