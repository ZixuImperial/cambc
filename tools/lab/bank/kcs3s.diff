+// b2256 KCS (spec_kcs_1112, RC C717, Shared Mem field ruling): one team-word field holds the best known big foe channel,
+// v = 1 + ((altar*2 + bucket)*64 + end6), bucket 1 = it ends the game, 0 = bag >= KCS_BAG; end6 = min(end, now + 47) & 63.
+// Read: d = (end6 - now) & 63; d <= 47 valid (ends at now + d), 48..63 ended 1-16 rounds ago (stale: cleared).
+inline constexpr std::uint32_t KCS_H = 0xFFFFFFFFu; // gd_mem's handle for a channel known only through the word
+inline constexpr int KCS_BAG = 250;
+inline constexpr int KCS_D_MAX = 47;
+struct KcsCode
+{
+	int alt = -1, bucket = 0, end = -1000;
+};
+// The one accessor: true and c filled when the field holds a live code; stale: a code that has ended (or is out of range).
+static bool kcs_decode(std::uint32_t v, int now, KcsCode& c, bool& stale)
+{
+	stale = false;
+	if (v == 0)
+		return false;
+	const int x = static_cast<int>(v) - 1;
+	const int ab = x >> 6;
+	const int d = ((x & 63) - now) & 63;
+	if ((ab >> 1) >= M.na || d > KCS_D_MAX)
+	{
+		stale = true;
+		return false;
+	}
+	c.alt = ab >> 1;
+	c.bucket = ab & 1;
+	c.end = now + d;
+	return true;
+}
+static std::uint32_t kcs_encode(int alt, int bucket, int end, int now)
+{
+	const int e6 = std::min(end, now + KCS_D_MAX) & 63;
+	return 1u + static_cast<std::uint32_t>((alt * 2 + bucket) * 64 + e6);
+}
+// RC C728 K1: the altar and every non-wall tile within 1 of it are in my vision board this turn (a channeller hidden in a bush is not
