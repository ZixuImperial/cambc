+static bool kcs_altar_ring_seen(vec2 alt)
+{
+	const bitboard& vb = CCX_ON(1) ? W.vis : W.own_vis;
+	for (int x = alt.x - 1; x <= alt.x + 1; ++x)
+		for (int y = alt.y - 1; y <= alt.y + 1; ++y)
+		{
+			const vec2 t{ x, y };
+			if (x < 0 || y < 0 || x >= M.w || y >= M.h || bbget(M.walls, t))
+				continue;
+			if (!bbget(vb, t))
+				return false;
+		}
+	return true;
+}
+// RC C728 K2: a stun of mine is ready (single-target, area or dash stun) for an ending channel known only through the word.
