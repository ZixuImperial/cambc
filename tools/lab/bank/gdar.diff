diff --git b/src/feat_gda.cpp b/src/feat_gda.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_gda.cpp
@@ -0,0 +1,53 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_gda.cpp (GDA, b1643): see feat_gda.h. Reached only when GDA_ON(...) is true at the hook (combat.cpp game_deny_slow, gd_follow).
+#include "feat_gda.h"
+namespace nova::feat::gda
+{
+namespace bu = ::nova::combat::burst;
+static void fired_block()
+{
+}
+static void fired_hold()
+{
+}
+int step(const bitboard& goal, int rad, int t_way)
+{
+	const float cap = bu::lb_cap();
+	vec2 bad[8];
+	int nb = 0;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 n{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if ((dx == 0 && dy == 0) || !::nova::mv::free_tile(n))
+				continue;
+			if (t_way <= 1 && bbget(goal, n))
+				continue; // the cancel lands from n this turn
+			if (bu::lb_sum(n, 0, nullptr) >= cap)
+				bad[nb++] = n;
+		}
+	if (nb == 0)
+		return ::nova::mv::step_to_set(goal, rad) ? 1 : 0;
+	fired_block();
+	auto& rf = ::nova::mv::refused;
+	const std::size_t n0 = rf.size();
+	for (int i = 0; i < nb; ++i)
+		rf.push_back(bad[i]);
+	::nova::mv::dyn_valid = false;
+	const bool moved = ::nova::mv::step_to_set(goal, rad);
+	if (rf.size() >= n0 + static_cast<std::size_t>(nb))
+		rf.erase(rf.begin() + static_cast<std::ptrdiff_t>(n0), rf.begin() + static_cast<std::ptrdiff_t>(n0) + nb);
+	::nova::mv::dyn_valid = false;
+	NLOG("r%d slot %d GDA block %d moved %d\n", W.round, P.my_slot, nb, static_cast<int>(moved));
+	if (moved)
+		return 1;
+	if (W.can_move() && bu::lb_sum(W.me.pos, 0, nullptr) < cap)
+	{
+		fired_hold();
+		return 2;
+	}
+	return 0;
+}
+} // namespace nova::feat::gda
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_gda.h b/src/feat_gda.h
new file mode 100644
--- /dev/null
+++ b/src/feat_gda.h
@@ -0,0 +1,18 @@
+#pragma once
+// feat_gda (GDA, b1643): game_deny approach survival test (Deep cancelhit2: APPROACH_END deaths .71/g, lethal .16/g; Combat retest
+// 01a1ba26-ba8b). A tributing foe can cancel and act the same turn (GameRules.md:108/:112, docs/rules/10_timing.md:93/:145).
+// Flag GDA_BITS, 0 = nova_b2715_vop2r. Bits: 1 STEP game_deny's approach step (and gd_follow's walk) does not end on a tile where
+// the seen foes' summed next-turn damage (lb_sum, the channeller counted) reaches lb_cap, unless the cancel lands from it this turn;
+// no such step and my tile survivable: hold one tile out. Hooks: combat.cpp game_deny_slow and gd_follow (the step lines).
+#include "common.h"
+#define GDA_BITS 0
+inline const volatile int GDA_TAB[2] = { 0x47444131, GDA_BITS }; // slot 0 magic keeps it out of .bss
+#define GDA_ON(b) ((GDA_TAB[1] & (b)) != 0)
+#define GDA_BIT_STEP 1
+namespace nova::feat::gda
+{
+// bit 1: one approach step toward `goal` (search radius rad) that avoids lethal end tiles; a tile of `goal` is exempt when
+// t_way <= 1 (the cancel lands from it this turn). 1 = moved, 2 = hold here (every non-lethal step failed, my tile survivable),
+// 0 = no step and no hold (the caller's base logic goes on).
+int step(const bitboard& goal, int rad, int t_way);
+} // namespace nova::feat::gda
