+// b2384 ODH bit 2 (Path Finding spec_odh_1113, owner replay 01a1d450): a dash body leaving the spawn for a group whose crossing route is
+// shorter than its walk takes that route at once (the pair table and thin_hole_plan need several turns to exist): one field from my tile
+// with thin holes passable (the blockers of mapinfo.cc's f_home_dash), its route to gi's nearest member, walked step by step, each hole
+// crossed by the dash (held for it: no travel dash spends it on the way). It ends past the route's last hole, off the route, on a refused
+// step or dash, or when waiting for the cooldown is no faster than the walk.
+bool odh_trip = false, odh_trip_done = false; // ODH bit 2: the game's FIRST trip out of the spawn only (Builder 13 Nov)
+namespace {
+std::vector<vec2> odh_rt;
+int odh_rt_g = -1, odh_rt_end_g = -1; // the route's group; a group whose route ended on this trip
+bool odh_rt_on = false;
