+	const std::uint16_t dh = M.groups[static_cast<std::size_t>(gi)].d_home;
+	if (!on_s)
+		return dh;
+	const std::uint16_t dd = odh_dd[static_cast<std::size_t>(gi)];
+	return dd < dh ? dd : dh;
+}
