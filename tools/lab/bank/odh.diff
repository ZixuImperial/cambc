+bool odh_route_turn(int gi, const distance_field& wf)
+{
+	if (!W.alive || !W.me.kit || W.me.channeling() || gi < 0 || gi >= M.ng)
+		return false;
+	const Kit& k = *W.me.kit;
+	if (k.slot_dash < 0 || static_cast<int>(k.dash_range) != 2)
+		return false;
+	if (W.on_spawn)
+		odh_rt_end_g = -1;
+	if (gi != odh_rt_g)
+	{
+		odh_rt_g = gi;
+		odh_rt_on = false;
+	}
+	const vec2 me = W.me.pos;
+	const std::uint16_t wme = dfget(wf, me);
+	if (!odh_rt_on)
+	{
+		if (!odh_trip || gi == odh_rt_end_g || wme == UNREACH || !bbany(M.holes) || fuel() < 3L * G.w * G.h + 30000)
+			return false;
+		const bitboard Wb = ~(M.walls | M.holes | M.altars_bb);
+		bitboard pairs = Wb.shift_right(1) & Wb.shift_right(-1);
+		pairs |= Wb.shift_up(1) & Wb.shift_up(-1);
+		pairs |= Wb.shift_right(1).shift_up(1) & Wb.shift_right(-1).shift_up(-1);
+		pairs |= Wb.shift_right(1).shift_up(-1) & Wb.shift_right(-1).shift_up(1);
+		const bitboard thin = M.holes & pairs;
+		if (!bbany(thin))
+		{
+			odh_rt_end_g = gi;
+			return false;
+		}
+		bitboard src, visited;
+		bbset(src, me);
+		distance_field fm;
+		fm.compute(M.walls | (M.altars_bb & ~(M.altars_bb & pairs)) | M.enemy_spawn | (M.holes & ~thin), src, visited);
+		vec2 cur{ -1, -1 };
+		int best = UNREACH;
+		for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+		{
+			const vec2 q = M.camps[static_cast<std::size_t>(ci)].pos;
+			const int v = dfget(fm, q);
+			if (v < best)
+			{
+				best = v;
+				cur = q;
+			}
+		}
+		if (cur.x < 0 || best + 1 >= static_cast<int>(wme)) // the crossing route must beat the walk
+		{
+			odh_rt_end_g = gi;
+			return false;
+		}
+		odh_rt.clear();
+		odh_rt.push_back(cur);
+		int v = best;
+		while (v > 0)
+		{
+			vec2 nx{ -1, -1 };
+			bool nh = true;
+			for (const vec2 d : DIRS)
+			{
+				const vec2 q = cur + d;
+				if (!inb(q) || dfget(fm, q) != v - 1)
+					continue;
+				const bool h = bbget(M.holes, q);
+				if (nx.x < 0 || (nh && !h))
+				{
+					nx = q;
+					nh = h;
+				}
+			}
+			if (nx.x < 0)
+			{
+				odh_rt_end_g = gi;
+				return false;
+			}
+			cur = nx;
+			--v;
+			odh_rt.push_back(cur);
+		}
+		int nholes = 0;
+		for (const vec2 q : odh_rt)
+			nholes += bbget(M.holes, q) ? 1 : 0;
+		if (nholes != 1) // a short, finishable route: one crossing
+		{
+			odh_rt_end_g = gi;
+			return false;
+		}
+		std::reverse(odh_rt.begin(), odh_rt.end()); // me first
+		odh_rt_on = true;
+	}
+	int idx = -1;
+	for (int i = 0; i < static_cast<int>(odh_rt.size()); ++i)
+		if (odh_rt[static_cast<std::size_t>(i)] == me)
+		{
+			idx = i;
+			break;
+		}
+	bool hole_ahead = false;
+	for (int i = idx + 1; idx >= 0 && i < static_cast<int>(odh_rt.size()) && !hole_ahead; ++i)
+		hole_ahead = bbget(M.holes, odh_rt[static_cast<std::size_t>(i)]);
+	if (idx < 0 || !hole_ahead)
+	{
+		odh_rt_on = false;
+		odh_rt_end_g = gi;
+		return false;
+	}
+	const int n = static_cast<int>(odh_rt.size());
+	const vec2 nxt = odh_rt[static_cast<std::size_t>(idx + 1)];
+	if (bbget(M.holes, nxt))
+	{
+		if (idx + 2 >= n || bbget(M.holes, odh_rt[static_cast<std::size_t>(idx + 2)]))
+		{
+			odh_rt_on = false;
+			return false;
+		}
+		const vec2 land = odh_rt[static_cast<std::size_t>(idx + 2)];
+		if (!combat::ready(k.slot_dash))
+		{
+			const int cd = W.cd[static_cast<std::size_t>(k.slot_dash)];
+			if (static_cast<int>(wme) <= cd + (n - 1 - idx) - 1)
+			{
+				odh_rt_on = false;
+				odh_rt_end_g = gi;
+				return false; // waiting for the dash is no faster than the walk
+			}
+			return true; // the dash is held for the crossing
+		}
+		if (!thin_hole_dash_legal(me, land, gi) || !combat::cast_at(k.slot_dash, land))
+		{
+			odh_rt_on = false;
+			odh_rt_end_g = gi;
+			return false;
+		}
+		if (idx + 3 < n && !bbget(M.holes, odh_rt[static_cast<std::size_t>(idx + 3)]))
+			try_move(odh_rt[static_cast<std::size_t>(idx + 3)]);
+		return true;
+	}
+	if (try_move(nxt))
+		return true;
+	odh_rt_on = false;
+	odh_rt_end_g = gi;
+	return false;
+}
