+// b2384 ODH bit 1 (Path Finding spec_odh_1113, owner replay 01a1d450): a range-2 dash kit prices a walk group by the crossing distance
+// min(d_home, dash-field distance + 1) from the draft's f_home_dash (the draft-turn plan, dfg/OSD; play keeps d_home). odh_dd[gi] holds the crossing distance only where it is shorter than d_home (else UNREACH).
+std::vector<std::uint16_t> odh_dd;
+bool odh_ready = false, odh_any = false;
+// always true (kept for the caller's form)
+bool odh_build()
+{
+	if (odh_ready)
+		return true;
+	if (!M.has_home || !bbany(M.holes) || M.ng <= 0)
+	{
+		odh_ready = true;
+		return true;
+	}
+	// RC C1233b: the crossing is priced only where the plan is made, the draft turn (its f_home_dash); in play (no f_home_dash) every body
+	// uses d_home, the same on every body (no fuel-dependent field build, no stall).
+	if (!M.has_dash)
+		return true; // not ready: asked again (cheap); the draft builds f_home_dash during its analysis
+	const distance_field* f = &M.f_home_dash;
+	odh_dd.assign(static_cast<std::size_t>(M.ng), UNREACH);
+	for (int gi = 0; gi < M.ng; ++gi)
+	{
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		if (g.access != ACC_WALK || g.d_home == UNREACH)
+			continue;
+		const std::uint16_t d = M.group_dist(*f, g);
+		if (d == UNREACH || 2 * (d + 1) > g.d_home) // Path Finding gate: the crossing saves at least half the walk
+			continue;
+		// the route down f from the group's nearest member: exactly one hole, its launch (the tile before it) within 6 walk steps of the spawn
+		vec2 cur{ -1, -1 };
+		int v = UNREACH;
+		for (int ci : g.members)
+		{
+			const vec2 q = M.camps[static_cast<std::size_t>(ci)].pos;
+			const int x = dfget(*f, q);
+			if (x < v)
+			{
+				v = x;
+				cur = q;
+			}
+		}
+		int holes = 0, launch_d = UNREACH;
+		bool prev_hole = false;
+		while (cur.x >= 0 && v > 0 && v != UNREACH)
+		{
+			vec2 nx{ -1, -1 };
+			bool nh = true;
+			for (const vec2 dd : DIRS)
+			{
+				const vec2 q = cur + dd;
+				if (!inb(q) || dfget(*f, q) != v - 1)
+					continue;
+				const bool h = bbget(M.holes, q);
+				if (nx.x < 0 || (nh && !h))
+				{
+					nx = q;
+					nh = h;
+				}
+			}
+			if (nx.x < 0)
+				break;
+			if (prev_hole)
+				launch_d = v - 1; // cur is the hole; nx, the next tile toward the spawn, is the launch
+			prev_hole = nh;
+			holes += nh ? 1 : 0;
+			cur = nx;
+			--v;
+		}
+		if (v != 0 || holes != 1 || launch_d > 6)
+			continue;
+		odh_dd[static_cast<std::size_t>(gi)] = static_cast<std::uint16_t>(d + 1);
+		odh_any = true;
+	}
+	odh_ready = true;
+	return true;
+}
+inline bool odh_kit(int s)
+{
+	if (s < 0 || s >= TM.n)
+		return false;
+	const Kit& k = kit_of(P.type[static_cast<std::size_t>(s)]);
+	return k.slot_dash >= 0 && k.dash_range >= 2.0f;
+}
