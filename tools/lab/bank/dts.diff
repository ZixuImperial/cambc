+namespace {
+// DTS / DTD: the lowest priority >= want (and <= DT_CAP) at which my rank next round is at most rmax among my visible mates (their
+// next-round values; ties to the lower handle), else -1.
+int dt_priority_for_rank(int want, int rmax)
+{
+	if (rmax < 0)
+		return -1;
+	std::array<int, 8> v{};
+	int n = 0;
+	for (const auto& al : W.allies)
+		if (n < 8)
+			v[static_cast<std::size_t>(n++)] = PRA_DEC(burst::ed_prio_hdt(al.h, true)) * 2 + (al.h < W.me.h ? 1 : 0); // ties: lower handle first
+	for (int p = want; p <= DT_CAP; ++p)
+	{
+		int r = 0;
+		for (int i = 0; i < n; ++i)
+			r += v[static_cast<std::size_t>(i)] > p * 2 ? 1 : 0;
+		if (r <= rmax)
+			return p;
+	}
+	return -1;
+}
+// The highest rank next round at which I act before foe slot ux next round.
+int dt_rank_before(std::size_t ux)
+{
+	const bool en2 = enemy_starts(W.round + 1);
+	return en2 ? hdt_o.rb2[ux] - 1 : hdt_o.rb2[ux]; // foe starts: me 2r+1 < 2rb; we start: me 2r < 2rb+1
+}
+bool dt_foe_before_me_now(std::size_t ux)
+{
+	const bool en = enemy_starts(W.round);
+	const int pm = 2 * hdt_o.ra + (en ? 1 : 0), pf = 2 * hdt_o.rb[ux] + (en ? 0 : 1);
+	return pf < pm;
+}
+static std::uint32_t dts_h = 0;
+static int dts_round = -1000;
+inline bool dts_fire() { return true; } // firing counters (firecount counts new functions' entries)
+inline bool dts_double_landed() { return true; }
+inline bool dtd_pending() { return true; }
+inline bool dtd_broken() { return true; }
+} // namespace
+// DTS STRIKE: the priority for a double turn on the focus (or want unchanged).
+int dts_strike_priority(const Assessment& a, int want)
+{
+	if (dts_round == W.round - 1 && dts_h != 0) // last round's strike: did F act before my turn now?
+	{
+		for (const auto& e : W.enemies)
+			if (e.h == dts_h && (e.state & FLEE_FIX_ST_ACTED) == 0 && dts_double_landed())
+				break;
+		dts_h = 0;
+	}
+	if (a.stance != FIGHT || a.focus < 0 || !W.alive || !W.me.kit || want >= DT_CAP)
+		return want;
+	const Body& f = W.enemies[static_cast<std::size_t>(a.focus)];
+	const int d = cheb(f.pos, W.me.pos);
+	if (d > W.me.range + 1)
+		return want;
+	const float two = burst::my_burst_m(f, d, false) + kit_rules::my_basic_hit() * (W.me.kit->slot_reset >= 0 ? 2.0f : 1.0f);
+	if (two < eff_hp(f) || visible_foes_lethal_next_turn())
+		return want;
+	build_acting_order_table();
+	std::size_t ux = 0;
+	while (ux < static_cast<std::size_t>(hdt_o.n) && hdt_o.h[ux] != f.h)
+		++ux;
+	if (ux >= static_cast<std::size_t>(hdt_o.n) || !dt_foe_before_me_now(ux))
+		return want;
+	const int p = dt_priority_for_rank(want, dt_rank_before(ux));
+	if (p < 0 || !dts_fire())
+		return want;
+	dts_h = f.h;
+	dts_round = W.round;
+	return p;
+}
+// DTD DENY: the priority that takes away a lethal foe's double before my next turn (or want unchanged).
+int dtd_deny_priority(int want)
+{
+	if (!W.alive || want >= DT_CAP || W.enemies.empty())
+		return want;
+	const float eff = eff_hp(W.me);
+	build_acting_order_table();
+	int rmax = 99;
+	bool any = false;
+	for (std::size_t ux = 0; ux < static_cast<std::size_t>(hdt_o.n); ++ux)
+	{
+		const Body& e = W.enemies[ux];
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 9 || dt_foe_before_me_now(ux) || burst::stun_takes_next_turn(e))
+			continue; // it has acted this round, or it is too far, or a stun takes its next turn
+		const bool en2 = enemy_starts(W.round + 1);
+		const bool before_next = en2 ? 2 * hdt_o.rb2[ux] < 2 * hdt_o.ra2 + 1 : 2 * hdt_o.rb2[ux] + 1 < 2 * hdt_o.ra2;
+		if (!before_next)
+			continue; // one turn only
+		const float h1 = burst::lethal_burst_hit(e, d, 0, nullptr);
+		const float two = burst::lethal_burst_two_turn_hit(e, d, h1);
+		if (two * 100.0f < static_cast<float>(DTD_TAB[2]) * eff)
+			continue;
+		any = true;
+		rmax = std::min(rmax, dt_rank_before(ux));
+	}
+	if (!any || !dtd_pending())
+		return want;
+	const int p = dt_priority_for_rank(want, rmax);
+	if (p < 0 || p == want || !dtd_broken())
+		return want;
+	return p;
+}
