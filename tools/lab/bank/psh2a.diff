+// ---- v861 PSH bit 2 (champ_ci_plan.h): Issac's dash kept as the escape; Cassi passive while outscaled (Q gate).
+namespace
+{
+int psh_q_r = -1;
+bool psh_q_on = false;
+// Q gate with hysteresis, once a round: the strongest visible foe within 8 (maxHp x (Str + Focus)) over Cassi's.
+bool psh_outscaled()
+{
+	if (psh_q_r == W.round)
+		return psh_q_on;
+	psh_q_r = W.round;
+	const int cg = PSH_TAB[2];
+	if (cg <= 0)
+		return psh_q_on = true;
+	const float me = std::max(1.0f, W.me.maxhp * (W.me.str + W.me.foc));
+	float best = 0.0f;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 8)
+			best = std::max(best, e.maxhp * (e.str + e.foc));
+	const float q10 = 10.0f * best / me;
+	psh_q_on = psh_q_on ? q10 >= static_cast<float>(cg - 10) : q10 >= static_cast<float>(cg);
+	return psh_q_on;
+}
+} // namespace
+bool psh_refuse(vec2 dest, bool dash)
+{
+	if (W.enemies.empty() || combat::spz_b_in_r != W.round || combat::gdn_end_cast || econ::T.capturing || mv::eox_escaping)
+		return false; // RC C1038 F1: only steps / dashes of the fight stage; never a game-ending deny, a capture or an escape
+	const Body* pb = partner_body();
+	if (ci_layer::me_issac())
+	{
+		if (!dash || !pb)
+			return false;
+		bool cassi_risk = false; // Cassi within a visible foe's two-turn reach
+		for (const auto& e : W.enemies)
+			cassi_risk = cassi_risk || cheb(e.pos, pb->pos) <= combat::foe_next_turn_reach(e) + 1; // RC C1038 F3
+		if (!cassi_risk)
+			return false;
+		int d0 = BIG, d1 = BIG;
+		for (const auto& e : W.enemies)
+		{
+			d0 = std::min(d0, cheb(e.pos, W.me.pos));
+			d1 = std::min(d1, cheb(e.pos, dest));
+		}
+		return d1 < d0; // a closing dash: kept for the escape
+	}
+	if (!ci_layer::me_cassi() || !psh_outscaled())
+		return false;
+	const Body* mate = nullptr; // nearest non-Issac mate within 8
+	for (const auto& al : W.allies)
+		if ((!pb || al.h != pb->h) && cheb(al.pos, W.me.pos) <= 8 && (!mate || cheb(al.pos, W.me.pos) < cheb(mate->pos, W.me.pos)))
+			mate = &al;
+	int dn0 = BIG, dn1 = BIG;
+	for (const auto& e : W.enemies)
+	{
+		const int d0 = cheb(e.pos, W.me.pos), d1 = cheb(e.pos, dest);
+		dn0 = std::min(dn0, d0);
+		dn1 = std::min(dn1, d1);
+		if (d1 >= d0 || d1 > 8)
+			continue;
+		const bool beyond_i = !pb || d1 < cheb(e.pos, pb->pos);
+		const bool beyond_m = !mate || d1 < cheb(e.pos, mate->pos);
+		if (beyond_i && beyond_m)
+			return true; // she would lead toward this foe
+	}
+	return mate && dn1 < dn0 && cheb(dest, mate->pos) > PSH_MATE_R; // no advance away from her group
+}
 } // namespace nova::ci2
