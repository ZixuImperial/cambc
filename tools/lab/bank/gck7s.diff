 // a further trip is priced as the walk (2 x d_home turns, healed at the spawn turn's end, GR:153/385; a recall in an awake golem's range
 // is cancelled by its first hit, GR:387) with each trip's budget = budget - str_sum x 2 x (d_home - 1). 0 = v804.
 // v814 NSG: heavy near-spawn trips not orphaned (NSG)
 #define NSG_BITS 1
 inline constexpr int NSG_TAB[2] = { 0x4E534731, NSG_BITS }; // slot 0 magic keeps it out of .bss
+// b2167 GCK (RC X600, play-identical, background only). Flag read first; 0 = v813. Bit 1 GCK1: when gtb_prebuild's one-shot price
+// fails, the static bounds table is filled in GCK_K-group chunks from post-done background fuel (key snapshotted at chunk 0; restart
+// on a key change) and moved into gbs_tab once complete with the key still current. Bit 2 OWU1: prospector_fill once in post-done
+// background (its pre_tables half is already live: PRE1 runs post-done). Bit 4 GCK2 (with bit 1): a table rebuild under the stage's key
+// fills only the rows the slices did not reach and installs the stage.
+#define GCK_BITS 0
+#define GCK_K 48
+inline const volatile int GCK_TAB[3] = { 0x47434B31, GCK_BITS, GCK_K }; // slot 0 magic keeps it out of .bss
+#define GCK_ON(b) ((GCK_TAB[1] & (b)) != 0)
