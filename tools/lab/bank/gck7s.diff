 // v7xx GTB GTB1 (RC X531/X538; caller reads GTB_ON(1)): a full table rebuild (~35k at 100 groups) in background spare fuel once its key is
 // final (map done, no ring or open-field work left), so the next decision turn finds it ready. The same call the bounds pass makes.
 long gtb_worst = 0;
+static long gck_pg = 400; // worst measured fuel per group of a chunk
+static __attribute__((noinline)) void gck_chunks(long reserve, bool sga, int kg, int kr, int ks)
+{
+	const std::size_t ng = static_cast<std::size_t>(M.ng);
+	if (gck_stage.size() != ng || kg != gck_kg || kr != gck_kr || ks != gck_ks)
+	{
+		gck_stage.assign(ng, GBS{});
+		gck_n = 0;
+		gck_kg = kg;
+		gck_kr = kr;
+		gck_ks = ks;
+	}
+	const int k = std::max(1, static_cast<int>(GCK_TAB[2]));
+	while (gck_n < static_cast<int>(ng) && fuel() > reserve + static_cast<long>(k) * gck_pg + 8000L)
+	{
+		const long f0 = fuel();
+		const int r0 = static_cast<int>(round_number_nc());
+		const int e = std::min(static_cast<int>(ng), gck_n + k);
+		for (int i = gck_n; i < e; ++i)
+			group_static_fill(gck_stage[static_cast<std::size_t>(i)], M.groups[static_cast<std::size_t>(i)], i, sga);
+		if (static_cast<int>(round_number_nc()) == r0)
+			gck_pg = std::max(gck_pg, (f0 - FXR_FUEL()) / std::max(1, e - gck_n));
+		gck_n = e;
+	}
+	if (gck_n == static_cast<int>(ng))
+	{
+		gbs_tab.swap(gck_stage); // the full fill's table (same inputs under the same key), as group_static_table's rebuild
+		gbs_key_gates = kg;
+		gbs_key_ring = kr;
+		gbs_key_sga = ks;
+		gbs_key_dist = 2;
+		gck_stage.clear();
+		gck_n = 0;
+		gck_kg = -1;
+	}
+}
 void gtb_prebuild(long reserve)
 {
 	if (M.ng < BOUNDS_MIN_GROUPS || !M.done() || M.ring_todo || M.open_todo)
 		return;
 	const bool sga = sg_any();
 	const int kg = static_cast<int>(M.gate_groups.size()), kr = M.ring ? 1 : 0, ks = sga ? 1 : 0;
 	const bool same = gbs_tab.size() == static_cast<std::size_t>(M.ng) && ks == gbs_key_sga;
 	if (same && kg == gbs_key_gates && kr == gbs_key_ring)
 		return; // current, or only kd 1 -> 2 (GSI1 sets the altar walk in place on the next bounds call, a few k)
 	if (fuel() < reserve + std::max(400L * M.ng + 8000L, gtb_worst + gtb_worst / 4))
+	{
+		if (GCK_ON(1)) // b2167 GCK1: the one-shot price fails: fill it in chunks instead
+			gck_chunks(reserve, sga, kg, kr, ks);
 		return;
+	}
 	const long f0 = fuel();
 	const int r0 = static_cast<int>(round_number_nc());
 	group_static_table(sga);
 	if (static_cast<int>(round_number_nc()) == r0)
 		gtb_worst = std::max(gtb_worst, f0 - FXR_FUEL());
 }
