+// v641 SDT bit 2: my team starts the next round and I am first in its order, so no foe acts between my turns beyond its one turn
+// left this round; a lower value gives up that place, and then any foe still to act may also act before me next round (foes can
+// raise their own value after my turn: the turn counts' worst case, interactions.md:23). Lethal: such a foe within 9 whose two
+// turns kill me from one step nearer.
+bool sdt_drop_lethal(int want)
+{
+	if (!W.alive || W.enemies.empty() || !W.me.kit)
+		return false;
+	const bool tie = SDT_ON(4);
+	burst::EdRanks q0;
+	if (!tie)
+		q0 = burst::turn_order_ranks();
+	const burst::SdtOrd* t = tie ? &burst::turn_order_tie() : nullptr; // bit 4: the round's shared order
+	const burst::EdRanks& q = t ? t->q : q0;
+	if (q.my_start || q.ra2 != 0)
+		return false; // no sure first place next round to give up
+	int ra2n = 0;
+	if (t)
+		for (std::size_t x = 0; x < t->na; ++x)
+			ra2n += (t->ap2[x] > want || (t->ap2[x] == want && t->ah[x] < W.me.h)) ? 1 : 0;
+	else
+		for (const auto& al : W.allies)
+			ra2n += PRA_DEC(burst::ed_prio_hdt(al.h, true)) > want ? 1 : 0;
+	if (ra2n == 0)
+		return false; // still first
+	const int miss = std::max(0, P.n - static_cast<int>(W.enemies.size()));
+	const float eff = eff_hp(W.me);
+	for (std::size_t x = 0; x < q.m; ++x)
+	{
+		const Body& e = W.enemies[x];
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 9)
+			continue;
+		int rb = 0, rb2 = 0;
+		if (t)
+			rb = t->rb[x];
+		else
+			q.foe_rank(x, rb, rb2);
+		if (!q.still_to_act(rb + miss))
+			continue; // its turn this round is done: at most one before my next
+		const int dd = std::max(1, d - 1);
+		const float h = e.stunned ? 0.0f : burst::lethal_burst_hit(e, dd, 0, nullptr);
+		const float v = e.stunned ? burst::lethal_burst_hit(e, dd, 1, nullptr) : burst::lethal_burst_two_turn_hit(e, dd, h);
+		if (v >= eff)
+			return true;
+	}
+	return false;
+}
