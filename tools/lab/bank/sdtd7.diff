+// v641 SDT bit 4: this round's turn order with a priority tie going to the lower id (interactions.md:16), mates and foes, each value read
+// once a round and shared by the foe turn counts, the acting-order table (hdt_o) and the drop hold. Refilled when my own value changes
+// (sdt_order_changed: no one else acts inside my turn) or a re-perceive changed who I see. q.pb/pb2 hold the foes' raw values.
+struct SdtOrd
+{
+	int round = -1000;
+	std::uint32_t me = 0;
+	EdRanks q;                     // ra, ra2 tie-aware
+	std::size_t na = 0;
+	std::array<std::uint32_t, 12> h{}, ah{}; // foe / mate handles, in W.enemies / W.allies order
+	std::array<int, 12> rb{}, rb2{}, ap2{};  // a foe's place in its team's order now / next round; a mate's decoded next value
+};
+static SdtOrd sdt_ord;
+static __attribute__((noinline)) const SdtOrd& turn_order_tie()
+{
+	SdtOrd& t = sdt_ord;
+	bool same = t.round == W.round && t.me == W.me.h && t.q.m == std::min(W.enemies.size(), t.h.size()) && t.na == std::min(W.allies.size(), t.ah.size());
+	for (std::size_t x = 0; same && x < t.q.m; ++x)
+		same = t.h[x] == W.enemies[x].h;
+	for (std::size_t x = 0; same && x < t.na; ++x)
+		same = t.ah[x] == W.allies[x].h;
+	if (same)
+		return t;
+	t.round = W.round;
+	t.me = W.me.h;
+	EdRanks& q = t.q;
+	q.my_start = !enemy_starts(W.round);
+	q.ra = q.ra2 = 0;
+	const int pa = PRA_DEC(champion_priority_of(W.me.h, false)), pa2 = PRA_DEC(champion_priority_of(W.me.h, true)); // our values decode
+	t.na = std::min(W.allies.size(), t.ah.size());
+	for (std::size_t x = 0; x < t.na; ++x)
+	{
+		const std::uint32_t h = W.allies[x].h;
+		const int p = PRA_DEC(champion_priority_of(h, false)), p2 = PRA_DEC(champion_priority_of(h, true));
+		t.ah[x] = h;
+		t.ap2[x] = p2;
+		q.ra += (p > pa || (p == pa && h < W.me.h)) ? 1 : 0;
+		q.ra2 += (p2 > pa2 || (p2 == pa2 && h < W.me.h)) ? 1 : 0;
+	}
+	q.m = std::min(W.enemies.size(), t.h.size());
+	for (std::size_t x = 0; x < q.m; ++x)
+	{
+		t.h[x] = W.enemies[x].h;
+		q.pb[x] = champion_priority_of(t.h[x], false);
+		q.pb2[x] = champion_priority_of(t.h[x], true);
+	}
+	for (std::size_t x = 0; x < q.m; ++x)
+	{
+		int r = 0, r2 = 0;
+		for (std::size_t y = 0; y < q.m; ++y)
