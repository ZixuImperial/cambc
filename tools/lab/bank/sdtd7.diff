+			const bool lo = t.h[y] < t.h[x];
+			r += (q.pb[y] > q.pb[x] || (q.pb[y] == q.pb[x] && lo)) ? 1 : 0;
+			r2 += (q.pb2[y] > q.pb2[x] || (q.pb2[y] == q.pb2[x] && lo)) ? 1 : 0;
