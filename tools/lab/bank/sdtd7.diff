+// v641 SDT bit 1: the foe turn counts (irb_tab) and the acting-order table (hdt_o) read my next-round value; a new one refills them.
+// Bit 4: only my rank next round moves (no one else acts inside my turn), so the round's order and hdt_o take it in place, no priority reads.
+void sdt_order_changed(int v)
+{
+	burst::irb_tab.at_round = -1;
+	if (SDT_ON(4) && burst::sdt_next_changed(PRA_DEC(v)))
+	{
