+// b2423 PSL (econ_flags.h; callers read the flag): quiet group, and another unclaimed alive group with value (once a round per body).
+static bool psl_quiet(const GroupI& g, int self)
+{
+	if (g.contest >= 0.5f)
+		return false;
+	if (self == my_slot()) // RC C1460: my own sight only on my own row; every row reads the shared danger
+		for (const auto& e : W.enemies)
