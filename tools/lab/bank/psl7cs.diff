+}
+static bool psl_other_free(int gi, int self)
+{
+	static int r = -1000, sl = -1, gx = -1;
+	static bool v = false;
+	if (r == now() && sl == self && gx == gi)
+		return v;
+	r = now();
+	sl = self;
+	gx = gi;
+	v = false;
+	for (int k = 0; k < M.ng && !v; ++k)
+	{
+		if (k == gi)
+			continue;
+		const GroupI& h = M.groups[static_cast<std::size_t>(k)];
+		const GroupMem& hm = mem[static_cast<std::size_t>(k)];
+		if (h.gems + h.gold <= 0 || h.access != ACC_WALK || hm.status != GS_ALIVE || hm.fail_until > now() || sg_big(h))
+			continue;
+		bool taken = false;
+		for (int s = 0; s < TM.n; ++s)
+			if (TM.claim[static_cast<std::size_t>(s)] == k)
+				taken = true;
+		v = !taken;
+	}
+	return v;
+}
+// b2423 PSL bit 4 (callers read the flag): our Prism is unfit: her solo clear on her posted claim is infeasible or over PSL_T (once a round).
+static __attribute__((noinline)) bool psl_unfit()
+{
+	static int r = -1000;
+	static bool v = false;
+	if (r == now())
+		return v;
+	r = now();
+	v = false;
+	const int ps = prism::prism_slot();
+	if (ps < 0 || ps >= TM.n || TM.round != now() || !prism::prism_alive())
+		return v;
+	const int gi = TM.claim[static_cast<std::size_t>(ps)];
+	if (gi < 0 || gi >= M.ng || mem[static_cast<std::size_t>(gi)].status != GS_ALIVE)
+		return v;
+	Crew c;
+	c.add(ECX_TM(static_cast<std::size_t>(ps)));
+	const ClearEst e = estimate_cx(1, M.groups[static_cast<std::size_t>(gi)], mem[static_cast<std::size_t>(gi)], c);
+	v = !e.feasible || e.t > static_cast<float>(PSL_TAB[2]);
+	return v;
+}
+// b2423 PSL bit 4 (a): self is the nearest free mate to our unfit Prism's claimed group gi.
+static __attribute__((noinline)) bool psl_escort(int gi, int self)
+{
+	const int ps = prism::prism_slot();
+	if (ps < 0 || self == ps || ps >= TM.n || TM.claim[static_cast<std::size_t>(ps)] != gi || !psl_unfit())
+		return false;
+	const vec2 a = M.groups[static_cast<std::size_t>(gi)].anchor;
+	int best = -1, bd = 1 << 20;
+	for (int s = 0; s < TM.n; ++s) // RC C1470: shared data only: each slot's posted claim anchor, else home; lowest slot on ties
+	{
+		if (s == ps)
+			continue;
+		const int k = comms::ckind(s);
+		if (k == 1 || k == 4)
+			continue;
+		const int c = TM.claim[static_cast<std::size_t>(s)];
+		const vec2 p = (c >= 0 && c < M.ng) ? M.groups[static_cast<std::size_t>(c)].anchor : M.home_anchor;
+		const int d = cheb(p, a);
+		if (d < bd)
+		{
+			bd = d;
+			best = s;
+		}
+	}
+	return best == self;
+}
+static __attribute__((noinline)) bool psl_close(int gi, int self, const GroupI& g, const GroupMem& m, const Claims& cl)
+{
+	const int ps = prism::prism_slot();
+	if (ps < 0 || ps >= TM.n || m.status != GS_ALIVE)
+		return false;
+	const float tmax = static_cast<float>(PSL_TAB[2]);
+	if (self != ps)
+	{
+		if (!PSL_ON(1) || TM.claim[static_cast<std::size_t>(ps)] != gi || !psl_quiet(g, self))
+			return false;
+		Crew c;
+		c.add(ECX_TM(static_cast<std::size_t>(ps)));
+		const ClearEst e = estimate_cx(1, g, m, c);
+		return e.feasible && e.t <= tmax && psl_other_free(gi, self);
+	}
+	if (!PSL_ON(2) || claimants(gi, self, cl) == 0 || !psl_quiet(g, self))
+		return false;
+	const ClearEst e = estimate_cx(1, g, m, crew_of_claimants(gi, self, cl));
+	return e.feasible && e.t <= tmax && psl_other_free(gi, self);
+}
