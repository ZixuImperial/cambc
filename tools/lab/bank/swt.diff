 // v673 SWD: farm walks travel-dash (+respawn stage)
 #define SWD_BITS 3
 inline constexpr int SWD_TAB[2] = { 0x53574431, SWD_BITS }; // slot 0 magic keeps it out of .bss
 inline int swd_r = -1000;     // SWD: the round brain reached the farm or errand stage (bit 1)
 inline int swd_block = -1000; // SWD: a keep-out or bail walk this round: no plain dash
+// SWT (b1779, Rule Checker BRT SWD1): swd_r, set at errand_stage, stayed set through team_stage, so the SWD plain-walk travel dash
+// also fired on the guard / converge / defend / help / crew / tie walks, and mv::escape's step_to_set fallbacks never set swd_block.
+// Runtime data flag, read first; 0 = off. Bit 1: team_stage clears swd_r (the farm stage sets it again). Bit 2: the escape
+// fallbacks walk with swd_block set (restored after).
+#define SWT_BITS 0
+inline const volatile int SWT_TAB[2] = { 0x53575431, SWT_BITS }; // slot 0 magic keeps it out of .bss
+#define SWT_ON(b) ((SWT_TAB[1] & (b)) != 0)
