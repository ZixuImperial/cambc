diff --git a/src/common_flags.h b/src/common_flags.h
--- a/src/common_flags.h
+++ b/src/common_flags.h
@@ -1355,6 +1355,15 @@ inline constexpr int REB_TAB[2] = { 0x52454231, REB_BITS }; // slot 0 magic keep
 // encode (comms.cc slim4_of_full; the slim-2 width guard failed on ng 7/39/103). Bit 4 CMS1/TND1: a channel TAKEN is dated at the post
 // round (a latest bound; news waits up to INTEL_NEWS_TTL), so intel_taken keeps a live respawn timer inside [at - TTL - 1, at].
 // Bit 8 CK1: drop the dead ckind == 1 terms (codes 1-3 fold to idle in the slim field; mates never decode kind 1).
 // v911 XCB: REB BNX SCL XCB4 (owner ship) v910
 #define XCB_BITS 4
 inline constexpr int XCB_TAB[2] = { 0x58434231, XCB_BITS }; // slot 0 magic keeps it out of .bss
+// BRX (b2409; Combat spec_brx_1113, witness v Fish 01a1d68d r111: a 37%-HP Cassi recalled 5 rounds after a Prism hit her from a bush edge,
+// was hit in the channel and died with Issac): runtime data flag BRX_TAB[1], read first; 0 = v911. Bit 1: recall_safe's bush guard
+// (econ_recall_heal.cc) applies below BRX_TAB[2] percent HP (50: the whole 'out' branch) instead of 35. Bit 2: recall_bush_threat counts a
+// foe seen up to BRX_TAB[3] (6) rounds ago, its reach grown by min(age, 3) (it may have walked toward me); still only foes next to a bush.
+#define BRX_BITS 0
+#define BRX_FRAC 50
+#define BRX_AGE 6
+inline const volatile int BRX_TAB[4] = { 0x42525831, BRX_BITS, BRX_FRAC, BRX_AGE }; // slot 0 magic keeps it out of .bss
+#define BRX_ON(b) ((BRX_TAB[1] & (b)) != 0)
