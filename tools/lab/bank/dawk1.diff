+// Re-pick past a waking landing: at most 3 picks, each tested once; x < 0: none left (the flee falls through).
+__attribute__((noinline)) vec2 dawk_repick(const std::vector<mv::Threat>& zs, vec2 me, int r, int now, vec2 best)
+{
+	dawk_n = 0;
+	vec2 out{ -1, -1 };
+	while (dawk_n < 3)
