+// SWP bit 1: called once a turn at refresh_target's top, flag read first.
+void swp_track()
+{
+	for (int s = 0; s < comms::CLAIM_SLOTS && s < 8; ++s)
+	{
+		const int g = s == my_slot() ? -1 : comms::cgroup(s);
+		const std::size_t k = static_cast<std::size_t>(s);
+		if (g != swp_cur[k])
+		{
+			swp_old[k] = swp_cur[k];
+			swp_cur[k] = g;
+			swp_chg[k] = now();
+		}
+	}
+}
+// SWP bit 1: the mate whose move makes my switch to best a swap (it left best for my target within SWP_WIN rounds), or -1.
+int swp_mate(int best)
+{
+	if (T.target < 0 || best < 0 || best == T.target)
+		return -1;
+	for (int s = 0; s < comms::CLAIM_SLOTS && s < 8; ++s)
+	{
+		const std::size_t k = static_cast<std::size_t>(s);
+		if (s != my_slot() && swp_cur[k] == T.target && swp_old[k] == best && now() - swp_chg[k] <= SWP_TAB[3])
+			return s;
+	}
+	return -1;
+}
+// SWP bit 1: the swap is not made. The lower slot keeps its target; the higher one keeps it this turn and re-rates next turn without best.
+void swp_hold(int mate, int best)
+{
+	if (my_slot() > mate && best < mem_n)
+	{
+		auto& m = mem[static_cast<std::size_t>(best)];
+		m.fail_until = std::max(m.fail_until, now() + SWP_TAB[4]);
+		T.eval_round = now() - PLAN_EVAL_EVERY; // due again next turn
+		return;
+	}
+	T.eval_round = now();
+}
