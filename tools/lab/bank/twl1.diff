+// b2384 TWL bit 1 (caller reads TWL_ON(1); econ_flags.h): call the siege at the lull without the 4-round SG_EVERY wait. On the turn my
+// capture paid (or the next, as the payout is seen) or my first live turns after a respawn, with >= 2 mates idle or just off an engaged
+// claim, siege_try_call's own tests (its own free crew) run on the heavy groups within walk TWL_TAB[3] with no foe seen near. True if I called.
+template <int DM>
+bool twl_try_call()
+{
+	const int ev = std::max(twl_paid_r, twl_dead_r + 1);
+	if (!(now() - twl_paid_r <= 1 || now() - twl_dead_r <= 2) || twl_used_r >= ev || my_slot() < 0 || my_slot() >= 8)
+		return false;
+	if (!sg_any() || !opened || !W.alive || SGO.gi >= 0 || T.engaged || T.capturing || W.me.frac() < SG_HP)
+		return false;
+	if ((DM & 1) && dc_is(T.target))
+		return false; // committed to D
+	if (sg_next_eval - now() > SG_EVERY || fuel() < 72000 || (ci2x2_risk_bag() >= 40) || siege_running_group() >= 0)
+		return false; // a plain re-eval wait is skipped, a failed operation's longer wait holds
+	if (T.target >= 0 && finish_progress_mode())
+		return false;
+	int nl = 0;
+	for (int s = 0; s < TM.n && s < 8; ++s)
+	{
+		if (s == my_slot() || !siege_ally_alive(s))
+			continue;
+		const int k = comms::ckind(s);
+		const bool idle = k == 0 && comms::cgroup(s) < 0;
+		const bool off = !comms::cengaged(s) && k != 1 && k != 4 && now() - twl_eng_r[static_cast<std::size_t>(s)] <= TWL_TAB[2];
+		if (idle || off)
+			++nl;
+	}
+	if (nl < 2)
+		return false;
+	twl_used_r = now();
+	int best = -1;
+	float best_s = 0;
+	for (int gi = 0; gi < M.ng && fuel() > 60000; ++gi)
+	{
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		if (g.n_mono + g.n_golem <= 0 || (!sg_big(g) && !siege_is_crew_group<DM>(gi)) || siege_group_refused(gi))
+			continue;
+		if (siege_slot_arrival_eta(my_slot(), gi) > TWL_TAB[3] || intel::count_near(g.anchor, TWL_TAB[4], TWL_TAB[5]) > 0)
+			continue;
+		float sc = 0;
+		if (siege_start_gate<DM>(gi, &sc) && sc > best_s)
+		{
+			best_s = sc;
+			best = gi;
+		}
+	}
+	if (best < 0)
+		return false;
+	Crew cc;
+	int eta = 0;
+	siege_free_crew(best, cc, eta);
+	sg_next_eval = now() + SG_EVERY;
+	if (!sg_big(M.groups[static_cast<std::size_t>(best)]) && best < 255)
+		comms::write_event(best, SG_CALL_EV, now());
+	siege_take_group(best, true, siege_slot_arrival_eta(my_slot(), best), eta);
+	return true;
+}
