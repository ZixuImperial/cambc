+// ======== VIK (b1769, owner idea): Vendetta kills a camp she can finish this turn to refresh her cooldowns (GameRules.md:626) ========
+namespace {
+constexpr long VIK_MIN_FUEL = 15000; // the picker scans visible camps; skipped on a starved turn
+// The camp in my melee reach that this turn's hits kill (one plain hit, or hit + reset + hit when two_ok): a cluster or an awake
+// attacker, never a hit that wakes a sleeping attacker with me in its reach; the weakest. -1: none.
+int vik_pick(bool two_ok)
+{
+	const float dmg = W.me.str * mu::my_camp(mu::OUT);
+	const int r = std::max(1, W.me.range);
+	int best = -1;
+	float bh = 1e9f;
+	for (const auto& vc : W.camps)
+	{
+		if (vc.ci < 0 || vc.ci >= M.nc || vc.hp <= 0.0f || vc.hp > (two_ok ? 2.0f * dmg : dmg))
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (cheb(c.pos, W.me.pos) > r || (c.attacks() && !vc.awake) || prestep_hit_wakes_group(vc.ci))
+			continue;
+		if (vc.hp < bh)
+		{
+			bh = vc.hp;
+			best = vc.ci;
+		}
+	}
+	return best;
+}
+// Vendetta with an attack left this turn.
+NOVA_INLINE bool vik_body()
+{
+	return W.alive && W.me.kit && W.me.kit->kill_reset && !W.me.kit->ranged && !W.attacked && W.can_attack() && !W.me.channeling() &&
+		W.me.kit->slot_dash >= 0 && fuel() > VIK_MIN_FUEL;
+}
+// Hit ci; a kill re-reads the refunded cooldowns. Not dead and allow_reset: reset (the turn's cast) and hit again. True: it died.
+bool vik_kill(int ci, bool allow_reset)
+{
+	const Kit& k = *W.me.kit;
+	if (!attack_camp(ci))
+		return false;
+	if (!camps::camp_alive_in_engine(ci))
+	{
+		camps::refresh_cooldowns();
+		return true;
+	}
+	if (!allow_reset || k.slot_reset < 0 || !ready(k.slot_reset) || !cast_self(k.slot_reset) || !attack_camp(ci))
+		return false;
+	camps::refresh_cooldowns(); // the engine's refund when the second hit killed
+	return !camps::camp_alive_in_engine(ci);
+}
+NOVA_INLINE bool vik_foe_within(int d)
+{
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= d)
+			return true;
+	return false;
+}
+} // namespace
+// Bit 1 TRAVEL: before the walk's travel dash (mv::step_field / step_to_set), so a plain-hit kill's refunded dash goes this turn.
+bool vik_travel_slow()
+{
+	if (!vik_body() || W.cd[static_cast<std::size_t>(W.me.kit->slot_dash)] < VIK_TAB[2] || vik_foe_within(8))
+		return false;
+	const Kit& k = *W.me.kit;
+	const bool two = k.slot_reset >= 0 && ready(k.slot_reset);
+	const int ci = vik_pick(two);
+	return ci >= 0 && vik_kill(ci, two);
+}
+// Bit 2 ESCAPE: a flee turn with a bag: one plain hit only, so the refunded dash can go this turn.
+bool vik_flee_slow()
+{
+	if (!vik_body() || W.me.gems < static_cast<std::uint32_t>(VIK_TAB[3]) || W.cd[static_cast<std::size_t>(W.me.kit->slot_dash)] <= 0)
+		return false;
+	const int ci = vik_pick(false);
+	return ci >= 0 && vik_kill(ci, false);
+}
+// Bit 4 PRE-FIGHT: a foe seen at 4-8, none nearer; reset or dash on cooldown: kill now so both are up at contact.
+bool vik_prefight_slow()
+{
+	if (!vik_body() || vik_foe_within(3) || !vik_foe_within(8))
+		return false;
+	const Kit& k = *W.me.kit;
+	const bool rup = k.slot_reset >= 0 && W.cd[static_cast<std::size_t>(k.slot_reset)] <= 0;
+	const bool dup = W.cd[static_cast<std::size_t>(k.slot_dash)] <= 0;
+	if (rup && dup)
+		return false;
+	const bool two = rup && ready(k.slot_reset);
+	const int ci = vik_pick(two);
+	return ci >= 0 && vik_kill(ci, two);
+}
 } // namespace nova::combat
