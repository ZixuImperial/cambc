+#define PBT_BITS 0
+#define PBT_G 300 // slot 2
+#define PBT_HG 90 // slot 3
+#define PBT_MR 6 // slot 4
+#define PBT_FR 10 // slot 5
+#define PBT_TR 8 // slot 6
