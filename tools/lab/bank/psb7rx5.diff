+#define PBT_BG 60 // slot 8
+#define PBT_AGE 10 // slot 9
+inline const volatile int PBT_TAB[10] = { 0x50425431, PBT_BITS, PBT_G, PBT_HG, PBT_MR, PBT_FR, PBT_TR, PBT_BH, PBT_BG, PBT_AGE }; // slot 0 magic keeps it out of .bss
