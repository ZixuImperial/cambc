+// PBT bit 2 (b2452): a healthy carrier Prism does not shop-recall out of her group: 2+ mates within PBT_MR and a remembered foe
+// within PBT_FR, or her target group within PBT_TR and not respawning. Own and shared data only (W.allies, combat memory, group memory).
+bool pbt_from_group(float frac)
+{
+	if (frac < 0.8f || !prism_layer::carrier())
+		return false;
+	if (T.target >= 0 && static_cast<std::size_t>(T.target) < mem.size() && T.target < M.ng)
+	{
+		const std::size_t g = static_cast<std::size_t>(T.target);
+		if (mem[g].status != GS_RESPAWN && cheb(W.me.pos, M.groups[g].anchor) <= PBT_TAB[6])
+			return true;
+	}
+	int n = 0;
+	for (const auto& al : W.allies)
+		n += cheb(al.pos, W.me.pos) <= PBT_TAB[4] ? 1 : 0;
+	return n >= 2 && combat::nearest_foe_distance_seen(PBT_TAB[9]) <= PBT_TAB[5];
+}
