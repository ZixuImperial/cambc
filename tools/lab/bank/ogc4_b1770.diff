+// v642 OGC one-gem carry (Econ spec_ogc_1109): the gate, the carry and the three bits' tests. Callers read OGC_TAB first.
+namespace nova::ogc
+{
+namespace
+{
+int og_top = -2; // the top gem group (the draft's map_class_compute order: the first with the most gems)
+bool og_done = false; // we captured the top group: normal play
+int og_r = -1000, og_carry = -1;
+std::array<float, 8> og_sh{}; // the most shards seen per slot (shards only grow; gold stays with a dead body)
+std::array<float, 8> og_pw{}; // the most maxHP x Str seen per slot (bit 8's pair mate)
+int top()
+{
+	if (og_top == -2 && !M.groups.empty())
+	{
+		int best = -1, bg = -1;
+		for (int i = 0; i < M.ng; ++i)
+			if (M.groups[static_cast<std::size_t>(i)].gems > bg)
+			{
+				bg = M.groups[static_cast<std::size_t>(i)].gems;
+				best = i;
+			}
+		og_top = best;
+	}
+	return og_top < 0 ? -1 : og_top;
+}
+bool gate()
+{
+	if ((map_class() & MCL_BIT_ONEHEAVY) == 0 || og_done)
+		return false;
+	const int t = top();
+	if (t < 0)
+		return false;
+	const auto& c = planner::camp(t);
+	if (c.state == planner::CS_RESPAWN && (c.by == planner::BY_ME || c.by == planner::BY_ALLY))
+	{
+		og_done = true;
+		return false;
+	}
+	return true;
+}
+int carry()
+{
+	if (og_r == W.round)
+		return og_carry;
+	og_r = W.round;
+	if (P.my_slot >= 0 && P.my_slot < 8)
+	{
+		og_sh[static_cast<std::size_t>(P.my_slot)] = std::max(og_sh[static_cast<std::size_t>(P.my_slot)], econ::shards_of(W.me));
+		og_pw[static_cast<std::size_t>(P.my_slot)] = std::max(og_pw[static_cast<std::size_t>(P.my_slot)], W.me.maxhp * W.me.str);
+	}
+	for (const auto& a : W.allies)
+		if (a.slot >= 0 && a.slot < 8)
+		{
+			og_sh[static_cast<std::size_t>(a.slot)] = std::max(og_sh[static_cast<std::size_t>(a.slot)], econ::shards_of(a));
+			og_pw[static_cast<std::size_t>(a.slot)] = std::max(og_pw[static_cast<std::size_t>(a.slot)], a.maxhp * a.str);
+		}
+	// The best holder_gold_mult x (shards + 1), ties to the kit whose gold buys the most damage (rcy_d100); the carry changes only
+	// when another body's number beats hers by OGC_HYS %, so the routed gold stays with one body.
+	int best = -1;
+	float bv = -1.0f;
+	for (int s = 0; s < std::min(P.n, 8); ++s)
+	{
+		const float v = mu::holder_gold_mult(s) * (og_sh[static_cast<std::size_t>(s)] + 1.0f);
+		const int ti = static_cast<int>(P.type[static_cast<std::size_t>(s)]);
+		const float tb = (ti >= 0 && ti < 13) ? 1e-4f * static_cast<float>(planner::rcy_d100[ti]) : 0.0f;
+		if (v + tb > bv)
+		{
+			bv = v + tb;
+			best = s;
+		}
+	}
+	if (og_carry >= 0 && og_carry < std::min(P.n, 8) && best != og_carry)
+	{
+		const float cv = mu::holder_gold_mult(og_carry) * (og_sh[static_cast<std::size_t>(og_carry)] + 1.0f);
+		if (bv * 100.0f < cv * static_cast<float>(100 + OGC_TAB[6]))
+			best = og_carry;
+	}
+	og_carry = best;
+	return og_carry;
+}
+} // namespace
+bool rank_on(int slot) { return gate() && slot >= 0 && slot == carry(); }
+bool leave_payout(int gi)
+{
+	if (gi < 0 || gi >= M.ng || !gate())
+		return false;
+	const int c = carry();
+	if (c < 0 || c == P.my_slot)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	if (g.gold <= 0 || !econ::claims(c, gi))
+		return false;
+	const Body* cb = nullptr;
+	for (const auto& a : W.allies)
+		if (a.slot == c)
+			cb = &a;
+	if (cb == nullptr || cb->channeling() || cheb(cb->pos, g.anchor) > OGC_TAB[4])
+		return false;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, g.anchor) <= 8)
+			return false;
+	return true;
+}
+bool siege_me(int gi, float dps1, int n)
+{
+	if (n != 1 || P.my_slot < 0 || gi != top() || !gate() || carry() != P.my_slot)
+		return false;
+	if (dps1 != econ::TM.m[static_cast<std::size_t>(P.my_slot)].dps1) // the lone crew is me
+		return false;
+	if (static_cast<std::int64_t>(W.me.maxhp) * static_cast<std::int64_t>(W.me.str) < static_cast<std::int64_t>(OGC_TAB[5]) || W.me.hp <= 0.6f * W.me.maxhp)
+		return false;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 10)
+			return false;
+	return true;
+}
+bool pair_me(int gi, float dps1, int n)
+{
+	if (n != 2 || P.my_slot < 0 || gi != top() || !gate())
+		return false;
+	const int c = carry();
+	if (c < 0)
+		return false;
+	int m = -1; // the pair mate: the strongest other body by maxHP x Str seen
+	for (int s = 0; s < std::min(P.n, 8); ++s)
+		if (s != c && (m < 0 || og_pw[static_cast<std::size_t>(s)] > og_pw[static_cast<std::size_t>(m)]))
+			m = s;
+	if (m < 0 || (P.my_slot != c && P.my_slot != m))
+		return false;
+	const int other = P.my_slot == c ? m : c;
+	if (dps1 != econ::TM.m[static_cast<std::size_t>(c)].dps1 + econ::TM.m[static_cast<std::size_t>(m)].dps1) // the crew is the pair
+		return false;
+	const Body* ob = nullptr;
+	for (const auto& a : W.allies)
+		if (a.slot == other)
+			ob = &a;
+	if (ob == nullptr || cheb(ob->pos, W.me.pos) > 3 || ob->hp <= 0.6f * ob->maxhp || W.me.hp <= 0.6f * W.me.maxhp)
+		return false;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 10)
+			return false;
+	return true;
+}
+} // namespace nova::ogc
