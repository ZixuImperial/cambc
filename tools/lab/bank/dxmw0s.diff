 // DXS (draft_flags.h): does Prism stay against the DXC cell 0 swap to Ryth? Called wherever DXC cell 0 fires (no flag test).
+// DXM (b2272): one walkable mid group (contest .4-.6) holds >= DXM_SH % of the map's gems.
+static bool dxm_class()
+{
+	long tot = 0, midg = 0;
+	for (const auto& g : M.groups)
+	{
+		tot += g.gems;
+		if (g.access == ACC_WALK && g.d_home != UNREACH && g.contest >= 0.4f && g.contest <= 0.6f && g.gems > midg)
+			midg = g.gems;
+	}
+	return tot > 0 && 100L * midg >= static_cast<long>(DXM_SH) * tot;
+}
 bool dxs_keep_prism(std::uint16_t eff)
 {
 	const long f16 = swap_feature(16, map_totals(), static_cast<long>(G.w) * G.h);
 	const float p = std::min(1.0f, std::max(0.0f, static_cast<float>(f16 - DXS_TAB[4]) / static_cast<float>(std::max(1, DXS_TAB[5] - DXS_TAB[4]))));
-	return lineup_value(eff) + 0.1f * static_cast<float>(DXS_TAB[2]) - 0.1f * static_cast<float>(DXS_TAB[3]) * p >= lineup_value((eff & ~bit(PR)) | bit(RY));
+	const int w10 = (DXM_ON(1) && dxm_class()) ? DXM_TAB[2] : DXS_TAB[3]; // DXM (b2272): penalty weight on the one-mid-group class
+	return lineup_value(eff) + 0.1f * static_cast<float>(DXS_TAB[2]) - 0.1f * static_cast<float>(w10) * p >= lineup_value((eff & ~bit(PR)) | bit(RY));
 }
