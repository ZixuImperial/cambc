+// DNY (b1777; owner idea, Deep CDD + Combat DNY strict gate): called only on a turn where visible_foes_lethal_next_turn() held (brain's
+// priority branch, DNY_ON read there). Doomed: off spawn, not channeling, my bag not a winning tribute, no ready own dash / shield / heal,
+// no mate within 5 (a heal, stun or peel could save me), and the visible foes' next-turn sum kills me on every tile I can step to. Then a
+// tile Q one step away where awake attacking camps (each with HP > 2 x my Strength) hit me at the next camp phase for >= my HP + shield,
+// I being strictly nearer each of them than every other body (a foe counts 1 closer, 3 with a dash kit). Step there: the camp's kill
+// destroys my bag and pays the foe nothing (GR:124 camps act at round start; GR:192 nearest champion; GR:375).
+int dny_round = -1; // the round a lethal check (brain priority, lethal_burst_assess no-escape) saw me doomed with DNY on
+static float dny_foe_sum(vec2 t)
+{
+	float s = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, t);
+		if (d > 9)
+			continue;
+		float h = burst::lethal_burst_hit(e, d, 0, nullptr);
+		h = burst::stun_takes_next_turn(e) ? 0.0f : burst::reach_burst_turns(e) >= 2 ? burst::lethal_burst_two_turn_hit(e, d, h) : h;
+		s += std::max(0.0f, h);
+	}
+	return s;
+}
+static float dny_camp_kill_at(vec2 q)
+{
+	float s = 0.0f;
+	for (const auto& vc : W.camps)
+	{
+		if (!vc.awake || vc.ci < 0)
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (!c.attacks() || vc.hp <= 2.0f * W.me.str)
+			continue;
+		const int d = cheb(q, c.pos);
+		if (d > c.reach)
+			continue;
+		bool nearest = true;
+		for (const auto& o : W.allies)
+			if (cheb(o.pos, c.pos) <= d)
+				nearest = false;
+		for (const auto* v : { &W.enemies, &W.enemies_far })
+			for (const auto& e : *v)
+				if (cheb(e.pos, c.pos) - ((e.kit && e.kit->slot_dash >= 0) ? 3 : 1) <= d)
+					nearest = false;
+		if (nearest)
+			s += c.str;
+	}
+	return s * mu::ct_k;
+}
+static bool dny_step(vec2 q) { return mv::try_move(q); }
+bool doomed_die_to_camp()
+{
+	bool any_camp = false; // cheapest test first: an awake attacking camp in sight at all
+	for (const auto& vc : W.camps)
+		if (vc.awake && vc.ci >= 0 && M.camps[static_cast<std::size_t>(vc.ci)].attacks())
+		{
+			any_camp = true;
+			break;
+		}
+	if (!any_camp || !W.alive || !W.me.kit || W.on_spawn || W.me.channeling() || !W.can_move())
+		return false;
+	const Kit& k = *W.me.kit;
+	if (W.tributed_us + static_cast<int>(W.me.gems) >= 1000)
+		return false;
+	if ((k.slot_dash >= 0 && ready(k.slot_dash)) || (k.slot_shield >= 0 && ready(k.slot_shield)) || (k.slot_heal >= 0 && ready(k.slot_heal)))
+		return false;
+	for (const auto& o : W.allies)
+		if (cheb(o.pos, W.me.pos) <= 5)
+			return false;
+	const float eff = W.me.hp + std::max(0.0f, W.me.shield);
+	if (dny_foe_sum(W.me.pos) < eff)
+		return false;
+	vec2 best{ -1, -1 };
+	float bs = 0.0f;
+	for (int dy = -1; dy <= 1; ++dy)
+		for (int dx = -1; dx <= 1; ++dx)
+		{
+			if (!dx && !dy)
+				continue;
+			const vec2 q{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!inb(q) || !mv::free_tile(q))
+				continue;
+			if (dny_foe_sum(q) < eff)
+				return false; // a tile the foes do not kill me on: not doomed
+			const float cs = dny_camp_kill_at(q);
+			if (cs >= eff && cs > bs)
+			{
+				bs = cs;
+				best = q;
+			}
+		}
+	if (best.x < 0)
+		return false;
+	return dny_step(best);
+}
 bool is_caster_champion()
 {
 	const int t = static_cast<int>(W.me.type);
 	return t >= 0 && t < 32 && ((PO_CASTER_MASK >> t) & 1u) != 0;
 }
