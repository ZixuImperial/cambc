 // also runs after turn_tail, whose champion hits it never saw.
 // v701 HPU: HPR refresh uses Durability-scaled HP
 #define HPU_BITS 3
 inline constexpr int HPU_TAB[2] = { 0x48505531, HPU_BITS }; // slot 0 magic keeps it out of .bss
+// DNY (b1777; owner idea; Deep spec_cdd_1109 + Combat dny.py strict gate): a body the visible foes kill next turn on every tile it can
+// step to, with no mate within 5 and no ready own dash, shield or heal, steps where awake camps (it strictly nearest) kill it at the
+// next camp phase: no bag and no bounty for the foe (GR:375). Read only inside brain's visible_foes_lethal_next_turn branch. 0 = off.
+#define DNY_BITS 0
+inline const volatile int DNY_TAB[2] = { 0x444E5931, DNY_BITS }; // slot 0 magic keeps it out of .bss
+#define DNY_ON(b) ((DNY_TAB[1] & (b)) != 0)
