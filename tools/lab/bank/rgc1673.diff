+// RGC: where a foe can hit me from: its basic and step, or a damaging spell (GR:506, 668, 756: melee Ren, Marcella, Ryth from 4).
+static int rgc_foe_hit_reach(const Body& e)
+{
+	int r = e.range + 1;
+	if (!e.kit)
+		return r;
+	const Kit& k = *e.kit;
+	if (k.dmg_mod > 0)
+		r = std::max(r, static_cast<int>(k.dmg_range));
+	if (k.cc_mod > 0)
+		r = std::max(r, static_cast<int>(k.cc_range));
+	if (k.aoe_mod > 0)
+		r = std::max(r, static_cast<int>(k.aoe_range + k.aoe_radius));
+	return r;
+}
