+// v7xx SGCNL bit 4: Stellar does not lead a travel walk-in. Per visible foe at 2..SGCNL_DMAX she is our nearest body to (no visible mate
+// as close) and cannot kill this turn: an entry (foe, d - 1). The caller reads the flag.
+__attribute__((noinline)) void sgc_nolead_zones(const Assessment& a, std::vector<std::pair<vec2, int>>& out)
+{
+	const int dmax = SGCNL_TAB[2];
+	for (const auto& f : a.foes)
+	{
+		if (f.idx < 0 || f.idx >= static_cast<int>(W.enemies.size()))
+			continue;
+		const int d = cheb(W.me.pos, f.pos);
+		if (d < 2 || d > dmax)
+			continue;
+		bool mate = false;
+		for (const auto& al : W.allies)
+			if (cheb(al.pos, f.pos) <= d)
+			{
+				mate = true;
+				break;
+			}
+		if (mate)
+			continue;
+		const Body& e = W.enemies[static_cast<std::size_t>(f.idx)];
+		if (d <= std::max(W.me.range + 1, 2) && burst::kills(e, d, 0))
+			continue;
+		out.emplace_back(f.pos, d - 1);
+	}
+}
+// v7xx SGCNL bit 8: a FIGHT approach to the focus stops at SGCNL_FSTOP (spell range) unless a mate is within 2 of it or she can kill it
+// this turn. No entry while she already stands inside the stop (an entry around her would drop the whole guard).
+__attribute__((noinline)) void sgc_fight_stop_zones(const Assessment& a, std::vector<std::pair<vec2, int>>& out)
+{
+	if (a.focus < 0 || a.focus >= static_cast<int>(W.enemies.size()))
+		return;
+	const Body& e = W.enemies[static_cast<std::size_t>(a.focus)];
+	const int stop = SGCNL_TAB[3];
+	const int d = cheb(W.me.pos, e.pos);
+	if (d < stop || d > 9)
+		return;
+	for (const auto& al : W.allies)
+		if (cheb(al.pos, e.pos) <= 2)
+			return;
+	if (d <= std::max(W.me.range + 1, 2) && burst::kills(e, d, 0))
+		return;
+	out.emplace_back(e.pos, stop - 1);
+}
 } // namespace nova::combat
