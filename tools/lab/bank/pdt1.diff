diff --git b/src/combat_pdt.cc b/src/combat_pdt.cc
new file mode 100644
--- /dev/null
+++ b/src/combat_pdt.cc
@@ -0,0 +1,85 @@
+// combat_pdt.cc: b2402 PDT bit 1, the Prism's 1v1 by turn count (spec_pdt_1113; RC C1296). Callers read the flag.
+#include "combat_internal.h"
+namespace nova::combat {
+namespace {
+// one step to a free adjacent tile with dmin <= cheb(t, e) <= dmax (the farthest first when far is set); true if moved
+bool pdt_step(vec2 e, int dmin, int dmax, bool far)
+{
+	vec2 best{ -1, -1 };
+	int bd = far ? -1 : 1 << 20;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			if (!dx && !dy)
+				continue;
+			const vec2 t{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!inb(t) || !mv::free_tile(t) || bbget(M.enemy_spawn, t))
+				continue;
+			const int d = cheb(t, e);
+			if (d < dmin || d > dmax)
+				continue;
+			if (far ? d > bd : d < bd)
+			{
+				bd = d;
+				best = t;
+			}
+		}
+	return best.x >= 0 && mv::try_move(best);
+}
+} // namespace
+bool pdt_turn(const Assessment& a)
+{
+	if (!W.alive || !W.me.kit || !W.me.kit->gem_focus || W.me.channeling() || W.me.stunned || W.cast || a.stance == FLEE)
+		return false;
+	const Body* e = nullptr;
+	int n8 = 0;
+	for (const auto& f : W.enemies)
+	{
+		const int d = cheb(f.pos, W.me.pos);
+		if (d > 10)
+			continue;
+		if (d > 8)
+			return false;
+		++n8;
+		e = &f;
+	}
+	if (n8 != 1 || !e)
+		return false;
+	const auto& tt = intel::team_table();
+	for (const auto& r : tt)
+		if (r.alive && r.h != e->h && r.round > -1000 && W.round - r.round <= PDT_TAB[2] && cheb(r.pos, W.me.pos) <= 10)
+			return false; // another foe was near lately: not a 1v1
+	const int k = burst::pdt_k(*e);
+	if (k != 0 && k != 2)
+		return false;
+	const Kit& kt = *W.me.kit;
+	const int d = cheb(e->pos, W.me.pos);
+	const bool st_ok = kt.slot_cc >= 0 && ready(kt.slot_cc) && !marcella_layer::fight_stun_wasted(*e);
+	const bool dm_ok = kt.slot_dmg >= 0 && ready(kt.slot_dmg);
+	const int r0 = static_cast<int>(kt.cc_range), r1 = static_cast<int>(kt.dmg_range);
+	const int R1 = foe_next_turn_reach(*e);
+	const int R2 = R1 + 1 + ((e->kit && e->kit->slot_dash >= 0) ? static_cast<int>(e->kit->dash_range) : 0);
+	if (k == 0)
+	{
+		if (st_ok && d <= r0 && cast_on_champion(kt.slot_cc, *e))
+			return true;
+		if (dm_ok && d <= r1 && cast_on_champion(kt.slot_dmg, *e))
+			return true;
+		if ((st_ok || dm_ok) && W.can_move() && !W.moved)
+		{
+			const int want = st_ok ? r0 : r1;
+			if (d > want && R1 < want && pdt_step(e->pos, R1 + 1, want, false))
+				return true; // in his range next turn only after my second turn: he cannot answer the step
+		}
+		return false;
+	}
+	// k == 2: his double comes before my next turn
+	if (d > R2)
+		return false;
+	if (W.can_move() && !W.moved && pdt_step(e->pos, R2 + 1, 1 << 20, true))
+		return true;
+	if (st_ok && d <= r0 && cast_on_champion(kt.slot_cc, *e))
+		return true; // the stun takes one of his two turns
+	return false;
+}
+} // namespace nova::combat
