 		reach_burst_turns_fill();
 	for (std::size_t x = 0; x < b.m; ++x)
 		if (b.hh[x] == e.h)
 			return b.nn[x];
 	return 2; // a foe not in this turn's list is not certain
 }
+// b2402 PDT (caller read the flag): still to act this round (the seen foe's has-acted bit; the burst table's unseen-foe shift made every
+// 1v1 foe read 2) + first next round, from ranks taken now (my next-round priority was set before the stages).
+int pdt_k(const Body& e)
+{
+	const EdRanks q = turn_order_ranks();
+	for (std::size_t x = 0; x < q.m; ++x)
+	{
+		if (W.enemies[x].h != e.h)
+			continue;
+		int rb = 0, rb2 = 0;
+		q.foe_rank(x, rb, rb2);
+		const bool acted = (W.enemies[x].state & FLEE_FIX_ST_ACTED) != 0; // a seen foe's has-acted bit is exact (b2263 probe, 866/866)
+		return (acted ? 0 : 1) + (q.first_next_round(rb2) ? 1 : 0);
+	}
+	return -1;
+}
