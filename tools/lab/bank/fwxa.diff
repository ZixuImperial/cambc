+// FWX: consecutive no-path fight turns on one focus; after K of them that foe is banned as my focus for FWX_BAN rounds.
+static std::uint32_t fwx_h = 0, fwx_ban_h = 0;
+static int fwx_n = 0, fwx_last = -1000, fwx_until = -1000;
+void fwx_note(std::uint32_t h, bool failed)
+{
+	if (!failed)
+	{
+		if (h == fwx_h)
+			fwx_n = 0;
+		return;
+	}
+	fwx_n = (h == fwx_h && W.round - fwx_last <= 2) ? fwx_n + 1 : 1;
+	fwx_h = h;
+	fwx_last = W.round;
+	const int k = FWX_ON(2) && !FWX_ON(1) ? FWX_TAB[3] : FWX_TAB[2]; // bit 1 / 4: FWX_K, bit 2 alone: FWX_K2
+	if (fwx_n >= k)
+	{
+		fwx_ban_h = h;
+		fwx_until = W.round + FWX_TAB[4];
+		fwx_n = 0;
+	}
+}
+bool fwx_banned(std::uint32_t h) { return h == fwx_ban_h && W.round < fwx_until; }
