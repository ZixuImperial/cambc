@@ -319,6 +319,17 @@ inline bool bb12_akill = false; // BB12 bit 4: this fight turn's area kills the
 // PFC (b1777, pra2f fuel: the flee dash-escape path that PRA2 a1's later-acting low-HP bodies run). Removed work only, play-identical.
 // Read first; 0 = off. Bit 1: dash_away returns before the landing search when staying is already outside every zone (danger 0: no
 // landing can beat it). Bit 2: dash_path_ok runs dash_legal_between once (a 2-step dash with BGX bit 2 tested it twice).
 // v672 PFC: escape-40 off + flee-path fuel cuts (PRA2F)
 #define PFC_BITS 3
 inline constexpr int PFC_TAB[2] = { 0x50464331, PFC_BITS }; // slot 0 magic keeps it out of .bss
+
+// FWX (bundle_combat_1109b; b1775): drop a FIGHT focus I can't path to (corridors ping-pong). 0 = nova_base_v673. Bit 1 (A): after
+// FWX_K consecutive fight turns whose walk to the focus found no path, that foe is not my focus for FWX_BAN rounds (the errand stage
+// takes a real target). Bit 2 (B): the same with FWX_K2. Bit 4 (C): instead of no focus, the nearest other foe in fight range with a
+// path (not unreachable) becomes the focus.
+#define FWX_BITS 0
+#define FWX_K 2
+#define FWX_K2 4
+#define FWX_BAN 5
+inline const volatile int FWX_TAB[5] = { 0x46575831, FWX_BITS, FWX_K, FWX_K2, FWX_BAN }; // slot 0 magic keeps it out of .bss
+#define FWX_ON(b) ((FWX_TAB[1] & (b)) != 0)
