@@ -306,16 +306,56 @@ static __attribute__((noinline)) bool whv_attach(int gi)
 		if (al.slot >= 0 && al.slot < 32 && al.slot != P.my_slot && !al.channeling() && cheb(al.pos, g.anchor) <= 6)
 			mates |= 1u << al.slot;
 	if (__builtin_popcount(mates) < (2))
