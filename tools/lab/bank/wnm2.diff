 	return nova::econ::siege_enemies_near_group(gi, 15) == 0; // WHVFIRE
 }
+// b2436 WNM bit 2 (caller read the flag): the contested carry's claimed group, or -1. Once a round.
+static __attribute__((noinline)) int wnm2_carry_group()
+{
+	static int r = -1, cg = -1;
+	if (r == W.round)
+		return cg;
+	r = W.round;
+	cg = -1;
+	auto rank = [](cambc::champion_type t) { return t == cambc::champion_type::prism ? 0 : t == cambc::champion_type::vesper_vale ? 1 : t == cambc::champion_type::marcella ? 2 : 9; };
+	int best = 9, cs = -1;
+	for (int s = 0; s < P.n; ++s)
+	{
+		const int k = rank(P.type[static_cast<std::size_t>(s)]);
+		if (k < best)
+		{
+			best = k;
+			cs = s;
+		}
+	}
+	if (best >= 9 || cs == P.my_slot || cs >= comms::CLAIM_SLOTS || !alive_slot(cs))
+		return cg;
+	const int g = comms::cgroup(cs);
+	const Body* b = W.ally_by_slot(cs);
+	if (g < 0 || g >= M.ng || !b || cheb(b->pos, M.groups[static_cast<std::size_t>(g)].anchor) > 6)
+		return cg;
+	for (const auto* lst : { &W.enemies, &W.enemies_far })
+		for (const auto& e : *lst)
+			if (cheb(e.pos, b->pos) <= 8)
+			{
+				cg = g;
+				return cg;
+			}
+	return cg;
+}
 float wl2_pull(int gi, float rate)
 {
 	if (rate <= 0.0f || gi < 0 || gi >= M.ng)
 		return rate;
+	if (WNM_ON(2))
+	{
+		const int wnm_cg = wnm2_carry_group();
+		if (wnm_cg >= 0 && gi != wnm_cg)
+			return rate * static_cast<float>(WNM_TAB[2]) / 1000.0f; // b2436 WNM bit 2: the contested carry's group first
+	}
 	const auto& g = M.groups[static_cast<std::size_t>(gi)];
 	bool work = false;
 	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS && !work; ++s)
 		work = s != P.my_slot && alive_slot(s) && comms::cgroup(s) == gi;
 	for (const auto& al : W.allies)
 		work = work || (!al.channeling() && cheb(al.pos, g.anchor) <= 6);
