+// WCH bit 1: true when moving my young own-half ward to own-half tile p adds little view (see common_flags.h).
+static __attribute__((noinline)) bool wch_churn(int t, vec2 p)
+{
+	if (my_ward.x < 0 || t - my_ward_round >= WCH_TAB[2])
+		return false;
+	if (cheb(p, M.home_anchor) >= cheb(p, M.enemy_anchor) || cheb(my_ward, M.home_anchor) >= cheb(my_ward, M.enemy_anchor))
+		return false;
+	static bitboard vn, vo;
+	cambc::ward::visible_tiles_from_into(p, vn);
+	cambc::ward::visible_tiles_from_into(my_ward, vo);
+	const std::size_t nw = bitboard::raw_buffer_size() / 8;
+	long nn = 0, both = 0;
+	for (std::size_t i = 0; i < nw; ++i)
+	{
+		nn += __builtin_popcountll(vn.ptr()[i]);
+		both += __builtin_popcountll(vn.ptr()[i] & vo.ptr()[i]);
+	}
+	return nn > 0 && 1000 * both >= static_cast<long>(WCH_TAB[3]) * nn;
+}
