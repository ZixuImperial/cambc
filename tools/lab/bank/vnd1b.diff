+// b2390 VND bit 1 (econ_flags.h; the caller read the flag): Vendetta's hit after the follow step / a single hit with the reset ready.
+static __attribute__((noinline)) bool vnd_target(int gi, int* out)
+{
+	int best = -1;
+	bool best_clu = false;
+	for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+	{
+		if (!visible_camp(ci) || !camp_alive_now(ci) || cheb(W.me.pos, M.camps[static_cast<std::size_t>(ci)].pos) > std::max(1, W.me.range))
+			continue;
+		const bool clu = !M.camps[static_cast<std::size_t>(ci)].attacks();
+		if (best < 0 || (clu && !best_clu))
+		{
+			best = ci;
+			best_clu = clu;
+		}
+	}
+	*out = best;
+	return best >= 0;
+}
+static __attribute__((noinline)) bool vnd_hit_again(int gi)
+{
+	if (!W.me.kit || !vendetta_layer::vendash(*W.me.kit) || W.me.channeling())
+		return false;
+	const int rs = W.me.kit->slot_reset;
+	bool hit = false;
+	int ci = -1;
+	if (W.can_attack() && vnd_target(gi, &ci))
+	{
+		hit = combat::attack_camp(ci);
+		if (hit && !combat::camps::camp_alive_in_engine(ci) && vendetta_layer::camp_kill_reset(*W.me.kit))
+			combat::camps::refresh_cooldowns();
+	}
+	if (rs >= 0 && !W.cast && !W.can_attack() && W.attacked && combat::ready(rs) && vnd_target(gi, &ci) && combat::cast_self(rs))
+	{
+		if (combat::attack_camp(ci))
+		{
+			hit = true;
+			if (!combat::camps::camp_alive_in_engine(ci) && vendetta_layer::camp_kill_reset(*W.me.kit))
+				combat::camps::refresh_cooldowns();
+		}
+	}
+	return hit;
+}
+// b2390 VND bit 4 (1b, econ_flags.h; the caller read the flag and saw my cluster kill this turn): the reset hit only when the group
+// has no living attacker, the next target is a cluster of the SAME group, and the reset is the turn's only cast.
+static __attribute__((noinline)) bool vnd1b_reset_hit(int gi)
+{
+	if (!W.me.kit || !vendetta_layer::vendash(*W.me.kit) || W.me.channeling())
+		return false;
+	const int vrs = W.me.kit->slot_reset;
+	if (vrs < 0 || W.cast || W.can_attack() || !W.attacked || !combat::ready(vrs))
+		return false;
+	int vci = -1;
+	for (int mi : M.groups[static_cast<std::size_t>(gi)].members)
+	{
+		if (!camp_alive_now(mi))
+			continue;
+		if (M.camps[static_cast<std::size_t>(mi)].attacks())
+			return false; // a living attacker in the group
+		if (vci < 0 && visible_camp(mi) && cheb(W.me.pos, M.camps[static_cast<std::size_t>(mi)].pos) <= std::max(1, W.me.range))
+			vci = mi;
+	}
+	if (vci < 0 || !combat::cast_self(vrs))
+		return false;
+	const bool vhit = combat::attack_camp(vci);
+	if (vhit && !combat::camps::camp_alive_in_engine(vci) && vendetta_layer::camp_kill_reset(*W.me.kit))
+		combat::camps::refresh_cooldowns();
+	return vhit;
+}
