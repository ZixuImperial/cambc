+// b2432 CTT (caller read the flag): set T.cap_on from the engine's capture state of group gi; false = no exact read (the old guess runs).
+static bool ctt_cap_on(int gi, const GroupI& g)
+{
+	if (gi < 0 || gi >= M.ng)
+		return false;
+	cambc::detail::camp_group_capture_state cs{};
+	if (cambc::detail::sdk_camp_group_capture_state(M.groups[static_cast<std::size_t>(gi)].handle, &cs) != 0)
+		return false;
+	const int st = static_cast<int>(cs.state);
+	const int ct = rs::rules().capture_time;
+	if (CTT_ON(1) && st == 1 && cs.timer >= 1 && cs.timer <= ct && !prism::has_family(rs::F_CAPTURE) && !capture_holder_on_group(g))
+	{
+		T.cap_on = now() + static_cast<int>(cs.timer) - ct; // ally_capturing: pay at now + timer (= cap_on + capture_time)
+		return true;
+	}
+	if (CTT_ON(2) && (st == 0 || st == 3))
+	{
+		T.cap_on = -1; // no_capture_available / enemy_capturing: no timer of ours runs
+		return true;
+	}
+	return false;
+}
