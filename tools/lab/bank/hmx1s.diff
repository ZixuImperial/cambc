+// v898 HMX (spec_hmx_1113, RC C1301): heal (bit 1) and shield (bit 2) are real HP on the tank, while the budget is HP / camp_mult;
+// price them in the budget's units (/ the leading tank's camp multiplier). Callers read HMX_ON(3) first.
+inline float hmx_soak(const Crew& c)
+{
+	const float k = 1.0f / (c.hmx_cm0 > 0.0f ? c.hmx_cm0 : 1.0f);
+	return (HMX_ON(1) ? c.heal8 * k : c.heal8) + (HMX_ON(2) ? c.shield8 * k : c.shield8);
+}
 inline Crew& Crew::operator=(const Crew& o)
 {
 	if (this != &o)
 		vmove_n<sizeof(Crew)>(reinterpret_cast<unsigned char*>(this), reinterpret_cast<const unsigned char*>(&o));
 	return *this;
 }
