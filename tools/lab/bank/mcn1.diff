+// b2409 MCN bit 1 (combat_flags.h): Marcella's ready damage spell on a turn with no walk and no cast, at the lowest effective-HP
+// enemy champion in range (free_cast's guards). True if cast.
+bool mcn_free_nuke()
+{
+	if (!W.me.kit || !marcella_layer::me() || W.cast || W.moved || W.me.channeling())
+		return false;
+	const Kit& k = *W.me.kit;
+	if (k.slot_dmg < 0 || k.dmg_mod <= 0 || !ready(k.slot_dmg))
+		return false;
+	const Body* t = nullptr;
+	for (const auto& e : W.enemies)
+	{
+		if (cheb(e.pos, W.me.pos) > static_cast<int>(k.dmg_range) || foe_model::unreachable(e) || bbget(M.enemy_spawn, e.pos))
+			continue;
+		if (ren_layer::kills_me(e))
+			continue;
+		if (MCN_ON(2) && !e.channeling() && eff_hp(e) > k.dmg_mod * W.me.foc * kit_rules::passive_mult(W.me) * mu::pair(W.me, e))
+			continue; // bit 2 (RC C1373): only a channeller or a kill spends the 8-turn cooldown
+		if (!t || eff_hp(e) < eff_hp(*t))
+			t = &e;
+	}
+	return t && cast_on_champion(k.slot_dmg, *t);
+}
