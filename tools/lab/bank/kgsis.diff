+// b2392 KGS (econ_flags.h; callers read the flag): the KEY groups and the gold floor, map-static, computed once.
+namespace {
+std::vector<std::uint8_t> kgs_key_v;
+float kgs_gold_max = 0.0f, kgs_gold_top3 = 0.0f;
+__attribute__((noinline)) void kgs_build()
+{
+	const std::size_t ng = M.groups.size();
+	kgs_key_v.assign(ng, 0);
+	float tot = 0.0f, r1 = -1.0f, r2 = -1.0f;
+	int i1 = -1, i2 = -1;
+	std::array<int, 3> gtop{ 0, 0, 0 };
+	for (std::size_t i = 0; i < ng; ++i)
+	{
+		const auto& g = M.groups[i];
+		const int gd = g.gold;
+		if (gd > gtop[2])
+		{
+			gtop[2] = gd;
+			if (gtop[2] > gtop[1])
+				std::swap(gtop[1], gtop[2]);
+			if (gtop[1] > gtop[0])
+				std::swap(gtop[0], gtop[1]);
+		}
+		if (g.gems <= 0)
+			continue;
+		const float r = static_cast<float>(g.gems) * 100.0f / static_cast<float>(g.respawn + 5);
+		tot += r;
+		if (r > r1)
+		{
+			r2 = r1;
+			i2 = i1;
+			r1 = r;
+			i1 = static_cast<int>(i);
+		}
+		else if (r > r2)
+		{
+			r2 = r;
+			i2 = static_cast<int>(i);
+		}
+	}
+	kgs_gold_max = static_cast<float>(gtop[0]);
+	kgs_gold_top3 = static_cast<float>(gtop[0] + gtop[1] + gtop[2]) / static_cast<float>(std::max<std::size_t>(1, std::min<std::size_t>(3, ng)));
+	if (tot <= 0.0f || i1 < 0)
+		return;
+	if (r1 >= 0.80f * tot)
+		kgs_key_v[static_cast<std::size_t>(i1)] = 1;
+	else if (i2 >= 0 && r1 + r2 >= 0.80f * tot)
+	{
+		kgs_key_v[static_cast<std::size_t>(i1)] = 1;
+		kgs_key_v[static_cast<std::size_t>(i2)] = 1;
+	}
+}
+} // namespace
+bool kgs_key(int gi)
+{
+	if (kgs_key_v.size() != M.groups.size())
+		kgs_build();
+	return gi >= 0 && static_cast<std::size_t>(gi) < kgs_key_v.size() && kgs_key_v[static_cast<std::size_t>(gi)] != 0;
+}
+float kgs_floor_v(float v, int gi)
+{
+	if (!kgs_key(gi))
+		return v;
+	const float gold = KGS_ON(8) ? kgs_gold_top3 : kgs_gold_max;
+	return std::max(v, gold * 0.50f * strat::policy().gold_value);
+}
 } // namespace nova::econ
