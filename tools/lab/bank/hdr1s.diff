+// HDR bit 1 (b1825, spec_hdr_1110, owner replay 01a1c60b): a Heart's dash-stun reaches 4 (walk 1 + dash 2 + radius 1, GR:826).
+// Zone = tiles within 4 of a visible enemy Heart within 6 whose dash is ready within a round (unknown = ready). A Heart stunned now is
+// left out (bit 1 alone) or kept when it can still act before my next turn (bit 2, combat::hdr_stun_acts_first). Outside: no walk
+// ends in it. Inside with a free tile outside one step away: pinned, and the turn's walk takes that tile (hdr_step_out, turn tail).
+void hdr_turn_start()
+{
+	mv::hdr_round = -1000;
+	mv::hdr_pin = false;
+	if (!W.alive || W.me.stunned || !ci_layer::me_cassi())
+		return;
+	bitboard z;
+	bool any = false;
+	for (const auto& e : W.enemies)
+	{
+		if (!e.kit || !e.kit->dash_stun || e.kit->slot_dash < 0 || cheb(e.pos, W.me.pos) > 6 || !foe_ready(e, e.kit->slot_dash, 1))
+			continue;
+		if (e.stunned && !(HDR_ON(2) && combat::hdr_stun_acts_first(e)))
+			continue;
+		HDR_CNT(5, e.stunned);
+		z.draw_chebyshev(e.pos, 4.0f);
+		any = true;
+	}
+	if (!any)
+		return;
+	if (bbget(z, W.me.pos))
+	{
+		bool out = false;
+		for (int dx = -1; dx <= 1 && !out; ++dx)
+			for (int dy = -1; dy <= 1 && !out; ++dy)
+			{
+				const vec2 t{ W.me.pos.x + dx, W.me.pos.y + dy };
+				out = (dx || dy) && inb(t) && mv::free_tile(t) && !bbget(z, t);
+			}
+		HDR_CNT(3, !out);
+		if (!out)
+			return; // no way out this turn: today's rules
+		mv::hdr_pin = true;
+	}
+	mv::hdr_bb = z;
+	mv::hdr_round = W.round;
+	HDR_CNT(mv::hdr_pin ? 2 : 1, true);
+}
+bool hdr_step_out()
+{
+	if (!mv::hdr_pinned() || W.me.channeling())
+		return false;
+	const Body* pb = partner_body();
+	vec2 best{ -1, -1 };
+	int bk = 1 << 30;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 t{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!(dx || dy) || !inb(t) || !mv::free_tile(t) || bbget(mv::hdr_bb, t))
+				continue;
+			int md = 99; // ties: toward Issac, else the nearest mate
+			if (pb)
+				md = cheb(pb->pos, t);
+			else
+				for (const auto& al : W.allies)
+					md = std::min(md, cheb(al.pos, t));
+			const int k = (mv::camp_threat(t) > 0 ? 1000 : 0) + md;
+			if (k < bk)
+			{
+				bk = k;
+				best = t;
+			}
+		}
+	if (best.x < 0)
+		return false;
+	const bool ok = mv::try_move(best);
+	HDR_CNT(4, ok);
+	return ok;
+}
+// HDR bit 8: with her nuke on cooldown and a foe seen within 12 (now, or by the team in the last 5 rounds), the stun is her only spell
+// left: it is not spent on a camp (owner replay 01a1c60b r289-301: both spells down while four foes walked in).
+bool hdr_keep_stun(const Kit& k)
+{
+	if (!ci_layer::me_cassi() || k.slot_dmg < 0 || combat::slot_up(k.slot_dmg))
+		return false;
+	bool seen = foe_within(12);
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size() && !seen; ++i)
+	{
+		const int r = intel::team_body_round(i);
+		if (!tt[i].alive || r <= -1000 || W.round - r > 5)
+			continue;
+		const Body* b = intel::team_body(i);
+		seen = b && cheb(b->pos, W.me.pos) <= 12;
+	}
+	HDR_CNT(8, seen);
+	return seen;
+}
