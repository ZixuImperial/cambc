 // A gem group's value as progress toward the win (gem units): my share of its gems capped at the need; gold only counts a tenth on a
 // group with no gems (gold ends no game).
+// b2376 HRP bit 1/2 (caller read the flag): our local power over theirs at the group's anchor (within 8), clamped to [0, 1]; 1 with no foe there.
+float hrp_power(int gi)
+{
+	float ours = 0, theirs = 0;
+	combat::local_power_at(M.groups[static_cast<std::size_t>(gi)].anchor, 8, ours, theirs);
+	if (!(theirs > 0.0f))
+		return 1.0f;
+	return std::max(0.0f, std::min(1.0f, ours / theirs));
+}
+// b2376 HRP bit 4 (caller read the flag): no foe within 5 of the group for 20 rounds and none visible within 12 of its anchor.
+static bool hrp_open(int gi)
+{
+	if (now() - mem[static_cast<std::size_t>(gi)].enemy_seen <= 20)
+		return false;
+	const vec2 a = M.groups[static_cast<std::size_t>(gi)].anchor;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, a) <= 12)
+			return false;
+	return true;
+}
