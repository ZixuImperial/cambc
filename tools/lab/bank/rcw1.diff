+// RCW: a seen foe whose ready damage spell of range >= 4 (area: range + radius) reaches me from d; bit 4 also needs that spell to be >= 40%
+// of my effective HP.
+static __attribute__((noinline)) bool rcw_in_cast_range(const Foe& f, int d)
+{
+	if (f.idx < 0 || f.remembered)
+		return false;
+	const Body& e = assess_enemy(f.idx);
+	if (!e.kit || !e.kit->valid)
+		return false;
+	const Kit& k = *e.kit;
+	float best = 0.0f;
+	auto s = [&](int slot, float mod, float range, float radius) {
+		if (slot < 0 || mod <= 0.0f)
+			return;
+		const int r = static_cast<int>(range + radius);
+		if (r < 4 || d > r || !kit_rules::slot_ready(e, slot))
+			return;
+		best = std::max(best, mod * e.foc);
+	};
+	s(k.slot_dmg, k.dmg_mod, k.dmg_range, 0.0f);
+	s(k.slot_cc, k.cc_mod, k.cc_range, 0.0f);
+	s(k.slot_aoe, k.aoe_mod, k.aoe_range, k.aoe_radius);
+	if (best <= 0.0f)
+		return false;
+	return RCW_ON(1) || best * kit_rules::passive_mult(e) >= 0.4f * eff_hp(W.me);
+}
