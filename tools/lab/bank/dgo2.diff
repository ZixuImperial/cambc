+// b2412 DGO bit 2 (the caller reads the flag): a calm turn: no visible foe within TD_FOE_R, no remembered sighting younger than
+// DGO_AGE rounds within DGO_R.
+bool dgo_calm()
+{
+	const vec2 me = W.me.pos;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, me) <= tune::TD_FOE_R)
+			return false;
+	for (const auto& s : combat::seen)
+		if (static_cast<int>(W.round) - s.round < static_cast<int>(DGO_TAB[2]) && cheb(s.foe.pos, me) <= static_cast<int>(DGO_TAB[3]))
+			return false;
+	return true;
