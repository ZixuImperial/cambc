+		{
+			const vec2 q{ t.x + dx, t.y + dy };
+			if (!inb(q) || bbget(M.my_spawn, q) || bbget(M.walls, q) || bbget(M.holes, q) || bbget(M.altars_bb, q))
+				continue;
