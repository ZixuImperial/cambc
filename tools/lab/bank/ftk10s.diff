 // Map analysis and the setup, spread over the first turns. True: no fuel left for a turn this round.
+// v8xx FTK bit 2: boards of at most FTK_TAB[3] tiles (the layout's size, known before the analysis); larger boards cut turns 1-3 at a low keep.
+static __attribute__((noinline)) bool ftk_small()
+{
+	const auto L = cambc::detail::layout();
+	return static_cast<long>(L.width) * static_cast<long>(L.height) <= static_cast<long>(FTK_TAB[3]);
+}
 template <int DM> NOVA_INLINE bool setup_stage()
 {
 	if (!M.ready())
 	{
 		// Static analysis is spread over the first turns; champions wait on spawn meanwhile.
 		M.lean = true;
 		M.pause_at_ready = true;
 		comms::bcl_prebuild(); // v7xx BCP1
-		M.init(25000);
+		M.init(FTK_ON(1) && (!FTK_ON(2) || ftk_small()) ? static_cast<long>(FTK_TAB[2]) : 25000L); // v8xx FTK: the first turns' analysis keep
 		PROF("init");
 		if (!M.ready())
 		{
 			prestep_turn();
 			return true;
 		}
