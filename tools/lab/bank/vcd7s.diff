+// VCD bit 8: a ranged body walking to bring a living camp of group gi into range: among the goal tiles nearest to me (Chebyshev), a free
+// dead camp tile of the group (no awake camp hits it) is preferred, so the capture starts when the last camp dies. goals is narrowed
+// to those tiles; false (goals untouched) when there is none.
+static __attribute__((noinline)) bool vcd_region_goals(int gi, bitboard& goals)
+{
+	if (!W.me.kit || !W.me.kit->ranged || !W.can_move() || fuel() < 15000)
+		return false;
+	const vec2 me = W.me.pos;
+	int dmin = 99;
+	bbforeach(goals, [&](vec2 t) { dmin = std::min(dmin, cheb(me, t)); });
+	if (dmin <= 0 || dmin >= 99)
+		return false;
+	bitboard pick;
+	bool any = false;
+	for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+	{
+		const vec2 p = M.camps[static_cast<std::size_t>(ci)].pos;
+		if (camp_alive_now(ci) || !bbget(goals, p) || cheb(me, p) != dmin || !mv::free_tile(p) || mv::camp_threat(p, -1) > 0.0f)
+			continue;
+		bbset(pick, p);
+		any = true;
+	}
+	if (!any)
+		return false;
+	goals = pick;
+	VCD_CNT(8, true);
+	return true;
+}
