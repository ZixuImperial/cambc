+std::vector<std::uint8_t> pgx_lost; // PGX: events per group
+std::vector<int> pgx_last;          // PGX: the round of the last one
+int pgx_walk_gems = -1;             // PGX: the walkable gems of the map (the half-share test)
+NOVA_INLINE bool pgx_ready()
+{
+	if (pgx_lost.size() != static_cast<std::size_t>(M.ng))
+	{
+		pgx_lost.assign(static_cast<std::size_t>(M.ng), 0);
+		pgx_last.assign(static_cast<std::size_t>(M.ng), -1000);
+	}
+	return M.ng > 0;
+}
+NOVA_INLINE int pgx_lost_now(int gi)
+{
+	const auto gu = static_cast<std::size_t>(gi);
+	if (pgx_lost[gu] && W.round - pgx_last[gu] > PGX_TAB[4] * std::max(1, M.groups[gu].respawn))
+		pgx_lost[gu] = 0;
+	return pgx_lost[gu];
+}
 } // namespace
+bool pgx_rec_on() { return W.me.kit && prism_layer::me(); }
+void pgx_event(int gi)
+{
+	if (gi < 0 || gi >= M.ng || !pgx_ready())
+		return;
+	const auto gu = static_cast<std::size_t>(gi);
+	if (W.round - pgx_last[gu] <= 2)
+		return; // the same loss seen by two readers
+	if (pgx_lost_now(gi) < 9)
+		++pgx_lost[gu];
+	pgx_last[gu] = W.round;
+}
+void pgx_won(int gi)
+{
+	if (gi >= 0 && gi < M.ng && pgx_ready())
+		pgx_lost[static_cast<std::size_t>(gi)] = 0;
+}
+float pgx_factor(int gi)
+{
+	if (gi < 0 || gi >= M.ng || !pgx_ready() || pgx_lost_now(gi) == 0)
+		return 1.0f;
+	if (pgx_walk_gems < 0)
+	{
+		pgx_walk_gems = 0;
+		for (const auto& g : M.groups)
+			if (g.access == ACC_WALK)
+				pgx_walk_gems += g.gems;
+	}
+	if (2 * M.groups[static_cast<std::size_t>(gi)].gems >= pgx_walk_gems)
+		return 1.0f; // the main gem source is never discounted
+	return static_cast<float>(pgx_lost[static_cast<std::size_t>(gi)] >= 2 ? PGX_TAB[3] : PGX_TAB[2]) / 100.0f;
+}
