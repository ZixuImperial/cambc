+// b2408 PPW bit 1 (the caller read the flag): EPB writer (non-Prism bodies) and reader age (every body).
+static std::uint32_t epb_v = 0;
+static int epb_since = -1000;
+void epb_turn()
+{
+	if (!comms::epb_f.ok())
+		return;
+	if (W.alive && W.me.kit && !prism::me_prism() && P.my_slot >= 0 && P.my_slot < 8)
+	{
+		int bag = -1;
+		for (const auto& e : W.enemies)
+			if (e.type == cambc::champion_type::prism && e.hp > 0)
+			{
+				bag = static_cast<int>(e.gems);
+				break;
+			}
+		const std::uint32_t cur = comms::spare_get(comms::epb_f);
+		if (bag >= 0)
+		{
+			const std::uint32_t band = bag < 50 ? 1u : bag < 100 ? 2u : bag < 150 ? 3u : bag < 250 ? 4u : bag < 400 ? 5u : bag < 600 ? 6u : 7u;
+			const std::uint32_t want = band | (static_cast<std::uint32_t>(P.my_slot) << 3);
+			if (want != cur)
+				comms::spare_put(comms::epb_f, want);
+		}
+		else if (cur != 0 && static_cast<int>(cur >> 3) == P.my_slot)
+			comms::spare_put(comms::epb_f, 0); // my sighting is gone
+	}
+	const std::uint32_t v = comms::spare_get(comms::epb_f);
+	if (v != epb_v)
+	{
+		epb_v = v;
+		epb_since = now();
+	}
+}
+// b2408 PPW bit 1 reader (the caller read the flag): our Prism, seeing no enemy Prism herself, adds a phantom one at the writer's tile to
+// her walk guard when the reported bag's two-cast burst exceeds her HP + shield.
+void ppw_phantom(std::vector<std::pair<vec2, int>>& out)
+{
+	if (!comms::epb_f.ok() || !W.alive || !prism::me_prism() || (epb_v & 7u) == 0 || now() - epb_since > PPW_TAB[3])
+		return; // RC C1368: an unchanged entry of a living writer is a standing sighting; only the long safety cap ages it
+	for (const auto& e : W.enemies)
+		if (e.type == cambc::champion_type::prism)
+			return; // she sees one: her own zones decide
+	const int s = static_cast<int>(epb_v >> 3);
+	if (s == P.my_slot || s >= P.n || !siege_ally_alive(s))
+		return; // RC C1368: a dead writer's entry is void
+	static constexpr int lo[8] = { 0, 25, 75, 125, 200, 325, 500, 700 }; // RC C1368: the band's midpoint bag (band 7: 700)
+	const Kit& pk = kit_of(cambc::champion_type::prism); // her two casts at base Focus plus the bag's (GR:564-574)
+	const float pfoc = pk.foc + static_cast<float>(PPW_FPG_X10 * lo[epb_v & 7u]) / 10.0f;
+	const float burst = (pk.dmg_mod + pk.aoe_mod) * pfoc;
+	if (!(mu::mult_foe_hit_to_real_hp(burst) > W.me.hp + W.me.shield))
+		return;
+	vec2 p{ -1, -1 };
+	if (const Body* b = W.ally_by_slot(s))
+		p = b->pos;
+	else
+	{
+		const int gi = comms::cgroup(s);
+		if (gi >= 0 && gi < M.ng)
+			p = M.groups[static_cast<std::size_t>(gi)].anchor;
+	}
+	if (p.x < 0)
+		return;
+	out.emplace_back(p, PPW_TAB[2]);
+}
