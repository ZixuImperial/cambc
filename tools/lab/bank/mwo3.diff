+// b2329 MWO1 (caller reads the flag): the living attackers' strength as noted at group g's last hp_left observation, else g.str_sum.
+static float mwo_living_str(const GroupI& g, const GroupMem& m)
+{
+	const std::size_t gi = static_cast<std::size_t>(g.idx);
+	if (m.status != GS_ALIVE || m.hp_left < 0 || gi >= bgx_gn.size() || bgx_gn[gi] < 0 || gi >= bgx_att.size())
+		return g.str_sum;
+	float s = 0;
+	for (int i = 0; i < bgx_gn[gi]; ++i)
+		s += bgx_att[gi][static_cast<std::size_t>(i)].second;
+	return s;
+}
+// b2329 MWO1: trips for camp damage dmg at a per-trip budget b when each non-final trip also pays the walk-out w (the final trip
+// recalls out of reach without one): 1 + ceil((dmg - b) / (b - w)); 1e9 when infeasible or over tmax.
+static float mwo_trips(float dmg, float b, float w, int tmax)
+{
+	if (b <= 0.0f)
+		return 1e9f;
+	if (dmg <= b)
+		return 1.0f;
+	if (b - w <= 0.0f || (dmg - b) > (b - w) * static_cast<float>(tmax))
+		return 1e9f; // no int cast of a huge ratio
+	return 1.0f + std::ceil((dmg - b) / (b - w));
 }
