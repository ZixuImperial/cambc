+		bitboard visited, root;
+		bbset(root, e.pos);
+		auto& f = pool[static_cast<std::size_t>(i)];
+		if (!f)
+			f = std::make_unique<distance_field>();
+		f->compute((dasher ? b_walls : b_holes) & ~root, root, visited, 48);
+	}
+	return pool;
+}
