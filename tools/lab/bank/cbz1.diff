diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -1307,6 +1307,12 @@ inline constexpr int DDT_TAB[2] = { 0x44445431, DDT_BITS }; // slot 0 magic keep
 inline constexpr int NSG_TAB[2] = { 0x4E534731, NSG_BITS }; // slot 0 magic keeps it out of .bss
 // b2169 SVR (RC C606, was EGR1): a same-code re-post whose word would not change (cmp_ent == v) takes the other entry when it is empty
 // or stood 2+ rounds, else is not posted (bh64_lp_drop / false, the retry lands at an odd gap). Bit 1 HELP + FIGHT, bit 2 ENEMY news.
 // v817 SVR: same-word HELP/FIGHT re-post not lost (SVR)
 #define SVR_BITS 1
 inline constexpr int SVR_TAB[2] = { 0x53565231, SVR_BITS }; // slot 0 magic keeps it out of .bss
+// b2183 CBZ (RC X613 CBZ1): chip_clear_share copied tank_turn's bail at escape steps + 1.5, but v774 BLX moved every camp bail line
+// (tank_bail_out, camp_holder_bail, crew_mates_in_reach, crew_bail) to steps + BLX_M10/10 = steps + 0. Bit 1: the chip model bails
+// at steps + BLX_TAB[2]/10 too (chip_start_partial_clear, the rate_crew chip trip, wait_chip_target). 0 = v817.
+#define CBZ_BITS 0
+inline const volatile int CBZ_TAB[2] = { 0x43425A31, CBZ_BITS }; // slot 0 magic keeps it out of .bss
+#define CBZ_ON(b) ((CBZ_TAB[1] & (b)) != 0)
