+// IGD (caller read the flag): a foe's one-turn kit reach (the econ foe model's foe_reach_in_turns(e, 1)).
+static int igd_reach1(const Body& e)
+{
+	const Kit* k = e.kit;
+	int r = std::max(e.range, 1) + 3;
+	if (k && k->valid)
+	{
+		r = k->ranged ? std::max(e.range, 1) + 1 - (k->slot_reset >= 0 ? 0 : 1) : std::max(e.range, 1) + 1;
+		auto sp = [&](int slot, float range, float radius, bool excl)
+		{
+			if (slot >= 0)
+				r = std::max(r, static_cast<int>(range + radius) + 1 - (excl ? 1 : 0));
+		};
+		sp(k->slot_dmg, k->dmg_range, 0.0f, k->dmg_excl);
+		sp(k->slot_cc, k->cc_range, 0.0f, k->cc_excl);
+		sp(k->slot_aoe, k->aoe_range, k->aoe_radius, k->aoe_excl);
+		if (k->slot_dash >= 0)
+			r += 2;
+	}
+	return r;
+}
+// IGD (caller read the flag; Issac, a dash that doesn't kill): refuse the gap dash to landing L.
+static __attribute__((noinline)) bool igd_refuse(vec2 L)
+{
+	if (IGD_ON(4) && W.me.frac() * 100.0f < static_cast<float>(IGD_TAB[3]))
+		return true;
+	if (!IGD_ON(1))
+		return false;
+	float sum = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, L);
+		if (d > igd_reach1(e))
+			continue;
+		const float t1 = burst::lethal_burst_hit(e, d, 0, nullptr);
+		sum += stance::foe_turns_within_rounds(e, 2) >= 2 ? burst::foe_two_turn_damage(e, d, t1) : t1;
+	}
+	for (const auto& s : seen)
+	{
+		const int age = W.round - s.round;
+		if (age < 1 || age > 3)
+			continue;
+		bool vis = false;
+		for (const auto& e : W.enemies)
+			vis = vis || e.h == s.h;
+		if (!vis && cheb(s.foe.pos, L) <= std::max(2, s.foe.reach) + age)
+			sum += s.foe.burst;
+	}
+	float bar = eff_hp(W.me);
+	for (const auto& al : W.allies)
+		if (al.type == cambc::champion_type::cassi)
+		{
+			bool in = false;
+			for (const auto& e : W.enemies)
+				in = in || cheb(e.pos, al.pos) <= igd_reach1(e);
+			if (in)
+				bar = std::min(bar, eff_hp(al));
+		}
+	return sum * 100.0f >= static_cast<float>(IGD_TAB[2]) * bar;
+}
