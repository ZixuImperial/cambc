+namespace nova::econ {
+// MBB8 bit 1 RBD1, caller read the flag: a foe in sight channels a game-ending tribute that lands in a round no later than my winning bag
+// would (a tie counts as the foe's unless the turn order says I act first that round). My landing: now + the walk's own steps + my ticks.
+// RC C448: my_land counts the walk's turns as whole turns, so it can read one round late; that errs toward denying (safe side).
+bool rbd_foe_ends_first()
+{
+	const int gems = static_cast<int>(W.me.gems);
+	if (gems <= 0 || W.tributed_us + gems < rs::WIN_TRIBUTE || (W.me.state & ST_TRIBUTE))
+		return false;
+	const std::uint16_t d = bank_dist_here();
+	const int my_land = d == UNREACH ? BIG : W.round + std::max(0, static_cast<int>(d) - 1) + rs::tribute_turns_of(gems, W.me.h, W.round);
+	for (const auto& e : W.enemies)
+	{
+		if (!(e.state & ST_TRIBUTE) || W.tributed_them + static_cast<int>(e.gems) < rs::WIN_TRIBUTE)
+			continue;
+		std::int32_t lf = -1;
+		if (cambc::detail::sdk_champion_channel_time(e.h, &lf) != 0 || lf < 0)
+			continue;
+		const int land = W.round + static_cast<int>(lf) + ((e.state & FLEE_FIX_ST_ACTED) != 0 ? 1 : 0);
+		if (land < my_land || (land == my_land && combat::rbd_me_first(e, land - W.round) != 1))
+			return true;
+	}
+	return false;
+}
