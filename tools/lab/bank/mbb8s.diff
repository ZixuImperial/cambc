+// RBD (b2017, RC X480; GR:122-131, INT:14/21), caller read the flag. A foe whose acted bit differs from enemy_starts(now) is not the one
+// at my place (that pair goes starting team first), so its order against me is the same every round; anything else, or a priority change
+// pending for me, a mate in sight or the foe, is unknown.
+int rbd_me_first(const Body& e, int j)
+{
+	const bool acted = (e.state & FLEE_FIX_ST_ACTED) != 0;
+	if (j <= 0)
+		return acted ? 0 : 1;
+	if (burst::ed_prio_hdt(W.me.h, true) != burst::ed_prio_hdt(W.me.h, false) || burst::ed_prio_hdt(e.h, true) != burst::ed_prio_hdt(e.h, false))
