+	for (const auto& al : W.allies)
+		if (burst::ed_prio_hdt(al.h, true) != burst::ed_prio_hdt(al.h, false))
+			return -1;
+	if (acted == enemy_starts(W.round))
+		return -1;
+	return acted ? 0 : 1;
+}
