+// b2384 MKD bit 1 DENY (combat_flags.h; DNY3's strict gate on heavy monsters). Runs only on a turn a lethal check marked (mkd_round).
+int mkd_round = -1;
+static float mkd_foe_sum(vec2 t)
+{
+	float s = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, t);
+		if (d > 9)
+			continue;
+		float h = burst::lethal_burst_hit(e, d, 0, nullptr);
+		h = burst::stun_takes_next_turn(e) ? 0.0f : burst::reach_burst_turns(e) >= 2 ? burst::lethal_burst_two_turn_hit(e, d, h) : h;
+		s += std::max(0.0f, h);
+	}
+	return s;
+}
+// The heavy camps' hit on me at q at the next camp phase: awake ones, and asleep ones I can hit from q this turn (a hit wakes the group;
+// its first attack is the next camp phase, RC C1018 Q2), each counted only when I am strictly its nearest champion (a foe 1 closer,
+// 3 with a dash kit; a mate at my distance or nearer takes it) and its HP is over 2 x my Strength. *wake: the asleep camp to hit.
+static float mkd_camp_kill_at(vec2 q, int* wake, float* awake_s)
+{
+	float s = 0.0f;
+	*wake = -1;
+	*awake_s = 0.0f;
+	const bool rk = W.me.kit && W.me.kit->ranged && !(W.me.kit->slot_reset >= 0 && ready(W.me.kit->slot_reset)); // RC C1024 (i)
+	for (const auto& vc : W.camps)
+	{
+		if (vc.ci < 0 || static_cast<std::size_t>(vc.ci) >= static_cast<std::size_t>(M.nc))
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (!(c.type == cambc::camp_type::monolith || c.type == cambc::camp_type::golem) || vc.hp <= 2.0f * W.me.str)
+			continue;
+		const int d = cheb(q, c.pos);
+		if (d > c.reach || (!vc.awake && (d > W.me.range || !W.can_attack() || (rk && !(q == W.me.pos)) || (*wake >= 0 && M.camps[static_cast<std::size_t>(*wake)].group != c.group))))
+			continue; // a ranged body that steps loses its basic attack (GR:102) unless a reset is ready
+		bool nearest = true;
+		for (const auto& o : W.allies)
+			if (cheb(o.pos, c.pos) <= d)
+				nearest = false;
+		for (const auto* v : { &W.enemies, &W.enemies_far })
+			for (const auto& e : *v)
+				if (cheb(e.pos, c.pos) - ((e.kit && e.kit->slot_dash >= 0) ? 3 : 1) <= d)
+					nearest = false;
+		if (!nearest)
+			continue;
+		if (!vc.awake)
+			*wake = vc.ci;
+		else
+			*awake_s += c.str * mu::ct_k;
+		s += c.str;
+	}
+	return s * mu::ct_k;
+}
+// Certain death: off spawn, not channeling, no ready dash / shield / heal, no mate within 5 and no mate healer within 8, and the visible
+// foes kill me on my tile and on every free tile one step away (DNY3's test).
+static bool mkd_doomed()
+{
+	if (!W.me.kit || W.on_spawn || W.me.channeling())
+		return false;
+	const Kit& k = *W.me.kit;
+	auto rdy = [&](int sl) { return sl >= 0 && ready(sl); };
+	if (rdy(k.slot_dash) || rdy(k.slot_shield) || rdy(k.slot_heal))
+		return false;
+	const int ls = linked_slot();
+	for (const auto& o : W.allies)
+	{
+		const int d = cheb(o.pos, W.me.pos);
+		if ((d <= 5 && o.slot != ls) || (d <= 8 && o.kit && o.kit->slot_heal >= 0))
+			return false; // my linked partner dies with me (GR:442): it is no save, unless it heals
+	}
+	const float eff = W.me.hp + std::max(0.0f, W.me.shield);
+	if (mkd_foe_sum(W.me.pos) < eff)
+		return false;
+	for (int dy = -1; dy <= 1; ++dy)
+		for (int dx = -1; dx <= 1; ++dx)
+		{
+			const vec2 q{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if ((dx || dy) && inb(q) && mv::free_tile(q) && mkd_foe_sum(q) < eff)
+				return false;
+		}
+	return true;
+}
+bool mkd_die_to_camp()
+{
+	if (!W.alive || W.on_spawn || W.me.channeling())
+		return false;
+	bool near = false; // cheapest test first: a heavy camp within reach + 1
+	for (const auto& vc : W.camps)
+		if (vc.ci >= 0 && static_cast<std::size_t>(vc.ci) < static_cast<std::size_t>(M.nc))
+		{
+			const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+			near = near || ((c.type == cambc::camp_type::monolith || c.type == cambc::camp_type::golem) && cheb(c.pos, W.me.pos) <= c.reach + 1);
+		}
+	if (!near)
+		return false;
+	int bag = static_cast<int>(W.me.gems);
+	const int ls = linked_slot();
+	const Body* pp = ls >= 0 ? W.ally_by_slot(ls) : nullptr;
+	if (pp)
+		bag += static_cast<int>(pp->gems); // a C&I pair dies together, one reward (GR:442)
+	if ((bag < MKD_BAG && !pp) || W.tributed_us + bag >= 1000 || !mkd_doomed())
+		return false;
+	const float eff = W.me.hp + std::max(0.0f, W.me.shield);
+	vec2 best{ -1, -1 };
+	int bw = -1;
+	float bs = 0.0f, ba = 0.0f;
+	for (int dy = -1; dy <= 1; ++dy)
+		for (int dx = -1; dx <= 1; ++dx)
+		{
+			const vec2 q{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!inb(q) || ((dx || dy) && (!W.can_move() || !mv::free_tile(q))))
+				continue;
+			int wk = -1;
+			float as = 0.0f;
+			const float cs = mkd_camp_kill_at(q, &wk, &as);
+			if (cs >= eff && cs > bs)
+			{
+				bs = cs;
+				best = q;
+				bw = wk;
+				ba = as;
+			}
+		}
+	if (best.x < 0)
+		return false;
+	if (!(best == W.me.pos) && !mv::try_move(best))
+		return false;
+	if (bw >= 0 && !hit_camp(bw) && ba < eff)
+		return false; // RC C1024 (ii): the wake failed and the awake camps alone do not kill me: the stages decide
+	if (W.can_attack())
+	{
+		// RC C1024 (iii): trade back on the weakest foe in range (a camp's target does not depend on damage taken)
+		const Body* wf = nullptr;
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, W.me.pos) <= W.me.range && (!wf || e.hp < wf->hp))
+				wf = &e;
+		if (wf)
+			(void)attack_champion(*wf);
+	}
+	return true;
+}
