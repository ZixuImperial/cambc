+// b2384 MKD (combat_flags.h): heavy monsters as a weapon.
+static bool mkd_heavy(const CampI& c) { return c.type == cambc::camp_type::monolith || c.type == cambc::camp_type::golem; }
+// my claim, read once a turn (claim_target clears DTR's dtr_rsp: RC C1024)
+static int mkd_tg()
+{
+	static int r = -1000, v = -1;
+	if (r != W.round)
+	{
+		r = W.round;
+		v = econ::claim_target();
+	}
+	return v;
+}
+static bool mkd_mate_claims(int g)
+{
+	for (int s = 0; s < comms::CLAIM_SLOTS; ++s)
+		if (s != P.my_slot && comms::cgroup(s) == g)
+			return true;
+	return false;
+}
+static int mkd_foe_d(vec2 p)
+{
+	int d = 99;
+	for (const auto* v : { &W.enemies, &W.enemies_far })
+		for (const auto& e : *v)
+			d = std::min(d, cheb(e.pos, p));
+	return d;
+}
+// MKD bit 8 (caller reads MKD_ON(8)): a zone per awake heavy camp outside my target group with an enemy in its reach: the tiles where I
+// would be its nearest (or tied) champion. A zone that already holds me is left out (entry guard only).
+void mkd_feed_zones(std::vector<std::pair<vec2, int>>& z)
+{
+	const int tg = mkd_tg();
+	for (const auto& vc : W.camps)
+	{
+		if (vc.ci < 0 || !vc.awake || static_cast<std::size_t>(vc.ci) >= static_cast<std::size_t>(M.nc))
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (!mkd_heavy(c) || (tg >= 0 && c.group == tg) || mkd_mate_claims(c.group))
+			continue; // RC C1024: a group a mate claims is a crew's farm
+		const int de = mkd_foe_d(c.pos);
+		if (de > c.reach)
+			continue;
+		int r = std::min(c.reach, de);
+		for (const auto& o : W.allies)
+			r = std::min(r, cheb(o.pos, c.pos));
+		if (r < 0 || cheb(W.me.pos, c.pos) <= r)
+			continue;
+		z.emplace_back(c.pos, r);
+	}
+}
+// MKD bit 4 (caller reads MKD_ON(4)): step_out_of_reach's extra score (lowest wins) for flee tile t: per awake heavy camp outside my
+// target group whose reach t is in, +MKD_FLEE_BAD when t makes me its nearest (or tied) champion; -MKD_FLEE_GOOD when a seen enemy
+// in its reach stays strictly nearer to it than t and every seen mate.
+int mkd_flee_term(vec2 t)
+{
+	const int tg = mkd_tg();
+	int sc = 0;
+	for (const auto& vc : W.camps)
+	{
+		if (vc.ci < 0 || !vc.awake || static_cast<std::size_t>(vc.ci) >= static_cast<std::size_t>(M.nc))
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		const int dt = cheb(t, c.pos);
+		if (!mkd_heavy(c) || (tg >= 0 && c.group == tg) || dt > c.reach + 1)
+			continue;
+		int de = 99;
+		for (const auto& e : W.enemies)
+			de = std::min(de, cheb(e.pos, c.pos));
+		int du = dt;
+		for (const auto& o : W.allies)
+			du = std::min(du, cheb(o.pos, c.pos));
+		if (dt <= c.reach && dt <= de && dt <= du)
+			sc += MKD_FLEE_BAD;
+		else if (de <= c.reach && de < du)
+			sc -= MKD_FLEE_GOOD;
+	}
+	return sc;
+}
+// MKD bit 2 (caller reads MKD_ON(2)): at my turn's end. True if I hit a camp.
+bool mkd_wake_on_them()
+{
+	if (!W.alive || W.me.channeling() || !W.can_attack())
+		return false;
+	const int tg = mkd_tg();
+	for (const auto& vc : W.camps)
+	{
+		if (vc.ci < 0 || vc.awake || static_cast<std::size_t>(vc.ci) >= static_cast<std::size_t>(M.nc))
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (!mkd_heavy(c) || cheb(W.me.pos, c.pos) > W.me.range || c.group < 0 || c.group >= M.ng || c.group == tg)
+			continue;
+		if (mkd_mate_claims(c.group))
+			continue;
+		// every attacking member of the group wakes: none may pick one of ours (ties ours), and at least one picks a seen enemy in reach
+		bool ok = true, hits = false;
+		int far = 0;
+		for (int mi : M.groups[static_cast<std::size_t>(c.group)].members)
+		{
+			const auto& m = M.camps[static_cast<std::size_t>(mi)];
+			if (!m.attacks() || !bbget(W.occ_camps, m.pos))
+				continue; // RC C1024 B: a dead member does not wake
+			int de = 99, dm = 99; // raw, and after the foe's move before the camp phase (1, 3 with a dash kit; 0 channelling: RC C1024 A)
+			for (const auto& e : W.enemies)
+			{
+				const int d = cheb(e.pos, m.pos);
+				de = std::min(de, d);
+				dm = std::min(dm, d + (e.channeling() ? 0 : ((e.kit && e.kit->slot_dash >= 0) ? 3 : 1)));
+			}
+			int du = cheb(W.me.pos, m.pos);
+			for (const auto& o : W.allies)
+				du = std::min(du, cheb(o.pos, m.pos));
+			if (du <= m.reach && (du <= de || du <= dm))
+				ok = false;
+			if (de <= m.reach && dm < du)
+				hits = true;
+			far = std::max(far, m.reach);
+		}
+		if (!ok || !hits || !attack_camp(vc.ci))
+			continue; // RC C1024 C: one hit wakes the group; no reset spent
+		if (W.can_move() && cheb(W.me.pos, c.pos) <= far + 1)
+		{
+			// step farther from it (Path Finding: stay strictly farther than the foe next turn)
+			vec2 bq{ -1, -1 };
+			int bd = cheb(W.me.pos, c.pos);
+			for (int dy = -1; dy <= 1; ++dy)
+				for (int dx = -1; dx <= 1; ++dx)
+				{
+					const vec2 q{ W.me.pos.x + dx, W.me.pos.y + dy };
+					if ((dx || dy) && inb(q) && mv::free_tile(q) && !mv::foe_guarded(q) && cheb(q, c.pos) > bd)
+					{
+						bd = cheb(q, c.pos);
+						bq = q;
+					}
+				}
+			if (bq.x >= 0)
+				(void)mv::try_move(bq);
+		}
+		return true;
+	}
+	return false;
+}
