 // v904 LDS: LDS spawn-to-spawn landing step (fp)
 #define LDS_BITS 1
 inline constexpr int LDS_TAB[2] = { 0x4C445331, LDS_BITS }; // slot 0 magic keeps it out of .bss
+// b2379 WTS (Combat spec_wts_1113.md): a ranged walk ends in shot range when the reset is ready, so the existing walk shot
