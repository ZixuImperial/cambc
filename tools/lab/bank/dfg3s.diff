+			if (g == -2 || fuel() < dfg::floor_f)
+				ok = false;
+			if (g >= M.ng)
+				g = -1;
+			int crew = 0; // drafted into a crew: a body earlier in the simulation order holds the same group
+			if (g >= 0)
