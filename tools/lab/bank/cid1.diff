+// CID (b2347; callers read CID_ON first): am I a roster carry (the first two fielded of Prism, Vesper, Marcella)?
+__attribute__((noinline)) bool cid_carry()
+{
+	static int v = -1;
+	if (v < 0)
+	{
+		v = 0;
+		int n = 0;
+		const cambc::champion_type pri[3] = { cambc::champion_type::prism, cambc::champion_type::vesper_vale, cambc::champion_type::marcella };
+		for (const auto t : pri)
+			for (int s = 0; s < P.n && s < 8 && n < 2; ++s)
+				if (P.type[static_cast<std::size_t>(s)] == t)
+				{
+					if (s == P.my_slot)
+						v = 1;
+					++n;
+					break;
+				}
+	}
+	return v == 1;
+}
+// CID bit 1 (rate form, Planner): does a free live group I clear alone beat the awaited group gi? Its value / (walk + clear) against gi's
+// value / (max(respawn left, walk) + clear), both with my own crew (estimate, crew 1).
+__attribute__((noinline)) bool cid_live_beats(int gi, int left, int walk)
+{
+	build_team(false);
+	if (travel_round != now() || travel_from != W.me.pos)
+		compute_travel();
+	const Claims cl = claims_for_me();
+	const auto& g0 = M.groups[static_cast<std::size_t>(gi)];
+	const ClearEst e0 = estimate_cx(1, g0, mem[static_cast<std::size_t>(gi)], crew_for_ref(gi, my_slot(), 0, cl));
+	const float r0 = group_value(g0, gi, my_slot()) / std::max(1.0f, static_cast<float>(std::max(left, walk)) + e0.t);
+	static std::vector<std::pair<int, int>> near; // RC C916c note 1: the CID_NG nearest live groups by my walk
+	near.clear();
+	for (int x = 0; x < M.ng; ++x)
+	{
+		if (x == gi)
+			continue;
+		const auto& m = mem[static_cast<std::size_t>(x)];
+		const std::uint16_t tr = travel[static_cast<std::size_t>(x)];
+		if (m.status == GS_ALIVE && tr != UNREACH && M.groups[static_cast<std::size_t>(x)].access == ACC_WALK && m.fail_until <= now())
+			near.push_back({ static_cast<int>(tr), x });
+	}
+	if (near.size() > static_cast<std::size_t>(CID_NG))
+	{
+		std::nth_element(near.begin(), near.begin() + CID_NG, near.end());
+		near.resize(static_cast<std::size_t>(CID_NG));
+	}
+	for (const auto& pr : near)
+	{
+		const int x = pr.second;
+		const auto& g = M.groups[static_cast<std::size_t>(x)];
+		const auto& m = mem[static_cast<std::size_t>(x)];
+		const std::uint16_t tr = travel[static_cast<std::size_t>(x)];
+		if (!reachable_target(x) || sg_big(g))
+			continue;
+		const float v = group_value(g, x, my_slot());
+		if (v / std::max(1.0f, static_cast<float>(tr)) <= r0) // the bound: walk alone
+			continue;
+		if (claimants(x, my_slot(), cl) > 0)
+			continue;
+		const ClearEst e = estimate_cx(1, g, m, crew_for_ref(x, my_slot(), 0, cl));
+		if (e.feasible && v / std::max(1.0f, static_cast<float>(tr) + e.t) > r0)
+			return true;
+	}
+	return false;
+}
+// CID bit 2: a free live group within CID_NEAR of me that I clear alone; sets it as my target until `until` (the filler form). True when taken.
+__attribute__((noinline)) bool cid_solo_near(int wait_gi, int until)
+{
+	build_team(false);
+	if (travel_round != now() || travel_from != W.me.pos)
+		compute_travel();
+	const Claims cl = claims_for_me();
+	int best = -1;
+	float best_v = 0, best_r = 0;
+	for (int gi = 0; gi < M.ng; ++gi)
+	{
+		if (gi == wait_gi)
+			continue;
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		const auto& m = mem[static_cast<std::size_t>(gi)];
+		const std::uint16_t tr = travel[static_cast<std::size_t>(gi)];
+		if (m.status != GS_ALIVE || tr == UNREACH || static_cast<int>(tr) > CID_NEAR || g.access != ACC_WALK || m.fail_until > now() || !reachable_target(gi) || sg_big(g))
+			continue;
+		if (claimants(gi, my_slot(), cl) > 0)
+			continue;
+		const float v = group_value(g, gi, my_slot());
+		if (v <= best_v)
+			continue;
+		const ClearEst e = estimate_cx(1, g, m, crew_for_ref(gi, my_slot(), 0, cl));
+		if (!e.feasible)
+			continue;
+		best_v = v;
+		best = gi;
+		best_r = v / std::max(1.0f, static_cast<float>(tr) + e.t);
+	}
+	if (best < 0)
+		return false;
+	set_target(best, best_r, 1);
+	T.filler_until = until; // RC C916 FIX 2: the filler form, back to the awaited group after
+	return true;
+}
