+// OCF bit 1 (the caller read the flag): the primary carry in the owner's order: Prism, else Vesper, else Marcella (-1 none).
+static int ocf_primary()
+{
+	if (OCF_ON(16)) // b2365 OCF-M: Marcella first only when she is the primary (no Prism, no Vesper fielded); otherwise live's first body
+	{
+		int ma = -1;
+		for (int s = 0; s < P.n; ++s)
+		{
+			const auto t = P.type[static_cast<std::size_t>(s)];
+			if (t == cambc::champion_type::prism || t == cambc::champion_type::vesper_vale)
+				return P.carrier_gold;
+			if (t == cambc::champion_type::marcella)
+				ma = s;
+		}
+		return ma >= 0 ? ma : P.carrier_gold;
+	}
+	if (OCF_ON(8)) // b2365 OCF-P: Prism first only when she is fielded; otherwise live's first body (the gold carrier, -1 = tank order)
+	{
+		for (int s = 0; s < P.n; ++s)
+			if (P.type[static_cast<std::size_t>(s)] == cambc::champion_type::prism)
+				return s;
+		return P.carrier_gold;
+	}
+	if (P.carrier_gems >= 0 && P.carrier_gems < P.n && kit_of(P.type[static_cast<std::size_t>(P.carrier_gems)]).gem_focus)
+		return P.carrier_gems;
+	if (P.carrier_gold >= 0)
+		return P.carrier_gold;
+	return P.carrier_gems;
+}
+// OCF bit 4 (the caller read the flag): our Vendetta's slot, -1 none.
+static int ocf_vendetta()
+{
+	for (int s = 0; s < P.n; ++s)
+		if (P.type[static_cast<std::size_t>(s)] == cambc::champion_type::vendetta)
+			return s;
+	return -1;
+}
+// OCF bits 1 / 4 (the caller read the flag): the opening order with the primary carry first (bit 1, else live's gold carrier) and our
+// Vendetta second (bit 4), then by_tank without them.
+static int ocf_body_at(int i)
+{
+	const int first = OCF_ON(25) ? ocf_primary() : P.carrier_gold;
+	if (first < 0 || first >= TM.n)
+		return TM.by_tank[static_cast<std::size_t>(i)];
+	if (i == 0)
+		return first;
+	const int second = OCF_ON(4) ? ocf_vendetta() : -1;
+	const bool has2 = second >= 0 && second < TM.n && second != first;
+	if (has2 && i == 1)
+		return second;
+	int k = has2 ? 1 : 0;
+	for (int j = 0; j < TM.n; ++j)
+	{
+		const int s = TM.by_tank[static_cast<std::size_t>(j)];
+		if (s == first || (has2 && s == second))
+			continue;
+		if (++k == i)
+			return s;
+	}
+	return TM.by_tank[static_cast<std::size_t>(i)];
+}
 // the body at position i of the opening simulation: by_tank order, or with bit 1 the gold carrier first, then by_tank without her.
