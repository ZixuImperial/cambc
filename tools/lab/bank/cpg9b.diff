+// CPG (b1743, 04lines-type cut fix): camp-work steps checked against their own measured peak cost. Runtime data flag, read first;
+// 0 = live. Each body keeps the most fuel one call of the step has cost it (no fade); the step is skipped this turn when the fuel
+// left is under that peak + CPG_TAIL (the rest of the turn). Bit 1: heart_dash_try_slow (its floor HD_MIN_FUEL stays the minimum).
+// Bit 2: hold_capture_slow's spell on a foe. Bit 4: hit_claimed_camp_in_range_slow. Bit 8: squad_partner_retarget's cost meter
+// keeps its peak on a measured call (it fades only while skipped), so a cheap check does not let the next costly one cut the turn.
+#define CPG_BITS 0
+#define CPG_TAIL 5000
+inline const volatile int CPG_TAB[3] = { 0x43504731, CPG_BITS, CPG_TAIL }; // slot 0 magic keeps it out of .bss
+#define CPG_ON(b) ((CPG_TAB[1] & (b)) != 0)
+inline long cpg_peak[3] = { 0, 0, 0 }; // measured peak per step: 0 heart dash, 1 hold spell, 2 claimed camp hit
+struct CpgMeter // measures one call's cost into cpg_peak[i] when armed (f0 >= 0)
+{
+	int i;
+	long f0;
+	~CpgMeter()
+	{
+		if (f0 >= 0)
+		{
+			const long u = f0 - static_cast<long>(static_cast<std::uint64_t>(cambc::detail::sdk_fuel_remaining()));
+			if (u > cpg_peak[i])
+				cpg_peak[i] = u;
+		}
+	}
+};
+#define CPG_SKIP(i) (fuel() < cpg_peak[i] + static_cast<long>(CPG_TAB[2]))
