 #define EPW_MAX 70000
 inline constexpr int EPW_TAB[5] = { 0x45505731, EPW_BITS, EPW_F0, EPW_DIV, EPW_MAX }; // slot 0 magic keeps it out of .bss
+
+// HSF (b1989, RC X436 HSF1, bug bar): home_steps (move_retreat.cc) fell back to cheb(p, home) for a tile walk-cut from home (dfget
+// UNREACH), so a hole-ringed island read as near home for every caller (dash_landing, escape_dash_end_tile, flee/retreat steps,
+// lethal-burst escape, crystal escape, home_close/flee_rally/react_rally). Bit 1: an UNREACH tile reads M.w * M.h + cheb (beyond every
+// walk distance; cheb keeps the order among walk-cut tiles). Runtime data flag, read first; 0 = off.
+#define HSF_BITS 0
+inline const volatile int HSF_TAB[2] = { 0x48534631, HSF_BITS }; // slot 0 magic keeps it out of .bss
+#define HSF_ON(b) ((HSF_TAB[1] & (b)) != 0)
