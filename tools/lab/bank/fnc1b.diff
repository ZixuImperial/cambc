+// ---------------------------------------------------------------- v8xx FNC: fresh claimed mates crew a golem group (see econ_flags.h).
+// Reached only with FNC_BITS set.
+namespace nova::econ::fresh_crew
+{
+namespace
+{
+namespace E = nova::econ;
+int fnc_r = -1;                 // round of fnc_me
+bool fnc_me = false;            // I am fresh this round
+int fnc_took_r = -1;            // round of fnc_took_g
+std::vector<int> fnc_took_g;    // groups whose feasible crew held an FNC mate this round
+bool fnc_hit = false;           // ok() admitted a mate since the last count()
+__attribute__((noinline)) void fnc_mark_ok() { __asm__ volatile(""); }
+__attribute__((noinline)) void fnc_mark_took() { __asm__ volatile(""); }
+__attribute__((noinline)) void fnc_mark_pick() { __asm__ volatile(""); }
+__attribute__((noinline)) void fnc_mark_b2() { __asm__ volatile(""); }
+bool near_spawn(vec2 p)
+{
+	bool f = false;
+	bbforeach_near(M.my_spawn, p, FNC_SPN, [&](vec2) { f = true; });
+	return f;
+}
+// the class key (static, from M): golem camp, no monolith, walkable, d_home > 8, not a gate, open gem share >= .15 (as nsg_class)
+bool key(int gi)
+{
+	static std::vector<signed char> c;
+	static int open_ok = -1;
+	if (!M.done() || gi < 0 || gi >= M.ng)
+		return false;
+	if (open_ok < 0)
+	{
+		float all = 0, open = 0;
+		for (const auto& q : M.groups)
+		{
+			all += static_cast<float>(q.gems);
+			if (q.n_mono + q.n_golem == 0)
+				open += static_cast<float>(q.gems);
+		}
+		open_ok = (all <= 0.0f || open / all >= 0.15f) ? 1 : 0;
+		c.assign(static_cast<std::size_t>(M.ng), -1);
+	}
+	auto& v = c[static_cast<std::size_t>(gi)];
+	if (v < 0)
+	{
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		v = (open_ok && g.n_golem > 0 && g.n_mono == 0 && g.access == ACC_WALK && g.d_home != UNREACH && static_cast<int>(g.d_home) > 8 &&
+				std::find(M.gate_groups.begin(), M.gate_groups.end(), gi) == M.gate_groups.end()) ? 1 : 0;
+	}
+	return v > 0;
+}
+// G alive and unhit as memory knows; bit 2: no foe seen within FNC_FOE of it
+bool group_ok(int gi)
+{
+	if (!key(gi))
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const auto& m = E::mem[static_cast<std::size_t>(gi)];
+	if (m.status == GS_CLEARED || m.status == GS_RESPAWN || !(m.hp_left < 0 || m.hp_left >= g.hp))
+		return false;
+	if (FNC_ON(2))
+	{
+		if (now() - m.enemy_seen < FNC_FOE)
+			return false;
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, g.anchor) <= FNC_FOE)
+				return false;
+		for (const auto& e : W.enemies_far)
+			if (cheb(e.pos, g.anchor) <= FNC_FOE)
+				return false;
+		fnc_mark_b2();
+	}
+	return true;
+}
+// I am fresh (cached per round)
+bool me_fresh()
+{
+	if (fnc_r != now())
+	{
+		fnc_r = now();
+		fnc_me = E::opened && !E::TM.base && W.me.frac() >= 0.9f && !W.me.channeling() && !E::T.engaged && near_spawn(W.me.pos);
+	}
+	return fnc_me;
+}
+// a visible mate within 8 of me, fresh, claiming a group other than gi
+bool mate_fresh(const Body& a, int gi, int cg)
+{
+	const int s = a.slot;
+	if (s < 0 || s >= E::TM.n || s >= 8 || s == E::my_slot() || cg < 0 || cg >= M.ng || cg == gi)
+		return false;
+	const auto ss = static_cast<std::size_t>(s);
+	return !E::TM.busy[ss] && !a.channeling() && comms::ckind(s) != 4 && cheb(a.pos, W.me.pos) <= 8 && a.frac() >= 0.9f &&
+		now() - E::sen_since[ss] <= FNC_AGE && near_spawn(a.pos) && E::siege_ally_alive(s);
+}
+} // namespace
+int count(int gi, const std::array<int, 8>& cl)
+{
+	fnc_hit = false;
+	if (!me_fresh() || !group_ok(gi))
+		return 0;
+	int n = 0;
+	for (const auto& a : W.allies)
+		if (a.slot >= 0 && a.slot < E::TM.n && a.slot < 8 && mate_fresh(a, gi, cl[static_cast<std::size_t>(a.slot)]) &&
+			E::TM.claim[static_cast<std::size_t>(a.slot)] >= 0 && nova::econ::crew_bypass::far_claim(a, E::TM.claim[static_cast<std::size_t>(a.slot)]) < 0) // BYC's count already holds it
+			++n;
+	return n;
+}
+bool ok(int s, int gi, int cg)
+{
+	const Body* a = W.ally_by_slot(s);
+	if (!a || gi < 0 || gi >= M.ng || !me_fresh() || !mate_fresh(*a, gi, cg) || !group_ok(gi))
+		return false;
+	fnc_hit = true;
+	fnc_mark_ok();
+	return true;
+}
+void took(int gi)
+{
+	if (!fnc_hit)
+		return;
+	if (fnc_took_r != now())
+	{
+		fnc_took_r = now();
+		fnc_took_g.clear();
+	}
+	fnc_took_g.push_back(gi);
+	fnc_mark_took();
+}
+bool pick(int gi)
+{
+	return fnc_took_r == now() && std::find(fnc_took_g.begin(), fnc_took_g.end(), gi) != fnc_took_g.end();
+}
+void fired()
+{
+	fnc_mark_pick();
+}
+} // namespace nova::econ::fresh_crew
