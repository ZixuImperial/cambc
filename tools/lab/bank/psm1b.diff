@@ -303,12 +303,13 @@ constexpr int FKH_BIT_HOLD = 1;
 #define RECALL_TRAVEL 8 // the travel recall's margin RECALL_TRAVEL (rounds); a trip that ends in a recall
 
                   // drops to RTS_MARGIN while a shop or heal is due (gold >= RTS_GOLD and shopping allowed, or HP < RTS_HP100 %), so
                   // the recall that shops/heals anyway replaces the walk when it is no slower; also needs no enemy within RTS_FOE; 0
                   // = off
 #define RTS_GOLD 90
+#define RTS_HP100 80
 #define RTS_MARGIN 0
 #define RTS_FOE 10
 
                       // Recall walk cost (RTM_MODE, RTM_MARGIN): 0 = the recall only speeds up the trip to a target chosen by
                       // walking cost.
 #define OE_CMAX 0.45f
@@ -1102,6 +1103,13 @@ inline constexpr int RTS_TAB[2] = { 0x52545331, RTS_BITS }; // slot 0 magic keep
 // 00the_line 01a1c8e2-70c6 r43). Runtime data flag ROB2_TAB[1], read first; 0 = live. recall_safe refuses, whichever branch (out or
 // low) passed, when no foe is visible and enemy_close is <= 4 rounds old (bit 1) or <= 2 rounds old (bit 2). b1813's bit 4
 // (remembered-foe reach) is dropped: .4708 with deaths +.70 z+3.2.
 // v748 ROB2: no recall within 2 rounds of contact (ROB2)
 #define ROB2_BITS 2
 inline constexpr int ROB2_TAB[2] = { 0x524F4232, ROB2_BITS }; // slot 0 magic keeps it out of .bss
+
+// PSM (psm, b1821 PSE1; RC C133, Econ; adaptation psm1b: bag >= CR_BAG only, the Prism keeps trips with a low bag): a carrier (bag >= CR_BAG) takes no solo heavy job that is feasible only
+// through the multi-trip branch (e.dmg > e.budget): dying to camps loses the bag (GR:375), as chip_trip already refuses. 0 = nova_base_v736.
+// Bit 1. Non-carriers keep multi-trip.
+#define PSM_BITS 0
+inline const volatile int PSM_TAB[2] = { 0x50534D31, PSM_BITS }; // slot 0 magic keeps it out of .bss
+#define PSM_ON(b) ((PSM_TAB[1] & (b)) != 0)
