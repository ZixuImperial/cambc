+// b2390 WNM bit 1 (champ_willow.h; the caller read the flag): my heal is (nearly) ready and I farm alone: no living mate within 4, no foe
+// within 6, and I am not on my own running capture (my claim's region is being captured by us with me at it).
+static __attribute__((noinline)) bool wnm_alone()
+{
+	if (!W.me.kit || W.me.kit->slot_heal < 0 || W.cd[static_cast<std::size_t>(W.me.kit->slot_heal)] > 2)
+		return false;
+	for (const auto& al : W.allies)
+		if (al.hp > 0 && cheb(al.pos, W.me.pos) <= 4)
+			return false;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 6)
+			return false;
+	const int cg = econ::claim_target();
+	if (cg >= 0 && cg < M.ng && cheb(W.me.pos, M.groups[static_cast<std::size_t>(cg)].anchor) <= 3)
+	{
+		cambc::detail::camp_group_capture_state cs{};
+		if (cambc::detail::sdk_camp_group_capture_state(M.groups[static_cast<std::size_t>(cg)].handle, &cs) == 0 && static_cast<int>(cs.state) == 1)
+			return false; // ally_capturing: my own running capture
+	}
+	return true;
+}
 float wl2_pull(int gi, float rate)
 {
 	if (rate <= 0.0f || gi < 0 || gi >= M.ng)
 		return rate;
 	const auto& g = M.groups[static_cast<std::size_t>(gi)];
 	bool work = false;
 	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS && !work; ++s)
 		work = s != P.my_slot && alive_slot(s) && comms::cgroup(s) == gi;
 	for (const auto& al : W.allies)
 		work = work || (!al.channeling() && cheb(al.pos, g.anchor) <= 6);
+	if (WNM_ON(1) && !work && wnm_alone())
+		return rate * static_cast<float>(WNM_TAB[2]) / 1000.0f; // b2390 WNM bit 1: a group by a mate first
 	if (work && whv_attach(gi))
 	{
 		return rate * (1.0f + static_cast<float>(WL2_TAB[2]) / 100.0f) * (1.0f + static_cast<float>(WHV_TAB[2]) / 100.0f); // WHV bit 4
 	}
 	return work ? rate * (1.0f + static_cast<float>(WL2_TAB[2]) / 100.0f) : rate;
 }
