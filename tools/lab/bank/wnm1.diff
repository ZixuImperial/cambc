+	if (wl2_heal()) // bit 16384 (diagnostic): the old heal rule on the new path
+		return true;
+	return WSS_ON(1) && wss_step() && wl2_heal(); // b2390 WSS bit 1: one step toward a mate a full heal fits, then the heal rule again
 }
 
