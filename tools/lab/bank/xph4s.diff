diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -1892,6 +1892,14 @@ inline constexpr int CGB_TAB[2] = { 0x43474231, CGB_BITS };
 // Bit 4 SECOND CARRY: while our Prism lives, Marcella / Vesper lose their carrier rank and stack bonus on gem groups (gold-only keep theirs).
 #define PCM_BITS 1
 #define PCM_G 15
 // v907 PCM: PCM variant PCM_BITS=1
 #define PCM_R 400
 inline constexpr int PCM_TAB[4] = { 0x50434D31, PCM_BITS, PCM_G, PCM_R }; // slot 0 magic keeps it out of .bss
+
+// XPH (b2410, RC X914 bug hunt, bug bar; one bit per row, read first; 0 = nova_base_v907). 1 X914-4: mate_pins_group counts only a mate
+// that claims the group (PHO1 rule: a non-claiming mate holds nothing). 2 X914-2: PCM bit 1's Prism-near test reads her shared claim on
+// g (same for every evaluator), not my sight of her. 4 X914-3: should_capture keeps the capture (no yield) while a seen foe is within
+// CL_FOE of me, as capture()'s hand-off guard does. 8 X914-5: cap_rank's PF_RANK quiet test reads shared danger (danger_shared_any).
+#define XPH_BITS 0
+inline const volatile int XPH_TAB[2] = { 0x58504831, XPH_BITS }; // slot 0 magic keeps it out of .bss
+#define XPH_ON(b) ((XPH_TAB[1] & (b)) != 0)
