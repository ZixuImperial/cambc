+// RQS1 (caller read RQS_TAB): e's ready no-damage cc (a stun) reaches me within n turns, by foe_dmg's spell() reach.
+static __attribute__((noinline)) bool rqs_stun_reach(const Body& e, int d, int n)
+{
+	if (W.me.kit && W.me.kit->stun_immune)
+		return false; // C617: a stun can't cancel my recall (GR:658)
+	if (!e.kit || !e.kit->valid)
+		return false;
+	const Kit& k = *e.kit;
+	auto by = [&](int s) { return s >= 0 && s <= 1 && foe_cd(e, s) <= n - 1; };
+	if (k.cc_mod > 0 || !by(k.slot_cc))
+		return false;
+	const int dash = by(k.slot_dash) ? static_cast<int>(k.dash_range) : 0;
+	return d - ((k.cc_excl ? n - 1 : n) + dash) <= static_cast<int>(k.cc_range);
+}
