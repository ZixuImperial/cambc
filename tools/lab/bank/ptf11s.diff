+	ptf_round = W.round;
+	travel_table_build(PTF_TAB[4]); // rows and stages only when they fit: never cut
+	ptf_round = -1;
+	return static_cast<int>(round_number_nc()) != W.round; // an estimate that ran short: the engine resumed us in a new round (no yield)
