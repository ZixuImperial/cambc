+
+// FB8 (Rule Checker "Fuel inside group_bounds and observe" GO1/GO3; b1775): play-identical fuel cuts. 0 = nova_base_v672. Bit 1 GO1:
+// GroupMem::awake_seen (never read) is no longer accumulated or stored (the field stays). Bit 2 GO3: group_bounds_finish's kill-window
+// loop runs only within 20 rounds of the last group kill mark.
+#define FB8_BITS 0
+inline const volatile int FB8_TAB[2] = { 0x46423831, FB8_BITS }; // slot 0 magic keeps it out of .bss
