 // The first early-out test inline at the call site (a call and frame a turn saved), the rest out of line.
+// b2373 PSW (combat_flags.h; callers read the flag): the STATE's enemy Prism.
+const Body* psw_foe_prism()
+{
+	if (!W.me.kit || !prism_layer::kit(*W.me.kit) || static_cast<int>(W.me.gems) < PSW_TAB[2])
+		return nullptr;
+	const int my_r = static_cast<int>(std::max(W.me.kit->cc_range, W.me.kit->dmg_range));
+	for (const auto& e : W.enemies)
+		if (e.kit && prism_layer::kit(*e.kit))
+		{
+			const int d = cheb(e.pos, W.me.pos);
+			if (d <= 8 && d > my_r)
+				return &e;
+		}
+	return nullptr;
+}
+bool psw_spare(const Body& o)
+{
+	if (o.kit && o.kit->stun_immune)
+		return true;
+	if (o.gems > 0)
+		return false;
+	float dmg = cheb(o.pos, W.me.pos) <= o.range + 2 ? o.str : 0.0f;
+	if (o.kit && o.kit->slot_dmg >= 0 && foe_cd(o, o.kit->slot_dmg) <= 0 && o.kit->dmg_mod > 0)
+		dmg += o.foc * o.kit->dmg_mod;
+	return dmg < 0.35f * W.me.hp;
+}
 __attribute__((always_inline)) bool linked_pair_cast(int site)
 {
 	if (!W.alive || !W.me.kit || W.cast || W.me.channeling() || W.enemies.empty()) // FB5 LPE1
 		return false;
 	return cast::linked_pair_cast_kill_slow(site);
 }
