+// v8xx SWG bit 1 (b2395, spec_swg_1113, owner replay 01a1d410): a big wolf pack is cleared from its rim. Monsters hit the nearest
+// champion in their reach and do not chase (GR:192, :209), so only the attackers whose reach covers the crew's stand tile hit it.
+inline bool swg_pack(const GroupI& g) { return g.n_wolf >= 12 && g.n_elk + g.n_golem + g.n_mono == 0; }
+// The fewest attackers in reach of a free tile (not blocked, not a camp tile) that has an attacker within the crew's attack range
+// (3 ranged, 1 melee); static per group (wolf-only: every attacker at reach_max); 0 = unknown (map not done, low fuel, box too big).
+__attribute__((noinline)) int swg_rim_k(const GroupI& g, bool ranged)
+{
+	static std::vector<std::uint8_t> kk; // per group: [melee k, ranged k], 0 unknown, 255 no stand tile
+	static std::vector<std::uint16_t> ps;
+	if (!M.done() || g.idx < 0 || g.idx >= M.ng)
+		return 0;
+	if (kk.size() != 2u * static_cast<std::size_t>(M.ng))
+		kk.assign(2u * static_cast<std::size_t>(M.ng), 0);
+	std::uint8_t* const v = &kk[2u * static_cast<std::size_t>(g.idx)];
+	if (v[0] == 0)
+	{
+		const int rch = std::max(1, g.reach_max), pad = rch + 3;
+		const int x0 = g.bx0 - pad, y0 = g.by0 - pad;
+		const int w = g.bx1 - g.bx0 + 1 + 2 * pad, h = g.by1 - g.by0 + 1 + 2 * pad, w1 = w + 1;
+		if (w <= 0 || h <= 0 || w * h > 1600 || fuel() < 30000L + 40L * w * h)
+			return 0;
+		ps.assign(static_cast<std::size_t>(w1 * (h + 1)), 0);
+		for (int ci : g.members)
+		{
+			const auto& c = M.camps[static_cast<std::size_t>(ci)];
+			if (c.attacks())
+				++ps[static_cast<std::size_t>((c.pos.y - y0 + 1) * w1 + (c.pos.x - x0 + 1))];
+		}
+		for (int y = 1; y <= h; ++y)
+			for (int x = 1; x <= w; ++x)
+				ps[static_cast<std::size_t>(y * w1 + x)] = static_cast<std::uint16_t>(ps[static_cast<std::size_t>(y * w1 + x)] + ps[static_cast<std::size_t>((y - 1) * w1 + x)] +
+					ps[static_cast<std::size_t>(y * w1 + x - 1)] - ps[static_cast<std::size_t>((y - 1) * w1 + x - 1)]);
+		auto rect = [&](int x, int y, int r) {
+			const int xa = std::max(0, x - r), xb = std::min(w - 1, x + r), ya = std::max(0, y - r), yb = std::min(h - 1, y + r);
+			return static_cast<int>(ps[static_cast<std::size_t>((yb + 1) * w1 + xb + 1)]) - ps[static_cast<std::size_t>(ya * w1 + xb + 1)] -
