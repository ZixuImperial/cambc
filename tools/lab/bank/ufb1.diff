+// b2296 UFB bit 1 (RC C761): the flee step I just took and what I saw when I took it (per body; written only with the bit set).
+struct UfbMem
+{
+	int r = -1000;       // round of the flee step (-1000: none)
+	vec2 fpos{ -1, -1 }; // the fled foe's last seen tile
+	vec2 from{ -1, -1 }; // the tile I left
+	int rad = -1;        // max(its reach, its distance to the tile I left)
+	std::uint32_t fh = 0, set = 0, gems = 0;
+	int friends = 0, band = 0;
+};
+UfbMem ufb_m, ufb_s; // the live memory; this turn's start snapshot
+vec2 ufb_p0{ -1, -1 };
+int ufb_r0 = -1000;
+std::uint32_t ufb_set_hash() // the seen foes' ids
+{
+	std::uint32_t s = 0;
+	for (const auto& e : W.enemies)
+		s += (e.h | 1u) * 2654435761u;
+	return s;
+}
+int ufb_band() { return static_cast<int>(W.me.frac() * 20.0f); }
+// After assess: this turn's start tile, the foe I would flee (nearest seen, else remembered) and the inputs.
+__attribute__((noinline)) void ufb_turn_start(const combat::Assessment& a)
+{
+	ufb_r0 = W.round;
+	ufb_p0 = W.me.pos;
+	ufb_s = UfbMem{};
+	const combat::Foe* fl = nullptr;
+	int bd = 1 << 20;
+	for (const auto& f : a.foes)
+	{
+		const int d = cheb(f.pos, ufb_p0) + (f.idx < 0 ? 1000 : 0);
+		if (f.reach >= 0 && d < bd)
+		{
+			bd = d;
+			fl = &f;
+		}
+	}
+	if (!fl)
+		return;
+	ufb_s.r = W.round;
+	ufb_s.fpos = fl->pos;
+	ufb_s.from = ufb_p0;
+	ufb_s.rad = std::max(fl->reach, cheb(fl->pos, ufb_p0));
+	ufb_s.fh = fl->idx >= 0 ? W.enemies[static_cast<std::size_t>(fl->idx)].h : 0;
+	ufb_s.set = ufb_set_hash();
+	ufb_s.gems = W.me.gems;
+	ufb_s.friends = a.n_friends;
+	ufb_s.band = ufb_band();
+}
+// Turn end: a dispatched-FLEE turn that moved me keeps the snapshot; any other turn of mine leaves the memory as it is.
+__attribute__((noinline)) void ufb_turn_end()
+{
+	if (ufb_r0 != W.round || tm2_stance != 2)
+		return;
+	ufb_m.r = -1000;
+	if (W.alive && ufb_s.r == W.round && cheb(ufb_p0, W.me.pos) != 0)
+		ufb_m = ufb_s;
+}
+// A turn within 2 rounds of the flee step: 0 = the inputs are unchanged, else the release reason (memory forgotten).
+int ufb_check(const combat::Assessment& a)
+{
+	auto& m = ufb_m;
+	int why = 0;
+	if (!W.alive || W.round - m.r > 2)
+		why = 1;
+	else if (ufb_set_hash() != m.set)
+		why = 3;
+	else if (a.n_friends > m.friends)
+		why = 4;
+	else if (W.me.gems != m.gems)
+		why = 5;
+	else if (combat::took_damage(1)) // a hit since my last turn (a shield expiring is not one)
+		why = 6;
+	else if (ufb_band() > m.band)
+		why = 7;
+	else if (m.fh != 0)
+		for (const auto& e : W.enemies)
+			if (e.h == m.fh)
+			{
+				if (cheb(e.pos, W.me.pos) > m.rad + 2)
+					why = 8;
+				m.fpos = e.pos; // its last seen tile
+			}
+	if (why != 0)
+		m.r = -1000;
+	return why;
+}
+// A CALM turn: the fled foe's zone joins the calm-walk guard (never one that holds me: AvoidFoeReach drops whole then).
+__attribute__((noinline)) void ufb_zone(const combat::Assessment& a, std::vector<std::pair<vec2, int>>& out)
+{
+	if (ufb_m.r < 0 || ufb_check(a) != 0 || a.stance != combat::CALM || econ::capture_pay_in() >= 0 || econ::busy_capturing())
+		return;
+	if (cheb(W.me.pos, ufb_m.fpos) > ufb_m.rad)
+		out.emplace_back(ufb_m.fpos, ufb_m.rad);
+	else if (cheb(W.me.pos, ufb_m.from) != 0) // RC C761b: inside the zone (a sideways step, or the foe closed): the tile I left alone
+		out.emplace_back(ufb_m.from, 0);
+}
