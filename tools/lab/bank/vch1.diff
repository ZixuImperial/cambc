+// v700 VCH: the dash-only step onto a goal set (one call per firing: firecount counts it). True if the dash went out.
+static bool vch_dash_go(const bitboard& goals, int gi)
+{
+	mv::collect_dash(1);
+	mv::collect_dash_only(true);
+	const bool ok = mv::step_to_set(goals, 12, gi) && W.cast;
+	mv::collect_dash_only(false);
+	mv::collect_dash(0);
+	return ok;
+}
+// v700 VCH bit 1: Vendetta 2-3 tiles from a focus her one basic kills dashes beside it instead of walking: the kill refunds the dash
+// (GameRules.md:626) and her walk stays free for the next member. The dash is the turn's one cast (GameRules.md:118). Sure kill =
+// the focus's seen HP <= her Strength (no emblem bonus counted).
+static bool vch_dash_onto_kill(int gi, int focus, const vec2 fp, int want)
+{
+	if (!vendetta_layer::vendash(*W.me.kit) || W.cast || W.moved || !W.can_move() || W.me.kit->slot_dash < 0 || !combat::ready(W.me.kit->slot_dash))
+		return false;
+	const int d = cheb(W.me.pos, fp);
+	const VisCamp* vc = W.camp_by_index(focus);
+	if (d < 2 || d > 3 || want != 1 || !vc || vc->hp > W.me.str || fuel() < 30000)
+		return false;
+	static bitboard vch_g1{ cambc::uninitialized };
+	nchk(cambc::detail::sdk_Bitboard_Zero(vch_g1.ptr()));
+	bool any = false;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 t{ fp.x + dx, fp.y + dy };
+			if ((dx || dy) && inb(t) && mv::free_tile(t) && mv::camp_threat(t, gi) <= 0.0f)
+			{
+				bbset(vch_g1, t);
+				any = true;
+			}
+		}
+	return any && vch_dash_go(vch_g1, gi);
+}
