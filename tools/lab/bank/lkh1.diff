+// v683 LKH bit 1 (called with the flag read first): an unseen bush tile within 1 of the altar while a mate is out of my sight.
+static bool lkh_hidden_mate_risk(vec2 altar)
+{
+	bool bush = false;
+	for (int dx = -1; dx <= 1 && !bush; ++dx)
+		for (int dy = -1; dy <= 1 && !bush; ++dy)
+		{
+			const vec2 q{ altar.x + dx, altar.y + dy };
+			bush = inb(q) && bbget(M.bushes, q) && !bbget(W.vis, q);
+		}
+	if (!bush)
+		return false;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		const auto h = P.handle[static_cast<std::size_t>(s)];
+		bool seen = false;
+		for (const auto& al : W.allies)
+			seen = seen || al.h == h;
+		if (!seen)
+			return true;
+	}
+	return false;
+}
