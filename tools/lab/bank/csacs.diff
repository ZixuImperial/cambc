+// CSA (econ_flags.h): Cassi's own rating factor for group gi (bits = which CSA bits apply). Claims for every caller; the mates I
+// can see only for my own rating.
+__attribute__((noinline)) float csa_factor(int gi, int self, const Claims& cl, int bits)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	int iss = -1;
+	for (int s = 0; s < P.n && s < 8; ++s)
+		if (s != self && P.type[static_cast<std::size_t>(s)] == cambc::champion_type::issac)
+			iss = s;
+	bool mate = false, pair = false;
+	for (int s = 0; s < P.n && s < 8; ++s)
+		if (s != self && cl[static_cast<std::size_t>(s)] == gi)
