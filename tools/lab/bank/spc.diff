+// SPC bit 1: the focus is walking home and stands within SPC_SPAWN_D of its spawn, and nobody of ours can hit it this turn. A stunned or
+// channelling focus cannot run; one with no sighting last round, or no closer to its spawn than then (it turned back), does not count.
+static bool spc_focus_gets_home(const FightCtx& c)
+{
+	if (bbget(M.enemy_spawn, c.f.pos))
+		return false;
+	int sd = 1;
+	while (sd <= SPC_SPAWN_D && !mates::enemy_spawn_near(c.f.pos, sd))
+		++sd;
+	if (sd > SPC_SPAWN_D || stance::kill_window(c.f) || foe_next_turn_reach(W.me, false) >= c.d)
+		return false;
+	const SpcTrack* s = nullptr;
+	for (const auto& t : spc_track)
+		if (t.h == c.f.h && t.round == W.round && t.prev_round == W.round - 1)
+			s = &t;
+	if (!s || mates::enemy_spawn_near(s->prev, sd))
+		return false;
+	for (const auto& m : W.allies)
+		if (foe_next_turn_reach(m, false) >= cheb(m.pos, c.f.pos))
+			return false;
+	return true;
+}
