+// SPC bit 1: move each visible foe's latest tile to its previous one and note the new one.
+static void spc_note_sightings(int now)
+{
+	for (const auto& e : W.enemies)
+	{
+		SpcTrack* s = nullptr;
+		for (auto& t : spc_track)
+		{
+			if (t.h == e.h)
+			{
+				s = &t;
+				break;
