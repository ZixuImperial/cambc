+// A REAR YIELDS, from step_field (caller read bit 1 and the gate round): the field's lowest neighbour, mates not walls, is held by a
+// walking (moved since my last sighting last round), non-channelling mate M and no free tile is as low: next round I act after M.
+void wpr_rear_yield(const distance_field& f)
+{
+	const vec2 me = W.me.pos;
+	const std::uint16_t cur = dfget(f, me);
+	if (cur == UNREACH || cur <= 4 || !wpr_adopt)
+		return;
+	int bv = cur;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!inb(n) || bbget(M.block, n))
+			continue;
+		const std::uint16_t v = dfget(f, n);
+		if (v != UNREACH && v < bv)
+			bv = v;
+	}
+	if (bv >= cur)
+		return;
+	const Body* m = nullptr;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!inb(n) || bbget(M.block, n) || dfget(f, n) != bv)
+			continue;
+		const Body* h = nullptr;
+		for (const auto& a : W.allies)
+			if (a.pos == n)
+				h = &a;
+		if (h)
+			m = h;
+		else if (!bbget(W.occ_units, n) && !bbget(W.occ_camps, n))
+			return; // a free tile as low: no block
+	}
+	if (!m || m->slot < 0 || m->slot >= 8 || m->channeling())
+		return;
+	const auto s = static_cast<std::size_t>(m->slot);
+	if (wpr_rp[s] != W.round - 1 || wpr_pp[s] == m->pos)
+		return; // not seen walking since last round
+	int w = tie_prio(m->slot) - 1;
+	if (w >= wpr_gate_base)
+		return; // already after M
+	if ((wpr_gate_base - w) % 7 == 0)
+		--w;
+	wpr_adopt(w);
+}
