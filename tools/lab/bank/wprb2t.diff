+// Cheb distance from p to group g's member box.
+NOVA_INLINE int wpr_box_d(vec2 p, int g)
+{
+	const auto& G1 = M.groups[static_cast<std::size_t>(g)];
+	const int dx = std::max({ 0, G1.bx0 - p.x, p.x - G1.bx1 }), dy = std::max({ 0, G1.by0 - p.y, p.y - G1.by1 });
+	return std::max(dx, dy);
+}
