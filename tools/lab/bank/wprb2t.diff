+// Called with my value after the overrides (want) and my base. Notes the mates' tiles, opens bit 1's gate for step_field and applies
+// bit 2. Gates: alive, no awake camp threat on me, no visible foe within 12, my target group > 4 tiles away, want == base.
+int wpr_turn(int want, int base)
+{
+	wpr_note_mates();
+	if (!W.alive || want != base || P.my_slot < 0)
+		return want;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 12)
+			return want;
+	const int tg = econ::wpr_target();
+	if ((tg >= 0 && tg < M.ng && wpr_box_d(W.me.pos, tg) <= 4) || camp_threat(W.me.pos) > 0)
+		return want;
+	if (WPR_ON(1))
+	{
+		wpr_gate_round = W.round;
+		wpr_gate_base = base;
+	}
+	if (WPR_ON(2) && tg >= 0 && tg < M.ng) // B FRONT LEADS
+	{
+		const vec2 an = M.groups[static_cast<std::size_t>(tg)].anchor;
+		const int dme = cheb(W.me.pos, an);
+		int w = want;
+		for (const auto& a : W.allies)
+			if (a.slot >= 0 && a.slot < 8 && a.slot != P.my_slot && cheb(a.pos, W.me.pos) <= 2 && !a.channeling() &&
