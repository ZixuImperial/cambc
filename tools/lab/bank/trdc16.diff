+	if (cheb(f0.pos, W.me.pos) > 6 || !trd_zone())
+		return;
+	struct TB { float h, d; int bag, slot; cambc::champion_type type; };
+	TB us[8], th[8];
+	int nu = 0, nt = 0;
+	{
+		float h = 0, d = 0;
+		mates::add_friend(W.me, h, d);
