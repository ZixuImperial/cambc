+static inline bool trd_carry(int slot, int bag) { return (slot >= 0 && (slot == P.carrier_gems || slot == P.carrier_gold)) || bag >= TRD_TAB[4]; }
+// v8xx TRD bit 1 (the caller read the flag): a soft FLEE becomes FIGHT on a favourable predicted exchange (spec_trd_1113.md): 6 turns
+// of focus fire, each side's total dps on the other's lowest-health body (ours: me + mates within 6 not channelling, mates::add_friend;
+// theirs: visible foes within 6, ehp / dps), <= 8 a side. Kill = bag + 70, our death = -(bag + 20).
+static __attribute__((noinline)) void trd_stay(Assessment& a, const stance::AssessCtx& c)
+{
+	if (c.kill_now || a.focus < 0 || !W.alive || !W.me.kit || W.me.channeling() || trd_carry(W.me.slot, static_cast<int>(W.me.gems)))
