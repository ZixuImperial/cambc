+		const int fb = (!f.remembered && f.idx >= 0) ? static_cast<int>(W.enemies[static_cast<std::size_t>(f.idx)].gems) : 0;
+		th[nt++] = { std::max(1.0f, f.ehp), std::max(0.0f, f.dps), fb, -1, (!f.remembered && f.idx >= 0) ? W.enemies[static_cast<std::size_t>(f.idx)].type : cambc::champion_type{} }; // b2370 TRD-C: the type (RC C1028c: C&I reward)
+	}
+	if (nt == 0)
+		return;
+	int K = 0, D = 0;
+	float trc_kv = 0; // b2370 TRD-C: sum of the killed foes' bag + 70
+	int trc_bd = -1;  // b2370 TRD-C: the first predicted dead's bag
+	bool trc_ci = false; // b2370 TRD-C: a foe Cassi or Issac already counted killed
+	bool bad_dead = false;
+	float val = 0;
+	for (int t = 0; t < 6; ++t)
+	{
+		float du = 0, dt = 0;
+		for (int i = 0; i < nu; ++i)
+			if (us[i].h > 0)
+				du += us[i].d;
+		for (int i = 0; i < nt; ++i)
+			if (th[i].h > 0)
+				dt += th[i].d;
+		if (du <= 0 || dt <= 0)
+			break;
+		int ti = -1, ui = -1;
+		for (int i = 0; i < nt; ++i)
+			if (th[i].h > 0 && (ti < 0 || th[i].h < th[ti].h))
+				ti = i;
+		for (int i = 0; i < nu; ++i)
+			if (us[i].h > 0 && (ui < 0 || us[i].h < us[ui].h))
