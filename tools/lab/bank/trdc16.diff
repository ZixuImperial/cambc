+				const auto ty = th[ti].type;
+				const bool ci = ty == cambc::champion_type::cassi || ty == cambc::champion_type::issac;
+				trc_kv += static_cast<float>(th[ti].bag) + ((ci && trc_ci) ? 0.0f : 70.0f);
