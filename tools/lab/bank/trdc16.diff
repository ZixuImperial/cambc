+		}
+		if (us[ui].h <= 0)
+		{
+			++D;
+			if (trc_bd < 0)
+				trc_bd = us[ui].bag;
+			val -= static_cast<float>(us[ui].bag) + 70.0f; // RC C1028 F3: the killer's 100 gold too (GR:375)
+			bad_dead = bad_dead || trd_carry(us[ui].slot, us[ui].bag);
+			const auto ty = us[ui].type;
+			if (ty == cambc::champion_type::cassi || ty == cambc::champion_type::issac)
+			{
+				// GR:381/442: the linked partner dies too; one kill reward for the pair (its gems + tempo)
+				const auto pt = nova::ci_layer::partner(ty);
+				bool inside = false;
+				for (int j = 0; j < nu; ++j)
+					if (j != ui && us[j].type == pt)
+					{
+						inside = true; // in the exchange: dies now unless already counted dead
+						if (us[j].h > 0)
+						{
+							us[j].h = 0;
+							++D;
+							val -= static_cast<float>(us[j].bag) + 20.0f;
+							bad_dead = bad_dead || trd_carry(us[j].slot, us[j].bag);
+						}
+						break;
+					}
+				if (!inside)
+				{
+					const Body* pb = nullptr; // the partner outside the exchange (me is always us[0])
+					for (const auto& al : W.allies)
+						if (!pb && al.type == pt)
+							pb = &al;
+					if (pb)
+					{
+						++D;
+						val -= static_cast<float>(pb->gems) + 20.0f;
+						bad_dead = bad_dead || trd_carry(pb->slot, static_cast<int>(pb->gems));
+					}
