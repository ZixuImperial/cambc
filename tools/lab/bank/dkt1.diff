+// DKT bit 4 (econ_flags.h; the callers read the flag): slot self's travel at its dash speed, x .85 for a Vendetta, Issac or Heart of Ruin
+// trip of 10+ tiles (rate_for and both group_bounds copies, RC C1274: the bound keeps rate <= bound).
+std::uint16_t dkt_trav(int self, std::uint16_t trav)
+{
+	if (trav == UNREACH || trav < 10 || self < 0 || self >= P.n || self >= 8)
+		return trav;
+	const auto t = P.type[static_cast<std::size_t>(self)];
+	if (t == cambc::champion_type::vendetta || t == cambc::champion_type::issac || t == cambc::champion_type::heart_of_ruin)
+		return static_cast<std::uint16_t>((static_cast<int>(trav) * 85 + 50) / 100);
+	return trav;
