+// DKT bit 1 (econ_flags.h): a dash kit's arrival at its dash speed (1.2 tiles a turn, GR:159), plus one round for the cooldown's phase.
+static bool dkt_dash_kit(int s)
+{
+	if (s < 0 || s >= P.n || s >= 8)
+		return false;
+	const auto t = P.type[static_cast<std::size_t>(s)];
+	return t == cambc::champion_type::vendetta || t == cambc::champion_type::vesper_vale || t == cambc::champion_type::issac ||
+		t == cambc::champion_type::heart_of_ruin || t == cambc::champion_type::ren;
+}
+static int dkt_eta(int s, int e)
+{
+	if (DKT_ON(1) && e > 1 && dkt_dash_kit(s))
+		return std::min(e, (e * 5 + 5) / 6 + 1); // ceil(e / 1.2) + 1, never above the walk
+	return e;
+}
