 		return false; // v694 FST-SEEN: a bag read this round can't have been banked out of sight
 	}
 	for (int r = std::min(r0, 2047), k = 0; r >= 0 && k < 30; --r, ++k)
 		if (fsb_them[r] != 0)
-			return W.tributed_them - (static_cast<int>(fsb_them[r]) - 1) >= (fsb_unseen_sum()); // v693 FST bit 1 FSB-TEAM
+			return W.tributed_them - (static_cast<int>(fsb_them[r]) - 1) - (FSB2_ON(2) ? fsb2_seen_drops(r0) : 0) >= (FSB2_ON(1) && W.round - r0 > RACE_TAB[6] ? fsb2_unseen_sum(bag, r0) : fsb_unseen_sum()); // v693 FST bit 1 FSB-TEAM; b1823 FSB2 bits 2, 1
 	return false;
 }
 void track()
 {
 	if (W.round >= 0 && W.round < 2048)
 		fsb_them[W.round] = static_cast<std::uint16_t>(W.tributed_them + 1);
+	if (FSB2_ON(2))
+		fsb2_track(); // b1823 FSB2 bit 2: foe bags at their reads
 	if (W.round - hist_last < 10)
 		return;
 	hist_last = W.round;
 	const std::size_t k = static_cast<std::size_t>(hist_n % 32);
 	hist_t[k] = W.tributed_them;
 	hist_u[k] = W.tributed_us;
