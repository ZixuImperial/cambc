 }
+// b1823 FSB2: each foe's read bag + 1 at the round of the read (0 = no read that round), team-table slots 0-7.
+static std::uint16_t fsb2_bag[8][2048];
+static int fsb2_last[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+static int fsb2_dead[8] = { -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000 }; // the last round each foe read dead (C32 FSD1)
+// FSB2 bit 1 FSA1 (caller: only for a tested bag read more than RFE_AGE rounds ago, a PBQ keep): that bag plus the unseen bags read within
+// RFE_AGE rounds. A young tested bag keeps the full sum (C32: never drop a real young bag for an old banked keep).
+static __attribute__((noinline)) int fsb2_unseen_sum(int bag, int r0)
+{
+	int s = bag;
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		const Body* b = intel::team_body(i);
+		const int br = intel::team_body_round(i);
+		if (tt[i].alive && b && b->gems > 0 && br < W.round && W.round - br <= RACE_TAB[6])
+			s += static_cast<int>(b->gems);
+	}
+	return s;
+}
+// FSB2 bit 2 FSA2: the bag drops of living foes re-read after r0, against their bag at r0 (their last read within FSB2_LOOK rounds of it);
+// a foe that died after that read lost its bag to the killer (GR:220), not to a tribute: skipped (C32 FSD1).
+static __attribute__((noinline)) int fsb2_seen_drops(int r0)
+{
+	int s = 0;
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size() && i < 8; ++i)
+	{
+		const Body* b = intel::team_body(i);
+		if (!tt[i].alive || !b || intel::team_body_round(i) <= r0)
+			continue;
+		for (int r = std::min(r0, 2047), k = 0; r >= 0 && k <= FSB2_TAB[2]; --r, ++k)
+			if (fsb2_bag[i][r] != 0)
+			{
+				if (fsb2_dead[i] >= r)
+					break; // died since that read
+				s += std::max(0, static_cast<int>(fsb2_bag[i][r]) - 1 - static_cast<int>(b->gems));
+				break;
+			}
+	}
+	return s;
+}
+// FSB2: record each foe's bag at the round of its read (track() runs before this turn's reads: the last turn's land here).
+static __attribute__((noinline)) void fsb2_track()
+{
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size() && i < 8; ++i)
+	{
+		const int br = intel::team_body_round(i);
+		const Body* b = intel::team_body(i);
+		if (!tt[i].alive || br < 0)
+			fsb2_dead[i] = W.round;
+		if (br >= 0 && br < 2048 && br != fsb2_last[i] && b)
+		{
+			fsb2_bag[i][br] = static_cast<std::uint16_t>(std::min<std::uint32_t>(b->gems, 60000u) + 1);
+			fsb2_last[i] = br;
+		}
+	}
+}
 static bool fsb_banked(int bag, int r0)
 {
 	if (r0 >= W.round)
