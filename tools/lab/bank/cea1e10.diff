 // No lone 1v3+ unless the kill lands now and I outlast their summed bursts.
+// CEA bit 8 guard (IGD bit 1's estimate): the foes' summed burst on tile L (two turns for a foe acting twice before my next turn,
+// remembered foes 1-3 rounds old) as % of the lower eff HP of me and my partner when she/he stands inside a visible foe's one-turn reach.
+static int cea_reach1(const Body& e)
+{
+	const Kit* k = e.kit;
+	int r = std::max(e.range, 1) + 3;
+	if (k && k->valid)
+	{
+		r = k->ranged ? std::max(e.range, 1) + 1 - (k->slot_reset >= 0 ? 0 : 1) : std::max(e.range, 1) + 1;
+		auto sp = [&](int slot, float range, float radius, bool excl)
+		{
+			if (slot >= 0)
+				r = std::max(r, static_cast<int>(range + radius) + 1 - (excl ? 1 : 0));
+		};
+		sp(k->slot_dmg, k->dmg_range, 0.0f, k->dmg_excl);
+		sp(k->slot_cc, k->cc_range, 0.0f, k->cc_excl);
+		sp(k->slot_aoe, k->aoe_range, k->aoe_radius, k->aoe_excl);
+		if (k->slot_dash >= 0)
+			r += 2;
+	}
+	return r;
+}
+static __attribute__((noinline)) int cea_guard_pct(vec2 L, vec2 pp)
+{
+	float sum = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, L);
+		if (d > cea_reach1(e))
+			continue;
+		const float t1 = burst::lethal_burst_hit(e, d, 0, nullptr);
+		sum += foe_turns_within_rounds(e, 2) >= 2 ? burst::foe_two_turn_damage(e, d, t1) : t1;
+	}
+	for (const auto& s : seen)
+	{
+		const int age = W.round - s.round;
+		if (age < 1 || age > 3)
+			continue;
+		bool vis = false;
+		for (const auto& e : W.enemies)
+			vis = vis || e.h == s.h;
+		if (!vis && cheb(s.foe.pos, L) <= std::max(2, s.foe.reach) + age)
+			sum += s.foe.burst;
+	}
+	float bar = eff_hp(W.me);
+	for (const auto& al : W.allies)
+		if (al.pos == pp)
+		{
+			bool in = false;
+			for (const auto& e : W.enemies)
+				in = in || cheb(e.pos, al.pos) <= cea_reach1(e);
+			if (in)
+				bar = std::min(bar, eff_hp(al));
+		}
+	return static_cast<int>(100.0f * sum / std::max(1.0f, bar));
+}
+// CEA bit 8 STRIKE FIRST (caller read the flag): an early pair body not in FIGHT, ratio >= .855, takes FIGHT on a visible foe inside its
+// strike reach that has me or my partner inside its one-turn reach, when the guard passes and the foe does not act twice before my next turn.
+static __attribute__((noinline)) void cea_strike_first(const AssessCtx& c)
+{
+	Assessment& a = c.a;
+	if (a.stance == FIGHT || c.low || c.kill_now || !W.me.kit || a.ratio < 0.855f || cea_w() <= 0.0f)
+		return;
+	const auto pt = W.me.type == cambc::champion_type::cassi ? cambc::champion_type::issac : cambc::champion_type::cassi;
+	vec2 pp{ -1000, -1000 };
+	for (const auto& al : W.allies)
+		if (al.type == pt)
+			pp = al.pos;
+	const Kit& k = *W.me.kit;
+	const int sr = std::max<int>(W.me.range, static_cast<int>(std::max(k.dmg_range, k.cc_range))) + (k.ranged ? 0 : 1);
+	int bi = -1, bp = 1 << 20;
+	for (const auto& f : a.foes)
+	{
+		if (f.idx < 0 || f.reach < 0 || cheb(f.pos, W.me.pos) > sr)
+			continue;
+		if (!(cheb(f.pos, W.me.pos) <= f.reach || cheb(f.pos, pp) <= f.reach))
+			continue;
+		const Body& e = W.enemies[static_cast<std::size_t>(f.idx)];
+		if (foe_turns_within_rounds(e, 2) >= 2 || foe_model::unreachable(e))
+			continue;
+		vec2 L = W.me.pos; // the tile I strike from: here if in range, else one step toward the foe
+		if (cheb(f.pos, W.me.pos) > W.me.range)
+		{
+			L.x += (f.pos.x > L.x) - (f.pos.x < L.x);
+			L.y += (f.pos.y > L.y) - (f.pos.y < L.y);
+		}
+		const int pct = cea_guard_pct(L, pp);
+		if (pct < CEA_TAB[6] && pct < bp)
+		{
+			bp = pct;
+			bi = f.idx;
+		}
+	}
+	if (bi >= 0)
+		assess_fight_on(a, bi);
+}
