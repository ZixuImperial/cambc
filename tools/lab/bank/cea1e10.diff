+// CEA: the early fade w for a pair body that may play early (pair bag < 50, not channelling or stunned); 0 otherwise.
+static float cea_w()
+{
+	if (!(W.me.type == cambc::champion_type::cassi || W.me.type == cambc::champion_type::issac) || W.me.channeling() || W.me.stunned)
+		return 0.0f;
+	if (nova::ci2::pair_bag() >= 50)
+		return 0.0f;
+	return std::max(0.0f, 1.0f - static_cast<float>(W.round) / static_cast<float>(std::max(1, static_cast<int>(CEA_TAB[2]))));
+}
+// CEA bits 1/2 (caller read the flag; not low): the pair's engage and flee bars fade from the early values to live's.
+static __attribute__((noinline)) void cea_early_bars(AssessCtx& c)
+{
+	const float w = cea_w();
+	if (w <= 0.0f)
+		return;
+	if (CEA_ON(1))
+		c.engage = std::max(std::min(c.engage, static_cast<float>(CEA_TAB[5]) / 100.0f), c.engage * (1.0f - static_cast<float>(CEA_TAB[3]) / 100.0f * w));
+	if (CEA_ON(2))
+		c.flee_thr *= 1.0f - static_cast<float>(CEA_TAB[4]) / 100.0f * w;
+}
 // A bag raises the bars: dying hands it to the killer, the bigger the more careful. Passive Cassi & Issac: my death also kills my
 // linked body and hands over its bag. With our support in the fight, more fights qualify (her heal is in the ratio too); team-fight
 // mode already counts her, so her own engage scale applies only outside it, and never twice.
 static __attribute__((always_inline)) inline void assess_bars_bag_and_support(AssessCtx& c)
 {
 	c.linked = linked_slot() >= 0;
@@ -119,12 +139,14 @@ static __attribute__((always_inline)) inline void assess_bars_bag_and_support(As
 		c.flee_thr *= tune::SUPPORT_FLEE_SCALE;
 	c.low = W.me.frac() < ((c.linked && !CI2_FIGHT()) ? tune::LOW_HP_LINKED : tune::LOW_HP); // PASSIVE Cassi & Issac
 	if (CI2_FIGHT())
 		nova::ci2::death_price_bar(c.engage, nova::ci2::pair_bag()); // CI2 decision 6: the price of death
 	else if (c.linked) // Cassi warier, Issac by team gold
 		nova::ci::builds::bars(c.engage, c.flee_thr);
+	if ((CEA_ON(1) || CEA_ON(2)) && !c.low) // CEA bits 1/2: the pair's early bars
+		cea_early_bars(c);
 	c.engage += strat::policy().engage_bias;
