 bool one_pack(); // draft_memory.cc (same unity unit)
 
 // CIMG (b1769): is this a gate map? Draft-time map data only.
+// OGG (b1769): MCL_BIT_ONEGEM's test (map_class_compute), from the draft's own map data.
+bool ogg_onegem()
+{
+	long tot = 0, top = 0;
+	float top_hp = 0.0f;
+	for (const auto& g : M.groups)
+	{
+		tot += g.gems;
+		if (g.gems > top)
+		{
+			top = g.gems;
+			top_hp = g.hp;
+		}
+	}
+	if (OGG_ON(2) && top_hp < static_cast<float>(OGG_TAB[2])) // OGG bit 2: heavy packs only
+		return false;
+	return tot > 0 && top * 100L >= static_cast<long>(OGS_TAB[2]) * tot;
+}
 bool cmg_gate()
 {
+	if (OGG_ON(1)) // b1769 OGG: the ONEGEM gate, on top of v647's one_pack gate (one_pack maps keep it whatever their HP)
+		return one_pack() || (M.done() && ogg_onegem());
 	return one_pack();
 }
 
