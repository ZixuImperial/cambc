+// v705 FCW: walk steps from p to a rally tile for the flee rally pick and step score, from a 4-slot field cache of its own keyed by the
+// rally tile (M.block is static, so a field stays valid while its root tile is the same), apart from retreat_step's one-slot rally field.
+int fcw_rally_walk(vec2 p, vec2 rally)
+{
+	static distance_field fcw_f[4];
+	static bitboard fcw_vis, fcw_roots;
+	static vec2 fcw_at[4] = { vec2{ -1, -1 }, vec2{ -1, -1 }, vec2{ -1, -1 }, vec2{ -1, -1 } };
+	static int fcw_next = 0;
+	const int r = static_cast<int>(FRW_TAB[2]);
+	int k = -1;
+	for (int i = 0; i < 4 && k < 0; ++i)
+		if (fcw_at[i] == rally)
+			k = i;
+	if (k < 0)
+	{
+		k = fcw_next;
+		fcw_next = (fcw_next + 1) & 3;
+		fcw_roots.clear();
+		bbset(fcw_roots, rally);
+		fcw_f[k].compute(M.block, fcw_roots, fcw_vis, static_cast<std::uint16_t>(r));
+		fcw_at[k] = rally;
+	}
+	const std::uint16_t v = dfget(fcw_f[k], p);
+	return v != UNREACH ? static_cast<int>(v) : r + 1 + cheb(p, rally);
+}
