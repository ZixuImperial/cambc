+// CSV: from a tile outside every heavy foe's one-turn reach, the step to dest closes into one's reach (heavy: burst >= b x my eff HP).
+// Once per turn and position (fuel): the heavy foes with their destination reach (+ 1 for a double-turn foe), whether a heavy foe is
+// near enough to matter, the kill_now and flee all-in-reach exceptions; each candidate step then runs only the closing test.
+struct CsvTurn
+{
+	int r = -1, n = 0;
+	vec2 me{ -1, -1 };
+	float b = -1.0f;
+	bool on = false; // a step from here can be vetoed
+	int x[16], y[16], rr[16];
+};
+static CsvTurn csv_t;
+static bool csv_bad(const CsvTurn& t, vec2 me, vec2 p) // the step to p closes into a heavy foe's reach
+{
+	for (int i = 0; i < t.n; ++i)
+	{
+		const vec2 fp{ t.x[i], t.y[i] };
+		const int dp = cheb(p, fp);
+		if (dp <= t.rr[i] && dp < cheb(me, fp))
+			return true;
+	}
+	return false;
+}
+static void csv_fill(CsvTurn& t, bool flee, float b)
+{
+	const vec2 me = W.me.pos;
+	t.r = W.round;
+	t.me = me;
+	t.b = b;
+	t.n = 0;
+	t.on = false;
+	const float lim = b * combat::eff_hp(W.me);
+	for (int i = 0; i < csv_n; ++i)
+	{
+		const CsvFoe& f = csv_f[i];
+		if (f.reach < 0 || f.burst < lim)
+			continue;
+		const vec2 fp{ f.x, f.y };
+		const int dm = cheb(me, fp);
+		if (dm <= f.reach)
+			return; // my tile is in a heavy foe's reach already: no veto
+		if (dm > f.reach + 2)
+			continue; // no single step brings it into reach (even with the double turn)
+		const bool vis = f.idx >= 0 && f.idx < static_cast<int>(W.enemies.size()) && W.enemies[static_cast<std::size_t>(f.idx)].pos == fp;
+		t.x[t.n] = f.x;
+		t.y[t.n] = f.y;
+		t.rr[t.n] = f.reach + ((vis && combat::burst::reach_burst_turns(W.enemies[static_cast<std::size_t>(f.idx)]) >= 2) ? 1 : 0);
+		++t.n;
+	}
+	if (t.n == 0)
+		return;
+	for (const auto& e : W.enemies) // kill_now: a foe I kill this turn from here (the assessment's test)
+		if (combat::burst::kills(e, cheb(e.pos, me), 0))
+			return;
+	if (flee)
+	{
+		bool out = false; // every free step closes into a reach: the flee keeps today's choice
+		for (const vec2 dd : DIRS)
+			if (free_tile(me + dd) && !csv_bad(t, me, me + dd))
+			{
+				out = true;
+				break;
+			}
+		if (!out)
+			return;
+	}
+	t.on = true;
+}
+static bool csv_test(vec2 dest, bool calm_ok, bool flee_ok, float b)
+{
+	if (csv_r != W.round)
+		return false;
+	const bool flee = csv_st == static_cast<int>(combat::FLEE);
+	if (!((csv_st == static_cast<int>(combat::CALM) && calm_ok) || (flee && flee_ok)))
+		return false;
+	CsvTurn& t = csv_t;
+	if (t.r != W.round || !(t.me == W.me.pos) || t.b != b)
+		csv_fill(t, flee, b);
+	if (!t.on || !csv_bad(t, W.me.pos, dest))
+		return false;
+	const auto pt = W.me.type == cambc::champion_type::cassi ? cambc::champion_type::issac : W.me.type == cambc::champion_type::issac ? cambc::champion_type::cassi : W.me.type;
+	if (pt != W.me.type)
+		for (const auto& al : W.allies)
+			if (al.type == pt && cheb(al.pos, dest) <= 1)
+				return false; // the C&I pair moves to the partner
+	return true;
+}
+static bool csv_veto(vec2 dest)
+{
+	const bool c = CSV_ON(7) != 0;
+	return c && (!CSV_ON(8) || csv_deaths >= CSV_TAB[2]) && csv_test(dest, true, CSV_ON(2), (CSV_ON(4) && !CSV_ON(3)) ? 0.15f : 0.30f);
+}
