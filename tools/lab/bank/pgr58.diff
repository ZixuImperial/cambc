+	{
+		for (const auto& e : W.enemies)
+			if (e.h != sh && !e.stunned && cheb(e.pos, W.me.pos) <= foe_reach_in_turns(e, 1))
+				return mv::step_field(M.f_home); // one step home-side
+	}
+	return false;
+}
+// The seat's view (sight 6 from the tile, own bush cluster): one mask per tile, 16 slots.
+static const bitboard* pgr_view(vec2 t)
+{
+	static std::array<vec2, 16> sp{};
+	static std::array<bitboard, 16> sm{};
+	static int sn = 0, sk = 0;
+	for (int i = 0; i < sn; ++i)
+		if (sp[static_cast<std::size_t>(i)] == t)
+			return &sm[static_cast<std::size_t>(i)];
+	std::size_t k = static_cast<std::size_t>(sn);
+	if (sn < 16)
+		++sn;
+	else
+	{
+		k = static_cast<std::size_t>(sk);
+		sk = (sk + 1) % 16;
+	}
+	sp[k] = t;
+	cambc::ward::visible_tiles_from_into(t, sm[k]);
+	return &sm[k];
+}
+static bool pgr_watched(const bitboard& view)
+{
+	for (const auto& e : W.enemies)
+		if (bbget(M.bushes, e.pos) && bbget(view, e.pos))
+			return true;
+	static bitboard fw{ cambc::uninitialized };
+	cambc::vision::ward_tiles_into(team::enemy, fw);
+	fw &= M.bushes;
+	fw &= view;
+	return bbany(fw);
+}
+// The seat (PPB arm C's tests): a bush tile within PGR_SR of an altar, out of every awake camp's reach, unwatched, that sees every altar-adjacent
+// tile within PGR_SR of it; the nearest of up to 3 candidates. Else the nearest standable tile within PGR_SR of an altar out of camp reach.
+static vec2 pgr_seat_find(vec2 me)
+{
+	const int cr = PGR_TAB[6];
+	vec2 fb = me;
+	fb.x = -1;
+	int fbd = BIG;
+	std::array<vec2, 3> tried{};
+	for (int pass = 0; pass < 3; ++pass)
+	{
+		vec2 cand = me;
+		cand.x = -1;
+		int bd = BIG;
+		for (const auto& a : M.altars)
+			for (int dy = -cr; dy <= cr; ++dy)
+				for (int dx = -cr; dx <= cr; ++dx)
+				{
+					vec2 t = a.pos;
+					t.x += dx;
+					t.y += dy;
+					if (!M.passable(t) || bbget(M.camp_tiles, t) || dfget(M.f_altar, t) == UNREACH)
+						continue;
+					const int d = cheb(t, me);
+					if (pass == 0 && d < fbd && mv::camp_threat(t) <= 0)
+					{
+						fbd = d;
+						fb = t;
+					}
+					if (!bbget(M.bushes, t))
+						continue;
+					bool seen = false;
+					for (int i = 0; i < pass; ++i)
+						seen = seen || tried[static_cast<std::size_t>(i)] == t;
+					if (!seen && d < bd)
+					{
+						bd = d;
+						cand = t;
+					}
+				}
+		if (cand.x < 0)
+			break;
+		tried[static_cast<std::size_t>(pass)] = cand;
+		if (mv::camp_threat(cand) > 0)
+			continue;
+		const bitboard* v = pgr_view(cand);
+		if (!v || pgr_watched(*v))
+			continue;
+		bool ring = true;
+		bbforeach_near(M.altar_adj, cand, cr, [&](vec2 q) { ring = ring && bbget(*v, q); });
+		if (ring)
+			return cand;
+	}
+	return fb;
+}
+static bool pgr_group_near_altar(int gi)
+{
+	if (gi < 0 || gi >= static_cast<int>(M.groups.size()))
+		return false;
+	for (const auto& a : M.altars)
+		for (const int ci : M.groups[static_cast<std::size_t>(gi)].members)
+			if (cheb(M.camps[static_cast<std::size_t>(ci)].pos, a.pos) <= PGR_TAB[5])
+				return true;
+	return false;
+}
+bool pgr_seat_turn()
+{
+	if (!pgr_hold() || busy_capturing())
+		return false;
+	if (W.round - pgr_seen_r > 15 && pgr_group_near_altar(T.target))
+		return false; // the leash: a group beside the altars while none of them came near
+	const vec2 me = W.me.pos;
+	static int pr = -1000;
+	vec2& pt = pgr_pt;
+	if (W.round - pr >= 8 || pr > W.round) // the seat search once per 8 rounds: fuel
+	{
+		pr = W.round;
+		pt = pgr_seat_find(me);
+	}
+	if (pt.x < 0)
+		return false;
+	if (pt.x == me.x && pt.y == me.y)
+		return true; // hold on the seat
+	if (W.can_move() && mv::step_to(pt, 0))
+		return true;
+	pr = W.round - 6; // no step: search again in 2 rounds (RC C975)
+	return false;
+}
+// The leash (Aggression, 13 Nov): in HOLD, while a foe was seen within 10 of an altar in the last 15 rounds, a step ending more than 4 from
+// the nearest altar tile and no nearer than her tile is refused (she casts from where she is or returns to the seat); bit 32's exit
+// condition lifts it (the live flee).
+bool pgr_leash_refuses(vec2 dest)
+{
+	if (!pgr_hold() || W.round - pgr_seen_r > 15 || ::nova::tm2_stance == 2 || W.me.frac() < 0.40f)
+		return false; // every flee and a hurt Prism walk as live (RC C975b)
+	int dd = BIG, dm = BIG;
+	for (const auto& a : M.altars)
+	{
+		dd = std::min(dd, cheb(a.pos, dest));
+		dm = std::min(dm, cheb(a.pos, W.me.pos));
+	}
+	if (dd <= 4 || dd < dm)
+		return false;
+	return true;
+}
+bool pgr_cast_refused(int slot, std::uint32_t kind, std::uint32_t handle, vec2 p)
+{
+	if (!pgr_hold() || slot < 0 || slot > 1 || kind == 2u || W.me.frac() < 0.40f || ::nova::tm2_stance == 2)
+		return false; // camps, a hurt Prism, a flee: as live (RC C975 F2a)
+	const float F = W.me.foc * mu::mo(W.me);
+	if (slot == 0)
+	{
+		if (kind == 1u)
+			for (const auto& e : W.enemies)
+			{
+				if (e.h != handle)
+					continue;
+				const float eh = mu::ehp(e); // real HP + shield over her Durability (MUL bit 2 FULL): compared with my raw hit
+				if ((e.state & ST_TRIBUTE) != 0 && cheb(e.pos, W.me.pos) <= 4)
+					return false; // the stun on a channeller (live end_stun's timing)
+				if (eh <= 1.5f * F)
+					return false; // a kill
+				if (combat::ready(1) && eh <= 2.5f * F)
+					return false; // stun, then the area on the stunned tile
+				break;
+			}
+		for (const auto& e : W.enemies)
+		{
+			if (e.gems < 20 || cheb(e.pos, W.me.pos) <= std::max(1, e.range) + 1)
+				continue; // no bag, or the body that threatens her this turn
+			int da = BIG;
+			for (const auto& a : M.altars)
+				da = std::min(da, cheb(e.pos, a.pos));
+			if (da <= 9)
+				return true; // kept: the stun answers their bank (an altar tile within the 8-turn cooldown)
+		}
+		return false;
+	}
+	int n = 0;
+	for (const auto& e : W.enemies)
+	{
+		if (cheb(e.pos, p) > 1)
+			continue;
+		if (e.stunned || mu::ehp(e) <= F)
+			return false; // a kill, or the second half on a stunned foe
+		++n;
+	}
+	return n == 1; // 2+ foes in the radius, or camps only, cast as live
+}
+} // namespace nova::econ
