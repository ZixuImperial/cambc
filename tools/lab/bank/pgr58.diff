+			gm[n] = g;
+			hh[n] = b->h;
+			++n;
+		}
+		for (int i = 0; i < n; ++i)
+		{
+			if (gm[i] >= need && te[i] < pgr_te)
+			{
+				pgr_te = te[i];
+				pgr_te_h = hh[i];
+			}
