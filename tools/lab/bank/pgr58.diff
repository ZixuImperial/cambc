+// The retire start test: recall_safe's bush, camp and hidden-camp terms; one-turn reach for every visible living un-stunned foe but sh.
+static bool pgr_recall_ok(std::uint32_t sh)
+{
+	if (W.on_spawn || !pgr_guard_ok(pgr_recall_left()))
+		return false;
+	const int fn = foe_turns_during_recall();
+	for (const auto& e : W.enemies)
+	{
+		if (e.hp <= 0)
+			continue;
+		// RC C975f: a stunned foe (or the one my slot 0 stunned this turn) loses one turn: it must stay out of reach for the rest of the
+		// channel; every other foe out of its one-turn reach (the watch cancels when one comes into it)
+		const bool st = e.stunned || e.h == sh;
+		if (cheb(e.pos, W.me.pos) <= (st ? foe_reach_in_turns(e, std::max(0, fn - 1)) : foe_reach_in_turns(e, 1)))
+			return false;
+	}
+	if (combat::recall_bush_threat())
+		return false;
+	for (const auto& vc : W.camps)
+	{
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (vc.awake && c.attacks() && cheb(c.pos, W.me.pos) <= c.reach + 1)
+			return false;
+	}
+	if (now() - S.hurt_unseen <= 8)
+	{
+		std::vector<mv::Threat> th;
+		hidden_camp_threats(W.me.pos, th);
+		if (!th.empty())
+			return false;
+	}
+	return true;
+}
+// Bit 16's rules 1-3 target within 4 (a channeller, a kill, a 2.5 x Focus kill with slot 1 ready), or nullptr.
+static const Body* pgr_rule_target()
+{
+	const float F = W.me.foc * mu::mo(W.me);
+	const Body* best = nullptr;
+	int bd = BIG;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 4 || d >= bd)
+			continue;
+		const float eh = mu::ehp(e);
+		if ((e.state & ST_TRIBUTE) != 0 || eh <= 1.5f * F || (combat::ready(1) && eh <= 2.5f * F))
+		{
+			best = &e;
+			bd = d;
+		}
+	}
+	return best;
+}
+bool pgr_retire_watch()
+{
+	if (!pgr_latched || !pgr_hold_raw() || !(W.me.state & ST_RECALL) || (W.me.state & ST_TRIBUTE))
+		return false;
+	if (!pgr_guard_ok(pgr_recall_left()))
+		return true; // the return guard flipped: cancel, back to the seat
+	for (const auto& e : W.enemies)
+		if (!e.stunned && e.hp > 0 && cheb(e.pos, W.me.pos) <= foe_reach_in_turns(e, 1))
+			return true; // RC C975f: a foe came into one-turn reach: cancel and re-evaluate
+	return combat::ready(0) && pgr_rule_target() != nullptr;
