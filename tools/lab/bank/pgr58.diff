+static vec2 pgr_pt{ -1, -1 }; // bit 8's seat (pgr_seat_turn's cache)
+static int pgr_te = 1 << 20, pgr_ta = 0;
+static std::uint32_t pgr_te_h = 0;
+static bool pgr_guard_ok(int left)
