+		int bd = BIG;
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, W.me.pos) <= 4 && cheb(e.pos, W.me.pos) < bd)
+			{
+				bd = cheb(e.pos, W.me.pos);
+				t = &e;
+			}
+	}
