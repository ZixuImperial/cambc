+				{
+					pgr_te = std::max(te[i], te[j]);
+					pgr_te_h = te[i] >= te[j] ? hh[i] : hh[j];
+				}
+		}
+	}
+	v = pgr_ta + 3 <= pgr_te;
+	return v;
+}
+static int pgr_recall_left()
