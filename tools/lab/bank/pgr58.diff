+		const Body tb = *t; // the cast re-reads the units
+		if (combat::ready(0) && combat::cast_on_champion(0, tb))
+			sh = marcella_layer::fight_stun_wasted(tb) ? 0u : tb.h; // stunned this turn (a stun-immune foe is not)
+		else if (combat::ready(1))
+			(void)combat::cast_at(1, tb.pos);
+	}
+	if (pgr_recall_ok(sh) && start_recall())
+		return true;
