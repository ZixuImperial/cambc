+// MGJ bit 1: Marcella joins a mate's capture that pays at the next round start (see econ_flags.h). True: I stepped on (end the turn).
+bool mgj_join()
+{
+	if (!W.alive || W.me.type != cambc::champion_type::marcella || W.me.channeling() || W.me.stunned || W.me.frac() < 0.5f || !W.can_move() || M.camp_at.empty())
+		return false;
+	if (busy_capturing() || M.camp_index(W.me.pos) >= 0)
+		return false; // MGJ-A: never leave a region I stand on (an empty region resets, GameRules:196)
+	if (W.me.gems >= 10u && bank_dist_here() == 0)
+		return false; // never off a tribute tile with a bag
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 6)
+			return false;
+	for (const auto& ts : intel::team_table())
+		if (ts.alive && now() - ts.round <= 3 && cheb(ts.pos, W.me.pos) <= 6)
+			return false; // a foe remembered within 3 rounds
+	// one pass over the allies: the groups they stand on and how many stand on each
+	std::array<int, 8> mg{}, mn{}, ms{};
+	int n = 0;
+	for (const auto& al : W.allies)
+	{
+		const int ci = M.camp_index(al.pos);
+		if (ci < 0 || ci >= M.nc)
+			continue;
+		const int gg = M.camps[static_cast<std::size_t>(ci)].group;
+		if (gg < 0)
+			continue;
+		int q = 0;
+		while (q < n && mg[static_cast<std::size_t>(q)] != gg)
+			++q;
+		if (q == n)
+		{
+			if (n >= 8)
+				continue;
+			mg[static_cast<std::size_t>(n)] = gg;
+			mn[static_cast<std::size_t>(n)] = 0;
+			ms[static_cast<std::size_t>(n)] = al.slot;
+			++n;
+		}
+		++mn[static_cast<std::size_t>(q)];
+		if (al.kit && al.kit->gem_focus)
+			mn[static_cast<std::size_t>(q)] = 99; // never beside the Prism (her bag rule stays)
+	}
+	for (int q = 0; q < n; ++q)
+	{
+		if (mn[static_cast<std::size_t>(q)] != 1)
+			continue;
+		const int gi = mg[static_cast<std::size_t>(q)];
+		const auto& g = M.groups[static_cast<std::size_t>(gi)];
+		if (g.members.empty() || (g.gold < 20 && g.gems < 6))
+			continue;
+		const int hs = ms[static_cast<std::size_t>(q)];
+		if (hs >= 0 && hs < P.n && mu::holds_prospector(hs) && !mu::holds_prospector(my_slot()))
+			continue; // MGJ-B: his Prospector bonus would then apply to half the reward (GameRules:297)
+		cambc::detail::camp_group_capture_state cs{};
+		if (cambc::detail::sdk_camp_group_capture_state(g.handle, &cs) != 0 || cs.state != 1 || cs.timer < 1 || cs.timer > (MGJ_ON(2) ? 2 : 1))
+			continue;
+		vec2 step{ -1, -1 }, far{ -1, -1 };
+		for (int ci : g.members)
+		{
+			const vec2 t = M.camps[static_cast<std::size_t>(ci)].pos;
+			const int d = cheb(t, W.me.pos);
+			if (d < 1 || d > 2 || (d == 2 && !MGJ_ON(2)) || !mv::free_tile(t))
+				continue;
+			if (d == 1 && step.x < 0)
+				step = t;
+			else if (d == 2 && far.x < 0)
+				far = t;
+		}
+		if (step.x >= 0 && mv::try_move(step))
+			return true;
+		if (MGJ_ON(2) && cs.timer == 2 && far.x >= 0) // MGJ bit 2: one step toward the region now
+			for (const vec2 dd : DIRS)
+			{
+				const vec2 nb = W.me.pos + dd;
+				if (inb(nb) && cheb(nb, far) == 1 && mv::free_tile(nb) && !mv::foe_guarded(nb) && mv::try_move(nb))
+					return true;
+			}
+	}
+	return false;
+}
