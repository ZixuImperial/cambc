+// v7xx WRD bit 1 WCH1: called flag-first just before a recall start. act() returns on a channeling body, so a ready charge would
+// wait out the recall and land at spawn; one coverage pass at the lowest bar keeps the ward on the field the body leaves (GR:118).
+bool place_before_recall()
+{
+	if (!W.alive || P.my_slot < 0 || W.me.stunned || sps_pending)
+		return false;
+	const int t = now();
+	if (t < ready_round || fuel() < wfs_actf())
+		return false;
+	try
+	{
+		refresh_self(); // this turn's moves
+		if (W.me.channeling() || (W.me.state & ST_ALIVE) == 0)
+			return false;
+		read_consts();
+		scan_allied_wards();
+		const auto& self = cambc::self();
+		if (self.ward_cooldown() > 0 || !spot_cache_ready())
+			return false;
+		const vec2 me = prepare_check(t);
+		if (reachable_weights(me) < BAR_MIN)
+			return false;
+		const PlaceChoice pick = pick_ward_tile(me, t, BAR_MIN);
+		if (pick.best.x < 0 || pick.best_v < BAR_MIN)
+			return false;
+		place_chosen_ward(self, t, pick.best, pick.best_v);
+		return true;
+	}
+	catch (const RestartTurn&)
+	{
+		throw;
+	}
+	catch (const std::exception& e)
+	{
+		(void)e;
+		return false;
+	}
+}
