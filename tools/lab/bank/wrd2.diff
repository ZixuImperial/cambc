+// WRD (b1856, Rule Checker X291 ward minors). Runtime data flag WRD_TAB[1], read first; 0 = v746. Bit 1 WCH1: a ready charge is placed
+// (one pick at BAR_MIN) before a recall start. Bit 2 WRT1: pick_ward_tile also tries the rest of the Chebyshev-2 square inside the same
+// miss budget. Bit 4 WCT1: a seen living camp's tile is a ward candidate (engine rc 0); unseen camp tiles still block.
+#define WRD_BITS 0
+inline const volatile int WRD_TAB[2] = { 0x57524431, WRD_BITS }; // slot 0 magic keeps it out of .bss
+#define WRD_ON(b) ((WRD_TAB[1] & (b)) != 0)
