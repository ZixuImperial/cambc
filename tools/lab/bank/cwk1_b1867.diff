+// v7xx CWK: the walking crew pick being held (its pick round, crew and walk when first seen), and the group whose hold ran out (this life).
+int cwk_r = -1000, cwk_g = -1, cwk_crew0 = 1, cwk_walk0 = 0, cwk_spent_g = -1;
+int cwk_why = 0; // the last test's answer: 0 hold, 1 not a crew pick, 2 ran out, 3 group gone, 4 hurt or banking, 5 no mate claims it, 6 foe near, 7 past the bound now, 8 not heavy (bit 4 off)
+static bool cwk_hold()
+{
+	const int g = T.target;
+	if (g < 0 || g >= M.ng)
+		return (cwk_why = 1), false;
+	if (cwk_spent_g >= 0 && cwk_spent_g < M.ng && mem[static_cast<std::size_t>(cwk_spent_g)].status == GS_RESPAWN)
+		cwk_spent_g = -1; // captured since: a new life
+	if (T.chosen != cwk_r || g != cwk_g)
+	{
+		cwk_r = T.chosen;
+		cwk_g = g;
+		cwk_crew0 = T.crew;
+		cwk_walk0 = travel[static_cast<std::size_t>(g)] == UNREACH ? 0 : static_cast<int>(travel[static_cast<std::size_t>(g)]);
+	}
+	if (cwk_crew0 < 2)
+		return (cwk_why = 1), false;
+	if (g == cwk_spent_g)
+		return (cwk_why = 2), false;
+	const auto& m = mem[static_cast<std::size_t>(g)];
+	if (m.status == GS_RESPAWN || m.fail_until > now())
+		return (cwk_why = 3), false;
+	if (W.me.frac() < 0.5f || pcf_calm == W.round)
+		return (cwk_why = 4), false;
+	int mates = 0;
+	for (int s = 0; s < comms::CLAIM_SLOTS && s < 8; ++s)
+		if (s != my_slot() && comms::cgroup(s) == g)
+			++mates;
+	if (mates == 0)
+		return (cwk_why = 5), false;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 6)
+			return (cwk_why = 6), false;
+	if (now() - T.chosen > cwk_walk0 + CWK_TAB[2])
+	{
+		cwk_spent_g = g; // the hold ends once
+		return (cwk_why = 7), false;
+	}
+	if (!CWK_ON(4) && !he_group(M.groups[static_cast<std::size_t>(g)]))
+		return (cwk_why = 8), false;
+	return (cwk_why = 0), true;
+}
