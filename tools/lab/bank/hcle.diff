+		if (!err)
+			hcl_e_r0 = -1000;
+		else if (hcl_prev_grp)
+			hcl_e_r0 = W.round;
+		e = err && W.round - hcl_e_r0 <= 10;
+		hcl_prev_grp = W.alive && group >= 0;
+	}
+	const bool b = (HCL_ON(2) && W.alive && x >= 100 && group >= 0 && group == hcl_pub) || e;
+	const int s = P.my_slot;
+	if (s >= 0 && s < comms::hcl_f.w)
+		comms::spare_put(comms::Spare{ comms::hcl_f.off + s, 1 }, b ? 1u : 0u);
+}
