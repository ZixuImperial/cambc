+std::array<int, 8> hcl_g{ -1, -1, -1, -1, -1, -1, -1, -1 }; // HCL bit 1: each mate's last group claim read
+std::array<int, 8> hcl_r{}; // HCL bit 1: the round it was read
+std::array<int, 8> hcl_pk{}; // HCL bit 4: the mate's claim kind last turn
+std::array<int, 8> hcl_z{ -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000 }; // HCL bit 4: the round its digit went fight -> 0
+// HCL bit 1: a mate whose byte shows its fight state in place of its group keeps that group for HCL_K rounds.
+void hcl_hold(int s, std::size_t ss)
+{
+	if (HCL_ON(4)) // bit 4: a fight -> 0 step restarts the 10-round cap (Shared Mem)
+	{
+		const int k0 = comms::ckind(s);
+		if (k0 == 0 && hcl_pk[ss] >= 4)
+			hcl_z[ss] = now();
+		hcl_pk[ss] = k0;
+	}
+	const int g = TM.claim[ss];
+	if (g >= 0)
+	{
+		hcl_g[ss] = g;
+		hcl_r[ss] = now();
+		return;
+	}
+	const int G = hcl_g[ss];
+	if (G < 0)
+		return;
+	if (HCL_ON(6) && comms::hcl_f.ok()) // bits 2/4: the mate's HOLD bit decides (bit 2 no K; bit 4 at code 0 for HCL_K rounds)
+	{
+		const int kd = comms::ckind(s);
+		if (s >= comms::hcl_f.w || ((comms::spare_get(comms::hcl_f) >> s) & 1u) == 0 || !siege_ally_alive(s) || G >= M.ng ||
+			!((HCL_ON(2) && kd >= 4) || (HCL_ON(4) && kd == 0 && now() - std::max(hcl_r[ss], hcl_z[ss]) <= HCL_TAB[2])))
+		{
+			hcl_g[ss] = -1;
+			return;
+		}
+	}
+	else if (!HCL_ON(3))
+	{
+		hcl_g[ss] = -1; // bit 4 alone without the field: no keep
+		return;
+	}
+	else if (comms::ckind(s) < 4 || now() - hcl_r[ss] > HCL_TAB[2] || !siege_ally_alive(s) || G >= M.ng ||
+		(static_cast<std::size_t>(G) < mem.size() && mem[static_cast<std::size_t>(G)].status == GS_RESPAWN))
+	{
+		hcl_g[ss] = -1;
+		return;
+	}
+	TM.claim[ss] = G; // v717 HCL: the hidden claim still counts
+	TM.busy[ss] = false;
+}
