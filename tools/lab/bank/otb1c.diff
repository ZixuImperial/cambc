+	if (now() - otb_last > 1)
+		otb_n = 0; // a new approach
+	if (otb_n >= OTB_TAB[4])
+		return false; // the cap: walk in as today
+	int nf = 0, foe_bags = 0;
+	float pf = 0.0f;
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		const Body* b = intel::team_body(i);
+		if (tt[i].alive && b)
+			foe_bags += static_cast<int>(b->gems);
+		if (!tt[i].alive || (tt[i].src != 1 && tt[i].src != 2) || now() - tt[i].round > 5 || cheb(tt[i].pos, al->pos) > 6)
