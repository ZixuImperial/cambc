+// b2373 OTB (econ_flags.h): one altar group (4-connected altar tiles), computed once.
+static bool otb_one_altar()
+{
+	static int v = -1;
+	if (v >= 0)
+		return v == 1;
+	const int n = static_cast<int>(M.altars.size());
+	if (n == 0)
+		return (v = 0) == 1;
+	std::vector<int> seen(static_cast<std::size_t>(n), 0), st;
+	st.push_back(0);
+	seen[0] = 1;
+	int got = 1;
+	while (!st.empty())
+	{
+		const int i = st.back();
+		st.pop_back();
+		for (int j = 0; j < n; ++j)
+			if (!seen[static_cast<std::size_t>(j)])
+			{
+				const vec2 a = M.altars[static_cast<std::size_t>(i)].pos, b = M.altars[static_cast<std::size_t>(j)].pos;
+				if (std::abs(a.x - b.x) + std::abs(a.y - b.y) == 1)
+				{
+					seen[static_cast<std::size_t>(j)] = 1;
+					st.push_back(j);
+					++got;
+				}
+			}
+	}
+	v = got == n ? 1 : 0;
+	return v == 1;
+}
+static int otb_n = 0, otb_last = -1000; // OTB: hold rounds in a row, the last held round
