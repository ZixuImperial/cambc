+// b2365 WFC bit 1 (caller read the flag): a pick farther than 15 from the dead gold group I wait out becomes my best group within 15 of
+// it (best_within); none within 15: live's pick.
+template <int DM>
+int wfc_filter_pick(int g, float* out_rate, int* out_crew)
+{
+	const int wg = wfc_group();
+	if (wg < 0 || g < 0 || g >= M.ng)
+		return g;
+	const vec2 an = M.groups[static_cast<std::size_t>(wg)].anchor;
+	if (cheb(M.groups[static_cast<std::size_t>(g)].anchor, an) <= 15)
+		return g;
+	float r = 0.0f;
+	int c = 1;
+	linear_score::lnr_save(); // RC C1006: the extra rating read leaves rf_* and the linear score's state as it found them
+	const int gq = best_within<DM>(an, 15, claims_for_me(), &r, &c);
+	linear_score::lnr_restore();
+	if (gq < 0)
+		return g;
+	*out_rate = r;
+	*out_crew = c;
+	return gq;
+}
