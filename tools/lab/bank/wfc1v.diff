+// b2365 WFC bit 1 (callers read the flag): the foe deaths I saw, and the dead big contested gold group survivors wait out (once a round).
+static int wfc_kr[8] = { -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000 };
+static vec2 wfc_kp[8];
+static int wfc_ki = 0;
+void wfc_note_kill(vec2 p, int now)
+{
+	wfc_kr[wfc_ki & 7] = now;
+	wfc_kp[wfc_ki & 7] = p;
+	++wfc_ki;
+}
+int wfc_group()
+{
+	static int r = -1000, v = -1;
+	if (r == now())
+		return v;
+	r = now();
+	v = -1;
+	if (!W.alive || !M.done() || W.me.frac() < 0.5f || W.me.gems >= 30)
+		return v;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 8)
+			return v;
+	for (int g = 0; g < M.ng && g < static_cast<int>(mem.size()); ++g)
+	{
+		const GroupI& gr = M.groups[static_cast<std::size_t>(g)];
+		if (gr.gold < 150 || gr.contest < 0.35f || gr.contest > 0.65f || cheb(W.me.pos, gr.anchor) > 15)
+			continue;
+		const GroupMem& m = mem[static_cast<std::size_t>(g)];
+		const int due = m.respawn_at - now();
+		if ((m.status != GS_RESPAWN && m.status != GS_CLEARED) || due < 0 || due > 40)
+			continue;
+		int nk = 0, last2 = -1000;
+		for (int i = 0; i < 8; ++i)
+			if (now() - wfc_kr[i] <= 15 && cheb(wfc_kp[i], gr.anchor) <= 15)
+				++nk;
+		if (nk < 2)
+		{
+			// the episode lasts 45 rounds from its second death: two deaths within 15 rounds of each other near the group
+			for (int i = 0; i < 8; ++i)
+				for (int j = 0; j < 8; ++j)
+					if (i != j && wfc_kr[i] >= wfc_kr[j] && wfc_kr[i] - wfc_kr[j] <= 15 && cheb(wfc_kp[i], gr.anchor) <= 15 && cheb(wfc_kp[j], gr.anchor) <= 15)
+						last2 = std::max(last2, wfc_kr[i]);
+			if (now() - last2 > 45)
+				continue;
+		}
+		v = g;
+		return v;
+	}
+	return v;
+}
