+// BN6 bit 2 PTB2 (econ_flags.h): a capture already paid at turn start goes straight into capture()'s pay branch (bookkeeping,
+// mark_respawn, drop_target(0)) before the stage chain. The same pay test as capture() (a gain while the engine shows the group alive
+// or unpaid is not the capture). Caller read the flag.
+void ptb2_settle()
+{
+	if (!T.capturing || T.target < 0 || !W.alive)
+		return;
+	const int gi = T.target;
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	const bool gain = W.me.gems > T.cap_gems || W.gold > T.cap_gold;
+	if (!gain && m.status != GS_RESPAWN)
+		return;
+	if (gain && m.status != GS_RESPAWN)
+	{
+		const int gs = group_state_now(gi);
+		if (gs == 1 || gs == 2 || (gs == 0 && !(S.recall_round > T.cap_on)))
+			return;
+	}
+	const int la = last_act;
+	capture(gi);
+	last_act = la;
+}
