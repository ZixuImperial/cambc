 int claim_group(std::uint8_t c)
 {
+	if (BCL_ON(1) && bcl_big)
+	{
+		const int r = static_cast<int>(c & 0x7F) - 1; // BCL bit 1: a rank
+		return (bcl_on && r >= 0 && r < 126) ? bcl_list[static_cast<std::size_t>(r)] : -1;
+	}
 	return static_cast<int>(c & 0x7F) - 1;
 }
