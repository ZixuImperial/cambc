+// v8xx PTF (b2349, b2381; owner 13 Nov: "after we do our turn ... polling every 30 instructions ... worst case neutral"): the post-action
+// table fill. Its only cut is a planned one: rows and the stages before them run only when their cost fits (reserve PTF_TAB[4]), so the
+// engine never cuts them; the k-list closure runs to the cut, polling the fuel every PTF_TAB[2] instructions of work (a rise = the engine
+// resumed the call in a new round). ptf_job (1 rows, 2 closure) is set before the work and cleared when it ends: a set job at the next
+// turn's start is the recognised, planned cut. No post-action work on a turn that ended under PTF_TAB[3] fuel or after a bailed or
+// suspended turn (af_heavy_round within AF_HEAVY_KEEP). The fill writes only xt_* tables and tvm_gen: no action, comms, travel stamp
+// or cost meter.
+int ptf_round = -1;
+int ptf_job = 0;      // the planned job in flight (0 none, 1 rows, 2 closure)
+int ptf_cut_job = 0;  // the job a planned cut fell in (read at the next turn's start)
+long ptf_last = 0, ptf_cd = 0;
+int ptf_cl_row = -1, ptf_cl_pass = -1; // the closure row and pass a planned cut left part-done (resumes at ptf_cl_j; a relaxation is idempotent)
+std::size_t ptf_cl_j = 0;
+bool ptf_new = false;
+bool ptf_poll()
+{
+	ptf_cd = PTF_TAB[2];
+	const long f = fuel();
+	if (f > ptf_last && static_cast<int>(round_number_nc()) != ptf_round)
+		ptf_new = true;
+	ptf_last = f;
+	return ptf_new;
+}
+// The closure (as travel_close_step, the same relaxations in the same order), polled inside the inner loop.
+static void ptf_close()
+{
+	if (xt_mode == 0 || xt_mode == 255)
+	{
+		xt_cl_done = true;
+		return;
+	}
+	const std::size_t n = static_cast<std::size_t>(xt_n), k = static_cast<std::size_t>(xt_mode);
+	std::uint16_t* d = xt_d.data();
+	const std::uint8_t* m = xt_raw.data();
+	const std::size_t sz = xt_raw.size();
+	while (true)
+	{
+		const std::size_t a = static_cast<std::size_t>(xt_cl_row);
+		std::uint16_t* ra = d + a * n;
+		for (std::size_t j = ptf_cl_row == xt_cl_row && ptf_cl_pass == xt_cl_pass ? ptf_cl_j : 0; j < k; ++j)
+		{
+			const std::size_t o = xt_go + (a * k + j) * 2;
+			if (o + 1 >= sz)
+				break;
+			const std::size_t c = m[o];
+			if (c >= n || c == a || ra[c] == UNREACH)
+				continue;
+			const int dac = ra[c];
+			const std::uint16_t* rc = d + c * n;
+			for (std::size_t b = 0; b < n; ++b)
+			{
+				if ((ptf_cd -= 8) <= 0 && ptf_poll()) // ~8 instructions a step
+				{
+					ptf_cl_row = xt_cl_row;
+					ptf_cl_pass = xt_cl_pass;
+					ptf_cl_j = j;
+					return;
+				}
+				if (rc[b] != UNREACH && dac + rc[b] < ra[b])
+				{
+					const int v = std::min(60000, dac + static_cast<int>(rc[b]));
+					ra[b] = static_cast<std::uint16_t>(v);
+					d[b * n + a] = static_cast<std::uint16_t>(v);
