+// b2363 GEZ bits 1+2 (Deep spec_gez_1113; caller read GEZ_TAB first): a foe bag that ends the game (tributed_them + bag >= WIN_TRIBUTE),
+// seen now or by my own sight within GEZ_TAB[2] rounds, before any channel. A lock holder walks to the lock ring of the altar nearest that
+// foe, places our lock when none of ours stands, and holds the ring (no farm walk); off on a lethal FLEE (HP < GEZ_TAB[3] %).
+static __attribute__((noinline)) const Body* gez_foe(vec2& at)
+{
+	for (const auto& e : W.enemies)
+		if (W.tributed_them + static_cast<int>(e.gems) >= rs::WIN_TRIBUTE)
+		{
+			at = e.pos;
+			return &e;
+		}
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		if (!tt[i].alive || tt[i].pos.x < 0 || intel::team_body_round(i) < W.round - GEZ_TAB[2])
+			continue;
+		const Body* b = intel::team_body(i);
+		if (b && W.tributed_them + static_cast<int>(b->gems) >= rs::WIN_TRIBUTE)
+		{
+			at = tt[i].pos;
+			return b;
+		}
+	}
+	return nullptr;
+}
