@@ -578,12 +578,139 @@ float hunt_prize(const Body& e)
 __attribute__((always_inline)) bool game_deny(const Assessment& a)
 {
 	if (!W.alive || W.me.channeling() || M.altars.empty() || !W.me.kit)
 		return false;
