+// RDN (b1759, Deep spec_rdn_1109.md with the Planner's edits): race-aware pre-emptive altar lock. 0 = v646 nova_base_v646. Trigger: a mate
+// (not me) holds a winning bag (our tributed + its bag >= 1000) and the foe could finish first (1000 - foe tributed <= RDN_N, or
+// prism::foe_finish_eta() <= the carrier's landing + RDN_M). Then the RDN_K nearest eligible bodies (not the carrier, not within 6 of it,
+// not channelling, CALM, carrying a lock for bit 1) walk to the altar(s) the carrier is not using, nearest the foes' last-known bags
+// first. Bit 1: place the lock within GD_LOCK_R and hold within 3 (game_deny's cancel acts on a channel seen there). Bit 2: go and hold, no lock.
+#define RDN_BITS 0
+#define RDN_N 250
+#define RDN_M 20
+#define RDN_K 1
+#define RDN_RECHECK 4 // fuel: rounds between quiet trigger checks
+inline const volatile int RDN_TAB[5] = { 0x52444E31, RDN_BITS, RDN_N, RDN_M, RDN_K }; // slot 0 magic keeps it out of .bss
+#define RDN_ON(b) ((RDN_TAB[1] & (b)) != 0)
