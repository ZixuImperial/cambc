 }
+// RDN (b1759, spec_rdn_1109.md): returns the altar I should cover (and sets *carrier), or {-1,-1} when the trigger is off or I am not one
+// of the RDN_K nearest eligible bodies. No action here.
+__attribute__((noinline)) vec2 rdn_target(int* carrier_out)
+{
+	const vec2 none{ -1, -1 };
+	static int rdn_skip_until = -1; // fuel: a quiet check waits RDN_RECHECK rounds before the next (bags and totals move slowly)
+	if (W.round < rdn_skip_until || W.tributed_them >= 1000 || M.altars.empty())
+		return none;
+	int carrier = -1;
+	std::uint32_t cg = 0;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == P.my_slot)
+			continue;
+		std::uint32_t g = 0;
+		if (cambc::detail::sdk_champion_gems(P.handle[static_cast<std::size_t>(s)], &g) != 0)
+			continue;
+		if (static_cast<long>(W.tributed_us) + static_cast<long>(g) >= 1000 && g > cg)
+		{
+			carrier = s;
+			cg = g;
+		}
+	}
+	if (carrier < 0 || static_cast<long>(W.tributed_us) + static_cast<long>(W.me.gems) >= 1000)
+	{
+		rdn_skip_until = W.round + RDN_RECHECK;
+		return none; // no winning bag on a mate (my own winning bag banks: not a denial body)
+	}
+	const Body* cb = W.ally_by_slot(carrier);
+	vec2 c_alt{ -1, -1 };
+	int c_walk = 0;
+	if (cb)
+	{
+		int bd = 1 << 20;
+		for (const auto& al : M.altars)
+			if (cheb(al.pos, cb->pos) < bd)
+			{
+				bd = cheb(al.pos, cb->pos);
+				c_alt = al.pos;
+			}
+		c_walk = std::max(0, bd - 1);
+	}
+	const int t_us = c_walk + rs::tribute_turns(static_cast<int>(cg), false);
+	const bool close = 1000 - W.tributed_them <= RDN_TAB[2] || prism::foe_finish_eta() <= static_cast<double>(t_us + RDN_TAB[3]);
+	if (!close)
+	{
+		rdn_skip_until = W.round + RDN_RECHECK;
+		return none;
+	}
+	if (W.me.channeling() || !W.me.kit || (cb && cheb(cb->pos, W.me.pos) <= 6))
+		return none; // never the carrier's escort
+	// altars the carrier is not using, nearest the foes' last-known bags first (else nearest their spawn)
+	std::array<vec2, 16> cand{};
+	std::array<int, 16> key{};
+	int nc = 0;
+	const auto& tt = intel::team_table();
+	for (const auto& al : M.altars)
+	{
+		if (nc >= 16 || (al.pos == c_alt && M.altars.size() > 1))
+			continue;
+		int k = 1 << 20;
+		for (std::size_t i = 0; i < tt.size(); ++i)
+		{
+			const Body* b = intel::team_body(i);
+			if (tt[i].alive && tt[i].round > -1000 && b && b->gems > 0)
+				k = std::min(k, cheb(tt[i].pos, al.pos));
+		}
+		if (k == (1 << 20))
+			k = 1000 + cheb(M.enemy_anchor, al.pos);
+		int j = nc++;
+		while (j > 0 && key[static_cast<std::size_t>(j - 1)] > k)
+		{
+			cand[static_cast<std::size_t>(j)] = cand[static_cast<std::size_t>(j - 1)];
+			key[static_cast<std::size_t>(j)] = key[static_cast<std::size_t>(j - 1)];
+			--j;
+		}
+		cand[static_cast<std::size_t>(j)] = al.pos;
+		key[static_cast<std::size_t>(j)] = k;
+	}
+	if (nc == 0)
+		return none;
+	const bool need_lock = RDN_ON(1);
+	const bool our_lock = deny::bbl_our_lock_on(cand[0]);
+	if (need_lock && !our_lock && deny::locks_carried() <= 0)
+		return none;
+	// my rank among the eligible visible bodies by distance to the first altar
+	const int dme = cheb(W.me.pos, cand[0]);
+	int rank = 0;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot == carrier || al.channeling() || !al.kit || (cb && cheb(cb->pos, al.pos) <= 6))
+			continue;
+		if (need_lock && !our_lock)
+		{
+			std::array<std::uint32_t, 4> cnt{};
+			if (cambc::detail::sdk_champion_consumables(al.h, cnt.data()) != 0 || cnt[RAW_LOCK] == 0)
+				continue;
+		}
+		const int d = cheb(al.pos, cand[0]);
+		rank += (d < dme || (d == dme && al.slot < P.my_slot)) ? 1 : 0;
+	}
+	if (rank >= RDN_TAB[4])
+		return none;
+	if (carrier_out)
+		*carrier_out = carrier;
+	return cand[static_cast<std::size_t>(std::min(rank, nc - 1))];
+}
+// RDN action (CALM turns, after game_deny): lock the altar (bit 1) or go and hold within 3 of it. True if the turn was used.
+bool rdn_turn(const Assessment& a)
+{
+	if (a.stance != CALM || !W.alive || M.altars.empty())
+		return false;
+	int carrier = -1;
+	const vec2 alt = rdn_target(&carrier);
+	if (alt.x < 0)
+		return false;
+	const int d = cheb(W.me.pos, alt);
+	if (RDN_ON(1) && !deny::bbl_our_lock_on(alt) && deny::locks_carried() > 0)
+	{
+		if (d <= deny::tune::GD_LOCK_R && deny::place_lock(alt))
+			return true;
+		return W.can_move() && !W.moved && mv::step_to(alt, deny::tune::GD_LOCK_R);
+	}
+	if (d > 3)
+		return W.can_move() && !W.moved && mv::step_to(alt, 3);
+	return true; // hold: a foe channel here is seen, and game_deny acts on it first
+}
