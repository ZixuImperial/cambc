 // econ_shop.cc: Buying at the shop.
 #include "econ_internal.h"
 namespace nova::econ {
+// b2426 RSS (caller read the flag): Ryth's first one (bit 1) or two (bit 2) emblems take Strength (see econ_flags.h).
+static int rss_fam[2] = { -2, -2 }; // -2: not latched yet; -1: none
+static void rss_strength_pass(const decltype(cambc::self().item_count())& counts)
+{
+	if (!W.me.kit || !ryth_layer::kit(*W.me.kit))
+		return;
+	auto owned_any = [&](std::uint32_t fam) {
+		for (std::uint32_t v = 0; v < 6u; ++v)
+			if (counts[cambc::item_type(fam * 6u + v)] > 0)
+				return true;
+		return false;
+	};
+	if (rss_fam[0] == -2)
+	{
+		const int n = RSS_ON(2) ? 2 : 1;
+		for (int j = 0; j < 2; ++j)
+		{
+			rss_fam[j] = -1;
+			if (j < n && static_cast<std::size_t>(j) < build.size())
+			{
+				const auto fam = static_cast<std::uint32_t>(build[static_cast<std::size_t>(j)]) / 6u;
+				if (fam != 12u && !owned_any(fam) && (j == 0 || static_cast<int>(fam) != rss_fam[0])) // never Greed
+					rss_fam[j] = static_cast<int>(fam);
+			}
+		}
+	}
+	for (int j = 0; j < 2; ++j)
+	{
+		if (rss_fam[j] < 0)
+			continue;
+		const auto fam = static_cast<std::uint32_t>(rss_fam[j]);
+		const auto str = cambc::item_type(fam * 6u), hp = cambc::item_type(fam * 6u + 4u);
+		const bool has_str = counts[str] > 0 || counts[cambc::item_type(fam * 6u + 1u)] > 0;
+		const bool has_hp = counts[hp] > 0 || counts[cambc::item_type(fam * 6u + 5u)] > 0;
+		if (has_hp && !has_str)
+			continue; // he started (or finished) its Health variant first: never changed
+		for (auto& t : build)
+			if (static_cast<std::uint32_t>(t) / 6u == fam)
+			{
+				t = str; // the first entry of the latched family
+				break;
+			}
+	}
+}
