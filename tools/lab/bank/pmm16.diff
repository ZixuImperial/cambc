+static int pmm_box_dist(const GroupI& g, vec2 t)
+{
+	const int dx = t.x < g.bx0 ? g.bx0 - t.x : (t.x > g.bx1 ? t.x - g.bx1 : 0);
+	const int dy = t.y < g.by0 ? g.by0 - t.y : (t.y > g.by1 ? t.y - g.by1 : 0);
+	return std::max(dx, dy);
+}
+void pmm_turn()
+{
+	pmm_g = -1;
