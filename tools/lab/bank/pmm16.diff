+	{
+		const Body& e = W.enemies[x];
+		if (e.stunned || e.type == cambc::champion_type::marcella || cheb(e.pos, W.me.pos) > static_cast<int>(W.me.kit->cc_range))
+			continue; // RC C1331: Marcella is stun-immune (GR:656)
+		int rb2 = 0; // next-round rank; ties count against her (a foe tie acts first)
+		for (std::size_t y = 0; y < m; ++y)
+			rb2 += pb2[y] > pb2[x] ? 1 : 0;
+		const bool still = (e.state & 32u) == 0; // RC C1331: its exact has-acted bit this round (ranks only for next round)
+		const bool first_next = we_start ? rb2 <= rh2 : rb2 < rh2; // next round the other team starts: the foe acts before her
+		if (!still || !first_next)
+			continue;
+		const int r1 = combat::foe_next_turn_reach(e);
+		const int r2 = std::max(r1, 2 * r1 - e.range);
+		const int d = cheb(e.pos, her->pos);
+		if (d > r2 || d >= bd)
+			continue;
+		bd = d;
+		best = &e;
+	}
+	if (!best)
+		return false;
+	NLOG("r%d slot %d pmm double-turn stun\n", now(), P.my_slot);
+	return combat::cast::cast_via_sdk(W.me.kit->slot_cc, combat::KIND_CHAMPION, best->h, best->pos);
+}
+bool pmm_mate_stun()
+{
+	const int ps = pmm_prism_slot();
+	if (P.n < 4 || ps < 0 || ps == P.my_slot || cltf_kind(P.my_slot) != 0 || !W.alive || !W.me.kit || W.me.kit->slot_cc < 0 || W.me.channeling())
+		return false;
+	const Body* her = nullptr;
+	for (const auto& a : W.allies)
+		if (a.slot == ps)
+			her = &a;
+	if (!her)
+		return false;
+	const bool hit = (pmm_st_r >= now() - 1 && her->hp < pmm_st_hp - 0.5f) || her->stunned;
+	pmm_st_r = now();
+	pmm_st_hp = her->hp;
+	if (!hit || cheb(her->pos, W.me.pos) > 8 || !combat::ready(W.me.kit->slot_cc))
+		return false;
+	std::uint32_t bag = 0;
+	if (cambc::detail::sdk_champion_gems(her->h, &bag) != 0 || static_cast<int>(bag) < PMM_B)
+		return false;
+	const Body* best = nullptr;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, her->pos) <= combat::foe_next_turn_reach(e) && cheb(e.pos, W.me.pos) <= static_cast<int>(W.me.kit->cc_range) &&
+			(!best || cheb(e.pos, her->pos) < cheb(best->pos, her->pos)))
+			best = &e;
+	if (!best)
+		return false;
+	NLOG("r%d slot %d pmm stuns a foe on her\n", now(), P.my_slot);
+	return combat::cast::cast_via_sdk(W.me.kit->slot_cc, combat::KIND_CHAMPION, best->h, best->pos);
+}
