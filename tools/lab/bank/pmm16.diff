+	if (ps < 0 || ps == P.my_slot || ps >= comms::CLAIM_SLOTS || cltf_kind(P.my_slot) != 0)
+		return;
+	const int gi = comms::cgroup(ps);
+	if (gi < 0 || gi >= M.ng)
+		return;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	if (g.access != ACC_WALK || g.gems < PMM_GEMS || g.contest < 0.35f || g.contest > 0.65f || m.status == GS_RESPAWN)
