+// b2379 KID (caller read the flag): the parity-double threshold for me (my HP + shield; bit 2: x KID_TAB[2]/100 with a KID_TAB[3]+ bag)
+static float kid_thr()
+{
+	float h = eff_hp(W.me);
+	if (KID_ON(2) && static_cast<int>(W.me.gems) >= KID_TAB[3])
+		h *= static_cast<float>(KID_TAB[2]) / 100.0f;
+	return h;
+}
+// KID: is tile t inside a parity-double foe's two-turn reach with a two-turn burst >= thr?
+static bool kid_lethal_at(const Assessment& a, vec2 t, float thr)
+{
+	if (!enemy_starts(W.round + 1))
+		return false; // their team does not start the next round: no parity double
+	for (const auto& f : a.foes)
+	{
+		if (f.remembered || f.idx < 0 || f.idx >= static_cast<int>(W.enemies.size()) || f.reach < 0)
+			continue;
+		const Body& e = W.enemies[static_cast<std::size_t>(f.idx)];
+		if ((e.state & 32u) != 0 || e.stunned)
+			continue; // completed its turn this round (or stunned)
+		const int r2 = foe_two_turn_reach_after_turn_count(f, &e);
+		const int d = cheb(t, e.pos);
+		if (r2 < 0 || d > std::max(f.reach, r2))
+			continue;
+		const float b2 = burst::foe_two_turn_damage(e, d, burst::lethal_burst_hit(e, d, 0, nullptr));
+		if (b2 >= thr)
+			return true;
+	}
+	return false;
+}
+// KID bit 1 / 2 (caller read the flag): before the farm step, step out of a parity-double foe's lethal two-turn zone. True = moved.
+bool kid_step_out(const Assessment& a)
+{
+	if (W.moved || W.me.channeling() || a.foes.empty())
+		return false;
+	const float thr = kid_thr();
+	if (!kid_lethal_at(a, W.me.pos, thr))
+		return false;
+	const float hp = eff_hp(W.me);
+	vec2 best{ -1, -1 };
+	float bd = 1e30f;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			if (!dx && !dy)
+				continue;
+			const vec2 t{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!mv::free_tile(t) || kid_lethal_at(a, t, thr))
+				continue;
+			const float dv = danger_veto(a, t);
+			if (dv >= hp || dv >= bd)
+				continue;
+			bd = dv;
+			best = t;
+		}
+	return best.x >= 0 && mv::try_move(best);
+}
