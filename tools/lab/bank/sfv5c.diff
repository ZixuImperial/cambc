diff --git b/src/feat_sfv.cpp b/src/feat_sfv.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_sfv.cpp
@@ -0,0 +1,74 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_sfv.cpp (SFV): see feat_sfv.h. Only reached when SFV_ON(...) is true at the hook.
+#include "feat_sfv.h"
+namespace nova::feat::sfv
+{
+namespace
+{
+// firing counters, firecount's DG at each function entry: a decision changed
+bool trip_chp()
+{
+	return true;
+}
+int trip_clf(int r)
+{
+	return r;
+}
+} // namespace
+bool chp_want()
+{
+	if (!W.alive)
+		return false;
+	std::int32_t left = -1;
+	if (cambc::detail::sdk_champion_channel_time(static_cast<std::uint32_t>(cambc::detail::sdk_my_champion()), &left) != 0 || left > 1)
+		return false;
+	int nearest = BIG;
+	for (const auto& e : W.enemies)
+		nearest = std::min(nearest, cheb(e.pos, W.me.pos));
+	if (nearest > 9)
+		return false; // frb_lethal reads foes within 9 only
+	if (mv::camp_threat(W.me.pos) > 0)
+		return false; // dyn_priority's escape branch needs no camp threat
+	if ((W.me.frac() < 0.5f && nearest <= 6) || combat::frb_lethal())
+		return trip_chp();
+	return false;
+}
+int alt_reach(const Body& u, bool all_immune)
+{
+	if (!u.kit || all_immune)
+		return 1; // a lock only: the old measure
+	const Kit& k = *u.kit;
+	int r = 1;
+	if (k.slot_cc >= 0)
+		r = std::max(r, static_cast<int>(k.cc_range));
+	if (k.aoe_stun)
+		r = std::max(r, static_cast<int>(k.aoe_range + k.aoe_radius));
+	if (k.dash_stun)
+		r = std::max(r, static_cast<int>(k.dash_range + k.dash_radius));
+	return r;
+}
+int clf_rounds(vec2* anchor, float* camp_in, float incoming)
+{
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= 8)
+			return -1;
+	const auto& g = M.groups[static_cast<std::size_t>(econ::T.target)];
+	const float hp = econ::mem[static_cast<std::size_t>(econ::T.target)].hp_left;
+	if (!(hp > 0))
+		return -1; // unknown or gone
+	const float dps = econ::crew_here(econ::T.target).crew.dps(1);
+	const float rounds = hp / std::max(1.0f, dps); // no pays-soon bars: nothing hits me here (callers bound the rounds)
+	*anchor = g.anchor;
+	*camp_in = incoming;
+	return trip_clf(static_cast<int>(std::ceil(rounds)));
+}
+void alt_fire()
+{
+}
+bool lrf_fire()
+{
+	return true;
+}
+} // namespace nova::feat::sfv
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_sfv.h b/src/feat_sfv.h
new file mode 100644
--- /dev/null
+++ b/src/feat_sfv.h
@@ -0,0 +1,34 @@
+#pragma once
+// feat_sfv (SFV, b1620 small-fix bundle 5; Combat, 02gift_wrapping 01a1b9eb-cd14-7a30-a425-c59134cb8f98, us A). Flag SFV_BITS,
+// 0 = nova_b2703_gds1 (v618).
+// Bits: 1 CHP  a channelling body returns before dyn_priority, so it never raised its turn order (r434-435: a 503-HP Varg's
+//              24-gem tribute paid after the foe Vesper's kill). When my channel completes at my next turn start (timer <= 1),
+//              dyn_priority's escape branch (want 40: HP < 50% with a foe within 6, or frb_lethal; no camp threat) is applied
+//              before the channel-hold return. set_priority takes effect next round (GameRules.md:130), i.e. the completing turn.
+//       2 ALT  altar-hold (econ alh_turn_slow) measured a stunner's arrival to the altar-adjacent tiles (reach 1); a body whose
+//              tool is a ranged or dash stun needs only (distance - reach): cc_range, aoe_range + aoe_radius, dash_range +
+//              dash_radius (HoR 2 + 1, GameRules.md:826), the dash counted once (r503-518: HoR 13 from stun range, measured 16).
+//       4 LRF  combat as_foe_weight: a LONE ranged foe that can reach me soon kept B467_SYM .66 (x CAMP_BUSY_W .6 by an awake camp
+//              = .40 at d4, 1.0 at d3: FIGHT/FLEE flicker; 03reef v Sponge r367-372, our Vesper); the PACK_N gate of the full-weight
+//              override is dropped for ranged foes. 16 LRF2: bit 4 and such a foe also skips the awake-camp discount (variant).
+//       8 CLF  econ finish_rounds returned -1 when no camp threatens me, so a cluster-only remnant (no attacker left) never got
+//              LOOTFIX's finish exception and the body walked off harmless clusters (03shrines 01a1b887 r105). With no threat
+//              and no visible foe within 8: rounds = ceil(group's remembered living HP / the crew's dps here) (Builder spec).
+#include "common.h"
+#include "world.h"
+#define SFV_BITS 0
+inline const volatile int SFV_TAB[2] = { 0x53465631, SFV_BITS }; // slot 0 magic keeps it out of .bss
+#define SFV_ON(b) ((SFV_TAB[1] & (b)) != 0)
+#define SFV_BIT_CHP 1
+#define SFV_BIT_ALT 2
+#define SFV_BIT_LRF 4
+#define SFV_BIT_CLF 8
+#define SFV_BIT_LRF2 16
+namespace nova::feat::sfv
+{
+bool chp_want();                              // CHP: true = take priority 40 now (my channel completes at my next turn start)
+int alt_reach(const Body& u, bool all_immune); // ALT: the tiles from a tributer's tile u's stun tool reaches (>= 1)
+void alt_fire();                              // ALT: the firing counter (the hold the old reach would skip)
+int clf_rounds(vec2* anchor, float* camp_in, float incoming); // CLF: finish_rounds for a threat-free remnant (-1: no)
+bool lrf_fire();                              // LRF: the firing counter (always true)
+} // namespace nova::feat::sfv
