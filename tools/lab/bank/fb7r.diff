+		ep = fb7_ep;
+		n = 0;
+	}
+	for (int i = 0; i < n; ++i)
+		if (hs[static_cast<std::size_t>(i)] == h)
+		{
+			*v = vs[static_cast<std::size_t>(i)];
+			return 0;
+		}
+	const std::int32_t c = cambc::detail::sdk_bc_champion_priority(h, 0, v);
+	if (c == 0 && n < 16)
+	{
+		hs[static_cast<std::size_t>(n)] = h;
+		vs[static_cast<std::size_t>(n)] = *v;
+		++n;
+	}
