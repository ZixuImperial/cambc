+	const std::int32_t ca = cambc::detail::sdk_altar_lock(p.x, p.y, cambc::detail::absolute_team(cambc::team::ally), &out);
+	if (ca == 0)
+		return true; // has_altar_lock true; altar_lock_at reads the same ally lock
+	if (ca != NF && ca != NIV)
+		cambc::detail::check(ca); // has_altar_lock throws
+	cambc::detail::altar_lock_info e{};
+	const std::int32_t ce = cambc::detail::sdk_altar_lock(p.x, p.y, cambc::detail::absolute_team(cambc::team::enemy), &e);
+	if (ce == NF || ce == NIV)
+		return false;
+	cambc::detail::check(ce); // has_altar_lock throws
+	if (ca != NF)
+		cambc::detail::check(ca); // altar_lock_at: an ally read that failed other than not-found throws
+	out = e; // altar_lock_at: the enemy lock
+	return true;
