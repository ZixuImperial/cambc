+// FB7 bits 4 / 8: cambc::vision::has_altar_lock(p) then altar_lock_at(p) in raw reads: false where has_altar_lock is false, else
+// out = what altar_lock_at returns (our lock when it stands). Throws exactly where the two wrappers throw. 3-4 host calls -> 1-2.
+inline bool fb7_lock_read(vec2 p, cambc::detail::altar_lock_info& out)
+{
+	constexpr std::int32_t NF = static_cast<std::int32_t>(cambc::error_code::api_not_found), NIV = static_cast<std::int32_t>(cambc::error_code::api_not_in_vision);
