+bool wmc_mate_group(int gi)
+{
+	if (gi < 0 || gi >= M.ng)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+		if (s != P.my_slot && alive_slot(s) && comms::cgroup(s) == gi)
