+++ b/src/feat_esc.h
@@ -0,0 +1,31 @@
+#pragma once
+// feat_esc (ESC, b1554; Deep spec condor-work/reports/analysts/spec_esc_1108.md): bank under escort. bank_first's any-hit veto
+// skips a foe a visible mate is fighting (HANDED), when that foe cannot stun me before the channel ends and the handed foes'
+// damage over walk + channel stays below my HP + shield. Flag ESC_BITS, 0 = nova_base_v613.
+// Bits: 1 HAND (veto loop, econ.cpp bank_first; Deep CHANGE: bank_first also runs under FIGHT for a 20+ gem carrier within 1 of
+//         the altar, and banks there only when a foe was handed; no FINF branch there); 2 CALL (a hand-made bank posts HELP);
+//       4 FIGHT-WIDE (the FIGHT call at bank_first's own 10 gems and walk <= 6);
+//       8 WIDE (a mate within 2 of the foe hands it, not only an adjacent one); 16 FULL (handed foes' damage at full exposure, not half);
+//       32 PRISM (owner 8 Nov: her PC_CHAN_R guards yield for an ordered bank escorted by mates, plus a PROTECT help call; feat_esc.cpp pc_escort);
+//       HAB (Combat spec_hunt_at_altar.md; 20+ gem non-Prism carrier, altar within 2): 64 no hunt target when bank_first's foe test passes;
+//       128 no CALM->FIGHT start (foe not hitting me) then; 256 the VETOED case: no hunt and no start while the test fails;
+//       NAB (Econ spec_nab_1108.md): 512 want_bank banks a G+ bag at walk <= D (a foe that can hit must be held by a mate, ESC's veto; wb2_safe or ESC's lethal guard); D 8 (1024: 4, 2048: 12), G 20 (4096: 15, 8192: 30).
+// Hooks read the flag first: at 0 no helper runs.
+#include "common.h"
+#define ESC_BITS 0
+inline const volatile int ESC_TAB[2] = { 0x45534331, ESC_BITS }; // slot 0 magic keeps it out of .bss
+#define ESC_ON(b) ((ESC_TAB[1] & (b)) != 0)
+namespace nova::combat { struct Assessment; }
+namespace nova::feat::esc
+{
+extern bool fight_call; // bits 1/4: bank_first is running for fight_bank (FIGHT stance)
+void reset();                                // bank_first, before the veto loop
+bool handed(vec2 foe, int walk, int chan);   // a vetoing foe a mate is fighting: skip its veto (records it)
+bool after(int walk, int chan);              // after the loop: false refuses the bank (FIGHT without a hand, or lethal)
+void banked(bool ok, int walk);              // bank_first's bank() result
+bool pc_escort(int gems, int ticks, int site); // bit 32: prism.cpp chan_start_ok (0), doom_exempt (1 in a channel, 2 otherwise)
+bool hab_hunt_skip(const combat::Assessment& a); // bits 64/256: combat.cpp hd_assess
+bool hab_calm(const combat::Assessment& a);      // bits 128/256: combat.cpp as_stance_stronger
+bool nab_bank(int gems, int d); // bit 512: econ.cpp want_bank
+bool fight_bank(const combat::Assessment& a); // bit 1 (bit 4 wider): brain, FIGHT stance
+} // namespace nova::feat::esc
