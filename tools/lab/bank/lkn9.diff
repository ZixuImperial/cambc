+// b2355 LKN bit 1/2 (called with the flag read first, after flee_stage; the caller checks stance != FLEE, no foe in reach, not lethal,
+// not attacked, not channelling): in state K (my hit on a latched altar's foe lock within my last 2 turns, LKN_CAP rounds from the
+// first hit, the lock still stands with hits_remaining <= LKN_REM or 5) hit it now; a break with gems in range opens the tribute this
+// turn (p94, INT:129). Returns 2 when a tribute started, 1 after a hit with the lock still standing, 0 when K does not hold.
+int lkn_turn()
+{
+	if (!lkn_init || !M.has_altar)
+		return 0;
+	const int rem = LKN_ON(2) ? 5 : LKN_REM;
+	for (std::size_t i = 0; i < M.altars.size() && i < 16; ++i)
+	{
+		if (now() - lkn_last[i] > 2 || now() - lkn_first[i] > LKN_CAP)
+			continue;
+		const AltarI& a = M.altars[i];
+		cambc::detail::altar_lock_info lb{};
+		if (!enemy_altar_lock_direct(a.pos, lb) || static_cast<int>(lb.hits_remaining) > rem)
+			continue; // gone, unseen, or more hits left than the bit finishes
+		trf_lh_pref = &a; // F5: the latched altar's lock first
+		const bool hit = lock_hit(true);
+		trf_lh_pref = nullptr;
+		if (!hit)
+			return 0;
+		LKN_FIRE(1);
+		if (enemy_altar_lock_direct(a.pos, lb))
+			return 1;
+		lkn_first[i] = lkn_last[i] = -1000; // broken: the episode ends
+		LKN_FIRE(2);
+		if (W.me.gems > 0 && cheb(a.pos, W.me.pos) <= cambc::constants::submit_gems_range)
+		{
+			const TurnStep s = bank_channel_gate(a, W.me.pos);
+			if (s == TurnStep::Done)
+				return 2; // the gate acted (as in bank_i)
+			if (s == TurnStep::Next && bank_open_tribute_at(a))
+			{
+				LKN_FIRE(3);
+				return 2;
+			}
+		}
+		return 1;
+	}
+	return 0;
+}
+// b2355 LKN bit 8 (called with the flag read first and the same guards): a 0-gem body, not capturing or engaged, within LKN_MJ_D of
+// a seen foe lock that our team has started (hits_remaining 2..4) hits it, or walks into attack range (attack() only: a 0-gem submit
+// is rc 46 and no hit, P-LKH1).
+bool lkn_mate_turn()
+{
+	if (!M.has_altar || W.me.gems > 0 || W.attacked || busy_capturing() || engaged_now())
+		return false;
+	const int r = std::max(1, W.me.range);
+	for (const auto& a : M.altars)
+	{
+		const int d = cheb(a.pos, W.me.pos);
+		if (d > LKN_MJ_D)
+			continue;
+		cambc::detail::altar_lock_info lb{};
+		if (!enemy_altar_lock_direct(a.pos, lb) || lb.hits_remaining < 2 || lb.hits_remaining > 4)
+			continue;
+		if (d <= r)
+		{
+			trf_lh_pref = &a;
+			const bool hit = lock_hit(true);
+			trf_lh_pref = nullptr;
+			if (hit)
+				LKN_FIRE(4);
+			return hit;
+		}
+		if (W.moved || W.no_move)
+			return false;
+		if (mv::step_to(a.pos, r, 20))
+		{
+			LKN_FIRE(5);
+			refresh_self();
+			if (!W.me.kit->ranged)
+				lock_hit(true);
+			return true;
+		}
+		return false;
+	}
+	return false;
+}
