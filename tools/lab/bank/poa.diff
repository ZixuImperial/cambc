+// POA bit 2: with the charge ready and my ward not within 6 of `to`, the ward on the tile within reach nearest to `to`.
+bool poa_place_toward(vec2 to)
+{
+	if (!W.alive || W.me.stunned || W.me.channeling() || (my_ward.x >= 0 && cheb(my_ward, to) <= 6))
+		return false;
+	const auto& self = cambc::self();
+	if (self.ward_cooldown() > 0)
+		return false;
+	vec2 best{ -1, -1 };
+	int bd = cheb(W.me.pos, to);
+	for (int dy = -reach_r; dy <= reach_r; ++dy)
+		for (int dx = -reach_r; dx <= reach_r; ++dx)
+		{
+			const vec2 p{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!M.passable(p) || bbget(M.camp_tiles, p) || bad_tile(p) || ally_ward_at(p) || p == my_ward)
+				continue;
+			const int d = cheb(p, to);
+			if (d < bd || (best.x < 0 && d <= bd))
+			{
+				bd = d;
+				best = p;
+			}
+		}
+	if (best.x < 0)
+		return false;
+	bool ok = false;
+	try
+	{
+		cancel_spin_before_action();
+		ok = self.place_ward(best);
+	}
+	catch (const std::exception& e)
+	{
+		(void)e;
+	}
+	if (!ok)
+	{
+		bad.push_back({ best, now() + 40 });
+		return false;
+	}
+	placed_at(best);
+	return true;
+}
