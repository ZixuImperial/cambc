+// FGM bit 1, caller read the flag: every passable tile within the sighting's age of its last tile is in my vision and holds no unit.
+static __attribute__((noinline)) bool fgm_gone(const Seen& s, int now)
+{
+	if (s.round >= now)
+		return false;
+	const int r = now - s.round;
+	const vec2 c = s.foe.pos;
+	for (int y = c.y - r; y <= c.y + r; ++y)
+		for (int x = c.x - r; x <= c.x + r; ++x)
+		{
+			const vec2 q{x, y};
+			if (!M.passable(q))
+				continue;
+			if (!bbget(W.vis, q) || bbget(W.occ_units, q))
+				return false;
+		}
+	return true;
+}
 // a recaller whose last tile I see empty has gone home.
 static __attribute__((always_inline)) inline void observe_forget_recalled(int now)
 {
 	auto rg_gone = [&](const Seen& s) { return s.rec && s.round < now && bbget(W.vis, s.foe.pos) && !bbget(W.occ_units, s.foe.pos); };
+	if (FGM_ON(1)) // FGM1: mark a sighting whose every reachable tile (within its age) I see empty; only assess skips it
+		for (auto& s : seen)
+			if (!s.gone && fgm_gone(s, now))
+				s.gone = true;
 	bool rg_any = false;
 	for (const auto& s : seen)
 		rg_any |= rg_gone(s);
 	if (rg_any)
 		seen.erase(std::remove_if(seen.begin(), seen.end(), rg_gone), seen.end());
 }
