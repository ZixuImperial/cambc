 // Engaged on my camp, a foe out of my range is not chased (the farm step captures more than a step toward a foe; spells already cast
 // this turn stand). A kill that still needs the walk and a nearly dead focus are chased.
+// b2390 FBO (combat_flags.h; the caller read the flag): break off the farm step for a fight we win.
+static __attribute__((noinline)) bool fbo_break(const FightCtx& c)
+{
+	const Assessment& a = c.a;
+	const Body& f = c.f;
+	auto camp_near_dead = [&]() {
+		const float hit = std::max(1.0f, kit_rules::my_basic_hit()); // RC C1504: the per-hit helper (Strength x passive)
+		for (const auto& vc : W.camps) // a camp I am farming (in my reach) within two of my hits of dead
+			if (vc.awake && vc.hp > 0 && cheb(W.me.pos, M.camps[static_cast<std::size_t>(vc.ci)].pos) <= std::max(1, W.me.range) && vc.hp <= 2.0f * hit)
+				return true;
+		return false;
+	};
+	const bool b1 = a.ratio_fc * 100.0f >= static_cast<float>(FBO_TAB[2]) && c.d <= W.me.range + 2 && !W.me.channeling() && !camp_near_dead();
+	if (FBO_ON(1) && b1)
+		return true;
+	if (FBO_ON(2) && a.ratio_fc * 100.0f >= static_cast<float>(FBO_TAB[3]) && !W.me.channeling())
+	{
+		bool committed = f.channeling();
+		for (const auto& vc : W.camps)
+		{
+			if (committed)
+				break;
+			const auto& cm = M.camps[static_cast<std::size_t>(vc.ci)];
+			committed = vc.awake && cm.attacks() && cheb(cm.pos, f.pos) <= std::max(1, cm.reach);
+		}
+		if (committed)
+			return true;
+	}
+	if (FBO_ON(4) && b1)
+		for (const auto& al : W.allies)
+			if (!al.channeling() && al.hp > 0 && cheb(al.pos, W.me.pos) <= 6 && cheb(al.pos, f.pos) <= std::max(1, al.range) + 1)
+				return true;
+	return false;
+}
 static __attribute__((always_inline)) inline bool fight_stay_on_camp(const FightCtx& c)
 {
+	if (FBO_TAB[1] != 0 && fbo_break(c))
+		return false; // b2390 FBO: the fight goes on (FARM BREAK)
 	return hold_state.active_round != W.round && c.d > W.me.range && econ::engaged_now() && !stance::kill_window(c.f) && !(c.f.frac() < FINISH_LOW_HP);
 }
 // Never take a free volley: a step that cannot be followed by a hit this turn must not enter a dangerous reach I am outside of now.
 static __attribute__((always_inline)) inline bool fight_volley_veto(const FightCtx& c)
 {
 	const bool hit_after = (c.d - 1 <= W.me.range) && (!c.k.ranged || slot_up(c.k.slot_reset));
