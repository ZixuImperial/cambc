+static void vbk_note_hit(std::uint32_t h)
+{
+	std::size_t k = 6;
+	for (std::size_t i = 0; i < 6; ++i)
+		if (vbkm::h[i] == h)
+		{
+			k = i;
+			break;
+		}
+	if (k == 6)
+		for (std::size_t i = 0; i < 6; ++i)
+			if (vbkm::h[i] == 0)
+			{
+				k = i;
+				break;
+			}
+	if (k == 6)
+		k = 0;
+	vbkm::h[k] = h;
+	vbkm::r[k] = W.round;
+	vbkm::ci[k] = 0;
+	for (const auto& e : W.enemies)
+		if (e.h == h)
+			vbkm::ci[k] = (e.type == cambc::champion_type::cassi || e.type == cambc::champion_type::issac) ? 1 : 0;
+}
+int vbk_kills_since(int since)
+{
+	int n = 0, ci_r = -1000;
+	for (std::size_t i = 0; i < 6; ++i)
+	{
+		if (vbkm::h[i] == 0)
+			continue;
+		const int dr = intel::foe_died_round(vbkm::h[i]);
+		if (dr > since && vbkm::r[i] >= dr - 1 && vbkm::r[i] <= dr)
+		{
+			if (vbkm::ci[i])
+			{
+				if (ci_r == dr)
+					continue; // C&I: one reward for the pair
+				ci_r = dr;
+			}
+			++n;
+		}
+	}
+	return n;
+}
