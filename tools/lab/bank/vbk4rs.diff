+// b2201 VBK: kill windfalls out of dbk_gain (bits 1/8) and the bit 2 latch (a K1 kill pickup left Vesper's bag >= VBK_BAG).
+static bool vbk_pick = false;
+static void vbk_rebook(int last_r, std::uint32_t lg, std::uint32_t lgold)
+{
+	const bool ves = W.me.type == cambc::champion_type::vesper_vale;
+	if (W.me.gems == 0 || W.me.gems < lg)
+		vbk_pick = false; // tributed or lost
+	const bool excl = ves ? VBK_ON(1) : (VBK_ON(8) && W.me.type != cambc::champion_type::prism);
+	if (!excl && !(ves && VBK_ON(2)))
+		return;
+	const int nk = combat::vbk_kills_since(last_r);
+	if (nk <= 0)
+		return;
+	const unsigned hu = prism::has_family(rs::F_HUNTER) ? 1u << rs::F_HUNTER : 0u, tr = prism::has_family(rs::F_TREASURE) ? 1u << rs::F_TREASURE : 0u;
+	const int kg = rs::kill_gold(static_cast<std::uint16_t>(hu | tr), vesper_layer::gold_pct(W.me.kit));
+	const int gr = W.gold > lgold ? static_cast<int>(W.gold - lgold) : 0;
+	if (gr + 1 < kg)
+		return; // no kill reward came to me
+	if (excl)
+	{
+		if (W.me.gems > lg)
+			dbk_gain -= static_cast<float>(W.me.gems - lg);
+		dbk_gain = std::max(0.0f, dbk_gain - 0.35f * static_cast<float>(std::min(gr, kg * nk)));
+	}
+	if (ves && VBK_ON(2) && W.me.gems > lg && static_cast<int>(W.me.gems) >= VBK_TAB[3])
+		vbk_pick = true;
+}
+// b2201 VBK bits 2/4: Vesper's bar after the dynamic raise.
+static float vbk_bar(float thr0, float td)
+{
+	if (VBK_ON(2) && vbk_pick)
+	{
+		bool near = false;
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, W.me.pos) <= 6)
+			{
+				near = true;
+				break;
+			}
+		if (!near)
+			return thr0;
+	}
+	return std::max(thr0, VBK_ON(4) ? std::min(td, static_cast<float>(VBK_TAB[2])) : td);
+}
