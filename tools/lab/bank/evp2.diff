+inline const volatile int EVP_TAB[5] = { 0x45565031, EVP_BITS, EVP_F_CLOSE, EVP_F_MID, EVP_F_FAR };
+#define EVP_ON(b) ((EVP_TAB[1] & (b)) != 0)
