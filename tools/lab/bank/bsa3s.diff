+// b2373 BSA bit 2 (the caller reads BSA_ON first; RC X873 FWI1 form): wards are permanent and one per champion (GR:360-363), so each foe
+// ward seen is kept by its owner (<= 8 entries, no TTL; a new sighting of the same owner replaces it; dropped when its tile is in my sight
+// without it). Its vision mask is computed once per placement, the first time a bush test needs it.
+struct BsaWard
+{
+	std::uint32_t owner;
+	vec2 t;
+	bool mask_ok;
+};
+std::array<BsaWard, 8> bsa_w{};
+std::array<bitboard, 8> bsa_m{};
+int bsa_n = 0;
+void bsa_observe()
+{
+	if (W.round % std::max(1, static_cast<int>(BSA_TAB[2])) != 0)
+		return; // read every BSA_POLL rounds
+	static std::vector<cambc::detail::ward_info> ws;
+	std::uint32_t c = 0;
+	try
+	{
+		cambc::detail::check(cambc::detail::sdk_wards(nullptr, 0, &c));
+		if (ws.size() < c)
+			ws.resize(c);
+		if (c > 0)
+		{
+			cambc::detail::check(cambc::detail::sdk_wards(ws.data(), c, &c));
+			if (c > ws.size())
+				c = static_cast<std::uint32_t>(ws.size()); // a fuel cut between the two reads can raise the count
+		}
+	}
+	catch (...)
+	{
+		return;
+	}
+	const std::uint32_t mine = static_cast<std::uint32_t>(cambc::detail::cached_my_team);
+	for (std::uint32_t j = 0; j < c; ++j)
+	{
+		if (ws[j].team == mine)
+			continue;
+		const vec2 t{ static_cast<int>(ws[j].x), static_cast<int>(ws[j].y) };
+		int k = -1;
+		for (int i = 0; i < bsa_n && k < 0; ++i)
+			if (bsa_w[static_cast<std::size_t>(i)].owner == ws[j].owner)
+				k = i;
+		if (k < 0)
+		{
+			if (bsa_n >= static_cast<int>(bsa_w.size()))
+				continue;
+			k = bsa_n++;
+			bsa_w[static_cast<std::size_t>(k)] = BsaWard{ ws[j].owner, t, false };
+		}
+		else if (!(bsa_w[static_cast<std::size_t>(k)].t == t))
+			bsa_w[static_cast<std::size_t>(k)] = BsaWard{ ws[j].owner, t, false }; // the owner placed a new ward: the old one is gone
+	}
+	for (int i = 0; i < bsa_n;) // a remembered tile in my sight with no foe ward on it: gone
+	{
+		const vec2 t = bsa_w[static_cast<std::size_t>(i)].t;
+		bool there = false;
+		for (std::uint32_t j = 0; j < c && !there; ++j)
+			there = ws[j].team != mine && ws[j].x == t.x && ws[j].y == t.y;
+		if (!there && bbget(W.vis, t))
+		{
+			bsa_w[static_cast<std::size_t>(i)] = bsa_w[static_cast<std::size_t>(bsa_n - 1)];
+			std::swap(bsa_m[static_cast<std::size_t>(i)], bsa_m[static_cast<std::size_t>(bsa_n - 1)]);
+			--bsa_n;
+			continue;
+		}
+		++i;
+	}
+}
+// a remembered foe ward on a bush whose vision holds t (a ward in a bush sees its cluster, GR:355; the engine's own ward vision)
+bool bsa_watched(vec2 t)
+{
+	for (int i = 0; i < bsa_n; ++i)
+	{
+		BsaWard& e = bsa_w[static_cast<std::size_t>(i)];
+		if (cheb(e.t, t) > 6 || !bbget(M.bushes, e.t))
+			continue;
+		if (!e.mask_ok)
+		{
+			cambc::ward::visible_tiles_from_into(e.t, bsa_m[static_cast<std::size_t>(i)]);
+			e.mask_ok = true;
+		}
+		if (bbget(bsa_m[static_cast<std::size_t>(i)], t))
+			return true;
+	}
+	return false;
+}
