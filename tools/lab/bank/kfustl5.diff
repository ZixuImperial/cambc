+// KFU bit 1: after a successful action, the visible foes within 6 the engine reports dead join this turn's dead list.
+static void kfu_mark_dead()
+{
+	if (kfu_dead_r != W.round || kfu_dead_me != static_cast<int>(W.me.h))
+	{
+		kfu_dead_r = W.round;
+		kfu_dead_me = static_cast<int>(W.me.h);
+		kfu_dead_n = 0;
+	}
+	for (const auto& e : W.enemies)
+	{
+		if (cheb(e.pos, W.me.pos) > 6 || kfu_is_dead(e.h) || kfu_dead_n >= 12)
+		{
+			continue;
+		}
+		std::int32_t al = 1;
+		if (cambc::detail::sdk_champion_is_alive(e.h, &al) == 0 && al == 0)
+		{
+			kfu_dead_h[static_cast<std::size_t>(kfu_dead_n++)] = e.h;
+		}
+	}
+}
+// STL: after a successful attack or cast: my shield (bit 1), the woken camp group (bit 2), my bag after a champion kill (bit 4).
+static void stl_after_action(std::uint32_t kind, std::uint32_t handle, int slot)
+{
+	if (STL_ON(1) && slot >= 0 && W.me.kit && slot == W.me.kit->slot_shield)
+	{
+		stl_reread_self(true, false);
+	}
+	if (STL_ON(2) && kind == KIND_CAMP)
+	{
+		int g = -1;
+		for (int ci = 0; ci < M.nc && g < 0; ++ci)
+		{
+			if (M.camps[static_cast<std::size_t>(ci)].handle == handle)
+			{
+				g = M.camps[static_cast<std::size_t>(ci)].group;
+			}
+		}
+		for (auto& vc : W.camps)
+		{
+			if (g >= 0 && vc.ci >= 0 && vc.ci < M.nc && M.camps[static_cast<std::size_t>(vc.ci)].group == g && !vc.awake)
+			{
+				vc.awake = true;
+				bbset(W.awake, M.camps[static_cast<std::size_t>(vc.ci)].pos);
+			}
+		}
+	}
+	if (STL_ON(4) && kind == KIND_CHAMPION)
+	{
+		std::int32_t al = 1;
+		if (cambc::detail::sdk_champion_is_alive(handle, &al) == 0 && al == 0)
+		{
+			stl_reread_self(false, true);
+		}
+	}
+}
