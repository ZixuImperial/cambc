+// STL: re-read my shield (bit 1) or my gems and gold (bit 4) after one of my own actions.
+void stl_reread_self(bool shield, bool bag)
+{
+	if (shield)
+	{
+		W.me.shield = 0;
+		W.me.shield_turns = 0;
+		read_buffs(W.me);
+	}
+	if (bag)
+	{
+		std::uint32_t g = 0, au = 0;
+		if (cambc::detail::sdk_champion_gems(my_h, &g) == 0)
+		{
+			W.me.gems = g;
+		}
+		if (cambc::detail::sdk_champion_gold(my_h, &au) == 0)
+		{
+			W.gold = au;
+		}
+	}
+}
