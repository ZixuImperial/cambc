+// SLM bit 4: strong remembered foes (eff HP >= 2x mine, age 1..OBS_FORGET_ROUNDS, not visible) that could have walked into my fight radius
+// since the sighting (d - age <= FIGHT_R + 1) add their remembered-weight power to e_sq / e_sq_fc only; carriers only (caller checks the bag).
+static __attribute__((noinline)) void slm_sum_moving(AssessCtx& c)
+{
+	const int now = W.round;
+	float bar = -1.0f;
+	for (const auto& s : seen)
+	{
+		const int age = now - s.round;
+		if (age < 1 || age > memory::tune::OBS_FORGET_ROUNDS)
+			continue;
+		const int d = cheb(s.foe.pos, c.me);
+		if (age <= tune::MEMORY_ROUNDS && d <= tune::MEMORY_R && d <= tune::FIGHT_R)
+			continue; // already in a.foes and summed by the loop above
+		if (d - age > tune::FIGHT_R + 1)
+			continue;
+		Foe f = s.foe;
+		if (bbget(M.enemy_spawn, f.pos)) // as assess_gather_remembered (MBB7 RHS1): healed to full on its spawn
+			f.ehp = s.ehp_full;
+		if (bar < 0.0f)
+			bar = 2.0f * eff_hp(W.me);
+		if (f.ehp < bar)
+			continue;
+		bool visible = false;
+		for (const auto& e : W.enemies)
+			if (e.h == s.h)
+				visible = true;
+		if (visible)
+			continue;
+		f.idx = -1;
+		f.remembered = true;
+		f.reach = -1;
+		const float fw = assess_foe_weight(c.a, f, std::max(0, std::min(d, tune::FIGHT_R)));
+		c.e_sq += fw * assess_power(f.ehp, f.dps);
+		c.e_sq_fc += fw * assess_power(f.ehp, f.dps_fc);
+	}
+}
