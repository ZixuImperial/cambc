diff --git a/src/champ_prism.cc b/src/champ_prism.cc
--- a/src/champ_prism.cc
+++ b/src/champ_prism.cc
@@ -989,13 +989,33 @@ void prism_carrier_shop_build()
 	if (prism::PL.flags & 2)
 		build.push_back(emblem(PROSPECTOR));
 	build.push_back(emblem((prism::PL.flags & 4) ? TREASURE : HUNTER));
 	build.push_back(emblem(CAPTURE));
 	build.push_back(emblem(TRIBUTE));
 	build.push_back(emblem(COLLECTORS));
+	if (PET_ON(8))
+		build.push_back(emblem(11)); // PET: Skirmish (family 11) before Durability
 	build.push_back(emblem(DURABILITY));
+	if (PET_ON(7))
+	{
+		// PET (spec_pet_1112): new families before a repeat: Skirmish 11, Home 5, then Monster 0, Jungle 4, the other of Treasure / Hunter
+		if (PET_ON(1))
+			build.push_back(emblem(11));
+		if (PET_ON(2))
+			build.push_back(emblem(5));
+		if (PET_ON(4))
+		{
+			build.push_back(emblem(0));
+			build.push_back(emblem(4));
+			build.push_back(emblem((prism::PL.flags & 4) ? HUNTER : TREASURE));
+			build.push_back(emblem(BRUISER));
+			for (int i = 0; i < SHOP_TAIL; ++i)
+				build.push_back(emblem(POWER));
+			return;
+		}
+	}
 	for (int i = 0; i < SHOP_TAIL; ++i)
 		build.push_back(emblem(((i & 1) ? POWER : BRUISER)));
 }
