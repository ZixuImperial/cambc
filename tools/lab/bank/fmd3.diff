+// pem_damage_sum + camp_threat first (one memo per turn), the mover's order on a tie. All outside: nothing. Scores become ranks.
+void fmd_order(CandList& cands, int ignore_group)
+{
+	const int n = cands.n;
+	if (n < 2)
