+// b2369 FMD (callers read FMD_BITS first): a seen foe's integer ready one-turn reach: lethal_burst_hit(e, d, 0) > 0 iff d <= it (str > 0).
+static int fmd_ready_reach(const Body& e)
+{
+	if (!e.kit || !e.kit->valid)
+		return std::max(2, e.range + 1);
+	const Kit& k = *e.kit;
+	const int R = e.range;
+	int r = k.ranged ? R : R + 1;
+	if (k.ranged && foe_ready(e, k.slot_reset, 0))
+		r = R + 1;
+	if (foe_ready(e, k.slot_dash, 0))
+	{
+		const int dr = static_cast<int>(k.dash_range);
+		r = std::max(r, k.ranged ? R + dr : R + dr + 1);
+		if (k.dash_mod > 0 && k.dash_mod * e.foc > 0)
+			r = std::max(r, dr + static_cast<int>(k.dash_radius) + 1);
+	}
+	auto spell = [&](int s, float mod, float range, bool excl, float radius)
+	{
+		if (mod > 0 && foe_ready(e, s, 0))
+			r = std::max(r, static_cast<int>(range + radius) + (excl ? 0 : 1));
+	};
+	spell(k.slot_dmg, k.dmg_mod, k.dmg_range, k.dmg_excl, 0.0f);
+	spell(k.slot_cc, k.cc_mod, k.cc_range, k.cc_excl, 0.0f);
+	spell(k.slot_aoe, k.aoe_mod, k.aoe_range, k.aoe_excl, k.aoe_radius);
+	return r;
+}
+// b2369 FMD: one per-turn record (perception stamp, round, body, acts, tile): the priced foes (pem_damage_sum's set: within 9 of me, not
+// stunned next turn), their ready reaches, whether one is within 6, and pem_damage_sum's (foe, distance) memo.
+struct FmdTurn
+{
+	int ps = -1, r = -1, act = -1, n = 0;
+	std::uint32_t me = 0;
+	vec2 at{ -1, -1 };
+	bool near6 = false;
+	vec2 fp[12];
+	int fr[12];
+	float memo[144];
+};
+static FmdTurn& fmd_turn()
+{
+	static FmdTurn t;
+	const int act = (W.cast ? 1 : 0) + (W.attacked ? 2 : 0);
+	if (t.ps == fg::pstamp && t.r == W.round && t.me == W.me.h && t.act == act && t.at == W.me.pos)
+		return t;
+	t.ps = fg::pstamp;
+	t.r = W.round;
+	t.me = W.me.h;
+	t.act = act;
+	t.at = W.me.pos;
+	t.n = 0;
+	t.near6 = false;
+	for (float& m : t.memo)
+		m = -1.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 9 || foe_stunned_next_turn(e))
+			continue;
+		t.near6 |= d <= 6;
+		if (t.n < 12)
+		{
+			t.fp[t.n] = e.pos;
+			t.fr[t.n++] = fmd_ready_reach(e);
+		}
+	}
+	return t;
+}
+// -1: no priced foe within 6 (FMD does nothing); 1: t is inside some priced foe's ready reach; 0: outside every one.
+int fmd_inside(vec2 t)
+{
+	const FmdTurn& f = fmd_turn();
+	if (!f.near6)
+		return -1;
+	for (int i = 0; i < f.n; ++i)
+		if (cheb(t, f.fp[i]) <= f.fr[i])
+			return 1;
+	return 0;
+}
