+// v7xx MBB11 CDM1X (GR:192, INT:105): a camp hits its nearest champion, a Chebyshev tie to the earlier mover, so its target zone is
+// radius min(reach, dmin - 1) when the nearest other body takes the tie, else min(reach, dmin) (camp_threat's own test). -1: none.
+static int cdm_exact_r(const CtEntry& e)
+{
+	CtEntry x = e;
+	if (x.dmin < 0)
+		camp_threat_other_bodies(x);
+	return std::min(x.reach, x.dtie <= x.dmin ? x.dmin - 1 : x.dmin);
+}
+bool cdm_exact_near(float min_str)
+{
+	for (const auto& e : camp_threat_entries())
+		if (e.str >= min_str && e.reach >= 0 && cheb(e.pos, W.me.pos) <= e.reach + 2)
+		{
+			const int r = cdm_exact_r(e);
+			if (r >= 0 && cheb(e.pos, W.me.pos) > r)
+				return true;
+		}
+	return false;
+}
+AvoidCampReach::AvoidCampReach(float min_str, bool exact)
+{
+	(void)exact;
+	if ((avoid_on && !avoid_foe) || !W.alive)
+		return;
+	bitboard z;
+	bool any = false;
+	for (const auto& e : camp_threat_entries())
+		if (e.str >= min_str && e.reach >= 0)
+		{
+			const int r = cdm_exact_r(e);
+			if (r < 0)
+				continue;
+			z.draw_chebyshev(e.pos, static_cast<float>(r));
+			any = true;
+		}
+	if (!any || bbget(z, W.me.pos))
+		return;
+	if (avoid_on && avoid_foe)
+	{
+		prev = std::make_unique<bitboard>(avoid_bb);
+		avoid_bb |= z;
+		merged = true;
+		return;
+	}
+	avoid_bb = z;
+	avoid_on = true;
+	active = true;
+}
