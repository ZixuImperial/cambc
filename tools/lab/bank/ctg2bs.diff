+++ b/src/econ_flags.h
@@ -1031,6 +1031,13 @@ inline constexpr int CPS_TAB[2] = { 0x43505332, CPS_BITS }; // slot 0 magic keep
 // with a record hits a camp of its group in reach, or travel-dashes toward it (Combat's guard: never C&I or Prism; landing no nearer the
 // foe spawn than my spawn tile and in our half or by the goal; 40k reserve). Bit 4 HOLD: while the record stands, the no-crew drop, the
 // switch margin and Prism's plan-group follow do not move me off it. Writes happen only while DFG_BITS != 0.
 // v735 DFG: DFG draft opening record + r1 acts (dfg3)
 #define DFG_BITS 3
 inline constexpr int DFG_TAB[2] = { 0x44464731, DFG_BITS }; // slot 0 magic keeps it out of .bss
+
+// CTH (b1832, CTG2: Deep spec_ctg2_1111.md, RC C131; 00happy_halloween 01a1c8c1 Cassi idle r257-281). 0 = nova_b12191_dfg3k. Bit 1: on a
+// support turn the CTG fuel gate stops, ctg_rate_hi decays one step (as the full turn's meter does), the turn is used only if
+// cheap_camp_hit lands, and otherwise the body takes one greedy step (mv::step_greedy, no search) toward its focus camp. The death reset also clears ctg_rate_hi (RC X334).
+#define CTH_BITS 0
+inline const volatile int CTH_TAB[2] = { 0x43544831, CTH_BITS }; // slot 0 magic keeps it out of .bss
+#define CTH_ON(b) ((CTH_TAB[1] & (b)) != 0)
