+// BDL FNA: distance to the nearest of danger()'s sightings no older than max_age, -1 if none. Call after danger() this turn.
+int nearest_sighting(vec2 p, int max_age)
+{
+	const int t = now();
+	if (active_round != t)
+		return -1;
+	int best = -1;
+	for (const auto& a : active)
+	{
+		if (t - a.round > max_age)
+			continue;
+		const int d = cheb(p, a.pos);
+		if (best < 0 || d < best)
+			best = d;
+	}
+	return best;
+}
