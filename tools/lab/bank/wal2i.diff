+				throw;
+			}
+			catch (const std::exception&)
+			{
+			}
+			act_core();
+			return;
+		}
+		act_core();
+		if (now() < ready_round)
+			return; // act_core placed (or the charge is not ready)
+		try
+		{
+			wal_try(t);
+		}
+		catch (const RestartTurn&)
+		{
+			throw;
+		}
+		catch (const std::exception&)
+		{
+		}
+		return;
+	}
+	act_core();
+}
