+static __attribute__((always_inline)) inline void act_core();
 __attribute__((always_inline)) void act()
+{
+	// Skip at the top on a map that does not qualify, while the charge recharges, and inside the 3-round retry wait.
+	if (WAL_ON(3) && wal_state != 2 && W.alive && P.my_slot >= 0 && now() >= ready_round && now() >= wal_next)
+	{
+		const int t = now();
