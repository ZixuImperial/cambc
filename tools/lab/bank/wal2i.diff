+// b2419 WAL bit 8 (caller read the flag): my standing ward is an altar ward, and the foe at p is beyond my own sight radius.
+bool wal_far_foe(vec2 p)
+{
+	if (my_ward.x < 0 || !(my_ward == wal_ward) || cheb(p, W.me.pos) <= 8)
+		return false;
+	for (const auto& a : M.altars)
+		if (cheb(p, a.pos) <= 3) // lock reach 2 (GR:328) + one step
+			return false;
+	return true;
+}
+
