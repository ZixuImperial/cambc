+// ---- AMB (b1769, owner idea): the altar ambush. Sightings of foe carriers, then the idle-turn wait next to their altar.
+namespace {
+struct AmbSeen
+{
+	std::uint32_t h = 0;
+	vec2 p0{ -1, -1 }, p1{ -1, -1 }; // the last two sightings (p1 newest)
+	int r0 = -1000, r1 = -1000, gems = 0;
+};
+std::array<AmbSeen, 6> amb_seen{};
+int amb_map_v = -1; // -1 unknown, 0 no, 1 yes
+}
+// A one-altar map, or two altars within AMB_PAIR (map features only).
+bool amb_map()
+{
+	if (amb_map_v < 0 && M.done())
+		amb_map_v = (M.na == 1 || (M.na == 2 && cheb(M.altars[0].pos, M.altars[1].pos) <= AMB_TAB[5])) ? 1 : 0;
+	return amb_map_v == 1;
+}
+// Each turn: the visible foes with a bag >= AMB_GEMS (bags read within 9, world.cc perceive).
+void amb_observe_slow()
+{
+	if (!amb_map())
+		return;
+	for (const auto& e : W.enemies)
+	{
+		if (static_cast<int>(e.gems) < AMB_TAB[2])
+			continue;
+		AmbSeen* s = nullptr;
+		for (auto& x : amb_seen)
+			if (x.h == e.h)
+				s = &x;
+		if (!s)
+		{
+			s = &amb_seen[0];
+			for (auto& x : amb_seen)
+				if (x.r1 < s->r1)
+					s = &x;
+			*s = AmbSeen{};
+			s->h = e.h;
+		}
+		if (s->r1 == W.round)
+			continue;
+		s->p0 = s->p1;
+		s->r0 = s->r1;
+		s->p1 = e.pos;
+		s->r1 = W.round;
+		s->gems = static_cast<int>(e.gems);
+	}
+}
+// The altar index the ambush goes to this idle turn, else -1 (*car: the carrier's handle).
+int amb_cond(std::uint32_t* car)
+{
+	if (!amb_map() || T.target >= 0 || T.capturing || W.me.channeling() || W.me.frac() < 0.6f)
+		return -1;
+	for (const auto& s : amb_seen)
+	{
+		if (s.h == 0 || W.round - s.r1 > AMB_TAB[3] || s.r0 < 0 || W.round - s.r0 > 2 * AMB_TAB[3])
+			continue;
+		for (int a = 0; a < M.na; ++a)
+		{
+			const vec2 ap = M.altars[static_cast<std::size_t>(a)].pos;
+			const int d1 = cheb(s.p1, ap), d0 = cheb(s.p0, ap);
+			if (d1 >= d0)
+				continue; // not closing on it
+			const int its = std::max(0, d1 - 1 - (W.round - s.r1));
+			const int mine = std::max(0, cheb(W.me.pos, ap) - 1);
+			if (mine > its + AMB_TAB[4])
+				continue;
+			int near = 0;
+			for (const auto& e : W.enemies)
+				near += cheb(e.pos, ap) <= 6 ? 1 : 0;
+			if (near >= 2)
+				continue;
+			if (car)
+				*car = s.h;
+			return a;
+		}
+	}
+	return -1;
+}
+// Bit 1: walk next to the altar (awake camps' reach kept out) and hit the carrier while it channels the tribute. True: the turn's move.
+bool amb_turn_slow()
+{
+	std::uint32_t car = 0;
+	const int a = amb_cond(&car);
+	if (a < 0)
+		return false;
+	const vec2 ap = M.altars[static_cast<std::size_t>(a)].pos;
+	for (const auto& e : W.enemies)
+		if (e.h == car && (e.state & ST_TRIBUTE) != 0 && !W.attacked && W.can_attack() && cheb(e.pos, W.me.pos) <= std::max(1, W.me.range) && combat::attack_champion(e))
+			return true;
+	if (cheb(W.me.pos, ap) <= 1)
+		return true; // in place: wait for the channel
+	const mv::AvoidCampReach guard;
+	return mv::step_to(ap, 1, 30);
+}
