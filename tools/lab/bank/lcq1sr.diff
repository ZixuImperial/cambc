diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -1900,6 +1900,12 @@ inline constexpr int PCM_TAB[4] = { 0x50434D31, PCM_BITS, PCM_G, PCM_R }; // slo
 // clear on land, cancel or its first dead turn while it owns the field); the field's age (value + round first seen + tributed_us then) is
 // kept inside rtc_value, i.e. only when a reader decides; the need bands are v2 (1: need <= 10, 2: <= 25, 3: <= 50, 4: <= 80, 5: <= 120,
 // 6: <= 200, 7 more; OLK's reader tests band != 0 only).
 // v908 RTL: RTL lazy RTC writer + v2 band edges
 #define RTL_BITS 1
 inline constexpr int RTL_TAB[2] = { 0x52544C31, RTL_BITS };
+// b2432 LCQ (fresh-eyes 1113 item 3, bug bar). Runtime data flag LCQ_TAB[1], read first; 0 = v908. Bit 1: cap_rank's 10 x shards term
+// for the group's carrier (carrier_gems on a gem group, carrier_gold on a gold group) fades with planner's capture_rank_fit fade
+// (planner::capture_fit_fade), so once the fit term is gone the -40 carrier bonus is not outweighed by the carry's shop count.
+#define LCQ_BITS 0
+inline const volatile int LCQ_TAB[2] = { 0x4C435131, LCQ_BITS }; // slot 0 magic keeps it out of .bss
+#define LCQ_ON(b) ((LCQ_TAB[1] & (b)) != 0)
