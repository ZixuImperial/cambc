+// b2432 LCQ: capture_rank_fit's fade (100 to r150 .. 0 from r875), in percent.
+int capture_fit_fade()
+{
+	const int r = now();
+	return r <= 150 ? 100 : r <= 300 ? 100 - 35 * (r - 150) / 150 : r <= 600 ? 65 - 45 * (r - 300) / 300 : r < 875 ? 20 - 20 * (r - 600) / 275 : 0;
+}
