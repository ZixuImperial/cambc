+// b2401 PCI (common_flags.h; callers read the flag): the flee memory and its one step.
+static int pci_flee_r = -1000, pci_quiet = 0;
+static __attribute__((noinline)) void pci_note(const combat::Assessment& a)
+{
+	bool near = false;
+	for (const auto& f : a.foes)
+		if (cheb(f.pos, W.me.pos) <= PCI_TAB[2])
+			near = true;
+	if (a.stance == combat::FLEE)
+		pci_flee_r = W.round, pci_quiet = 0;
+	else if (pci_flee_r >= 0)
+		pci_quiet = near ? 0 : pci_quiet + 1;
+}
+static __attribute__((noinline)) bool pci_step(const combat::Assessment& a)
+{
+	if (pci_flee_r < 0 || a.stance == combat::FLEE || pci_quiet >= PCI_TAB[3] || !no_action_yet())
+		return false;
+	if (pci_flee_r < W.round - 1)
+		return false; // a stage acted on a turn in between: the memory has ended
+	const Body* mate = nullptr;
+	int md = 9;
+	for (const auto& b : W.allies)
+		if (b.hp > 0 && cheb(b.pos, W.me.pos) <= 8 && cheb(b.pos, W.me.pos) < md)
+		{
+			md = cheb(b.pos, W.me.pos);
+			mate = &b;
+		}
+	bool moved = false;
+	if (mate && md > 1)
+		moved = mv::step_to(mate->pos, 1, 400, -1);
+	if (!moved && M.has_home && !W.on_spawn)
+		moved = mv::step_field(M.f_home);
+	if (moved)
+		pci_flee_r = W.round; // the next calm turn may step again (until the quiet count clears it)
+	return moved;
+}
