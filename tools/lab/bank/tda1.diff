+// TDA1: among the ring landings tied at best_v (every filter of the scan passed), the one nearest the tied set's centre, then msy_before.
+static __attribute__((noinline)) vec2 tda_pick(vec2 me, int r, const distance_field& f, vec2 best, int best_v, int ignore_group, bool reach_test, int land_r,
+	int cleared_group)
+{
+	vec2 c[64];
+	int n = 0, sx = 0, sy = 0;
+	for (int dx = -r; dx <= r && n < 64; ++dx)
+		for (int dy = -r; dy <= r && n < 64; dy += (dx == -r || dx == r) ? 1 : 2 * r)
+		{
+			const vec2 t{ me.x + dx, me.y + dy };
+			if (!inb(t) || !free_tile(t))
+				continue;
+			const std::uint16_t v = dfget(f, t);
+			if (v == UNREACH || static_cast<int>(v) != best_v)
