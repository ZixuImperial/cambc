+				continue;
+			if (land_r >= 0 && landing_wakes_camp(t, land_r, cleared_group))
+				continue;
+			c[n++] = t;
+			sx += dx;
+			sy += dy;
+		}
+	if (n < 2)
+		return best;
+	vec2 pick = c[0];
+	long bd = -1;
+	for (int i = 0; i < n; ++i)
+	{
+		const long ex = static_cast<long>(n) * (c[i].x - me.x) - sx, ey = static_cast<long>(n) * (c[i].y - me.y) - sy;
+		const long d = ex * ex + ey * ey;
+		if (bd < 0 || d < bd || (d == bd && msy_before(c[i], pick)))
+		{
+			bd = d;
+			pick = c[i];
+		}
+	}
+	return pick;
+}
