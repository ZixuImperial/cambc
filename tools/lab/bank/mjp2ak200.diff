+// MJP bit 2: a jackpot map: the largest-gem group among groups with attackers holds >= MJP_SHARE % of all gems, its contest in [MJP_CLO, MJP_CHI] %.
+static bool mjp_jp_class()
+{
+	std::int64_t tot = 0, top = -1;
+	float ct = 0.0f;
+	for (const auto& g : nova::M.groups)
+	{
+		tot += g.gems;
+		if (g.n_att > 0 && g.gems > top)
+		{
+			top = g.gems;
+			ct = g.contest;
+		}
+	}
+	return top >= 0 && tot > 0 && top * 100 >= static_cast<std::int64_t>(MJP_TAB[3]) * tot && ct * 100.0f >= static_cast<float>(MJP_TAB[4]) &&
+	       ct * 100.0f <= static_cast<float>(MJP_TAB[5]);
+}
