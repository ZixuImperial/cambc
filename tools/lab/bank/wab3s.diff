 	// Ward work waits for the map stages.
 	if (!M.done() && M.groups_ready() && fuel() > brain_tune::MAP_INIT_FUEL)
 		econ::pre_tables(); // v7xx PRE2: the groups are final at ST_GROUPS; bodies camp before the map stages finish
