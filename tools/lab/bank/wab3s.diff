 // Reset the budgets, refresh the allied-ward coverage and mark this check; returns my tile.
 static __attribute__((always_inline)) inline vec2 prepare_check(int t)
 {
-misses_left = MISS_MAX;
-weight_budget = WEIGHT_BUDGET;
+if (WAB_ON(2))
+{
+	const long wms_x = (fuel() - ACT_FLOOR - 20000) / 3000; // WMS1: the search widens with the fuel left (mean ~71k at act)
+	misses_left = static_cast<int>(std::clamp<long>(MISS_MAX + wms_x, MISS_MAX, 9));
+	weight_budget = static_cast<int>(std::clamp<long>(WEIGHT_BUDGET + wms_x, WEIGHT_BUDGET, WEIGHT_BUDGET + 7));
+}
+else
+{
+	misses_left = MISS_MAX;
+	weight_budget = WEIGHT_BUDGET;
+}
 scan_allied_wards();
 PROF("w_scan");
 if (acov_dirty || acov.size() != spots.size())
 	rebuild_acov();
 PROF("w_acov");
 const vec2 me = W.me.pos;
