diff --git a/src/common_flags.h b/src/common_flags.h
--- a/src/common_flags.h
+++ b/src/common_flags.h
@@ -964,6 +964,14 @@ inline int vb2_bits() { if (vb2_g < 0) vb2_g = VB2_TAB[1]; return vb2_g; }
 // nova_base_v660. Bit 1 CRH: a committed retreat stops when no foe has been seen for 2 rounds, HP >= .55 (linked .60) and my awake target
 // has 2+ crew within 6. Bit 2 CRZ: a held-over FLEE (nearest >= 7, nothing in reach) does not mark the herd as a threat target. Bit 4 HLX:
 // with my target awake and 3+ crew present, the heal exemption and the 59% leave line count a foe as near at 6, not 8.
 // v745 EHC: fpb5 bank bundle bk5b+ehc3s+rts
 #define EHC_BITS 7
 inline constexpr int EHC_TAB[2] = { 0x45484331, EHC_BITS }; // slot 0 magic keeps it out of .bss
+// WAB (b1823, ward line: b1838 WAB1 count + Rule Checker X236 WMS1; behaviour). Runtime data flag WAB_TAB[1], read first; 0 = v713.
+// Bit 1 WAB1: ward::act runs at the start of background_work (map stages done), before the background job block, not after it (the jobs
+// spent the fuel: 33.1/g opening-turn skips with the charge ready and >= 55k at background start); the late call is then skipped.
+// Bit 2 WMS1: ward::act scores clamp(2 + (fuel - ACT_FLOOR - 20k) / 3k, 2, 9) new candidate tiles per check (was 2: a fixed direction
+// order made placements lean +x/+y, mirrored seats warded differently), and its spot-weight refreshes scale the same way from 10 to 17.
+#define WAB_BITS 0
+inline const volatile int WAB_TAB[2] = { 0x57414231, WAB_BITS }; // slot 0 magic keeps it out of .bss
+#define WAB_ON(b) ((WAB_TAB[1] & (b)) != 0)
