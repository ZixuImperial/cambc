+// b2393 PKH bit 1 (spec_pkh_1113; RC P-PKH1): the kite cycle on a group with exactly one living elk/golem. The caller checks the flag.
+// b2368 LATCH (build correction): from any state she steps out of reach and runs the cycle; while latched the turn is always hers (live's
+// approach and basics do not run on the group) until the group is dead, a mate arrives, a foe is seen or her claim moves.
+static bool pkh_step_ring(vec2 a, int want, int gi)
+{
+	const vec2 me = W.me.pos;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 n{ me.x + dx, me.y + dy };
+			if ((dx == 0 && dy == 0) || !M.passable(n) || cheb(n, a) != want || !mv::free_tile(n) || mv::camp_threat(n, gi) > 0) // own group: the cycle's timing; others: live's threat
+				continue;
+			if (mv::try_move(n))
