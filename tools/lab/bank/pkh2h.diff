+		}
+	return false;
+}
+// b2393 PKH bit 4 PACK SPAM: coverage of s1 from stand tile p on group gi's living attackers (at[0..n)): the most attackers one cast
+// tile within aoe_range of p covers (radius r), never a tile that covers another group's camp; 0 when p is within 4 of any attacker.
+static int pkh_cover(vec2 p, int gi, const vec2* at, int n, int range, int r, vec2* best_t)
+{
+	for (int i = 0; i < n; ++i)
+		if (cheb(p, at[i]) < 5)
+			return 0;
+	int best = 0;
+	for (int i = 0; i < n; ++i)
+		for (int dx = -r; dx <= r; ++dx)
+			for (int dy = -r; dy <= r; ++dy)
+			{
+				const vec2 t{ at[i].x + dx, at[i].y + dy };
+				if (!inb(t) || cheb(t, p) > range)
+					continue;
+				int c = 0;
+				for (int j = 0; j < n; ++j)
+					c += cheb(t, at[j]) <= r ? 1 : 0;
+				if (c <= best)
+					continue;
+				bool other = false;
+				for (const auto& vo : W.camps)
+					if (M.camps[static_cast<std::size_t>(vo.ci)].group != gi && cheb(M.camps[static_cast<std::size_t>(vo.ci)].pos, t) <= r)
+						other = true;
+				if (other)
+					continue;
+				best = c;
+				if (best_t)
+					*best_t = t;
+			}
+	return best;
+}
+static int pkh_dmin(vec2 p, const vec2* at, int n)
+{
+	int d = 99;
+	for (int i = 0; i < n; ++i)
+		d = std::min(d, cheb(p, at[i]));
+	return d;
+}
+// One step to the free neighbour with the best key (no other group's camp threat): out of reach first (largest distance to the nearest
+// attacker while inside reach), else the most s1 cover, else (no cover) the nearest tile that stays >= 5 from every attacker.
+static bool pkh_pack_step(int gi, const vec2* at, int n, int range, int r, int dmin, int here)
+{
+	const vec2 me = W.me.pos;
+	int bk = -1;
+	vec2 bp{ -1, -1 };
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 q{ me.x + dx, me.y + dy };
+			if ((dx == 0 && dy == 0) || !M.passable(q) || !mv::free_tile(q) || mv::camp_threat(q, gi) > 0)
+				continue;
+			const int dq = pkh_dmin(q, at, n);
+			int key = -1;
+			if (dmin < 5)
+				key = dq > dmin ? 100 * dq + pkh_cover(q, gi, at, n, range, r, nullptr) : -1;
+			else if (dq >= 5)
+			{
+				const int c = pkh_cover(q, gi, at, n, range, r, nullptr);
+				key = c > here ? 1000 + c : (here == 0 && dq < dmin ? 100 - dq : -1);
+			}
+			if (key > bk)
+			{
+				bk = key;
+				bp = q;
+			}
+		}
+	return bk >= 0 && mv::try_move(bp);
+}
+inline int pkh_last_dmg = -1000;
+// b2393 PKH bit 4 PACK SPAM, latched (b2368): out of every attacker's reach first, then the stand tile with the most s1 cover; s1 whenever
+// ready, else wait. 0: hold/acted; else a hand-back reason.
+static int pkh_pack_turn(int gi, const vec2* at, int n)
+{
+	const Kit& k = *W.me.kit;
+	const vec2 me = W.me.pos;
+	const int range = static_cast<int>(k.aoe_range), r = std::max(0, static_cast<int>(k.aoe_radius));
+	const int dmin = pkh_dmin(me, at, n);
+	vec2 t{ -1, -1 };
+	const int here = pkh_cover(me, gi, at, n, range, r, &t);
+	int bn = 0; // the best neighbour stand tile's cover (a short climb before casting)
+	for (int dx = -1; dx <= 1 && here > 0 && ready(k.slot_aoe); ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			const vec2 q{ me.x + dx, me.y + dy };
+			if ((dx != 0 || dy != 0) && M.passable(q) && mv::free_tile(q) && mv::camp_threat(q, gi) <= 0)
+				bn = std::max(bn, pkh_cover(q, gi, at, n, range, r, nullptr));
+		}
+	if (here > 0 && bn <= here && ready(k.slot_aoe) && cast_at(k.slot_aoe, t))
+	{
+		pkh_last_dmg = static_cast<int>(W.round);
+		return 0;
+	}
+	if (W.moved || W.cast)
+		return 0;
+	if (dmin < 5 || here == 0 || ready(k.slot_aoe))
+	{
+		if (pkh_pack_step(gi, at, n, range, r, dmin, here))
+			return 0;
+		if (dmin < 5 || here == 0)
+			return PKW_NOTILE;
+	}
+	return 0; // wait on the stand tile for s1
+}
+// The turn's PKH step. True: this turn is PKH's (an action or a hold). Reasons for a false (or a hand-back) go to pkh_why / pkh_hb.
+static int pkh_turn_why()
+{
+	if (!W.me.kit || !prism_layer::type(W.me.type))
+		return PKW_TYPE;
+	const Kit& k = *W.me.kit;
+	if (k.slot_aoe != 1 || W.me.channeling())
+		return PKW_TYPE;
+	if (W.me.foc < static_cast<float>(PKH_TAB[2]))
+		return PKW_FOC;
+	const int gi = econ::claim_target();
+	if (pkh_lat >= 0 && gi != pkh_lat)
+		return PKW_CLAIM;
+	if (gi < 0 || gi >= M.ng)
+		return PKW_TGT;
+	std::array<vec2, 8> at{};
+	int na = 0, ai = -1;
+	for (const int mi : M.groups[static_cast<std::size_t>(gi)].members)
+	{
+		const auto& c = M.camps[static_cast<std::size_t>(mi)];
+		if (!c.attacks() || (bbget(W.vis, c.pos) && !bbget(W.occ_camps, c.pos)))
+			continue;
+		if (c.reach != 4 || na >= static_cast<int>(at.size()))
+			return PKW_REACH; // elk/golem only (wolves, monoliths untested)
+		at[static_cast<std::size_t>(na++)] = c.pos;
+		ai = mi;
+	}
+	if (na == 0)
+		return PKW_DEAD;
+	if (!(na == 1 ? PKH_ON(3) : PKH_ON(4)))
+		return PKW_BIT;
+	if (na == 1 && !PKH_ON(1) && econ::pkh_inreach_ok(gi))
+		return PKW_HYB; // b2400 PKH bit 2 HYBRID: my HP covers the rest of an in-reach clear: live's basics; else the kite cycle
+	const vec2 me = W.me.pos;
+	const int dmin = pkh_dmin(me, at.data(), na);
+	if (dmin > (pkh_lat >= 0 ? 8 : 6))
+		return PKW_FAR;
+	if (intel::count_near(me, 8, 5) > 0)
+		return PKW_FOE;
+	for (const auto& al : W.allies)
+		for (int i = 0; i < na; ++i)
+			if (cheb(al.pos, at[static_cast<std::size_t>(i)]) <= 8)
+				return PKW_MATE;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+		if (s != P.my_slot && comms::claim_group(comms::claim(s)) == gi)
+			return PKW_MATE;
+	for (const auto& vc : W.camps) // another awake group's reach
+	{
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (vc.awake && c.group != gi && c.attacks() && cheb(c.pos, me) <= c.reach)
+			return PKW_OTHER;
+	}
+	const int now_r = static_cast<int>(W.round);
+	if (pkh_lat != gi)
+	{
+		if (W.moved || W.cast)
+			return PKW_ACTED; // an earlier stage took the turn: live
+		pkh_lat = gi;
+		pkh_last_dmg = -1000;
+		for (int i = 0; i < na; ++i) // entering inside reach of an attacker seen awake or not seen: count from now
+			if (cheb(me, at[static_cast<std::size_t>(i)]) <= 4 && !(bbget(W.vis, at[static_cast<std::size_t>(i)]) && !bbget(W.awake, at[static_cast<std::size_t>(i)])))
+				pkh_last_dmg = now_r;
+	}
+	pkh_turn_r = now_r;
+	if (na >= 2)
+		return pkh_pack_turn(gi, at.data(), na);
+	const vec2 a = at[0];
+	const int d = dmin;
+	const bool vis = bbget(W.vis, a);
+	const bool awake = vis && bbget(W.awake, a);
+	if (d <= 4 && awake)
+		pkh_last_dmg = std::max(pkh_last_dmg, now_r); // in reach of the awake camp: its empty phases start after I leave
+	const bool hot = awake || now_r - pkh_last_dmg < 3;
+	if (W.moved || W.cast)
+		return 0; // hold: nothing more this turn
+	auto s1_cast = [&]() -> bool
+	{
+		const int r = std::max(0, static_cast<int>(k.aoe_radius));
+		for (int dx = -r; dx <= r; ++dx) // a tile within the radius of the attacker and in range of me, covering no other group
+			for (int dy = -r; dy <= r; ++dy)
+			{
+				const vec2 t{ a.x + dx, a.y + dy };
+				if (!inb(t) || cheb(t, me) > static_cast<int>(k.aoe_range))
+					continue;
+				bool other = false;
+				for (const auto& vo : W.camps)
+					if (M.camps[static_cast<std::size_t>(vo.ci)].group != gi && cheb(M.camps[static_cast<std::size_t>(vo.ci)].pos, t) <= r)
+						other = true;
+				if (!other && cast_at(k.slot_aoe, t))
+					return true;
+			}
+		return false;
+	};
+	const bool s0_next = W.cd[0] <= 1; // ready now, or after this turn's end
+	if (d < 4 || (d == 4 && hot))
+	{
+		if (pkh_step_ring(a, d + 1, gi))
+			return 0; // out of reach, a ring a turn
+		if (hot && vis && ready(0) && cast_on_camp(0, ai))
+		{
+			pkh_last_dmg = now_r; // no step out: the stun skips the next camp phase
+			return 0;
+		}
+		return PKW_NOTILE;
+	}
+	if (d == 4) // asleep, >= 3 rounds since I was in reach or dealt damage
+	{
+		if (vis && ready(0) && cast_on_camp(0, ai))
+		{
+			pkh_last_dmg = now_r; // t0: s0 wakes it stunned
+			return 0;
+		}
+		if (vis && s0_next)
+			return 0; // s0 next turn
+		pkh_step_ring(a, 5, gi); // no s0 (cooldown or no sight): wait at 5
+		return 0;
+	}
+	if (d == 5)
+	{
+		if (hot)
+		{
+			if (ready(k.slot_aoe) && s1_cast())
+				pkh_last_dmg = now_r;
+			return 0; // out of reach: s1 or wait
+		}
+		if (s0_next && pkh_step_ring(a, 4, gi))
+			return 0; // the step to 4 on a sleeping group, s0 next turn
+		if (ready(k.slot_aoe) && s1_cast())
+			pkh_last_dmg = now_r; // s0 on cooldown: the s1-from-5 half
+		return 0;
+	}
+	if (pkh_step_ring(a, d - 1, gi))
+		return 0; // 6-8: toward 5
+	return PKW_NOTILE;
+}
+__attribute__((noinline)) bool pkh_turn()
+{
+	const int was = pkh_lat;
+	const int why = pkh_turn_why();
+	pkh_why = why;
+	pkh_why_r = static_cast<int>(W.round);
+	if (why == 0)
+		return true;
+	if (was >= 0)
+	{
+		pkh_hb = why; // hand-back reason
+		pkh_hb_r = pkh_why_r;
+	}
+	pkh_lat = -1;
+	pkh_turn_r = -1;
+	return false;
+}
 } // namespace nova::combat
