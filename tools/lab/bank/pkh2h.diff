+	const float rsv = std::min(static_cast<float>(PKH_HY_TAB[2]), static_cast<float>(PKH_HY_TAB[1]) * static_cast<float>(W.me.gems) / 100.0f) / 100.0f * W.me.maxhp;
+	return e.dmg <= e.budget + (W.me.shield - rsv) / cm;
