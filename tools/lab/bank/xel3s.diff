diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -1626,6 +1626,15 @@ inline constexpr int SCH_TAB[2] = { 0x53434831, SCH_BITS };
 // v864 OXF (b2366, RC X770 / X826; baked, play-identical): RXLS1's respawn list (econ_observe.cc expiry pass, mark_respawn) on maps with
 // OXF_NG+ groups (the pool's cap; ladder / hms maps reach 114+); OVSC1 (observe skips an unseen group's dead hoard note) needs no state.
 #define OXF_NG 64
 inline std::vector<int> oxf_rl;           // groups mark_respawn made respawning (deduped by oxf_rin)
 inline std::vector<std::uint8_t> oxf_rin; // 1 while the group is in oxf_rl
 inline bool oxf_l2 = false;               // list mode this game (set by the expiry pass each turn)
+// b2384 XEL (RC X852 XEL1, fight-call lead election): runtime data flag XEL_TAB[1], read first; 0 = v866. Bit 1: fight_layer_turn defers
+// only to a mate's POSTED fresh fight call (the fl_call test), not to any visible lower-slot mate within 6: that mate posts only when it
+// is not calm, sees a foe within 6 and is not channelling, so a higher slot that alone sees the foe (or a lower slot recalling) left
+// the fight with no call. Two posts in one round: the later write wins (harmless).
+// Bit 2 FLW1 (RC X854): the fresh-call deferral takes calls up to 3 rounds old (the lead's unchanged re-post interval), so a body acting
+// before the lead in round r+3 no longer posts its own call and takes the leadership with turn order.
+#define XEL_BITS 0
+inline const volatile int XEL_TAB[2] = { 0x58454C31, XEL_BITS };
+#define XEL_ON(b) ((XEL_TAB[1] & (b)) != 0)
