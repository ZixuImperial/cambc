diff --git b/src/feat_rhc.cpp b/src/feat_rhc.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_rhc.cpp
@@ -0,0 +1,37 @@
+#ifdef NOVA_UNITY_ALL // compiled only through nova_all.cpp
+// feat_rhc.cpp (RHC, b1631): see feat_rhc.h. Reached only when RHC_ON(...) is true at the hooks (econ.cpp tt_travel_recall, refresh_target).
+#include "feat_rhc.h"
+#include "move.h"
+namespace nova::feat::rhc
+{
+// firecount counter: the hold kept a target the choice would have switched
+static void fired_hold()
+{
+}
+// firecount counter: a walk home in place of an RH recall
+static void fired_walk()
+{
+}
+void note(int gi, int now_r)
+{
+	rhc_r = now_r;
+	rhc_gi = gi;
+}
+bool hold(int target, bool on_spawn, int now_r)
+{
+	if (!on_spawn || target < 0 || target != rhc_gi || now_r - rhc_r > RHC_HOLD)
+		return false;
+	fired_hold();
+	return true;
+}
+bool walk_home(int gi, int now_r)
+{
+	const distance_field* hf = ::nova::mv::home_field();
+	if (!hf || !::nova::mv::step_field(*hf))
+		return false;
+	note(gi, now_r);
+	fired_walk();
+	return true;
+}
+} // namespace nova::feat::rhc
+#endif
diff --git b/src/feat_rhc.h b/src/feat_rhc.h
new file mode 100644
--- /dev/null
+++ b/src/feat_rhc.h
@@ -0,0 +1,20 @@
+#pragma once
+// feat_rhc (RHC, b1631, owner bug 01a1ba39 03showdown r11-28): the RECALL_HOP travel recall (econ.cpp tt_travel_recall) committed
+// Heart of Ruin to a fresh target (g12, chosen r11: walk 23 v recall 4 + hop 5) from 3 tiles off the spawn; on landing (r16) the
+// choice re-ran after an ally left g7 and switched to g7 (rate 1.36 v 1.02), so the bought crystal went unused and the body walked
+// back out past where it recalled. Bits: 1 HOLD = on the spawn within RHC_HOLD rounds of an RH commit, refresh_target keeps that
+// target (unless its rate is <= 0); 2 WALK = an RH trip whose spawn walk is no longer than the recall walks home instead of
+// recalling (no 4-5 round channel, no cancel risk). Flag first: 0 does no work.
+#include "common.h"
+#define RHC_BITS 0
+inline const volatile int RHC_TAB[2] = { 0x52484331, RHC_BITS }; // slot 0 magic keeps it out of .bss
+#define RHC_ON(b) ((RHC_TAB[1] & (b)) != 0)
+#define RHC_HOLD 8 // bit 1: rounds after the commit the hold lasts (a recall lands in 4-5)
+namespace nova::feat::rhc
+{
+inline int rhc_r = -1000; // round of my last RH commit (recall or walk home)
+inline int rhc_gi = -1;   // its group
+void note(int gi, int now_r);
+bool hold(int target, bool on_spawn, int now_r); // bit 1
+bool walk_home(int gi, int now_r);              // bit 2: true when it stepped toward the spawn
+} // namespace nova::feat::rhc
