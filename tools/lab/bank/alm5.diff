+		return; // v684 ALM bit 2: no lock or stun in time on arrival
+	deny::gd_mem.h = 0;
+	deny::gd_mem.pos = alm_alt;
+	deny::gd_mem.set = p;
+	deny::gd_mem.until = p + rs::tribute_turns(need, true) + 1;
+	deny::gd_mem.ending = true;
+	deny::gd_mem.lock_only = false; // ALM (RC C150): an alarm is a stun-or-lock follow, never a stale XDF1 lock-only one
