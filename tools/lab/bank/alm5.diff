+// v684 ALM: the alarm takes any entry below priority 45 (codes that don't fit the entry width are not posted).
+void alm_post(int altar, int round)
+{
+	if (!CS.t2 || altar < 0)
+		return;
+	const int code = CS.t2_rnews + 4 * (CS.t2_ng + altar) + 3;
+	if (code >= (1 << (CS.ew - 1)) || CS.ew > 31)
+		return;
+	const std::uint32_t all = comms::spare_get(CS.f);
+	const int e = team_mem_pick_entry(all, 45, -1, now(), nullptr);
+	if (e < 0)
+		return;
+	const std::uint32_t v = static_cast<std::uint32_t>(round & 1) | (static_cast<std::uint32_t>(code) << 1);
+	const int sh = e * CS.ew;
+	const std::uint32_t mk = ((1u << CS.ew) - 1u) << sh;
+	comms::spare_put(CS.f, (all & ~mk) | (v << sh));
+	CS.last[static_cast<std::size_t>(e)] = v;
+	CS.first[static_cast<std::size_t>(e)] = now();
+}
