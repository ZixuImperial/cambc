+++ b/src/prism.cpp
@@ -15,12 +15,13 @@
 #include "racefe.h" // RACE (b1372, prism.h)
 #include "restfix.h"
 #include "support.h"
 #include "econ.h" // WINBANK TGT
 #include "move.h" // PG9 GUARD
 #include "mult.h" // MFX bit 1024
+#include "feat_esc.h" // ESC (b1554)
 
 namespace nova::prism {
 
 Plan PL;
 
 namespace {
@@ -650,21 +651,25 @@ bool chan_start_ok(int gems)
 	if (gems < PC_CHAN_BAG)
 		return true;
 	// WIN_START: a winning bag opens with an enemy near while she is healthy, as channel_doomed keeps one (PC_WIN_KEEP_HP; WKH bit 1:
 	// below it, while no known foe can kill her first)
 	if (W.tributed_us + gems >= 1000 && (W.me.hp * 100.0f >= static_cast<float>(WKH_TAB[2]) * W.me.maxhp || (!wkh_doomed(chan_turns(gems)))))
 		return !(wsg_blocked(gems)); // WSG bit 4 (prism.h): flag first
+	if (ESC_ON(32) && nearest_known_enemy() <= PC_CHAN_R && nova::feat::esc::pc_escort(gems, chan_turns(gems), 0))
+		return !(wsg_blocked(gems)); // v614 ESC bit 32 (owner 8 Nov): an ordered bank escorted by mates opens
 	return nearest_known_enemy() > PC_CHAN_R;
 }
 
 // PC_CHAN's keep arms, shared by channel_doomed and chan_doom_free: a bag under PC_CHAN_BAG, or (winchan) a bag that wins the
 // game while her HP >= PC_WIN_KEEP_HP percent (WKH bit 1: below it, while !wkh_doomed over `ticks`, the own turns until it lands)
 static bool doom_exempt(int gems, int ticks)
 {
 	if (gems < PC_CHAN_BAG)
 		return true;
+	if (ESC_ON(32) && (W.me.state & ST_TRIBUTE) && nova::feat::esc::pc_escort(gems, ticks, 1))
+		return true; // v614 ESC bit 32 (owner 8 Nov): an escorted ordered bank in its channel is kept
 	if (W.tributed_us + gems < 1000)
 		return false;
 	if (!(W.me.hp * 100.0f < static_cast<float>(WKH_TAB[2]) * W.me.maxhp))
 		return true;
 	return !wkh_doomed(ticks); // WKH bit 1 (prism.h): flag first
 }
