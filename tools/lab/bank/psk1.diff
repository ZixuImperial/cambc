diff --git a/src/combat_flags.h b/src/combat_flags.h
--- a/src/combat_flags.h
+++ b/src/combat_flags.h
@@ -453,6 +453,14 @@ inline constexpr int VLS_TAB[2] = { 0x564C5331, VLS_BITS }; // slot 0 magic keep
 // VLC (b1816, Rule Checker X144/C35: the complete VLS1 form, owner replay 01a1c5d6). Runtime data flag, read first; 0 = v703. Bit 1:
 // react_kite's `forced` (the shot replaces the escape step) holds only when an adjacent melee foe exists AND no other foe has me within
 // foe_next_turn_reach; with no adjacent melee foe the shot never replaces the step (one-turn reach misses a two-turn threat).
 // v704 VLC: kite shot needs an adjacent melee foe (VLS2)
 #define VLC_BITS 1
 inline constexpr int VLC_TAB[2] = { 0x564C4331, VLC_BITS }; // slot 0 magic keeps it out of .bss
+
+// PSK (b1789, Deep spec_psk_1110): a big-bag Prism keeps her stun for champions. 0 = v704. Bit 1: camp_abilities' spell hold
+// (combat_camps.cc) no longer exempts the carrier Prism while her bag is >= PSK_BAG and a foe champion is in `seen`: her s0 stun is kept
+// for champions (her parting stun, GR:568); her area spell and basic attacks on camps are unchanged.
+#define PSK_BITS 0
+#define PSK_BAG 150
+inline const volatile int PSK_TAB[3] = { 0x50534B31, PSK_BITS, PSK_BAG }; // slot 0 magic keeps it out of .bss
+#define PSK_ON(b) ((PSK_TAB[1] & (b)) != 0)
