+// MJP bit 4 (1b): per clear (closed by my next capture reward), my camp HP lost, the crew's (me + visible mates within 3 claiming my
+// target), and my dps1 share of the crew; a ring of my last 3 clears.
+static std::array<float, 3> mjb_me{}, mjb_crew{}, mjb_s{};
+static std::array<int, 3> mjb_n{};
+static std::size_t mjb_k = 0;
+static int mjb_cnt = 0, mjb_nrw = 0, mjb_mate3 = 0;
+static float mjb_cme = 0.0f, mjb_ccrew = 0.0f, mjb_cs = 0.0f;
+static int mjb_cn = 0;
+static std::array<float, 8> mjb_php{};
+static std::array<int, 8> mjb_pr{ -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000 };
+static __attribute__((noinline)) void mjb_observe(int dmin)
+{
+	const int me = P.my_slot;
+	bool camp = false;
+	for (const auto& vc : W.camps)
+		camp = camp || (vc.awake && vc.ci >= 0 && vc.ci < M.nc && cheb(M.camps[static_cast<std::size_t>(vc.ci)].pos, W.me.pos) <= M.camps[static_cast<std::size_t>(vc.ci)].reach);
+	if (me >= 0 && me < 8 && camp && dmin > 5 && T.target >= 0 && emb_php >= 0 && emb_pr == now() - 1 && !W.on_spawn)
+	{
+		const float mine = W.me.hp < emb_php ? emb_php - W.me.hp : 0.0f;
+		const float myd = std::max(1.0f, TM.m[static_cast<std::size_t>(me)].dps1);
+		float crew = mine, dsum = myd;
+		bool mate = false;
+		for (const auto& al : W.allies)
+		{
+			if (al.slot < 0 || al.slot >= 8 || al.slot == me || cheb(al.pos, W.me.pos) > 3 || TM.claim[static_cast<std::size_t>(al.slot)] != T.target)
+				continue;
+			mate = true;
+			dsum += std::max(0.0f, TM.m[static_cast<std::size_t>(al.slot)].dps1);
+			const auto si = static_cast<std::size_t>(al.slot);
+			if (mjb_pr[si] == now() - 1 && al.hp < mjb_php[si])
+				crew += mjb_php[si] - al.hp;
+		}
+		mjb_cme += mine;
+		mjb_ccrew += crew;
+		mjb_cs += myd / dsum;
+		++mjb_cn;
+		mjb_mate3 = ((mjb_mate3 << 1) | (mate ? 1 : 0)) & 7;
+	}
+	for (const auto& al : W.allies)
+		if (al.slot >= 0 && al.slot < 8)
+		{
+			mjb_php[static_cast<std::size_t>(al.slot)] = al.hp;
+			mjb_pr[static_cast<std::size_t>(al.slot)] = now();
+		}
+	if (emd.nrw != mjb_nrw)
+	{
+		mjb_nrw = emd.nrw;
+		if (mjb_cn > 0)
+		{
+			mjb_me[mjb_k] = mjb_cme;
+			mjb_crew[mjb_k] = mjb_ccrew;
+			mjb_s[mjb_k] = mjb_cs;
+			mjb_n[mjb_k] = mjb_cn;
+			mjb_k = (mjb_k + 1) % 3;
+			++mjb_cnt;
+		}
+		mjb_cme = mjb_ccrew = mjb_cs = 0.0f;
+		mjb_cn = 0;
+	}
+}
+// MJP bit 4 (1b): my share s and the crew's camp damage relative to mine over my last 3 clears (no clears: s 1 solo, else .5; ratio 1).
+static void mjb_factors(float& s, float& cr)
+{
+	s = 1.0f;
+	cr = 1.0f;
+	if (mjb_cnt == 0)
+	{
+		s = mjb_mate3 == 0 ? 1.0f : 0.5f;
+		return;
+	}
+	float me = 0.0f, crew = 0.0f, ss = 0.0f;
+	int n = 0;
+	for (std::size_t i = 0; i < static_cast<std::size_t>(std::min(mjb_cnt, 3)); ++i)
+	{
+		me += mjb_me[i];
+		crew += mjb_crew[i];
+		ss += mjb_s[i];
+		n += mjb_n[i];
+	}
+	if (n > 0)
+		s = ss / static_cast<float>(n);
+	if (me > 0.0f)
+		cr = crew / me;
+}
