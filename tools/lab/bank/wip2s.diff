+// WIP bit 2 FIGHT VISION (common_flags.h; the caller read the flag): with a foe near (in sight or seen <= 2 rounds ago within 6), the
+// unlit bush tile within 4 of a foe that vanished 1-4 rounds ago, within my ward reach (2), nearest that foe's last tile.
+static vec2 wip_fight_bush_tile()
+{
+	vec2 best{ -1, -1 };
+	if (seen.empty() || memory::bkc_bushy == 0 || !W.alive || W.me.channeling() || fuel() < BSX_TAB[4])
+		return best;
+	const vec2 me = W.me.pos;
+	bool nearf = false;
+	for (const auto& e : W.enemies)
+		nearf = nearf || cheb(e.pos, me) <= WIP_FOE_R;
+	for (const auto& s : seen)
+		nearf = nearf || (W.round - s.round <= 2 && cheb(s.foe.pos, me) <= WIP_FOE_R);
+	if (!nearf)
+		return best;
+	int bd = 99;
+	for (const auto& s : seen)
+	{
+		const int age = W.round - s.round;
+		if (age < 1 || age > 4 || cheb(s.foe.pos, me) > WIP_FOE_R)
+			continue;
+		bool vis = false;
+		for (const auto& e : W.enemies)
+			vis = vis || e.h == s.h;
+		if (vis)
+			continue;
+		for (int dx = -2; dx <= 2; ++dx)
+			for (int dy = -2; dy <= 2; ++dy)
+			{
+				const vec2 q{ me.x + dx, me.y + dy };
+				if (!inb(q) || !bbget(M.bushes, q) || bbget(W.vis, q))
+					continue;
+				const int d = cheb(q, s.foe.pos);
+				if (d <= 4 && d < bd)
+				{
+					bd = d;
+					best = q;
+				}
+			}
+	}
+	return best;
+}
+vec2 wip_vanished_or_fight_tile()
+{
+	vec2 v = vanished_foe_last_tile();
+	if (WIP_ON(2) && v.x < 0)
+		v = wip_fight_bush_tile();
+	return v;
+}
