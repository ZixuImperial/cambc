+// b2345 CYS: a roster carry that claims gi: 0 = on a spawn tile of g, else her Chebyshev distance to its nearest member tile
+// (only when she is free: not channelling, no visible foe within 6 of her); -1 = none.
+static int cys_gain = 0, cys_cfit = 0; // b2378 CYS bit 16: the chosen carry's fit gain over mine, and her fit (set by cys_carry)
+static __attribute__((noinline)) int cys_carry(const GroupI& g, int gi)
+{
+	int best = -1;
+	const bool kit = CYS_ON(16 | 256); // b2378 CYS bits 16/256: only a carry whose fit beats mine on gi
+	const int myfit = kit ? planner::cys_fit(P.my_slot, gi) : 0;
+	cys_gain = cys_cfit = 0;
+	for (const int s : { P.carrier_gems, P.carrier_gold })
+	{
+		if (s < 0 || s >= P.n || s >= 8)
+			continue;
+		const auto t = P.type[static_cast<std::size_t>(s)];
+		if (t != cambc::champion_type::prism && t != cambc::champion_type::vesper_vale && t != cambc::champion_type::marcella)
+			continue;
+		const Body* b = s == P.my_slot ? (W.alive ? &W.me : nullptr) : W.ally_by_slot(s);
+		if (!b || !(s == P.my_slot ? econ::claim_target() == gi : econ::claims(s, gi)))
+			continue;
+		const int cf = kit ? planner::cys_fit(s, gi) : 0;
+		if (kit && cf - myfit <= 0) // b2378 CYS bit 16: the hand-over creates no value by the fit table
+			continue;
+		if (econ::on_group_spawn_tile(g, b->pos))
+		{
+			if (econ::cys_capm_gone(*b, g)) // RC C891: a carry leaving by a recall or teleport before the pay is not paid
+				continue;
+			cys_gain = cf - myfit;
+			cys_cfit = cf;
+			return 0;
+		}
+		if (b->channeling())
+			continue;
+		bool foe = false;
+		for (const auto& e : W.enemies)
+			foe |= cheb(e.pos, b->pos) <= 6;
+		if (foe)
+			continue;
+		int d = 1000;
+		for (int ci : g.members)
+			d = std::min(d, cheb(M.camps[static_cast<std::size_t>(ci)].pos, b->pos));
+		if (best < 0 || d < best)
+		{
+			best = d;
+			cys_gain = cf - myfit;
+			cys_cfit = cf;
+		}
+	}
+	return best;
+}
+// b2345 CYS bit 2: wait off the region (the turn is used) while a free roster carry claiming gi is within 4, at most her distance + 2 rounds.
+static int cys_w_gi = -1, cys_w_start = -1000, cys_w_lim = 0;
+// b2378 CYS bit 32: the wait's round budget (one body waits): my trip at gi (my value of gi over gi's own rate T.rate, in rounds)
+// x her fit gain / her fit, at most 60; 0 without a rate (RC C891c F1/F2).
+static __attribute__((noinline)) int cys_price(const GroupI& g, int gi)
+{
+	if (cys_cfit <= 0 || cys_gain <= 0 || !(econ::T.rate > 0.0f))
+		return 0;
+	const float trip = econ::group_value(g, gi, P.my_slot) / econ::T.rate;
+	return static_cast<int>(std::min(60.0f, trip * static_cast<float>(cys_gain) / static_cast<float>(cys_cfit)));
+}
+// b2378 CYS bit 32: true when my partner, nearer gi (or level and the lower slot), also waits off it for the carry: I move on.
+static __attribute__((noinline)) bool cys_partner_waits(const GroupI& g, int gi)
+{
+	const Body* pb = partner_body();
+	if (!pb || pb->channeling() || !(pb->slot >= 0 && pb->slot < 8 && econ::claims(pb->slot, gi)) || econ::on_group_spawn_tile(g, pb->pos))
+		return false;
+	int dm = 1000, dp = 1000;
+	for (int ci : g.members)
+	{
+		const vec2 cp = M.camps[static_cast<std::size_t>(ci)].pos;
+		dm = std::min(dm, cheb(cp, W.me.pos));
+		dp = std::min(dp, cheb(cp, pb->pos));
+	}
+	return dp < dm || (dp == dm && pb->slot < P.my_slot);
