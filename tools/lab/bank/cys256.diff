+			cys_w_gi = gi;
+			cys_w_start = W.round;
+			cys_w_lim = lim;
+		}
+		if (W.round - cys_w_start + d > cys_w_lim)
+			return 0;
+		return cys_partner_waits(g, gi) ? 2 : 1;
