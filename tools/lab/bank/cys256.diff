+		cys_w_start = W.round;
+		cys_w_lim = d + 2;
+	}
+	return W.round - cys_w_start <= cys_w_lim ? 1 : 0;
+}
+// b2378 CYS bit 256: on my pre-clear group, a kit-matched roster carry that claims it (on it or walking in) takes the capture.
