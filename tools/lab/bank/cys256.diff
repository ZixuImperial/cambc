+int cys_wait(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	if (econ::on_group_spawn_tile(g, W.me.pos))
+		return 0;
+	const int d = cys_carry(g, gi);
+	if (CYS_ON(32)) // b2378 CYS bit 32 PRICED REACH (with 16)
+	{
+		if (d <= 0)
+			return 0;
+		if (cys_w_gi != gi || W.round - cys_w_start > 60)
+		{
+			const int lim = cys_price(g, gi);
+			if (d > lim)
