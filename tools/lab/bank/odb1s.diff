+// b2386 ODB bit 2 (caller read the flag; before the bank field step): a LETHAL foe (sighting burst, real HP >= my HP + shield) seen within
+// ODB_AGE rounds, within 8 of me and nearer my altar (the bank field descended from my tile, RC C1181) than I am: recall if recall_safe, else one home-field step. True
+// when the turn's walk was taken here (a recall started, or the home step, or no step at all: the bank step is withheld).
+__attribute__((noinline)) bool odb_bank_block(const distance_field& bf)
+{
+	if (M.altars.empty())
+		return false;
+	const vec2 me = W.me.pos;
+	const float ehp = W.me.hp + W.me.shield;
+	bool any = false; // RC C1181b: the cheap trigger first (a LETHAL sighting within 8 of me, <= ODB_AGE rounds old)
+	for (const auto& s : combat::seen)
+		any |= now() - s.round <= ODB_TAB[2] && cheb(s.foe.pos, me) <= 8 && mu::mult_foe_hit_to_real_hp(s.foe.burst) >= ehp;
+	if (!any)
+		return false;
+	// RC C1181 FIX 1 (HDA's form, C1154b): the altar the walk heads to = descend the bank field from my tile to its goal, then the altar
+	// nearest that end tile.
+	vec2 end = me;
+	std::uint16_t cur = dfget(bf, end);
+	if (cur == UNREACH)
+		return false;
+	for (int it = 0; it < 256 && cur > 0; ++it)
+	{
+		vec2 bn = end;
+		std::uint16_t bv = cur;
+		for (const vec2 dd : DIRS)
+		{
+			const vec2 n = end + dd;
+			if (!inb(n))
