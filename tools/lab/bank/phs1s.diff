 // An ally's claim (a group whose anchor is within 8 tiles of gi's) or, for my own choices after the opening, a visible ally within 8
 // tiles of gi's anchor. The opening simulation uses claims only (positions are all the spawn). foes_down_count: enemy bodies that cannot be
 // back on their spawn within `ahead` rounds (once per round).
+// b2393 PHS bit 1: true when I am a Prism, gi is a golem/elk group no foe is known within 8 of, and clearing it alone would leave me
+// under PHS_KEEP % of max HP (spec_phs_1113: kill time from her cooldown cycle, each attacker hits until it dies).
+bool phs_refuse(int gi, const GroupI& g, const GroupMem& m)
+{
+	(void)gi;
+	if (!prism_layer::type(W.me.type) || (g.n_golem + g.n_elk) == 0 || g.att.empty() || intel::count_near(g.anchor, 8, 5) > 0)
+		return false;
+	const float scale = (m.status == GS_ALIVE && m.hp_left >= 0) ? clampf(m.hp_left / std::max(1.0f, g.hp), 0.02f, 1.0f) : 1.0f;
+	const float dpr = std::max(10.0f, (W.me.str + 2.5f * W.me.foc / static_cast<float>(rs::slot_cooldown())) * mu::my_camp(mu::OUT));
+	float tc = 0, cost = 0;
+	for (const auto& a : g.att)
+	{
+		tc += a.first * scale / dpr;
+		cost += a.second * tc;
+	}
+	cost -= std::min(1.0f, 1.0f / static_cast<float>(rs::slot_cooldown())) * tc * g.str_max; // one s0 stun per cycle skips a hit
+	cost = std::max(0.0f, cost) * mu::my_camp(mu::IN);
+	return W.me.hp - cost < static_cast<float>(PHS_TAB[2]) / 100.0f * W.me.maxhp;
+}
