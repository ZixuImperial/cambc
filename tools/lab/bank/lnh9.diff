+	set_target(cg, std::max(T.rate, 0.0f), 1);
+}
+bool lnh_carry_keep()
+{
+	return lnh_call_g >= 0 && lnh_call_g == T.target;
+}
+bool lnh_yield_capture(int gi)
+{
+	if (gi < 0 || gi >= M.ng || !lnh_lane(M.groups[static_cast<std::size_t>(gi)]))
+		return false;
+	const int cs = lnh_carry_slot(gi);
+	if (cs < 0 || cs == P.my_slot)
+		return false;
+	lnh_init();
+	lnh_scan(gi);
+	if (static_cast<int>(now()) - lnh_foe_r[static_cast<std::size_t>(gi)] < 2)
+		return false; // a foe could contest: I stay on (the split is accepted)
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	bool carry_on = false;
+	for (const auto& a : W.allies)
+		if (a.slot == cs)
+			for (int o : g.members)
+				carry_on = carry_on || M.camps[static_cast<std::size_t>(o)].pos == a.pos;
+	if (!carry_on)
+		return false;
+	bool me_on = false;
+	for (int o : g.members)
+		me_on = me_on || M.camps[static_cast<std::size_t>(o)].pos == W.me.pos;
+	if (!me_on)
+		return true; // beside the region: hold here, the carry takes the full pay
+	if (!W.can_move() || W.moved)
+		return false;
+	// step off onto a free non-camp neighbour out of camp reach; none -> stay on
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = W.me.pos + d;
+		if (!inb(n) || !mv::free_tile(n) || bbget(M.camp_tiles, n) || mv::camp_threat(n) > 0)
+			continue;
+		NLOG("r%d slot %d lnh yields lane %d to the carry\n", now(), P.my_slot, gi);
+		return mv::try_move(n);
+	}
+	return false;
+}
+} // namespace nova::econ
