+		if (o == ci)
+			continue;
+		const int d = lnh_dead_r[static_cast<std::size_t>(o)];
+		if (d < lnh_alive_r[static_cast<std::size_t>(o)] || d < 0 || (m.respawn_at > d && m.respawn_at <= r))
