+void lnh_scan(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const int r = static_cast<int>(now());
+	if (lnh_seen_r[static_cast<std::size_t>(gi)] == r)
+		return;
+	lnh_seen_r[static_cast<std::size_t>(gi)] = r;
+	bool foe = false;
+	for (int ci : g.members)
+	{
+		const vec2 p = M.camps[static_cast<std::size_t>(ci)].pos;
+		if (bbget(W.vis, p))
+		{
+			if (bbget(W.occ_camps, p))
+				lnh_alive_r[static_cast<std::size_t>(ci)] = r;
+			else
+				lnh_dead_r[static_cast<std::size_t>(ci)] = r;
+		}
+		for (const auto& e : W.enemies)
+			foe = foe || cheb(e.pos, p) <= LNH_R;
+		for (const auto& e : W.enemies_far)
