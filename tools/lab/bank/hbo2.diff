 	return h <= 2.0f * W.me.str * kit_rules::passive_mult(W.me) * mu::pair(W.me, f);
 }
+// b2386 HBO bit 1 (caller read the flag): held turns in a row against one focus, and the back-off step.
+static int hbo_round = -1000, hbo_n = 0;
+static std::uint32_t hbo_h = 0;
+static __attribute__((noinline)) void hbo_fc_step()
+{
+	__asm__ volatile("");
+}
+static __attribute__((noinline)) bool hbo_back_off(int d, std::uint32_t fh, vec2 fp)
+{
+	if (hbo_round != W.round)
+		hbo_n = (hbo_round == W.round - 1 && hbo_h == fh) ? hbo_n + 1 : 1;
+	hbo_round = W.round;
+	hbo_h = fh;
+	if (hbo_n < HBO_TAB[3] || static_cast<int>(W.me.gems) < HBO_TAB[2] || d <= W.me.range + 1 || !W.can_move())
+		return false;
+	for (const auto& al : W.allies) // seen this turn; alive by the engine read too (Planner: no stale mate)
+		if (cheb(al.pos, W.me.pos) <= HBO_TAB[4] && econ::siege_ally_alive(al.slot))
+			return false;
+	const vec2 rp = react_rally();
+	if (rp.x < 0 || rp == W.me.pos)
+		return false;
+	// RC C1316 + Planner: one step to a neighbour nearer the rally point, no nearer the focus, outside every seen foe's next-turn
+	// reach; else live's hold.
+	vec2 best{ -1, -1 };
+	int bd = cheb(W.me.pos, rp);
+	for (const vec2 dd : DIRS)
+	{
+		const vec2 t = W.me.pos + dd;
+		const int dt = cheb(t, rp);
+		if (dt >= bd || cheb(t, fp) < d || !mv::free_tile(t))
+			continue;
+		bool reach = false;
+		for (const auto& e : W.enemies)
+			reach = reach || cheb(t, e.pos) <= foe_next_turn_reach(e);
+		if (reach)
+			continue;
+		bd = dt;
+		best = t;
+	}
+	if (best.x < 0 || !mv::step_to(best, 0))
+		return false;
+	hbo_fc_step();
+	return true;
+}
 bool fight(const Assessment& a)
 {
 	AF_CHECK();
 	if (a.focus < 0)
 		return false;
 	const int bbm_lfr = turn_memory.last_fight_round; // BBM MF2: restored when the turn did nothing
@@ -527,12 +572,15 @@ bool fight(const Assessment& a)
 	if (c.path_failed && !c.acted)
 	{
 		if (!W.moved)
 			turn_memory.last_fight_round = bbm_lfr;
 		return false;
 	}
+	if (HBO_TAB[1] != 0 && HBO_ON(1) && c.hold && !c.acted && !W.moved &&
+		!(HBO_ON(2) && (c.f.channeling() || static_cast<float>(HBO_TAB[5]) * 0.1f * W.me.foc * mu::pair(W.me, c.f) >= eff_hp(c.f)))) // bit 2: a channelling or two-cast-killable focus
+		(void)hbo_back_off(c.d, c.f.h, c.f.pos); // b2386 HBO: a lone carrier's hold steps toward a mate or home
 	if (c.hold && !c.acted)
 		return true; // a hold ends the turn here (farming walks would step into their reach); past FSH_N held turns it falls through
 	if (!c.acted && !W.moved)
 		turn_memory.last_fight_round = bbm_lfr;
 	return c.acted;
 }
