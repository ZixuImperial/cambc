 // combat_fight_actions.cc: The actions of a FIGHT turn.
 #include "combat_internal.h"
 namespace nova::combat {
+// BEF bits 1/16: the lowest-HP visible foe within my attack range, not on their spawn.
+const Body* bef_weakest_in_range()
+{
+	const Body* b = nullptr;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, W.me.pos) <= W.me.range && !bbget(M.enemy_spawn, e.pos) && (!b || e.hp < b->hp))
+			b = &e;
+	return b;
+}
