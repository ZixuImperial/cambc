+static __attribute__((always_inline)) inline void act_core();
 __attribute__((always_inline)) void act()
+{
+	if (WAL_ON(3) && W.alive && P.my_slot >= 0)
+	{
+		const int t = now();
+		if (WAL_ON(1))
+		{
+			if (!combat::took_damage(1))
+			{
+				try
+				{
+					if (wal_try(t))
+						return;
+				}
+				catch (const RestartTurn&)
+				{
+					throw;
+				}
+				catch (const std::exception&)
+				{
+				}
+			}
+			act_core();
+			return;
+		}
+		act_core();
+		if (now() < ready_round)
+			return; // act_core placed (or the charge is not ready)
+		try
+		{
+			wal_try(t);
+		}
+		catch (const RestartTurn&)
+		{
+			throw;
+		}
+		catch (const std::exception&)
+		{
+		}
+		return;
+	}
+	act_core();
+}
