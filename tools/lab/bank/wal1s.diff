+// b2419 WAL (WAL_TAB, common_flags.h; callers read the flag): the altar ward.
+namespace {
+int wal_state = 0; // 0 not counted yet, 1 map qualifies, 2 not
+vec2 wal_alt{ -1, -1 }; // the likely bank altar's tile nearest our spawn
+std::vector<vec2> wal_tiles; // that altar's tiles
+int wal_seen_round = -1;
+int wal_next = 0; // no new search before this round (a search that placed nothing)
+// Diag marker (an entry the fire step counts).
+void wal_mark_placed()
+{
+	wal_fc_1();
+}
+int wal_dist(vec2 p)
+{
+	int d = BIG;
+	for (const vec2 a : wal_tiles)
+		d = std::min(d, cheb(p, a));
+	return d;
+}
+// Count the altar components once (8-connected, psa.py alt1); pick our bank altar; build the approach masks.
+__attribute__((noinline)) bool wal_setup()
+{
+	if (wal_state != 0)
+		return wal_state == 1;
+	if (!M.ready())
+		return false;
+	const int na = static_cast<int>(M.altars.size());
+	if (na == 0)
+	{
+		wal_state = 2;
+		return false;
+	}
+	std::vector<int> comp(static_cast<std::size_t>(na), -1);
+	int nc = 0;
+	for (int i = 0; i < na; ++i)
+	{
+		if (comp[static_cast<std::size_t>(i)] >= 0)
+			continue;
+		comp[static_cast<std::size_t>(i)] = nc;
+		std::vector<int> st{ i };
+		while (!st.empty())
+		{
+			const int k = st.back();
+			st.pop_back();
+			for (int j = 0; j < na; ++j)
+				if (comp[static_cast<std::size_t>(j)] < 0 &&
+					cheb(M.altars[static_cast<std::size_t>(k)].pos, M.altars[static_cast<std::size_t>(j)].pos) <= 1)
+				{
+					comp[static_cast<std::size_t>(j)] = nc;
+					st.push_back(j);
+				}
+		}
+		++nc;
+	}
+	int bi = -1;
+	std::uint16_t bd = UNREACH;
+	for (int i = 0; i < na; ++i)
+		if (M.altars[static_cast<std::size_t>(i)].d_home < bd)
+		{
+			bd = M.altars[static_cast<std::size_t>(i)].d_home;
+			bi = i;
+		}
+	if (nc > 2 || bi < 0)
+	{
+		wal_state = 2;
+		return false;
+	}
+	wal_alt = M.altars[static_cast<std::size_t>(bi)].pos;
+	for (int i = 0; i < na; ++i)
+		if (comp[static_cast<std::size_t>(i)] == comp[static_cast<std::size_t>(bi)])
+			wal_tiles.push_back(M.altars[static_cast<std::size_t>(i)].pos);
+	wal_state = 1;
+	wal_fc_4();
+	return true;
+}
+bool wal_watched()
+{
+	if (my_ward.x >= 0 && wal_dist(my_ward) <= 3)
+		return true;
+	for (const auto& a : ally)
+		if (a.pos.x >= 0 && wal_dist(a.pos) <= 3)
+			return true;
+	return false;
+}
+// Info marker: a turn my altar ward (or I) see a foe within 6 of the altar.
+void wal_note_sighting(int t)
+{
+	if (wal_seen_round == t || my_ward.x < 0 || wal_dist(my_ward) > 3)
+		return;
+	for (const auto& e : W.enemies)
+		if (wal_dist(e.pos) <= 6)
+		{
+			wal_seen_round = t;
+			wal_fc_2();
+			return;
+		}
+	for (const auto& e : W.enemies_far)
+		if (wal_dist(e.pos) <= 6)
+		{
+			wal_seen_round = t;
+			wal_fc_2();
+			return;
+		}
+}
+// With the charge ready and our bank altar within reach + 3, ward the approach. True when placed.
+__attribute__((noinline)) bool wal_try(int t)
+{
+	if (!wal_setup())
+		return false;
+	wal_note_sighting(t);
+	if (t < ready_round || t < wal_next || fuel() < wfs_actf())
+		return false;
+	read_consts();
+	const vec2 me = W.me.pos;
+	if (wal_dist(me) > reach_r + 2)
+		return false;
+	const auto& self = cambc::self();
+	if (self.ward_cooldown() > 0)
+		return false;
+	refresh_self();
+	if (W.me.channeling() || (W.me.state & ST_ALIVE) == 0)
+		return false;
+	scan_allied_wards();
+	if (wal_watched())
+		return false;
+	bad.erase(std::remove_if(bad.begin(), bad.end(), [&](const Bad& b) { return b.until <= t; }), bad.end());
+	// No vision query (each one costs a large share of the turn): the legal tile within reach and within 2 of the altar nearest the
+	// enemy anchor (the side the foe walks in from; a ward sees 6, so it covers the altar and its approach).
+	vec2 best{ -1, -1 };
+	int best_d = BIG;
+	wal_next = t + 3;
+	for (int dy = -reach_r; dy <= reach_r; ++dy)
+		for (int dx = -reach_r; dx <= reach_r; ++dx)
+		{
+			const vec2 p{ me.x + dx, me.y + dy };
+			if (!inb(p) || bbget(M.block, p) || camp_tile_blocks_ward(p) || ally_ward_at(p) || bad_tile(p))
+				continue;
+			if (wal_dist(p) > 2)
+				continue;
+			const int d = cheb(p, M.enemy_anchor);
+			if (d < best_d)
+			{
+				best_d = d;
+				best = p;
+			}
+		}
+	if (best.x < 0)
+		return false;
+	bool ok = false;
+	bool thrown = false;
+	try
+	{
+		cancel_spin_before_action();
+		ok = self.place_ward(best);
+	}
+	catch (const cambc::error& e)
+	{
+		thrown = true;
+		if (e.code() == cambc::error_code::invalid_action_place_ward_ally_ward_present)
+			note_ally_ward_tile(best);
+		else if (!rfa_own_error(e.code()))
+			bad.push_back({ best, t + 40 });
+		NLOG("r%d slot %d WAL ward %d,%d error %s\n", t, P.my_slot, best.x, best.y, e.what());
+	}
+	catch (const std::exception& e)
+	{
+		thrown = true;
+		bad.push_back({ best, t + 40 });
+		(void)e;
+	}
+	if (!ok)
+	{
+		if (!thrown)
+			note_ally_ward_tile(best);
+		return false;
+	}
+	NLOG("r%d slot %d WARD WAL %d,%d (me %d,%d)\n", t, P.my_slot, best.x, best.y, me.x, me.y);
+	placed_at(best);
+	wal_mark_placed();
+	return true;
+}
+} // namespace
