+// EHC (bits 1, 4; callers read the flag): my target group is awake and need+ bodies (me included) claim it within 6 of its anchor.
+bool ehc_herd_crew(int need)
+{
+	const int gi = T.target;
+	if (gi < 0 || gi >= M.ng)
+		return false;
+	bool awake = false;
+	for (const auto& c : W.camps)
+		if (c.awake && c.ci >= 0 && c.ci < M.nc && M.camps[static_cast<std::size_t>(c.ci)].group == gi)
+		{
+			awake = true;
+			break;
+		}
+	if (!awake)
+		return false;
+	const vec2 an = M.groups[static_cast<std::size_t>(gi)].anchor;
+	int n = cheb(W.me.pos, an) <= 6 ? 1 : 0;
+	for (const auto& a : W.allies)
+		if (a.slot >= 0 && a.slot < static_cast<int>(comms::CLAIM_SLOTS) && comms::cgroup(a.slot) == gi && cheb(a.pos, an) <= 6)
+			++n;
+	return n >= need;
+}
