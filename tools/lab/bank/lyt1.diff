@@ -733,6 +733,18 @@ inline constexpr int PSC_TAB[2] = { 0x50534331, PSC_BITS }; // slot 0 magic keep
 // DMP (b1789, Rule Checker DMP1): plan_memory_encode caps byte 10 at 200 groups and byte 11 at 40 altars while bytes 12/13 hold the
 // true counts, so pack() refused the whole image on a >200-group or >40-altar map (map class and tail blob lost). Runtime data flag
 // DMP_TAB[1], read first; 0 = off. Bit 1: pack() accepts true counts at or above the capped ones.
 // v685 DMP: 19 fixes phy1r2,npb1,orc1,wvc,cia3s,jgw31,x02,idm +11
 #define DMP_BITS 1
 inline constexpr int DMP_TAB[2] = { 0x444D5031, DMP_BITS }; // slot 0 magic keeps it out of .bss
+// LYT (b1807, bot_errors be219, Rule Checker unclear triage v685). Runtime data flag LYT_TAB[1], read first; 0 = v686. Bit 1: the compact
+// slim claim field (slim4_of_full, comms.cc) always encodes a retreat as 2 ng + 2 (the compact code fits by construction); the leftover
+// slim-2 room test dropped it to fight code 1 when 2 ng + 50 is a power of two (7 groups).
+#define LYT_BITS 0
+inline const volatile int LYT_TAB[2] = { 0x4C595431, LYT_BITS }; // slot 0 magic keeps it out of .bss
+#define LYT_ON(b) ((LYT_TAB[1] & (b)) != 0)
+// WCH (b1807, rules-gaps 385). Runtime data flag WCH_TAB[1], read first; 0 = v686. Bit 1: build_chokes keeps the choke spots aside and
+// stage_finish appends them with the bushes (A_FINAL, as ward_state.cc says), so the coverage cache stays valid and act() keeps placing
+// wards through the A_BUSH stages.
+#define WCH_BITS 0
+inline const volatile int WCH_TAB[2] = { 0x57434831, WCH_BITS }; // slot 0 magic keeps it out of .bss
+#define WCH_ON(b) ((WCH_TAB[1] & (b)) != 0)
diff --git a/src/comms.cc b/src/comms.cc
--- a/src/comms.cc
+++ b/src/comms.cc
@@ -48,13 +48,13 @@ static int slim4_of_full(int c)
 	if (c < 4)
 		return 0;
 	if (c < 4 + 4 * ng)
 		return 2 + (c - 4) / 4;
 	if (c < 4 + 8 * ng)
 		return 2 + ng + (c - 4 - 4 * ng) / 4;
-	if (c >= 4 + 8 * ng + 8 && c < 4 + 8 * ng + 12 && 2 * ng + 50 < (1 << std::bit_width(static_cast<unsigned>(2 * ng + 49))))
+	if (c >= 4 + 8 * ng + 8 && c < 4 + 8 * ng + 12 && (LYT_ON(1) || 2 * ng + 50 < (1 << std::bit_width(static_cast<unsigned>(2 * ng + 49))))) // LYT1
 		return 2 * ng + 2; // the retreat code
 	if (c < 16 + 8 * ng)
 		return 1;
 	const int ci = std::min(c - 16 - 8 * ng, 47), e = ci >> 4, o = (ci >> 1) & 7, h = ci & 1; // brain tm2_coming: ETA x octant x HP
 	if (L.slim == 4)
 		return 2 * ng + 3 + (e == 1 && h == 0 ? o : e >= 2 ? 8 : 9);
