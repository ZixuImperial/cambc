diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -879,6 +879,13 @@ inline constexpr int PEC_TAB[4] = { 0x50454331, PEC_BITS, PEC_M_X100, PEC_K }; /
 // Bits: 1 = idle-group pick by walk (no-walk groups skipped), 2 = idle arrival test (> 6) by walk.
 // Bit 4 (b1789, PTH's one pre-stated adaptation): the idle pick keeps live's cheb ranking and drops only groups whose walk is UNREACH or
 // exceeds cheb + 8 (alone; not with bits 1-2).
 // v707 PTH: idle pick skips groups far by walk (PTH adapt)
 #define PTH_BITS 4
 inline constexpr int PTH_TAB[2] = { 0x50544831, PTH_BITS }; // slot 0 magic keeps it out of .bss
+
+// PEY (pect, Rule Checker X180 on v706 PEC): two PEC follow-ups. 0 = nova_base_v707. Bit 1 PECT1 (confirmed bug): a resumed list
+// is used only by a body that still has a target (one that lost it between rounds re-rates the whole list). Bit 2 PECF1 (fuel): the
+// resumed loop stops once a bound is at or below the cut round's best rate (it could only lose to it).
+#define PEY_BITS 0
+inline const volatile int PEY_TAB[2] = { 0x50455931, PEY_BITS }; // slot 0 magic keeps it out of .bss
+#define PEY_ON(b) ((PEY_TAB[1] & (b)) != 0)
