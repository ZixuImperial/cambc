 // Gold in gem units. Early gold buys items that speed up every later clear (and wins fights), so it is worth
 // half a gem (B467_GOLDW_X100) until round 400; late in the game it only breaks ties. Where monoliths hold most of the gems,
 // gems are scarce and gold counts for less.
+// b2391 GWC bit 1 (caller read the flag): the 2,000-round equivalent of the rounds left, from the race horizon (cached per round).
+static float gwc_left_equiv()
+{
+	static int r = -1;
+	static float v = 0.0f;
+	if (r == now())
+		return v;
+	r = now();
+	const float left = static_cast<float>(GAME_END - now());
+	const int us = W.tributed_us, them = W.tributed_them; // shared inputs only (RC C1124 / C980): every self row reads the same clock
+	const float t = static_cast<float>(std::max(now(), static_cast<int>(GWC_TAB[2])));
+	float h = left;
+	for (const int k : { us, them })
+		if (k > 0)
+			h = std::min(h, static_cast<float>(std::max(0, rs::WIN_TRIBUTE - k)) * t / static_cast<float>(k));
+	const float n = static_cast<float>(now());
+	v = (n + h > 0.0f) ? static_cast<float>(GAME_END) * (1.0f - n / (n + h)) : left;
+	return v;
+}
