+// v8xx FCL bit 8 (RC X856 FCL8; caller reads the flag): on a FLEE turn, a threat within 8 of my target's anchor, or on my walk to it (within 8
+// of me and nearer the group on its field than I am), marks the target as threat_seen_one does (ban + drop), so the first CALM turn does not
+// walk the same route back. Capturing and a kept near-cleared target are left as threat_seen_one leaves them.
+__attribute__((noinline)) void fcl8_fc() { __asm__ volatile(""); }
+template <bool DOM>
+__attribute__((noinline)) void fcl8_note_t(const std::vector<vec2>& from)
+{
+	if (T.target < 0 || T.target >= M.ng || T.capturing || from.empty() || gmem_size(mem) != static_cast<std::size_t>(M.ng))
+		return;
+	const vec2 an = M.groups[static_cast<std::size_t>(T.target)].anchor;
+	const distance_field* gf = mv::group_field_ready(T.target);
+	const int me = gf ? static_cast<int>(dfget(*gf, W.me.pos)) : -1;
+	bool hit = false;
+	for (const vec2 t : from)
+		if (cheb(t, an) <= 8 || (gf && me >= 0 && me != static_cast<int>(UNREACH) && cheb(t, W.me.pos) <= 8 && static_cast<int>(dfget(*gf, t)) < me))
+		{
+			hit = true;
+			break;
+		}
+	if (!hit)
+		return;
+	fcl8_fc();
+	threat_seen_one<DOM>(static_cast<std::size_t>(T.target));
+}
+void fcl8_note(const std::vector<vec2>& from, bool dom)
+{
+	if (dom)
+		fcl8_note_t<true>(from);
+	else
+		fcl8_note_t<false>(from);
+}
 void threat_seen_dom(const std::vector<vec2>& foes)
 {
 	threat_seen_t<true>(foes);
 }
