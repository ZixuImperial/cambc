diff --git a/src/brain_turn.cc b/src/brain_turn.cc
--- a/src/brain_turn.cc
+++ b/src/brain_turn.cc
@@ -477,12 +477,14 @@ template <int DM> NOVA_INLINE bool flee_stage(const combat::Assessment& a)
 	std::vector<vec2> from = a.threats;
 	for (const auto& f : a.foes)
 		if (f.remembered)
 			from.push_back(f.pos);
 	if (!(a.nearest >= 7 && !a.in_reach)) // EHC bit 2 CRZ: a held-over FLEE does not block the herd target
 		threat_note<DM>(from);
+	if (FCL_ON(8) || (FCL_ON(16) && !(a.nearest >= 7 && !a.in_reach))) // v8xx FCL bit 8 (RC X856): a threat near the target's anchor or on my walk to it drops the target, as threat_seen does; bit 16: live FLEE turns only (C1130 adaptation)
+		econ::fcl8_note(from, (DM & 1) != 0);
 	if (combat::flee(a))
 		return end_task();
 	if (combat::flz_r == W.round && !combat::flz_z.empty() && !flz_guard)
 		flz_guard.emplace(combat::flz_z, true); // FLZ: the later stages walk outside flee's zones
 	return false;
 }
