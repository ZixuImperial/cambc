+// b2338 QBT (QBT_TAB[1] != 0 only): plain altars = not gated, none when the altars are ring-enclosed; counted once the gating is done
+// (RC C829: a.gated is set in step_distances, after M.ready(): count only when M.done() || M.distances_known(), else 0 uncached).
+static int qbt_plain_altars()
+{
+	static int v = -1;
+	if (v >= 0)
+		return v;
+	if (!(M.done() || M.distances_known()))
+		return 0;
+	int n = 0;
+	if (!M.ring)
+		for (const auto& a : M.altars)
+			n += a.gated ? 0 : 1;
+	v = n;
+	return v;
+}
+static bool qbt_quiet_floor()
+{
+	return team_quiet() && W.me.kit && !W.me.kit->gem_focus && (QBT_ON(1) || (QBT_ON(2) && qbt_plain_altars() >= 3));
+}
