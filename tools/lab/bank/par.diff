+// PAR: the visible foes near p (within 8) could one-shot me there: their one-turn hits at their distance to p, summed.
+bool par_oneshot(vec2 p)
+{
+	float s = 0;
+	for (const auto* lst : { &W.enemies, &W.enemies_far })
+		for (const auto& o : *lst)
+		{
+			const int d = cheb(o.pos, p);
+			if (d <= 8)
+				s += std::max(0.0f, nova::combat::burst::lethal_burst_hit(o, d, 0, nullptr));
+		}
+	return s >= nova::combat::eff_hp(W.me);
+}
+// PAR bit 4: our Prism carrier (a visible mate) stands within PAR_D of p.
