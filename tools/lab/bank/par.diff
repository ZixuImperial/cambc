+// v657 PAR bit 1 (called with the bit on, for my own row as the Prism carrier): a gem group a mate is capturing, within PAR_D of my
+// walk, that I reach before the payout with no one-shot threat near it, rated as a capture-only trip (its gems over my walk); -1
+// when it does not apply (the usual rating runs).
+float par_steal_rate(int gi, std::uint16_t trav, const Claims& cl, int* crew_out)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	if (g.gems == 0 || m.status != GS_CLEARED || trav == UNREACH || static_cast<int>(trav) > PAR_TAB[2])
+		return -1;
+	if (static_cast<int>(W.me.gems) >= prism::cap_of_prism() || claimants(gi, my_slot(), cl) == 0)
+		return -1;
+	cambc::detail::camp_group_capture_state cs{};
+	if (cambc::detail::sdk_camp_group_capture_state(g.handle, &cs) != 0 || cs.state == 2 || cs.state == 3)
+		return -1; // unread, contested or the enemy's
+	if (cs.state == 1 && static_cast<int>(trav) > cs.timer + 1)
+		return -1; // it pays out before I arrive
+	if (par_oneshot(g.anchor))
+		return -1;
+	par_fc_steal();
+	if (crew_out)
+		*crew_out = 1;
+	return static_cast<float>(g.gems) / std::max(1.0f, static_cast<float>(trav));
+}
