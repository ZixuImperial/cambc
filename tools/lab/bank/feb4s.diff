+// b2435 FEB4 (fresh eyes 2 item 4): the price of the entry shop() buys first. shop() moves an unowned Tribute entry to the front
+// (Prism, WBT bag), moves unowned passives ahead of the first unstarted Greed (passive_first) and skips CI2 shop_hold entries; the
+// rank (emblem_rank) and greed_gate only reorder or split unstarted entries, which all price 150, so they are left out.
+static int feb4_cost(const FxmItems& counts)
+{
+	std::vector<cambc::item_type> b = build;
+	if (W.me.kit && prism_layer::shop_wbt() && static_cast<int>(W.me.gems) >= WBT_BAG)
+		for (std::size_t i = 0; i < b.size(); ++i)
+		{
+			const auto si = static_cast<std::uint32_t>(b[i]);
+			if (si / 6 != 7)
+				continue;
+			if (static_cast<int>(counts[cambc::item_type(si + 1)]) >= 1 || i == 0)
+				break;
+			std::rotate(b.begin(), b.begin() + static_cast<std::ptrdiff_t>(i), b.begin() + static_cast<std::ptrdiff_t>(i) + 1);
+			break;
+		}
+	{
+		constexpr std::uint32_t F_POWER = 1, F_BRUISER = 6, F_GREED = 12;
+		auto passive = [](std::uint32_t fam) { return fam < 14u && fam != F_POWER && fam != F_BRUISER && fam != F_GREED; };
+		auto fam_owned = [&](std::uint32_t fam)
+		{
+			for (std::uint32_t st = 0; st < 3u; ++st)
+				if (counts[cambc::item_type(fam * 6u + st * 2u + 1u)] > 0)
+					return true;
+			return false;
+		};
+		const int n = static_cast<int>(b.size());
+		for (int i = 0; i < n; ++i)
+		{
+			const std::uint32_t si = static_cast<std::uint32_t>(b[static_cast<std::size_t>(i)]);
+			if (si / 6u != F_GREED || counts[cambc::item_type(si)] > 0 || counts[cambc::item_type(si + 1u)] > 0)
+				continue;
+			int at = i;
+			for (int j = i + 1; j < n; ++j)
+			{
+				const cambc::item_type t = b[static_cast<std::size_t>(j)];
+				const std::uint32_t fam = static_cast<std::uint32_t>(t) / 6u;
+				if (!passive(fam) || fam_owned(fam))
+					continue;
+				b.erase(b.begin() + j);
+				b.insert(b.begin() + at, t);
+				++at;
+			}
+			break;
+		}
+	}
+	std::array<int, 96> need;
+	vzero(need);
+	for (const auto& sh : b)
+	{
+		const auto si = static_cast<std::size_t>(static_cast<std::uint32_t>(sh));
+		++need[si];
+		if (static_cast<int>(counts[cambc::item_type(static_cast<std::uint32_t>(si + 1))]) >= need[si])
+			continue;
+		const int have = static_cast<int>(counts[sh]);
+		if (CI2_FARM() && nova::ci2::shop_hold(si, have))
+			continue;
+		if (static_cast<int>(si) / 6 == 12)
+			return 150;
+		return 30 * std::max(1, 5 - have);
+	}
+	return 1 << 24;
