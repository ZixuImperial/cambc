+// v8xx OSV (econ_flags.h; callers read the flag): the enemy champions visible now (one raw list read), their tiles and next-turn reach.
+struct OsvFoes
+{
+	int n = 0;
+	std::array<vec2, 8> p{};
+	std::array<int, 8> r{};
+};
+static __attribute__((noinline)) void osv_read(OsvFoes& F)
+{
+	for (const auto& c : cambc::vision::champions(cambc::team::enemy))
+	{
+		if (F.n >= 8)
+			break;
+		Body e; // its next-turn reach (combat::foe_next_turn_reach, RC C1000): kit and range from the raw read, cooldowns unknown = ready
+		e.type = c.champion_name();
+		const int ti = static_cast<int>(e.type);
+		e.kit = ti >= 0 && ti < 13 ? kit_of_ptr[ti] : nullptr;
+		e.pos = c.position();
+		e.range = std::max(1, static_cast<int>(c.attack_range()));
+		F.p[static_cast<std::size_t>(F.n)] = e.pos;
+		F.r[static_cast<std::size_t>(F.n)] = combat::foe_next_turn_reach(e, false);
+		++F.n;
+	}
+}
+// OSV class key (draft-time geometry, tools/lab/mapclass.d/spawngap.py): the Chebyshev gap between our spawn rect and theirs is <= OSV_R
+// (0 = touching). Static, computed once; off-class the flag reads nothing.
+static bool osv_class()
+{
+	static int c = -1;
+	if (c >= 0)
+		return c != 0;
+	int ax0 = BIG, ay0 = BIG, ax1 = -BIG, ay1 = -BIG, bx0 = BIG, by0 = BIG, bx1 = -BIG, by1 = -BIG;
+	bbforeach(M.my_spawn, [&](vec2 p) { ax0 = std::min(ax0, p.x); ay0 = std::min(ay0, p.y); ax1 = std::max(ax1, p.x); ay1 = std::max(ay1, p.y); });
+	bbforeach(M.enemy_spawn, [&](vec2 p) { bx0 = std::min(bx0, p.x); by0 = std::min(by0, p.y); bx1 = std::max(bx1, p.x); by1 = std::max(by1, p.y); });
+	if (ax1 < ax0 || bx1 < bx0)
+		return false; // spawns not known yet: not cached, asked again
+	const int gx = std::max(0, std::max(bx0 - ax1, ax0 - bx1) - 1), gy = std::max(0, std::max(by0 - ay1, ay0 - by1) - 1);
+	c = std::max(gx, gy) <= OSV_TAB[2] ? 1 : 0;
+	return c != 0;
+}
+// OSV bit 1: n is closer than me to a visible foe that would be within OSV_R of n.
+static bool osv_veto(const OsvFoes& F, const vec2 me, const vec2 n)
+{
+	for (int i = 0; i < F.n; ++i)
+	{
+		const vec2 f = F.p[static_cast<std::size_t>(i)];
+		if (cheb(n, f) < cheb(me, f) && cheb(n, f) <= OSV_TAB[2])
+			return true;
+	}
+	return false;
+}
+// OSV bit 2: tile t's distance to the foes' nearest legal standing tile one step on (their tile, or a free neighbour off our spawn).
+static int osv_tdist(const OsvFoes& F, const vec2 t)
+{
+	int best = BIG;
+	for (int i = 0; i < F.n; ++i)
+	{
+		const vec2 f = F.p[static_cast<std::size_t>(i)];
+		best = std::min(best, cheb(t, f));
+		for (const vec2 d : DIRS)
+		{
+			const vec2 q = f + d;
+			if (inb(q) && !bbget(M.block, q) && !bbget(M.my_spawn, q))
+				best = std::min(best, cheb(t, q));
+		}
+	}
+	return best;
+}
+// OSV bits 2 / 4: is the AWAY step due (I am on my spawn and a foe is within OSV_R, or bit 4: the other Cassi / Issac body is inside a foe's reach)?
+static bool osv_away_due(const OsvFoes& F, const vec2 me)
+{
+	if (F.n <= 0 || !bbget(M.my_spawn, me))
+		return false;
+	for (int i = 0; i < F.n; ++i)
+		if (cheb(me, F.p[static_cast<std::size_t>(i)]) <= OSV_TAB[2])
+			return true;
+	if (!OSV_ON(4))
+		return false;
+	using CT = cambc::champion_type;
+	const CT t = cambc::self().champion_name();
+	if (t != CT::cassi && t != CT::issac)
+		return false;
+	const CT other = t == CT::cassi ? CT::issac : CT::cassi;
+	for (const auto& a : cambc::vision::champions(cambc::team::ally))
+	{
+		if (a.champion_name() != other)
+			continue;
+		const vec2 q = a.position();
+		for (int i = 0; i < F.n; ++i)
+			if (cheb(q, F.p[static_cast<std::size_t>(i)]) <= F.r[static_cast<std::size_t>(i)])
+				return true;
+	}
+	return false;
+}
+// OSV bit 2: the adjacent free own-spawn tile with the largest osv_tdist (ties: the lower goal value val(n)), if larger than mine; {-1,-1} if none.
+template <class Val>
+static vec2 osv_away_tile(const OsvFoes& F, const vec2 me, const bitboard& units, const Val& val)
+{
+	vec2 best{ -1, -1 };
+	int bd = osv_tdist(F, me), bv = BIG;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!inb(n) || !bbget(M.my_spawn, n) || bbget(M.block, n) || bbget(units, n))
+			continue;
+		const int td = osv_tdist(F, n), v = val(n);
+		if (td > bd || (td == bd && best.x >= 0 && v < bv))
+		{
+			bd = td;
+			bv = v;
+			best = n;
+		}
+	}
+	return best;
+}
