+// v7xx RTF (b1851): the walk from my last spawn tile on group gi's own field (the field d is read on), when longer than hw.
+__attribute__((noinline)) int rtf_home_walk(int gi, int hw)
+{
+	if (rtf_sp.x < 0)
+		return hw;
+	const int w = mv::group_walk_at(gi, rtf_sp);
+	return (w >= 0 && w != mv::FP_NOWALK && w != UNREACH && w > hw) ? w : hw;
