@@ -288,6 +288,18 @@ inline constexpr int RGS_TAB[2] = { 0x52475331, RGS_BITS }; // slot 0 magic keep
 // 8192 VFD Vendetta's follow-kill dash after a walk.
 // 16384 PGW the Prism guard's stalled step_to gives way to her group's walk field, or to the later team stages.
 #define CB3_BITS 32255
 // v638 CB3: Bundle 3, 14 combat bug fixes
 #define CB3_LOCKTT 500
 inline constexpr int CB3_TAB[3] = { 0x43423331, CB3_BITS, CB3_LOCKTT }; // slot 0 magic keeps it out of .bss
+
+// FLK (b1759, Combat spec_flk_1109.md, Planner-approved): one-way FLEE -> FIGHT overturn from a 3-round rollout (port of fsp_job_c,
+// a C&I pair dies together and counts once, GR:381/442). 0 = v645 nova_base_v645. Bit 1: before contact (FLEE, not in reach, nearest
+// > 1), not channelling, bag < FLK_BAG, HP >= FLK_HP_X100 %, fuel >= FLK_MIN_FUEL: fight when the rollout says I survive, foe deaths
