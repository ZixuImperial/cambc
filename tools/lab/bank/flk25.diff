+#define FLK_HP_X100 40
+#define FLK_BAG 100
+#define FLK_MIN_FUEL 20000
+inline const volatile int FLK_TAB[6] = { 0x464C4B31, FLK_BITS, FLK_M_X100, FLK_HP_X100, FLK_BAG, FLK_MIN_FUEL }; // slot 0 magic keeps it out of .bss
+#define FLK_ON(b) ((FLK_TAB[1] & (b)) != 0)
