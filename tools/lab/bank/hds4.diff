 // danger_shared(p, radius, max_age) >= 1 (any kept report has n >= 1): stops at the first match.
+int shared_reports_near(vec2 c, int r, int max_age, int min_n, vec2* pos, int* age, int cap)
+{
+	const int t = now();
+	int k = 0;
+	for (const auto& rp : shared_rep)
+	{
+		if (k >= cap)
+			break;
+		const int a = t - rp.round;
+		if (rp.n < min_n || rp.n == 0 || a < 0 || a > max_age || cheb(rp.pos, c) > r)
+			continue;
+		pos[k] = rp.pos;
+		age[k] = a;
+		++k;
+	}
+	return k;
+}
