diff --git a/src/move_flags.h b/src/move_flags.h
--- a/src/move_flags.h
+++ b/src/move_flags.h
@@ -114,6 +114,15 @@ inline constexpr int NB3_TAB[2] = { 0x4E423331, NB3_BITS }; // slot 0 magic keep
 // reach into one (the caller takes another tile or stays put); reach = range + 1. Bit 2 (with 1): a foe whose dash is ready reaches
 // range + dash_range + 1 (GR:161). [2] LHST_HP 25.
 #define LHST_BITS 3
 // v877 LHST: LHST3 low-HP step refusal with dash reach
 #define LHST_HP 25
 inline constexpr int LHST_TAB[3] = { 0x4C485354, LHST_BITS, LHST_HP }; // slot 0 magic keeps it out of .bss
+
+// HDS (b2376, Combat spec_hds_1113 revised: bit 4 first, a 0-bit reader). Runtime data flag HDS_TAB[1], read first; 0 = v881. Bit 4
+// READER: in eqr_note, received enemy reports (intel's shared reports: mates' events and my own posts) at most 2 rounds old, within 8
+// of me, with at least HDS_N enemies (2 = EV_ENEMIES only), and no visible foe within 3 of the report point, enter EQR's foe list as
+// points with reach 4 + their age. Slot [2] HDS_N (2; the second arm is 1).
+#define HDS_BITS 0
+#define HDS_N 2
+inline const volatile int HDS_TAB[3] = { 0x48445331, HDS_BITS, HDS_N }; // slot 0 magic keeps it out of .bss
+#define HDS_ON(b) ((HDS_TAB[1] & (b)) != 0)
