 // HCAP (b2354, RC X757 HCAP1): hold_near_willow's cap return (brain_low_hp.cc) left wr_hold_r unstamped, so the next turn read a new
 // hold (wr_hold_n = 0) and held again: hold / walk home alternated. Bit 1 stamps wr_hold_r at the cap so the walk home goes on. 0 = v841.
 // v848 HCAP: 3 fixes alc32,ktw15,wbh1s
 #define HCAP_BITS 1
 inline constexpr int HCAP_TAB[2] = { 0x48434150, HCAP_BITS };
+// CLM (b2439, Planner fresh-eyes 3 #4): a body home for a heal or shop trip still posted its old group claim from the spawn and on the
+// walk back (live drops it only on the recall start and channel turns), so mates skipped the group or waited for it as crew
+// (crew_here claim_away). Runtime data flag CLM_TAB[1], read first; 0 = v909. Bit 1: on the spawn after a heal/shop trip home
+// (recall or walk), post no group. Bit 2: on the walk back, post no group until within CLM_NEAR of it (crew_here's 7), engaged,
+// or a new target. Travel recalls keep the claim.
+#define CLM_BITS 0
+inline const volatile int CLM_TAB[2] = { 0x434C4D31, CLM_BITS }; // slot 0 magic keeps it out of .bss
+#define CLM_ON(b) ((CLM_TAB[1] & (b)) != 0)
+#define CLM_NEAR 7
