+// b2439 CLM (caller read the flag): the trip-home phase. clm_hs_r: the round handle_low_hp, shop_recall or the heal go-home acted
+// (a walk home or a recall start). clm_ph: 1 that trip's recall channel, 2 on the spawn after it, 3 walking back to clm_g.
+int clm_hs_r = -100, clm_ph = 0, clm_g = -1, clm_last = -100;
+__attribute__((noinline)) bool clm_drop(int group)
+{
+	if (clm_last != W.round)
+	{
+		clm_last = W.round;
+		if (!W.alive)
+			clm_ph = 0;
+		else if (W.me.state & ST_RECALL)
+			clm_ph = (clm_hs_r == W.round - 1 || clm_ph == 1) ? 1 : 0;
+		else if (W.on_spawn)
+			clm_ph = (clm_ph == 1 || clm_ph == 2 || clm_hs_r == W.round - 1) ? 2 : 0;
+		else if (clm_ph == 2)
+		{
+			clm_ph = 3;
+			clm_g = -1;
+		}
+		else if (clm_ph == 1)
+			clm_ph = 0; // the recall was cancelled off the spawn
+	}
+	if (clm_ph == 3 && group >= 0)
+	{
+		if (clm_g < 0)
+			clm_g = group;
+		if (group != clm_g || group >= M.ng || econ::claim_engaged() ||
+			cheb(W.me.pos, M.groups[static_cast<std::size_t>(group)].anchor) <= CLM_NEAR)
+			clm_ph = 0; // a new target, or there: the claim stands
+	}
+	return group >= 0 && ((clm_ph == 2 && CLM_ON(1)) || (clm_ph == 3 && CLM_ON(2)));
+}
