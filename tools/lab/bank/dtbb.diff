diff --git b/src/feat_dtb.cpp b/src/feat_dtb.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_dtb.cpp
@@ -0,0 +1,29 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_dtb.cpp (DTB, b1615): a loaded bank walker skips DEFEND_TOGETHER's walks (feat_dtb.h). Unity build: after econ.cpp.
+#include "feat_dtb.h"
+#include "econ.h"
+namespace nova::feat::dtb
+{
+namespace
+{
+// Firing counters (firecount puts one at each function entry): defend_mate's walk skipped; the converge step skipped.
+void dm_fire()
+{
+}
+void cv_fire()
+{
+}
+} // namespace
+bool loaded_bank_walk(int bit)
+{
+	if (static_cast<int>(W.me.gems) < DTB_BAG || econ::pcf_calm < W.round - 1)
+		return false;
+	if (bit == DTB_BIT_DM)
+		dm_fire();
+	else
+		cv_fire();
+	return true;
+}
+} // namespace nova::feat::dtb
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_dtb.h b/src/feat_dtb.h
new file mode 100644
--- /dev/null
+++ b/src/feat_dtb.h
@@ -0,0 +1,18 @@
+#pragma once
+// feat_dtb (DTB, b1615; Deep spec via Builder, 00crater 01a1b990 r531-540: a 32-gem Varg on its bank walk joined a lost 4v4 and
+// died): DEFEND_TOGETHER (brain.cpp team_stage) runs before farm_stage's bank walk with no bag test, so a carrier walking to bank
+// diverts into a mate's fight. Bit 1 DM: a body with a bag >= DTB_BAG whose last turn took the calm bank walk (econ::pcf_calm,
+// set by farm_stage's want_bank branch) skips defend_mate's walk. Bit 2 CV: the same body skips the DT2 converge step.
+// Flag DTB_BITS, 0 = nova_b2681_vsr4i. Hook: brain.cpp team_stage; flag first.
+#include "common.h"
+#define DTB_BITS 0
+#define DTB_BAG 25
+inline const volatile int DTB_TAB[2] = { 0x44544231, DTB_BITS }; // slot 0 magic keeps it out of .bss
+#define DTB_ON(b) ((DTB_TAB[1] & (b)) != 0)
+constexpr int DTB_BIT_DM = 1;
+constexpr int DTB_BIT_CV = 2;
+namespace nova::feat::dtb
+{
+// True: I carry a bag >= DTB_BAG and my last turn was the calm bank walk. Caller read the flag and has a walk to skip.
+bool loaded_bank_walk(int bit);
+} // namespace nova::feat::dtb
