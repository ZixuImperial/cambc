+// FFL bit 16 RHN1 (RC X351): rally_home_narrow_near + `goals &= near` in one pass over the goal bits. With 0 < dm < UNREACH my tile's BFS predecessor
+// (f_home is a plain BFS from my spawn) is a window tile with d < dm, so the scan's `anyw` holds and near = {window tiles, d < dm};
+// goals lie inside the ESC_WIN window (escape_goal_tiles), so goals & near = the goal tiles with d < dm. Same bit index in a board
+// word and a field chunk. False (nothing done): dm 0 or UNREACH, where near stays the rally disk.
+NOVA_INLINE bool rhn_filter_goals(vec2 me, bitboard& goals)
+{
+	const std::uint16_t dm = dfget(M.f_home, me);
+	if (dm == UNREACH || dm == 0)
+		return false;
+	std::uint64_t* const w = goals.ptr();
+	const std::uint16_t* const fp = fview(M.f_home).p;
+	const int cx0 = std::max(0, me.x - tune::ESC_WIN) >> 3, cx1 = std::min(G.w - 1, me.x + tune::ESC_WIN) >> 3;
+	const int cy0 = std::max(0, me.y - tune::ESC_WIN) >> 3, cy1 = std::min(G.h - 1, me.y + tune::ESC_WIN) >> 3;
+	for (int cy = cy0; cy <= cy1; ++cy)
+		for (int cx = cx0; cx <= cx1; ++cx)
+		{
+			std::uint64_t& word = w[cy * G.stride + cx];
+			std::uint64_t m = word;
+			if (!m)
+				continue;
+			const std::uint16_t* const base = fp + (cy * G.cw + cx) * 64;
+			std::uint64_t keep = m;
+			while (m)
+			{
+				const int b = __builtin_ctzll(m);
+				m &= m - 1;
+				if (base[b] >= dm)
+					keep &= ~(std::uint64_t{ 1 } << b);
+			}
+			word = keep;
+		}
+	return true;
+}
