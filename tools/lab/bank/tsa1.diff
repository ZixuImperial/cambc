 // v682 CIS: 7 fixes fb10c,cpt29c,cpt29c,grd3c,cib47,cpw1,cis7
 #define CIS_BITS 7
 inline constexpr int CIS_TAB[2] = { 0x43495331, CIS_BITS };
+// TSA (b1809, bot_errors row 606). Runtime data flag, read first; 0 = v684. Bit 1: below TANK_SHIELD_BELOW_FRAC an engaged tank casts its
+// camp shield only with an awake attacker in reach (camp_abilities_attacked) or its focus within my attack range (my hit wakes it); the
+// shield lasts five turns (GR:794/:820), so one cast walking in to a sleeping camp expires before the first camp hit.
+#define TSA_BITS 0
+inline const volatile int TSA_TAB[2] = { 0x54534131, TSA_BITS }; // slot 0 magic keeps it out of .bss
+#define TSA_ON(b) ((TSA_TAB[1] & (b)) != 0)
