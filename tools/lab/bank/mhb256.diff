 // econ_shop.cc: Buying at the shop.
 #include "econ_internal.h"
 namespace nova::econ {
+// v8xx MHB bit 256 (caller reads MHB_ON(256)): NEED = the largest HP + shield lost over any 3 consecutive turns of mine (a > 2-round gap,
+// as across a respawn, restarts the window); 0 until hit.
+static float mhb_need = 0.0f, mhb_e = 0.0f, mhb_l[3] = { 0.0f, 0.0f, 0.0f };
+static int mhb_r = -1000, mhb_i = 0;
+void mhb_turn_start()
+{
+	if (!W.alive || W.round == mhb_r)
+		return;
+	const float e = W.me.hp + W.me.shield;
+	mhb_l[mhb_i] = (W.round - mhb_r <= 2) ? std::max(0.0f, mhb_e - e) : 0.0f;
+	mhb_i = (mhb_i + 1) % 3;
+	mhb_need = std::max(mhb_need, mhb_l[0] + mhb_l[1] + mhb_l[2]);
+	mhb_e = e;
+	mhb_r = W.round;
+}
+// v8xx MHB bit 256 2c COMPARATIVE (spec_mhb_1112; caller reads MHB_ON(256)): a Marcella with no Vesper / Prism of ours sets the next
+// unstarted emblem's stat: max HP after a Health emblem < MHB_LO% of NEED -> Health; max HP >= MHB_HI% of NEED (or NEED 0) -> live's entry; between ->
+// Bruiser (main stat) with 150 gold in hand, else the other stat than her last. Never touches a started entry, Greed or a Bruiser's family.
+static __attribute__((noinline)) void mhb_comparative(const decltype(cambc::self().item_count())& counts)
+{
+	using CT = cambc::champion_type;
+	if (W.me.type != CT::marcella || !W.me.kit)
+		return;
+	for (int s = 0; s < P.n && s < 8; ++s)
+		if (P.type[static_cast<std::size_t>(s)] == CT::vesper_vale || P.type[static_cast<std::size_t>(s)] == CT::prism)
+			return;
+	static int mhb_last = 1; // the stat of the last entry this rule set (1 Focus, 2 Health)
+	std::array<int, 96> need;
+	need.fill(0);
+	for (auto& sh : build)
+	{
+		const auto si = static_cast<std::size_t>(static_cast<std::uint32_t>(sh));
+		++need[si];
+		if (static_cast<int>(counts[cambc::item_type(static_cast<std::uint32_t>(si + 1))]) >= need[si])
+			continue; // owned emblem
+		constexpr int BRUISER = 6, GREED = 12;
+		const int fam = static_cast<int>(si) / 6;
+		if (static_cast<int>(counts[sh]) > 0 || fam == GREED)
+			return; // a started entry (or Greed) keeps its form
+		int st = 1, nf = fam;
+		if (mhb_need <= 0.0f || 100.0f * W.me.maxhp >= static_cast<float>(MHB_TAB[3]) * mhb_need)
+			return; // the Focus branch: live's entry stands (RC C954b)
+		if (100.0f * (W.me.maxhp + 5.0f * W.me.kit->hp_g) < static_cast<float>(MHB_TAB[2]) * mhb_need)
+			st = 2; // Health
+		else if (W.gold >= 150)
+			nf = BRUISER, st = 1; // the middle ground: Bruiser carries all three stats
+		else
+			st = mhb_last == 2 ? 1 : 2;
+		if (fam == BRUISER)
+			nf = BRUISER; // an owned-family Bruiser entry is never displaced
+		sh = cambc::item_type(static_cast<std::uint32_t>(nf * 6 + st * 2));
+		mhb_last = st;
+		return;
+	}
+}
