+// SSP (b1829, the caller read the flag): the least summed damage of a walk from our spawn (spawn tiles cost 0: the heal) through group
+// gi's reach (each tile costs the Strength of the attacking members whose reach covers it; walls, holes, altars and camps block) to a
+// tile out of every member's reach. 1e9 when no such tile is reachable.
+static float ssp_walk_out(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const int W0 = M.w, H0 = M.h;
+	auto cost = [&](vec2 q) {
+		float c = 0.0f;
+		for (int ci : g.members)
+		{
+			const auto& cm = M.camps[static_cast<std::size_t>(ci)];
+			if (cm.attacks() && cheb(cm.pos, q) <= cm.reach)
+				c += cm.str;
+		}
+		return c;
+	};
+	std::vector<float> dist(static_cast<std::size_t>(W0 * H0), 1e9f);
+	using QE = std::pair<float, int>;
+	std::priority_queue<QE, std::vector<QE>, std::greater<QE>> pq;
+	bbforeach(M.my_spawn, [&](vec2 p) { dist[static_cast<std::size_t>(p.y * W0 + p.x)] = 0.0f; pq.push({ 0.0f, p.y * W0 + p.x }); });
+	while (!pq.empty())
+	{
+		const auto [dd, id] = pq.top();
+		pq.pop();
+		if (dd > dist[static_cast<std::size_t>(id)])
+			continue;
+		const vec2 p{ id % W0, id / W0 };
+		if (!bbget(M.my_spawn, p) && cost(p) <= 0.0f)
+			return dd; // out of every member's reach
+		for (const vec2 dv : DIRS)
+		{
+			const vec2 q = p + dv;
+			if (!inb(q) || bbget(M.block_camps, q))
+				continue;
+			const float nd = dd + (bbget(M.my_spawn, q) ? 0.0f : cost(q));
+			const int qi = q.y * W0 + q.x;
+			if (nd < dist[static_cast<std::size_t>(qi)])
+			{
+				dist[static_cast<std::size_t>(qi)] = nd;
+				pq.push({ nd, qi });
+			}
+		}
+	}
+	return 1e9f;
+}
