+// false: no credit (the caller keeps c).
+__attribute__((noinline)) bool wwh_credit(const Crew& c, std::uint16_t trav, Crew& out)
+{
+	const std::uint32_t mask = wwh_mask;
+	if (TM.base || trav == 0 || trav == UNREACH || c.n < 2 || __builtin_popcount(mask) != c.n)
+		return false;
+	int tank = -1;
+	for (int i = 0; i < TM.n && tank < 0; ++i)
+	{
+		const int s = TM.by_tank[static_cast<std::size_t>(i)];
+		if ((mask >> s) & 1u)
+			tank = s;
+	}
+	if (tank < 0 || (tank == my_slot() && !W.alive))
+		return false;
+	const Body* tb = tank == my_slot() ? &W.me : W.ally_by_slot(tank);
+	if (!tb || tb->hp >= tb->maxhp)
+		return false;
+	bool near = false;
+	for (int s = 0; s < TM.n && !near; ++s)
+	{
+		if (s == tank || !((mask >> s) & 1u) || ECX_TM(static_cast<std::size_t>(s)).heal <= 0.0f)
+			continue;
+		const Body* hb = s == my_slot() ? (W.alive ? &W.me : nullptr) : W.ally_by_slot(s);
+		near = hb && cheb(hb->pos, tb->pos) <= 4;
+	}
+	if (!near)
+		return false;
+	const float hp_w = std::min(tb->maxhp - tb->hp, c.heal8 / static_cast<float>(rs::slot_cooldown()) * static_cast<float>(trav));
+	if (hp_w <= 0.0f)
+		return false;
+	const float add = hp_w / std::max(0.3f, tml_arg[static_cast<std::size_t>(tank)].cm);
+	const float b0 = ECX_TM(static_cast<std::size_t>(tank)).budget;
+	int i = -1;
+	for (int k = 0; k < c.n_melee && i < 0; ++k)
+		if (c.budget[static_cast<std::size_t>(k)] == b0)
+			i = k;
+	if (i < 0)
+		return false;
+	out = c;
+	out.budget[static_cast<std::size_t>(i)] += add;
+	out.budget_he[static_cast<std::size_t>(i)] += add;
+	for (; i > 0 && out.budget[static_cast<std::size_t>(i - 1)] < out.budget[static_cast<std::size_t>(i)]; --i) // best first again
+	{
+		std::swap(out.budget[static_cast<std::size_t>(i - 1)], out.budget[static_cast<std::size_t>(i)]);
+		std::swap(out.budget_he[static_cast<std::size_t>(i - 1)], out.budget_he[static_cast<std::size_t>(i)]);
+	}
+	return true;
