+// PHT bit 2: a mate that escorts a channel: >= 50% HP, not channelling, not stunned.
+bool pht_escort_ok(const Body& al)
+{
+	return al.hp * 2.0f >= al.maxhp && !al.channeling() && !al.stunned;
+}
+static const Body* pht_escort_mate(vec2 me)
+{
+	const Body* best = nullptr;
