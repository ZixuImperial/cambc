+// PHT bit 1: the escort hold (bank_channel_unsafe's pcf hold) times out after PHT_T rounds; she then walks to the plan's safe altar,
+// or home when she already stands at it or it has no field. The trip is latched until she arrives (or 60 rounds).
+static int pht_r0 = -1000, pht_last = -1000, pht_go = -1000;
+static bool pht_home = false;
+static bool pht_latched(vec2 me)
+{
+	if (now() - pht_go > 60)
+		return false;
+	if (pht_home)
+	{
+		if (W.on_spawn)
+			pht_go = -1000;
+		return !W.on_spawn;
+	}
+	const distance_field* f = prism::safe_altar_field();
+	const std::uint16_t ds = f ? dfget(*f, me) : static_cast<std::uint16_t>(UNREACH);
+	if (ds == UNREACH || ds == 0)
+	{
+		pht_go = -1000;
+		return false;
+	}
+	return true;
+}
+// Firing counters (firecount puts one at each function entry): the timeout sends her to the safe altar / home.
+static void pht_fire_safe()
+{
+}
+static void pht_fire_home()
+{
+}
+static bool pht_hold_timed_out(vec2 me)
+{
+	if (now() - pht_last > 3)
+		pht_r0 = now();
+	pht_last = now();
+	if (now() - pht_r0 < PHT_TAB[2])
+		return false;
+	const distance_field* f = prism::safe_altar_field();
+	const std::uint16_t ds = f ? dfget(*f, me) : static_cast<std::uint16_t>(UNREACH);
+	pht_home = ds == UNREACH || ds == 0;
+	pht_go = now();
+	pht_last = -1000;
+	if (pht_home)
+		pht_fire_home();
+	else
+		pht_fire_safe();
+	return true;
+}
+static bool pht_walk(vec2 me)
+{
+	if (pht_home)
+		return go_home();
+	const distance_field* f = prism::safe_altar_field();
+	if (f && dfget(*f, me) != UNREACH && W.can_move() && mv::step_field(*f))
+	{
+		mv::collect_dash(0);
+		return true;
+	}
+	return false;
+}
