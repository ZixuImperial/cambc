+// OAT (the caller read the flag): what score() subtracts from rf_time: the altar term (live), 0 (kept), or minus it (counted twice); a known
+// enemy lock on the one altar adds its hits_remaining rounds (5 hits clear it, one a turn: GR:238-240; RC OAT pre-build Q2). The class is
+// one walk-reachable ungated altar from our spawn (home_altar_dist's filter; RC Q1), static map data.
+static __attribute__((noinline)) float oat_alt_off(float alt)
+{
+	static int oat_one = -1, oat_ai = -1, oat_r = -1000;
+	static float oat_lock = 0.0f;
+	if (oat_one < 0)
+	{
+		int n = 0;
+		for (int k = 0; k < static_cast<int>(M.altars.size()); ++k)
+		{
+			const auto& a = M.altars[static_cast<std::size_t>(k)];
+			if (a.d_home != UNREACH && !a.gated && a.access == ACC_WALK)
+			{
+				++n;
+				oat_ai = k;
+			}
+		}
+		oat_one = n == 1 ? 1 : 0;
+	}
+	const bool one = oat_one == 1;
+	if (!(OAT_ON(4) || ((OAT_ON(1) || OAT_ON(2)) && one)))
+		return alt;
+	if (one && oat_r != E::now())
+	{
+		oat_r = E::now();
+		cambc::detail::altar_lock_info li{};
+		oat_lock = E::enemy_altar_lock_direct(M.altars[static_cast<std::size_t>(oat_ai)].pos, li) ? static_cast<float>(li.hits_remaining) : 0.0f;
+	}
+	const float lk = one ? oat_lock : 0.0f;
+	return (OAT_ON(2) && one ? -alt : 0.0f) - lk;
+}
 // S for the candidate whose parts rate_for just published: S(m) = A0 - m x B. Stage B: every term on top of rf_pen x rf_value.
 float sB = 0;
 float score(int gi)
 {
 	const float v = linear_group_value(gi, E::my_slot());
 	const float pen = E::rf_pen;
-	float t = E::rf_time - (cur.alt); // No altar term in the time (LNR_NOALT).
+	float t = E::rf_time - (OAT_ON(7) ? oat_alt_off(cur.alt) : (cur.alt)); // No altar term in the time (LNR_NOALT); OAT: kept on one-altar maps
 	t = std::max(1.0f, t);
 	sB = t;
 	return pen * v;
 }
