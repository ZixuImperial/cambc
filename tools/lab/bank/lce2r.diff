+// ---- b2313 LCE (move_flags.h LCE_TAB): layer-free corner entry to dash-only islands. Callers read LCE_ON first.
+namespace
+{
+struct LceEntry
+{
+	int gi = -1;
+	vec2 L{ -1, -1 }, P{ -1, -1 };
+	int g = -1, gl = UNREACH; // O1: the walk group whose kept field leads to L, and its value at L
+};
+std::vector<LceEntry> lce_e;
+std::vector<int> lce_of; // group -> index in lce_e, -1 none
+bool lce_found = false;
+[[gnu::noinline]] void lce_fire_find()
+{
+	asm volatile("");
+}
+[[gnu::noinline]] void lce_fire_price()
+{
+	asm volatile("");
+}
+[[gnu::noinline]] void lce_fire_go()
+{
+	asm volatile("");
+}
+[[gnu::noinline]] void lce_fire_dash()
+{
+	asm volatile("");
+}
+inline bool lce_stand(vec2 p) { return inb(p) && !bbget(M.block_camps, p); }
+inline bool lce_mid(vec2 m) { return inb(m) && !bbget(M.walls, m) && !bbget(M.camp_tiles, m) && !bbget(M.enemy_spawn, m); }
+// the scan, resumable one member at a time (RC C902 F1b, measured 28.6k median / 49k max in one call on class maps): cursor = group, member
+int lce_gc = 0, lce_mc = 0, lce_bd = UNREACH, lce_lb = 0;
+LceEntry lce_best;
+int lce_sx0 = 0, lce_sy0 = 0, lce_sx1 = -1, lce_sy1 = -1; // our spawn's bounding box (f_home's roots)
+// b2373 (PF ask c): d_home(L) >= the Chebyshev gap from L to the spawn box (f_home is a unit 8-way walk from the spawn tiles)
+inline int lce_box_gap(vec2 p) { return std::max(std::max(lce_sx0 - p.x, p.x - lce_sx1), std::max(std::max(lce_sy0 - p.y, p.y - lce_sy1), 0)); }
+void lce_member(int gi, int ci)
+{
+	// RC/PF (2): raw board and field views (a host read per tile cost ~200 fuel: 7.4k a member step)
+	const FView vh = fview(M.f_home);
+	const BView vbc = bview(M.block_camps), vw = bview(M.walls), ve = bview(M.enemy_spawn), vho = bview(M.holes), va = bview(M.altars_bb);
+	const vec2 c = M.camps[static_cast<std::size_t>(ci)].pos;
+	for (int px = -1; px <= 1; ++px)
+		for (int py = -1; py <= 1; ++py)
+		{
+			const vec2 P{ c.x + px, c.y + py };
+			if ((px == 0 && py == 0) || !inb(P) || vbc(P) || vh(P) != UNREACH)
+				continue;
+			// b2373 (PF ask c): a rim P only. The middle is next to a walk-reachable L and to the unreachable P, so it is not walkable for
+			// f_home and not a wall, camp or enemy spawn: a hole or an altar (interactions.md:143: both pass). A P with neither next to it has no entry.
+			bool rim = false;
+			for (int mx = -1; mx <= 1 && !rim; ++mx)
+				for (int my = -1; my <= 1 && !rim; ++my)
+				{
+					const vec2 m{ P.x + mx, P.y + my };
+					rim = (mx != 0 || my != 0) && inb(m) && (vho(m) || va(m));
+				}
+			if (!rim)
+				continue;
+			for (int dx = -2; dx <= 2; ++dx)
+				for (int dy = -2; dy <= 2; ++dy)
+				{
+					if (std::max(iabs(dx), iabs(dy)) != 2)
+						continue;
+					const vec2 L{ P.x + dx, P.y + dy };
+					if (!inb(L) || vbc(L))
+						continue;
+					const int dh = vh(L); // d_home before the middle test
+					if (dh == UNREACH || dh >= lce_bd)
+						continue;
+					bool mid = false;
+					for (int mx = -1; mx <= 1 && !mid; ++mx)
+						for (int my = -1; my <= 1 && !mid; ++my)
+						{
+							const vec2 m{ L.x + mx, L.y + my };
+							if (cheb(m, P) <= 1 && !(m.x == P.x && m.y == P.y) && !(mx == 0 && my == 0))
+								mid = inb(m) && !vw(m) && !ve(m) && (vho(m) || va(m)); // (the middle is a hole or an altar: see the rim test)
+						}
+					if (!mid)
+						continue;
+					lce_bd = dh;
+					lce_best.gi = gi;
+					lce_best.L = L;
+					lce_best.P = P;
+				}
+		}
+}
+// one turn's share of the scan: members while fuel stays above LCE_TAB[2] and this turn spent under LCE_TAB[4]; true when the scan is done
+bool lce_find_step()
+{
+	if (lce_of.size() != static_cast<std::size_t>(M.ng))
+	{
+		lce_of.assign(static_cast<std::size_t>(M.ng), -1);
+		lce_sx0 = lce_sy0 = 1 << 20;
+		lce_sx1 = lce_sy1 = -1;
+		bbforeach(M.my_spawn, [&](vec2 p) {
+			lce_sx0 = std::min(lce_sx0, p.x);
+			lce_sy0 = std::min(lce_sy0, p.y);
+			lce_sx1 = std::max(lce_sx1, p.x);
+			lce_sy1 = std::max(lce_sy1, p.y);
+		});
+	}
+	const long f0 = fuel();
+	while (lce_gc < M.ng)
+	{
+		const auto& g = M.groups[static_cast<std::size_t>(lce_gc)];
+		if (!M.has_home || g.access != ACC_DASH || g.gems <= 0)
+		{
+			++lce_gc;
+			continue;
+		}
+		if (lce_mc == 0) // b2373 (PF ask c): the island's lower bound on d_home(L): L lies within 3 of a member (P within 1, L at 2 from P)
+		{
+			lce_lb = UNREACH;
+			for (const int ci : g.members)
+				lce_lb = std::min(lce_lb, lce_box_gap(M.camps[static_cast<std::size_t>(ci)].pos) - 3);
+			lce_lb = std::max(lce_lb, 0);
+		}
+		if (lce_mc < static_cast<int>(g.members.size()) && lce_bd > lce_lb + 2) // stop at the first L within 2 of the lower bound
+		{
+			if (fuel() < static_cast<long>(LCE_TAB[2]) || f0 - fuel() > static_cast<long>(LCE_TAB[4]))
+				return false;
+			lce_member(lce_gc, g.members[static_cast<std::size_t>(lce_mc)]);
+			++lce_mc;
+			continue;
+		}
+		if (lce_best.gi >= 0)
+		{
+			lce_of[static_cast<std::size_t>(lce_gc)] = static_cast<int>(lce_e.size());
+			lce_e.push_back(lce_best);
+		}
+		lce_best = LceEntry{};
+		lce_bd = UNREACH;
+		lce_mc = 0;
+		++lce_gc;
+	}
+	lce_found = true;
+	lce_fire_find();
+	return true;
+}
+inline LceEntry* lce_get(int gi)
+{
+	if (!lce_found || gi < 0 || gi >= static_cast<int>(lce_of.size()) || lce_of[static_cast<std::size_t>(gi)] < 0)
+		return nullptr;
+	return &lce_e[static_cast<std::size_t>(lce_of[static_cast<std::size_t>(gi)])];
+}
+// O1 (spec OPTIMISED FORM): no field rooted at L. G = the walk group whose kept walk field has the least value at L (its value = the exact
+// walk from L to G's camps); cached once found. Only an L within LCE_WIN of its G is priced (the last steps are one window search).
+bool lce_pick_g(LceEntry& e)
+{
+	if (e.g >= 0)
+		return true;
+	int bg = -1, bv = UNREACH;
+	for (int g2 = 0; g2 < M.ng; ++g2)
+	{
+		if (M.groups[static_cast<std::size_t>(g2)].access != ACC_WALK)
+			continue;
+		const distance_field* f = mv::group_field_ready(g2);
+		if (!f)
+			continue;
+		const int v = dfget(*f, e.L);
+		if (v < bv)
+		{
+			bv = v;
+			bg = g2;
+		}
+	}
+	if (bg < 0 || bv > static_cast<int>(LCE_TAB[3]))
+		return false;
+	e.g = bg;
+	e.gl = bv;
+	return true;
+}
+} // namespace
+// background, in spare fuel: the scan once the map is done (bit 1 FIND, store only: no field is built under any bit)
+void lce_background()
+{
+	if (lce_found || !M.done() || !dasher())
+		return;
+	lce_find_step(); // RC C902 F1b: chunked (<= LCE_TAB[4] a turn, keeping LCE_TAB[2])
+}
+// bit 2 (O1): the walk group G whose field leads to the launch and the walk from G to the launch; false: no entry or none priced yet
+bool lce_route(int gi, int* g, int* gl)
+{
+	LceEntry* e = lce_get(gi);
+	if (!e || !lce_pick_g(*e))
+		return false;
+	*g = e->g;
+	*gl = e->gl;
+	lce_fire_price();
+	return true;
+}
+// bit 2 GO: on L, dash to P when ready (else hold for the cooldown); within LCE_WIN of L, one window search to L; else down G's field.
+int lce_land_gi = -1, lce_land_r = -1000; // bit 128 (d): the island my last LCE dash landed on, that round
+int lce_go_gi = -1, lce_go_r = -100, lce_go_r0 = -100; // bit 64: the island the last go turn walked to, that round, the episode's first
+[[gnu::noinline]] void lce_fire_hold()
+{
+	asm volatile("");
+}
+// bit 64 HOLD (Step 0 lce_s2: 11 of 16 walks to the launch ended by a re-choice): my target is the island I walked to last round, within
+// LCE_HOLD rounds of the walk's start, and it still has no dash route: the re-choice keeps it
+bool lce_holding(int gi)
+{
+	if (gi < 0 || gi != lce_go_gi || W.round - lce_go_r > 1 || W.round - lce_go_r0 > static_cast<int>(LCE_TAB[5]) || route_len(gi, W.me.pos) != UNREACH)
+		return false;
+	const LceEntry* e = lce_get(gi);
+	if (!e)
+		return false;
+	for (const auto* es : { &W.enemies, &W.enemies_far }) // RC C902c (c): a foe seen on the island or on the launch breaks the hold
+		for (const auto& o : *es)
+		{
+			if (cheb(o.pos, e->L) <= 1 || cheb(o.pos, e->P) <= 1)
+				return false;
+			for (const int ci : M.groups[static_cast<std::size_t>(gi)].members)
+				if (cheb(o.pos, M.camps[static_cast<std::size_t>(ci)].pos) <= 1)
+					return false;
+		}
+	lce_fire_hold();
+	return true;
+}
+// b2373 bit 128 (d) HOLD THROUGH THE PAY (diag dg1: 43 of 75 dash-ins left uncleared after 4 island turns, 42 re-chosen away, then a
+// recall): I stand off the walk area (f_home UNREACH) on the island my LCE dash landed on <= LCE_PAY rounds ago, above 40% HP, no foe
+// within 4: the re-choice keeps it until the capture (the caller tests the group's status)
+bool lce_paying(int gi)
+{
+	if (gi < 0 || gi != lce_land_gi || W.round - lce_land_r > static_cast<int>(LCE_TAB[6]) || W.me.frac() < 0.4f || dfget_me(M.f_home) != UNREACH)
+		return false;
+	for (const auto& o : W.enemies)
+		if (cheb(o.pos, W.me.pos) <= 4)
+			return false;
+	return true;
+}
+// bit 128 ISLAND RATE: gi has an LCE entry and its walk group G (the contest stand-in); -1 none
+int lce_walk_group(int gi)
+{
+	LceEntry* e = lce_get(gi);
+	return (e && lce_pick_g(*e)) ? e->g : -1;
+}
+bool lce_go(int gi)
+{
+	LceEntry* e = lce_get(gi);
+	if (!e || !W.alive || !lce_pick_g(*e))
+		return false;
+	const vec2 me = W.me.pos;
+	if (me.x == e->L.x && me.y == e->L.y)
+	{
+		const Kit& kit = *W.me.kit;
+		if (kit.slot_dash < 0)
+			return false;
+		ds_goal = gi; // RC C902 F3a: the target's own awake camps do not veto its landing (as step() does)
+		bool foe = false;
+		for (const auto& o : W.enemies)
+			foe |= cheb(o.pos, e->P) <= 2 || cheb(o.pos, me) <= 2;
+		if (!mv::free_tile(e->P))
+			return !foe; // RC C902 F6: an ally holds P: hold on L (no flicker); a foe: fall through
+		if (landing_unsafe(e->P))
+			return false;
+		if (kit.dash_mod > 0 && combat::lw_bad(e->P, std::max(1, static_cast<int>(kit.dash_radius)), gi)) // RC C902 F3b: Heart's landing wakes no other group
+			return false;
+		if (!combat::ready(kit.slot_dash))
+			return true; // hold on the launch for the cooldown
+		if (combat::cast_at(kit.slot_dash, e->P))
+		{
+			dpx_land = e->P; // the live DPX exit leaves the island by the reverse dash
+			lce_land_gi = gi; // bit 128 (d)
+			lce_land_r = W.round;
+			lce_fire_dash();
+			return true;
+		}
+		return false;
+	}
+	if (!W.can_move() || W.moved)
+		return false;
+	lce_fire_go();
+	if (lce_go_gi != gi || W.round - lce_go_r > 1)
+		lce_go_r0 = W.round;
+	lce_go_gi = gi;
+	lce_go_r = W.round;
+	if (cheb(me, e->L) <= static_cast<int>(LCE_TAB[3]))
+		return mv::step_to(e->L, 0, 40, gi);
+	const distance_field* f = mv::group_field(e->g);
+	return f && dfget_me(*f) != UNREACH && mv::step_field(*f, gi);
+}
 } // namespace nova::dn
