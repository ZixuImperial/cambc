+#pragma once
+// feat_tdv (TDV, b1633; spec_tdv_1108): travel dashes on more walks. Flag TDV_BITS, 0 = nova_b2715_vop2r. Bit 1 STS: step_to_set's
+// non-collection walks also try mv::travel_dash (it tried only with cd_mode > 0; the b1633 diag found 19 calm dash-ready Vesper
+// walk turns/g there). Bit 2 REACH: a plain dasher (no landing) with a foe within TD_FOE_R travel-dashes when healthy
+// (TD_COLLECT_HP) onto a landing out of every visible foe's next-turn reach (the collection dash's rule). Hooks: move.cpp, flag first.
+#include "common.h"
+#define TDV_BITS 0
+inline const volatile int TDV_TAB[2] = { 0x54445631, TDV_BITS }; // slot 0 magic keeps it out of .bss
+#define TDV_ON(b) ((TDV_TAB[1] & (b)) != 0)
+constexpr int TDV_BIT_STS = 1;
+constexpr int TDV_BIT_REACH = 2;
+namespace nova::feat::tdv
+{
+// Firing counters (firecount puts one at each function entry): a bit-1 dash in step_to_set; a bit-2 dash with a foe near.
+void sts_fire();
+void reach_fire();
+} // namespace nova::feat::tdv
