+		return 1.0f; // RC C1323b: my own rating only (her bag and tile are exact only in my sight; no shared bag field)
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	int d = 1 << 20;
+	if (pmg_nr_hg >= 0)
+	{
+		const auto& h = M.groups[static_cast<std::size_t>(pmg_nr_hg)];
+		if (const distance_field* f = mv::group_field_ready(pmg_nr_hg))
+		{
+			const std::uint16_t fd = dfget(*f, g.anchor);
+			if (fd != UNREACH)
+				d = static_cast<int>(fd);
+		}
+		if (d == (1 << 20))
+		{
+			const int dx = std::max(0, std::max(h.bx0 - g.bx1, g.bx0 - h.bx1)), dy = std::max(0, std::max(h.by0 - g.by1, g.by0 - h.by1));
+			d = std::max(dx, dy);
+		}
+	}
+	else if (pmg_nr_pos.x >= 0)
+	{
+		const int dx = pmg_nr_pos.x < g.bx0 ? g.bx0 - pmg_nr_pos.x : (pmg_nr_pos.x > g.bx1 ? pmg_nr_pos.x - g.bx1 : 0);
+		const int dy = pmg_nr_pos.y < g.by0 ? g.by0 - pmg_nr_pos.y : (pmg_nr_pos.y > g.by1 ? pmg_nr_pos.y - g.by1 : 0);
+		d = std::max(dx, dy);
+	}
+	const float c = d <= 4 ? 1.0f : (d >= 10 ? 0.0f : static_cast<float>(10 - d) / 6.0f);
+	return 1.0f + pmg_nr_w * c;
+}
