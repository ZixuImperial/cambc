+// PMG (econ_flags.h; the callers read the flag).
+static int pmg_prism_slot()
+{
+	for (int s = 0; s < P.n && s < 8; ++s)
+		if (P.type[static_cast<std::size_t>(s)] == cambc::champion_type::prism)
+			return s;
+	return -1;
+}
+// GEMONLY: total camp gold < 100 or camp gold share <= .05 (every camp tile; the reader's test). Cached once the camps are known.
+bool pmg_gemonly_calc()
+{
+	if (!M.groups_ready() || M.camps.empty())
+		return false;
+	static constexpr int GEMS[6] = { 4, 15, 7, 0, 200, 36 }, GOLD[6] = { 40, 90, 0, 20, 300, 160 };
+	long g = 0, m = 0;
+	for (const auto& c : M.camps)
+	{
+		const int k = static_cast<int>(c.type);
+		const int kk = k >= 0 && k < 6 ? k : 2;
+		g += GOLD[kk];
+		m += GEMS[kk];
+	}
+	pmg_go = (g < 100 || 100L * g <= 5L * std::max(1L, g + 10L * m)) ? 1 : 0;
+	return pmg_go != 0;
+}
+// PMM bit 4 (caller read the flag): a non-carry mate with its stun / lock ready stuns a foe within its reach that just stunned or hit her
+// (her HP fell since my last read, or she is stunned; the foe within its next-turn reach of her), while her bag >= PMG_B.
+static int pmg_st_r = -1000;
+static float pmg_st_hp = 0.0f;
+bool pmg_mate_stun()
+{
+	const int ps = pmg_prism_slot();
+	if (P.n < 4 || ps < 0 || ps == P.my_slot || cltf_kind(P.my_slot) != 0 || !W.alive || !W.me.kit || W.me.kit->slot_cc < 0 || W.me.channeling())
+		return false;
+	const Body* her = nullptr;
+	for (const auto& a : W.allies)
+		if (a.slot == ps)
+			her = &a;
+	if (!her)
+		return false;
+	const bool hit = (pmg_st_r >= now() - 1 && her->hp < pmg_st_hp - 0.5f) || her->stunned;
+	pmg_st_r = now();
+	pmg_st_hp = her->hp;
+	if (!hit || cheb(her->pos, W.me.pos) > 8 || !combat::ready(W.me.kit->slot_cc))
+		return false;
+	std::uint32_t bag = 0;
+	if (cambc::detail::sdk_champion_gems(her->h, &bag) != 0 || static_cast<int>(bag) < PMG_B)
+		return false;
+	const Body* best = nullptr;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, her->pos) <= combat::foe_next_turn_reach(e) && cheb(e.pos, W.me.pos) <= static_cast<int>(W.me.kit->cc_range) &&
+			(!best || cheb(e.pos, her->pos) < cheb(best->pos, her->pos)))
+			best = &e;
+	if (!best)
+		return false;
+	NLOG("r%d slot %d pmm stuns a foe on her\n", now(), P.my_slot);
+	return combat::cast::cast_via_sdk(W.me.kit->slot_cc, combat::KIND_CHAMPION, best->h, best->pos);
+}
