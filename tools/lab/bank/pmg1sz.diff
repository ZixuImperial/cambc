+					{
+						std::uint32_t bag = 0;
+						if (cambc::detail::sdk_champion_gems(a.h, &bag) != 0)
+							bag = a.gems;
+						setw(bag, a.pos);
+					}
+			if (pmg_nr_ps < comms::CLAIM_SLOTS)
+			{
+				const int hg = comms::cgroup(pmg_nr_ps);
+				pmg_nr_hg = (hg >= 0 && hg < M.ng) ? hg : -1;
+			}
