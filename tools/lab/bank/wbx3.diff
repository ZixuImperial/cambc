+// b2386 WBX counters (firecount: function entries): bit 1 found a tank under 35% (the case crew_here skips).
+__attribute__((noinline)) void wbx_fc_lowtank()
+{
+	__asm__ volatile("");
+}
+// b2386 WBX bit 1 WGT1 (caller read the flag): crew_here's tank choice (same bodies, same order test) without the 35% HP floor.
+const Body* wbx_tank(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	std::vector<Attacker> la_tmp;
+	const auto& att = living_attackers_cached(gi, false, la_tmp);
+	const int my_order = P.my_slot >= 0 ? P.tank_order[static_cast<std::size_t>(P.my_slot)] : 99;
+	const bool me_melee = !W.me.kit->ranged;
+	const Body* t = nullptr;
+	int nb = 0;
+	for (const auto& a : W.allies)
+	{
+		if (a.channeling() || a.slot < 0)
+			continue;
+		bool adjacent = false;
+		for (const auto& x : att)
+			adjacent |= cheb(a.pos, x.pos) <= 1;
+		if (!((claims(a.slot, gi) && cheb(a.pos, g.anchor) <= 7) || adjacent) || nb++ >= 8)
+			continue;
+		const bool melee = a.kit && !a.kit->ranged;
+		const int order = P.tank_order[static_cast<std::size_t>(a.slot)];
+		const bool better = (melee && !me_melee) || (melee == me_melee && order < my_order);
+		if (better && a.hp > 0 && (!t || P.tank_order[static_cast<std::size_t>(t->slot)] > order))
+			t = &a;
+	}
+	if (t && t->frac() <= 0.35f)
+		wbx_fc_lowtank();
+	return t;
+}
