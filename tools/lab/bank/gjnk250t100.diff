+// b2376 GJN bit 1 (caller read the flag): every attacker of the group is a golem or monolith (gem clusters allowed).
+static bool gjn_heavy_only(const GroupI& g) { return g.n_golem + g.n_mono > 0 && g.n_att == g.n_golem + g.n_mono; }
+// b2376 GJN bit 1 (caller read the flag; b2273 CLTF bit 256's HP table, RC C883e/g): rounds of heal trip the claimants other than b save
+// when b joins: per claimant s, [L(n)/n - L(n+1)/(n+1)] x its camp factor / (0.7 x its max HP) x (recall 5, 3 with my Home, + home walk
+// -> group) x GJN_TH / 100, with L(n) = K[heavy|light][min(n, 3)] / 1000 x GJN_KS / 100 x the group's remaining HP.
+static std::array<float, 8> gjn_inv{};
+static int gjn_r = -1;
+static float gjn_saved_rounds(int gi, int b, const Claims& cl, int n)
+{
+	if (n <= 0)
+		return 0.0f;
+	if (gjn_r != now())
+	{
+		gjn_r = now();
+		for (int s = 0; s < 8; ++s)
+		{
+			if (s >= P.n)
+			{
+				gjn_inv[static_cast<std::size_t>(s)] = 0.0f;
+				continue;
+			}
+			const Body* bd = s == my_slot() ? &W.me : W.ally_by_slot(s);
+			const float mhp = bd ? bd->maxhp : (grw_ls[static_cast<std::size_t>(s)].r >= 0 ? grw_ls[static_cast<std::size_t>(s)].maxhp : kit_of(P.type[static_cast<std::size_t>(s)]).hp);
+			const float cdf = s == my_slot() ? (mu::on(mu::B_CAMP) ? mu::my_camp(mu::IN) : mu::rule(mu::own_fam(own.jungle, false, false), mu::CAMP, mu::IN)) : 1.0f;
+			gjn_inv[static_cast<std::size_t>(s)] = cdf / std::max(1.0f, 0.7f * mhp);
+		}
+	}
+	static const int K[2][3] = { { 88, 78, 69 }, { 221, 193, 150 } };
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	const int h = g.n_elk + g.n_golem + g.n_mono > 0 ? 1 : 0;
+	const float ghp = (m.status == GS_ALIVE && m.hp_left >= 0) ? m.hp_left : g.hp;
+	const float lk = ghp * static_cast<float>(GJN_TAB[2]) / 100000.0f;
+	const float l0 = static_cast<float>(K[h][std::min(n, 3) - 1]) * lk, l1 = static_cast<float>(K[h][std::min(n + 1, 3) - 1]) * lk;
+	const float dhp = l0 / static_cast<float>(n) - l1 / static_cast<float>(n + 1);
+	if (dhp <= 0.0f)
+		return 0.0f;
+	const std::uint16_t dh = dfget(M.f_home, g.anchor);
+	const float trip = (5.0f + (dh == UNREACH ? 30.0f : static_cast<float>(dh))) * static_cast<float>(GJN_TAB[3]) / 100.0f;
+	float sum = 0.0f;
+	for (int s = 0; s < TM.n && s < 8; ++s)
+		if (s != b && cl[static_cast<std::size_t>(s)] == gi)
+			sum += gjn_inv[static_cast<std::size_t>(s)] * (trip - (s == my_slot() && prism::has_family(rs::F_HOME) ? 2.0f * static_cast<float>(GJN_TAB[3]) / 100.0f : 0.0f));
+	return dhp * sum;
+}
