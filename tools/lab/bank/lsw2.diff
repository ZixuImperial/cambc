@@ -663,12 +832,14 @@ bool capture(int gi)
 			if (cct_gi != gi || now() - cct_last > HOLD_BUDGET_FIX_TAB[2])
 				cct_n = 0;
 			cct_gi = gi;
 			cct_last = now();
