+		if (LSW_ON(1) && (cct || cf_contest))
+			(void)lsw_step(g, gi, cct, cf_contest); // v699 LSW: walk the region toward the unseen end, or close on the seen contester
 		// Hold the tile; hit an enemy in range if there is one.
 		for (const auto& e : W.enemies)
