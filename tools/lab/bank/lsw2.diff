+// LSW (spec_lsw_1110.md, case 01a1c5e4): on a contested group region with no foe in sight for LSW_N turns and a camp tile of it out of
+// my sight, the body nearest the unseen end walks along the region (camp tiles only) toward it; once a contester on the region is seen
+// beyond the fight radius and the local power is at the leave bar or better, it keeps closing. 0 = nova_base_v698. Bits (1): 1 = WALK.
+#define LSW_BITS 0
+#define LSW_N 3   // contested-unseen turns in a row before the walk
+#define LSW_HP 60 // least HP % for a step
+inline const volatile int LSW_TAB[4] = { 0x4C535731, LSW_BITS, LSW_N, LSW_HP }; // slot 0 magic keeps it out of .bss
+#define LSW_ON(b) ((LSW_TAB[1] & (b)) != 0)
