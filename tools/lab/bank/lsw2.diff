@@ -700,12 +871,14 @@ bool capture(int gi)
 		{
 			// the awake camps here kill me before the reward lands: leave the capture (the farm turn steps off)
 			NLOG("r%d slot %d CAW leave %d\n", now(), P.my_slot, gi);
 			drop_target(10);
 			return false;
