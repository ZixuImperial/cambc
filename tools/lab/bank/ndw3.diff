+// NDW bit 4 (the caller read the flag and calm_walk_ok, nothing done yet this turn): with the charge ready and no detour taken for it yet,
+// no foe known within 8, no camp near, one step that keeps my walk distance on f within +1 and brings an unlit meeting bush tile at
+// Chebyshev 3 within 2 (bush_place's reach). bush_place then wards it at the turn end. True when I stepped.
+bool ndw_detour_step(const distance_field* f)
+{
+	static int ndw_used = -2; // ready_since of the charge whose detour was taken
+	const int t = now();
+	if (f == nullptr || ready_since < 0 || t < ready_round || ndw_used == ready_since || !M.done())
+		return false;
+	const vec2 me = W.me.pos;
+	if (!inb(me) || combat::nearest_foe_distance_seen(4) <= 8 || mv::camp_threat(me) > 0)
+		return false;
+	for (int dy = -2; dy <= 2; ++dy)
+		for (int dx = -2; dx <= 2; ++dx)
+		{
+			const vec2 q{ me.x + dx, me.y + dy };
+			if (inb(q) && bbget(M.camp_tiles, q))
+				return false; // a camp in reach: farming, not a detour
+		}
+	const int d0 = dfget(*f, me);
+	if (d0 == UNREACH)
+		return false;
+	const bitboard& vis = my_current_vision();
+	for (int dy = -3; dy <= 3; ++dy)
+		for (int dx = -3; dx <= 3; ++dx)
+		{
+			if (std::max(std::abs(dx), std::abs(dy)) != 3)
+				continue;
+			const vec2 p{ me.x + dx, me.y + dy };
+			if (!inb(p) || !bbget(M.bushes, p) || bbget(M.camp_tiles, p) || bbget(vis, p) || ndw_meet(p) == 0)
+				continue;
+			if (my_ward.x >= 0 && cheb(my_ward, p) <= BUSH_GAP && !(NDW_ON(1) && ndw_meet(my_ward) == 0))
