 #include "ward_internal.h"
 namespace nova::ward {
+// NDW: the meeting test per TILE, on demand (the caller read its flag). +1 when p lies on a near-shortest spawn-to-spawn walk (f_home +
+// ndw_fe <= shortest + 2), +1 when p is on the midline (|f_home - ndw_fe| <= 6) within 6 of a contested group anchor (.35-.65). 0 when p
+// is not a bush or before the one ndw_fe build (map done, fuel to spare). ndw_fe: our own field from the enemy spawn, since the map's
+// enemy field is skipped when the draft stored the distances (mapinfo.cc:587; MBW's test read 0 everywhere for that reason).
+static int ndw_sh = -2; // -2 until ndw_build ran: the shortest spawn-to-spawn walk (UNREACH: none)
+static std::vector<vec2> ndw_ca;
+static distance_field ndw_fe; // from the enemy spawn
+// The one build, from the background block (the caller read the flag and the fuel): one field (~3wh) and ~72 reads.
+void ndw_build()
+{
+	if (ndw_sh != -2 || !M.done() || !M.has_home)
+		return;
+	bitboard visited;
+	ndw_fe.compute(M.walls | M.holes | M.altars_bb | M.my_spawn, M.enemy_spawn, visited);
+	ndw_sh = UNREACH; // my spawn blocks ndw_fe: the walk's length is min f_home + ndw_fe over the tiles next to my spawn
+	bbforeach(M.my_spawn, [&](vec2 q) {
+		for (const vec2 d : DIRS)
+		{
+			const vec2 r = q + d;
+			if (!inb(r) || bbget(M.my_spawn, r))
+				continue;
+			const int ra = dfget(M.f_home, r), rb = dfget(ndw_fe, r);
+			if (ra != UNREACH && rb != UNREACH)
+				ndw_sh = std::min(ndw_sh, ra + rb);
+		}
+	});
+	for (const auto& g : M.groups)
+		if (g.contest >= 0.35f && g.contest <= 0.65f)
+			ndw_ca.push_back(g.anchor);
+}
+int ndw_meet(vec2 p)
+{
+	if (ndw_sh < 0)
+		return 0; // not built yet
+	if (!inb(p) || !bbget(M.bushes, p) || ndw_sh == UNREACH)
+		return 0;
+	const int a = dfget(M.f_home, p), b = dfget(ndw_fe, p);
+	if (a == UNREACH || b == UNREACH)
+		return 0;
+	int sc = a + b <= ndw_sh + 2 ? 1 : 0;
+	if (std::abs(a - b) <= 6)
+		for (const vec2 ga : ndw_ca)
+			if (cheb(ga, p) <= 6)
+			{
+				++sc;
+				break;
+			}
+	return sc;
+}
