+// FBC bit 1 (b1756): the prism guard does not fire: no visible foe within its reach + 1 of the Prism; or she stands on our spawn and the
+// summed burst on her tile is under her eff HP (foes cannot step onto it, GR:153); or my worst ratio is under FBC_WR % while a foe
+// reaches me.
+static __attribute__((noinline)) bool fbc_guard_blocked(const Assessment& a, int ps, vec2 pz)
+{
+	bool near = false, reached = false;
+	for (const auto& f : a.foes)
+	{
+		near = near || (f.idx >= 0 && cheb(f.pos, pz) <= f.reach + 1);
+		reached = reached || cheb(f.pos, W.me.pos) <= f.reach;
+	}
+	if (!near)
+		return true;
+	if (bbget(M.my_spawn, pz))
+	{
+		const Body* pb = W.ally_by_slot(ps);
+		if (pb && burst::lethal_burst_damage_sum(pz, LETHAL_BURST_TAB[5], nullptr) < eff_hp(*pb))
+			return true;
+	}
+	return reached && assess_worst_ratio(a) < 0.01f * static_cast<float>(FBC_TAB[2]);
+}
