+	if (id == 1)
+		return gch::tot > 0.0f ? static_cast<int>(1000.0f * gch::cen / gch::tot) : -1;
+	if (id == 2)
+		return gch::tot > 0.0f ? static_cast<int>(1000.0f * gch::hv / gch::tot) : -1;
+	if (id == 15)
