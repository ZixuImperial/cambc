+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	const int t_us = (travel.size() == static_cast<std::size_t>(M.ng) && travel[static_cast<std::size_t>(gi)] != UNREACH ? static_cast<int>(travel[static_cast<std::size_t>(gi)]) : cheb(W.me.pos, g.anchor)) +
+		static_cast<int>(static_cast<float>(G[11]) / 10.0f + static_cast<float>(G[12]) / 10000.0f * g.hp);
+	int nus = 1;
+	float pus = gch_power(W.me), mus = gch_power(W.me);
+	bool carry_in = prism_layer::type_carrier(W.me.type) || W.me.type == cambc::champion_type::vesper_vale || W.me.type == cambc::champion_type::marcella;
+	for (const auto& al : W.allies)
+		if (al.slot >= 0 && comms::cgroup(al.slot) == gi)
+		{
+			++nus;
+			pus += gch_power(al);
+			mus = std::max(mus, gch_power(al));
+			carry_in = carry_in || prism_layer::type_carrier(al.type) || al.type == cambc::champion_type::vesper_vale || al.type == cambc::champion_type::marcella;
+		}
+	int nth = 0;
+	float pth = 0.0f, mth = 0.0f;
+	std::array<std::uint32_t, 8> counted{};
+	auto add = [&](std::uint32_t h, vec2 p, int age, const Body* b)
+	{
+		for (int k = 0; k < nth; ++k)
+			if (counted[static_cast<std::size_t>(k)] == h)
+				return;
+		if (nth >= 8 || std::max(0, cheb(p, g.anchor) - age) > t_us)
+			return;
+		counted[static_cast<std::size_t>(nth++)] = h;
+		const float pw = b ? gch_power(*b) : gch_power(W.me);
+		pth += pw;
+		mth = std::max(mth, pw);
+	};
+	for (const auto* v : { &W.enemies, &W.enemies_far })
+		for (const auto& e : *v)
+			add(e.h, e.pos, 0, &e);
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		const auto& e = tt[i];
+		const int age = now() - e.round;
+		if (!e.alive || e.round < 0 || age > G[35])
+			continue;
+		add(e.h, e.pos, age, intel::team_body(i));
+	}
+	{ // TRUE MIRROR: the unseen part of their team is expected at this group as many bodies as we send to our copy of it (the mirrored group)
+		int unseen = 0;
+		for (std::size_t i = 0; i < tt.size(); ++i)
+			if (tt[i].alive && !(tt[i].round >= 0 && now() - tt[i].round <= G[35]))
+				++unseen;
+		const int mg = gch::mirror_of.size() == M.groups.size() ? gch::mirror_of[static_cast<std::size_t>(gi)] : -1;
+		int ours_to_copy = 0;
+		if (mg >= 0)
+		{
+			ours_to_copy += T.target == mg ? 1 : 0;
+			for (int s2 = 0; s2 < P.n && s2 < 8; ++s2)
+				if (s2 != my_slot() && comms::cgroup(s2) == mg)
+					++ours_to_copy;
+		}
+		const int expect = std::min(unseen, ours_to_copy);
+		for (int k = 0; k < expect && nth < 8; ++k)
+		{
+			pth += gch_power(W.me); // an unseen foe: our own power as the mirror's
+			mth = std::max(mth, gch_power(W.me));
+			++nth;
+		}
+	}
+	int d = nus - nth;
+	float ratio = nopow ? 1.0f : nth > 0 ? (pus / static_cast<float>(nus)) / std::max(1.0f, pth / static_cast<float>(nth)) : 9.0f;
+	if (!nopow && nth > 0 && std::max(mus, mth) >= static_cast<float>(G[36])) // A15a: past the power mark the strongest bodies decide
+	{
+		d = 0;
+		ratio = mus / std::max(1.0f, mth);
+	}
+	// A15b: on a centre-dominant map the first centre capture is the carry's with 3+ bodies
+	if (gch::centre_dom && gch::side_of[static_cast<std::size_t>(gi)] == 1 && gch::kind_of[static_cast<std::size_t>(gi)] == 1 && gch::centre_caps == 0 && (!carry_in || nus < 3))
+		return 0;
+	static constexpr int TB[3][5] = { { 10, 13, 19, 24, 39 }, { 27, 38, 50, 54, 69 }, { 48, 67, 78, 80, 87 } }; // pw_hold.txt 'us': d <= -1 / 0 / >= +1 by ratio band
+	const int row = d <= -1 ? 0 : d == 0 ? 1 : 2;
+	const int col = ratio < 0.80f ? 0 : ratio < 0.95f ? 1 : ratio < 1.05f ? 2 : ratio < 1.25f ? 3 : 4;
+	return TB[row][col];
+}
+static int gch_hold_pct(int gi)
+{
+	static std::vector<std::int16_t> memo;
+	static int memo_r = -1000;
+	if (now() - memo_r >= std::max(1, gch::G[38]) || memo.size() != static_cast<std::size_t>(M.ng)) // the cached hold holds G[38] rounds
+	{
+		memo.assign(static_cast<std::size_t>(M.ng), -1);
+		memo_r = now();
+		gch::centre_caps = 0; // A15b: a centre gem group cleared or respawning = its first capture is past
+		if (gch::centre_dom && gmem_size(mem) == static_cast<std::size_t>(M.ng))
+			for (std::size_t i = 0; i < gch::side_of.size(); ++i)
+				if (gch::side_of[i] == 1 && gch::kind_of[i] == 1 && mem[i].status != GS_ALIVE)
+					++gch::centre_caps;
+	}
+	std::int16_t& m = memo[static_cast<std::size_t>(gi)];
+	if (m < 0)
+		m = static_cast<std::int16_t>(gch_hold_pct_raw(gi));
+	return m;
+}
+// a region code (1 + side x 3 + kind, + 16 x walk rank) matches group gi
+static bool gch_code_has(int code, std::size_t gi)
+{
+	const int reg = (code & 15) - 1, rk = code >> 4;
+	return reg >= 0 && reg == static_cast<int>(gch::side_of[gi]) * 3 + static_cast<int>(gch::kind_of[gi]) && (rk == 0 || rk == static_cast<int>(gch::rank_of[gi]));
+}
+static float gch_factor_compute(int gi, int self)
+{
+	const auto* G = gch::G;
+	const std::size_t ug = static_cast<std::size_t>(gi);
+	float f = 1.0f;
+	if ((gch::bits & 2) && self == my_slot() && gch::side_of[ug] != 0) // bit 2 HOLD: my own row's contested group, value x min(1, P(hold) / G[39])
+		f = G[39] > 0 ? std::min(1.0f, static_cast<float>(gch_hold_pct(gi)) / static_cast<float>(G[39])) : static_cast<float>(gch_hold_pct(gi) >= G[32] ? G[33] : G[34]) / 100.0f;
+	if (gch::plan == 0)
+		return f;
+	const int side = gch::side_of[ug], kind = gch::kind_of[ug];
+	const bool post = static_cast<int>(W.tributed_us) >= G[3]; // RC C1203b: shared state, not a round
+	f *= static_cast<float>(post ? (side == 0 ? G[9] : G[10]) : G[6 + side]) / 100.0f * (static_cast<float>(G[15 + kind]) / 100.0f);
+	int code = 0; // ROUTE: the active phase's region (phases keyed on our tributed gems), or the row kit's role region
+	for (int ph = 0; ph < 3; ++ph)
+		if (G[19 + 2 * ph] != 0 && static_cast<int>(W.tributed_us) >= G[20 + 2 * ph])
+			code = G[19 + 2 * ph];
+	if (self >= 0 && self < P.n && self < 8)
+	{
+		const auto t = P.type[static_cast<std::size_t>(self)];
+		const int role = t == cambc::champion_type::prism ? G[27] : t == cambc::champion_type::vesper_vale ? G[28] : t == cambc::champion_type::marcella ? G[29] : t == cambc::champion_type::vendetta ? G[30] : t == cambc::champion_type::ryth ? G[31] : 0;
+		if (role != 0)
+			code = role;
+	}
+	if (code != 0)
+		f *= static_cast<float>(gch_code_has(code, ug) ? G[25] : G[26]) / 100.0f;
+	if (G[13] != 0 && side != 0) // race term (off by default): own zone gets no race
+	{
+		const float m = static_cast<float>(gch::margin_of[ug] + G[18]) / static_cast<float>(std::max(1, G[14]));
+		const float s = std::clamp(static_cast<float>(G[13]) / 100.0f, 0.0f, 1.0f); // RC C1260b: s in [0, 1] keeps the term in (0, 1]
+		f *= (1.0f - s) + s / (1.0f + std::exp(-m));
+	}
+	return f;
+}
+// The hot path (b2392 form 2): one cached multiplier per group and row, refreshed every G[38] rounds; only called while gch_act.
+float gch_factor(int gi, int self)
+{
+	static std::array<std::vector<float>, 9> mult; // lazy per group: -1 = not computed this refresh
+	static std::array<int, 9> stamp{ -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000, -1000 };
+	if (gi < 0 || static_cast<std::size_t>(gi) >= gch::side_of.size())
+		return 1.0f;
+	const std::size_t k = (self >= 0 && self < 8) ? static_cast<std::size_t>(self) : 8;
+	if (now() - stamp[k] >= std::max(1, gch::G[38]) || mult[k].size() != gch::side_of.size())
+	{
+		mult[k].assign(gch::side_of.size(), -1.0f);
+		stamp[k] = now();
+	}
+	float& m = mult[k][static_cast<std::size_t>(gi)];
+	if (m < 0.0f)
+		m = gch_factor_compute(gi, self);
+	return m;
+}
 } // namespace nova::econ
