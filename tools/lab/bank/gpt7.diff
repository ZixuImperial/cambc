+// the GPT tree (GPT_TAB read once here): the plan for this map, or -1 when F0 == 0 (the GPC_TAB type table decides)
+static int gch_tree_plan()
+{
+	int t[13];
+	for (int k = 0; k < 13; ++k)
+		t[k] = GPT_TAB[k];
+	if (t[1] == 0)
+		return -1;
+	if (gch::map_type >= 0 && gch::map_type < 31 && ((t[7] >> gch::map_type) & 1))
+		return 0;
+	const int v0 = gch_feat_k(t[1]);
+	if (v0 < 0)
