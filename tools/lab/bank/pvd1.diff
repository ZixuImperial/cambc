 }
+// PVD bit 1 (Combat spec_pvd_1110): the bad-ratio veto now also holds for an undamaged peeler (the firing count).
+bool pvd_fire()
+{
+	return true;
+}
 bool peel_vetoes_target(float worst)
 {
-	if (worst * 100.0f >= static_cast<float>(FHC_PEEL_X100) || !combat::took_damage(2))
+	if (worst * 100.0f >= static_cast<float>(FHC_PEEL_X100) || (!combat::took_damage(2) && !(PVD_ON(1) && pvd_fire()))) // PVD bit 1: undamaged too
 		return false;
