+++ b/src/econ_flags.h
@@ -984,6 +984,12 @@ inline constexpr int VJN_TAB[3] = { 0x564A4E31, VJN_BITS, VJN_END }; // slot 0 m
 inline constexpr int VTK_TAB[3] = { 0x56544B31, VTK_BITS, VTK_K }; // slot 0 magic keeps it out of .bss
 // VGT (b1789, spec_vgt_1110 VV Design, owner 9 Nov: too many Greed emblems). 0 = v698. Bit 1: Vesper's own build takes no Greed
 // (greed_tail_pass's Skirmish slot as live). Bit 2 (only with bit 1): her Bruiser main entries stay Bruiser (not Power).
 // v715 VGT: stack package VSP (VJN+VTK+VGT+VCD)
 #define VGT_BITS 3
 inline constexpr int VGT_TAB[2] = { 0x56475431, VGT_BITS }; // slot 0 magic keeps it out of .bss
+
+// PVD (b1789, Combat spec_pvd_1110, 00interlock 01a1c781 r180-182): the peel bad-ratio veto (worst < FHC_PEEL_X100) also applies when
+// I took no damage in 2 rounds. 0 = v716. Bit 1: peel_vetoes_target (econ_team_ops.cc) drops the took_damage clause.
+#define PVD_BITS 0
+inline const volatile int PVD_TAB[2] = { 0x50564431, PVD_BITS }; // slot 0 magic keeps it out of .bss
+#define PVD_ON(b) ((PVD_TAB[1] & (b)) != 0)
diff --git a/src/econ_team_ops.cc b/src/econ_team_ops.cc
