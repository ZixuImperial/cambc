+// CHF bit 1: a FLEE about to be run down stays a FLEE (in reach, 2+ foes within CHF_NEAR, both ratios under CHF_RATIO, no ready dash).
+static __attribute__((noinline)) bool chf_keep_flee(const Assessment& a)
+{
+	if (!a.in_reach || std::max(a.ratio, a.ratio_near) * 100.0f >= static_cast<float>(CHF_TAB[3]))
+		return false;
+	if (W.me.kit && W.me.kit->slot_dash >= 0 && ready(W.me.kit->slot_dash))
+		return false;
+	int n = 0;
+	for (const auto& e : W.enemies)
+		n += cheb(e.pos, W.me.pos) <= CHF_TAB[2] ? 1 : 0;
+	return n >= 2;
+}
