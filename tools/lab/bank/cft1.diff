+		int cc = 1;
+		const float r2 = rate_for<DM>(g2, my_slot(), tr, cl3, free_near() + 1, &cc);
+		if (cc >= 2 && r2 > 0.0f && r2 >= tk * solo)
+		{
+			*out_rate = r2;
+			*out_crew = cc;
+			cft_hold_g = g2;
+			cft_hold_r = now();
