+	}
+	if (now() - cft_trig_r > 3 || fuel() < 60000)
+		return -1; // one 4-round window per shared clear
+	if (W.me.gems > 0 && want_bank())
+		return -1;
+	Claims cl2 = cl;
+	const int crew = cft_crew(old, &cl2);
+	if (crew < 1)
+		return -1;
+	const float solo = (b >= 0) ? *out_rate : 0.0f;
+	const float tk = static_cast<float>(CFT_TAB[4]) / 100.0f;
+	// FOLLOWER: a mate near me (a carry too: following one is the funnel) claimed another group in this window.
+	bool offered = false;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0 || al.slot >= 8 || al.channeling() || cheb(al.pos, W.me.pos) > 4 || squad::claim_changed(al.slot) < cft_trig_r - 1)
+			continue;
+		const int g2 = comms::cgroup(al.slot);
+		if (g2 < 0 || g2 >= M.ng || g2 == old)
+			continue;
+		offered = true;
+		if (g2 == b)
+			continue;
+		const std::uint16_t tr = travel[static_cast<std::size_t>(g2)];
+		if (tr == UNREACH || !reachable_target(g2) || fuel() < 45000)
+			continue;
+		Claims cl3 = cl;
