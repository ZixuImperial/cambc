+#define CFT_ON(b) ((CFT_TAB[1] & (b)) != 0)
+// b2329 CFT bit 1 (RC C900 F2): the damage my basic hits dealt per camp in round cft_dealt_r (hit_camp; caller reads the flag).
+inline std::vector<float> cft_dealt;
+inline int cft_dealt_r = -1000;
+inline void cft_note_dealt(int ci, float d, int round)
+{
+	if (cft_dealt_r != round)
+	{
+		cft_dealt_r = round;
+		for (auto& x : cft_dealt)
+			x = 0.0f;
+	}
+	if (ci < 0)
