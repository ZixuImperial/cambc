+// b2329 CFT (RC C900 F3): one crew test for me and for every mate, so every body keys on the same tile: alive, not channelling, and
+// either a group claim on gi (TM2 kinds 2 / 3) or within range + 1 of a living visible member of gi.
+static bool cft_in_crew(int slot, vec2 pos, int range, int gi)
+{
+	if (slot >= 0 && (comms::ckind(slot) == 2 || comms::ckind(slot) == 3) && comms::cgroup(slot) == gi)
+		return true;
+	const auto& sl = W.camp_slot;
+	for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+		if (ci >= 0 && static_cast<std::size_t>(ci) < sl.size() && sl[static_cast<std::size_t>(ci)] >= 0 &&
+			cheb(M.camps[static_cast<std::size_t>(ci)].pos, pos) <= range + 1)
+			return true;
+	return false;
+}
+// b2329 CFT bit 2 (caller read the flag): the tile of the crew body that acts first this round (highest current priority, ties lower
+// slot); cached per round and group.
+static vec2 cft_key(int gi)
+{
+	static int kr = -1000, kg = -1;
+	static vec2 kp{ -1, -1 };
+	if (kr == W.round && kg == gi)
+		return kp;
+	kr = W.round;
+	kg = gi;
+	int bp = -2147483647, bs = 1000;
+	kp = W.me.pos;
+	if (cft_in_crew(P.my_slot, W.me.pos, static_cast<int>(W.me.range), gi))
+	{
+		std::int32_t mine = 0;
+		cambc::detail::sdk_bc_champion_priority(static_cast<std::uint32_t>(cambc::detail::cached_my_champion), 0, &mine);
+		bp = mine;
+		bs = P.my_slot;
+	}
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0 || al.h == 0 || al.channeling() || al.hp <= 0.0f || !cft_in_crew(al.slot, al.pos, static_cast<int>(al.range), gi))
+			continue;
+		std::int32_t v = 0;
+		if (cambc::detail::sdk_bc_champion_priority(al.h, 0, &v) != 0)
+			continue;
+		if (v > bp || (v == bp && al.slot < bs))
+		{
+			bp = v;
+			bs = al.slot;
+			kp = al.pos;
+		}
+	}
+	return kp;
+}
+// b2329 CFT (caller read the flag): pick_focus with the crew terms. Same base terms as pick_focus_fast's plain branch (HP + 40 x
+// Chebyshev from the key tile, non-attacking members last, ties lower camp index).
+static int cft_pick(int gi, vec2 near)
+{
+	// Bit 1 (RC C900 F2): each camp's HP at my first look this round; last round's look minus what I dealt it is a mate's hit.
+	static std::vector<float> snap_prev, snap_cur;
+	static int snap_cur_r = -1000, snap_prev_r = -1000;
+	if (snap_cur_r != W.round)
+	{
+		snap_prev.swap(snap_cur);
+		snap_prev_r = snap_cur_r;
+		snap_cur.assign(static_cast<std::size_t>(M.nc), -1.0f);
+		snap_cur_r = W.round;
+	}
+	const bool have_prev = snap_prev_r == W.round - 1 && snap_prev.size() == static_cast<std::size_t>(M.nc);
+	const vec2 key = CFT_ON(2) ? cft_key(gi) : near;
+	const float hit = W.me.str * mu::my_camp(mu::OUT) * (W.me.kit && W.me.kit->missing_hp_bonus ? heart_layer::damage_mult(W.me.hp, W.me.maxhp) : 1.0f);
+	const int rng = static_cast<int>(W.me.range);
+	const bool step_hit = W.can_move() && W.me.kit && (!W.me.kit->ranged || (W.me.kit->slot_reset >= 0 && combat::ready(W.me.kit->slot_reset))); // RC C900 F1
+	const int rmv = rng + (step_hit ? 1 : 0);
+	const auto& slot = W.camp_slot;
+	int best = -1;
+	float best_s = 1e9f;
+	for (int ci : M.groups[static_cast<std::size_t>(gi)].members)
+	{
+		if (ci < 0 || static_cast<std::size_t>(ci) >= slot.size())
+			continue;
+		const int sl = slot[static_cast<std::size_t>(ci)];
+		if (sl < 0)
+			continue;
+		const VisCamp& vc = W.camps[static_cast<std::size_t>(sl)];
+		const auto& c = M.camps[static_cast<std::size_t>(ci)];
+		float s = vc.hp + static_cast<float>(cheb(c.pos, key)) * 40.0f;
+		if (!c.attacks())
+			s += 100000.0f;
+		const int dme = cheb(c.pos, W.me.pos);
+		if (CFT_ON(1) && dme <= rng && have_prev && snap_prev[static_cast<std::size_t>(ci)] >= 0.0f)
+		{
+			float loss = snap_prev[static_cast<std::size_t>(ci)] - vc.hp;
+			if (cft_dealt_r == W.round - 1 && static_cast<std::size_t>(ci) < cft_dealt.size())
+				loss -= cft_dealt[static_cast<std::size_t>(ci)]; // my own hits last round are not a mate's
+			if (loss > 0.5f)
+				s -= static_cast<float>(CFT_TAB[2]);
+		}
+		if (CFT_ON(4) && dme <= rmv && vc.hp <= hit)
+			s -= static_cast<float>(CFT_TAB[3]);
+		if (snap_cur[static_cast<std::size_t>(ci)] < 0.0f)
+			snap_cur[static_cast<std::size_t>(ci)] = vc.hp; // the first look this round only
+		if (s < best_s || (s == best_s && best >= 0 && ci < best))
+		{
+			best_s = s;
+			best = ci;
+		}
+	}
+	if (CFT_ON(2) && best >= 0 && cheb(M.camps[static_cast<std::size_t>(best)].pos, W.me.pos) > rmv)
+		best = pick_focus_fast(gi, near); // the agreed member is out of my reach this turn: my own best, as live
+	return best;
+}
 int pick_focus_raw(int gi, vec2 near)
 {
+	if (CFT_ON(7) && !varg_layer::focus_splash()) // b2329 CFT: the crew terms (econ_flags.h)
+		return cft_pick(gi, near);
 	return pick_focus_fast(gi, near);
 }
