+	if (cft_prop_g == -2)
+	{
+		cft_prop_g = -1;
+		cft_prop_rate = 0.0f;
+		// RC C900b: the CFT_NPROP nearest by travel over ALL groups within CFT_NEAR (a bounded insertion, ties lower index).
+		const int kmax = std::min(8, static_cast<int>(CFT_TAB[7]));
+		int pick[8];
+		int ptr[8];
+		int np = 0;
+		for (int gi = 0; gi < M.ng; ++gi)
+		{
+			const std::uint16_t tr = travel[static_cast<std::size_t>(gi)];
+			if (gi == old || tr == UNREACH || static_cast<int>(tr) > CFT_TAB[6])
+				continue;
+			const int t = static_cast<int>(tr);
+			if (np == kmax && t >= ptr[kmax - 1])
+				continue;
+			int j = np < kmax ? np++ : kmax - 1;
+			while (j > 0 && ptr[j - 1] > t)
+			{
+				pick[j] = pick[j - 1];
+				ptr[j] = ptr[j - 1];
+				--j;
+			}
+			pick[j] = gi;
+			ptr[j] = t;
+		}
+		for (int k = 0; k < np; ++k)
+		{
+			if (fuel() < 45000)
+				break;
+			const int gi = pick[k];
+			if (!reachable_target(gi))
+				continue;
+			int cc = 1;
+			const float r = rate_for<DM>(gi, my_slot(), travel[static_cast<std::size_t>(gi)], cl2, free_near() + crew, &cc);
+			if (cc >= 2 && r > cft_prop_rate)
+			{
+				cft_prop_rate = r;
+				cft_prop_g = gi;
+				cft_prop_c = cc;
+			}
+		}
+	}
+	if (cft_prop_g >= 0 && cft_prop_g != b && cft_prop_rate >= tk * solo)
+	{
+		*out_rate = cft_prop_rate;
+		*out_crew = cft_prop_c;
+		return cft_prop_g;
+	}
+	return -1;
+}
+// b2329 CFT bit 8: a follower keeps its crew's group until it arrives or hits; -1 when the hold is off or broken (RC C900 F6: kept only
+// while my target is the held group, at most travel + 5 rounds).
+template <int DM>
+static int cft_hold(const Claims& cl, float* out_rate, int* out_crew)
+{
+	const int g = cft_hold_g;
+	if (g < 0 || g >= M.ng)
+		return -1;
+	const auto& gr = M.groups[static_cast<std::size_t>(g)];
+	const std::uint16_t tr = travel[static_cast<std::size_t>(g)];
+	if ((now() > cft_hold_r && T.target != g) || now() - cft_hold_r > cft_hold_tr + 5 || !W.enemies.empty() ||
+		mem[static_cast<std::size_t>(g)].status == GS_RESPAWN || tr == UNREACH || T.engaged || cheb(W.me.pos, gr.anchor) <= CFT_TAB[5] ||
+		(W.me.gems > 0 && want_bank()))
+	{
+		cft_hold_g = -1;
+		return -1;
+	}
+	int cc = 1;
+	const float r = rate_for<DM>(g, my_slot(), tr, cl, free_near() + 1, &cc);
+	*out_rate = r > 0.0f ? r : 0.0f;
+	*out_crew = cc;
+	return g;
+}
