+// b2329 CFT bit 8 STAY CREWED (econ_flags.h; caller read the flag). State: my last live target, the decision window, the follower hold.
+static int cft_old = -1, cft_hold_g = -1, cft_hold_r = -1000, cft_hold_tr = 0, cft_trig_g = -1, cft_trig_r = -1000, cft_prop_g = -2, cft_prop_c = 1;
+static float cft_prop_rate = 0.0f;
+// RC C900 F8: a roster carry (Prism, Vesper, Marcella) takes no part in bit 8 (the shared roster helper is not in the base).
+static bool cft_carry(cambc::champion_type t)
+{
+	return t == cambc::champion_type::prism || t == cambc::champion_type::vesper_vale || t == cambc::champion_type::marcella;
+}
+// The crew of the shared clear of group old (RC C900 F8): visible, alive, not channelling, not a carry, within 4 of me and SITE + 3 of
+// old's anchor, its claim old or none, not engaged elsewhere (TM.busy), and not still on old's region while it is cleared (capturing).
+static int cft_crew(int old, Claims* cl2)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(old)];
+	const bool clr = mem[static_cast<std::size_t>(old)].status == GS_CLEARED;
+	int n = 0;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0 || al.slot >= 8 || al.channeling() || al.hp <= 0.0f || cft_carry(al.type) || cheb(al.pos, W.me.pos) > 4 ||
+			cheb(al.pos, g.anchor) > CFT_TAB[5] + 3)
+			continue;
+		const int cg = TM.claim[static_cast<std::size_t>(al.slot)];
+		if ((cg != old && cg >= 0) || TM.busy[static_cast<std::size_t>(al.slot)])
+			continue;
+		const int ci = M.camp_index(al.pos);
+		if (clr && ci >= 0 && ci < M.nc && M.camps[static_cast<std::size_t>(ci)].group == old)
+			continue;
+		++n;
+		if (cl2)
+			(*cl2)[static_cast<std::size_t>(al.slot)] = -1; // counted free for the crewed rating
+	}
+	return n;
+}
+template <int DM>
+static int cft_stay_crewed(int b, const Claims& cl, float* out_rate, int* out_crew)
+{
+	if (cft_old < 0 || cft_old >= M.ng || cft_carry(W.me.type) || !W.enemies.empty() || T.capturing)
+		return -1;
+	const int old = cft_old;
