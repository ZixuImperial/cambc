 		if (static_cast<long>(W.tributed_us) + g >= 1000)
 			continue; // wins alone
 		if (now() + rs::tribute_turns(static_cast<int>(g), static_cast<bool>(body_family_or_default(P.handle[static_cast<std::size_t>(s)], rs::F_TRIBUTE, true))) <= GAME_END)
 			sum += g;
