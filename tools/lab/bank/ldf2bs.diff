+// b2442 LDF (caller read the flag; GR:29): our tributed total reachable by GAME_END: tributed + my bag when it lands by then + mates'
+// channels landing by then + our tribute rate (eg_hist sample >= 200 rounds old) x rounds left. Unknown rate (no sample): 1 << 20
+// (nothing counts as decided). Once per round.
+static int ldf_r = -1, ldf_v = 0;
+int ldf_our_reach()
+{
+	if (ldf_r == now())
+		return ldf_v;
+	ldf_r = now();
+	const int left = std::max(0, GAME_END - now());
+	const std::array<int, 3>* old = nullptr;
+	for (const auto& h : eg_hist)
+		if (now() - h[0] >= 200)
+			old = &h;
+	if (!old || now() <= (*old)[0])
+		return ldf_v = 1 << 20;
+	long v = static_cast<long>(W.tributed_us) + static_cast<long>(W.tributed_us - (*old)[1]) * static_cast<long>(left) / static_cast<long>(now() - (*old)[0]);
+	const int g = static_cast<int>(W.me.gems);
+	if (g > 0 && M.has_altar)
+	{
+		const std::uint16_t d = bank_dist_here();
+		if (d != UNREACH && static_cast<int>(d) + rs::tribute_turns(g, prism::has_family(rs::F_TRIBUTE)) <= left)
+			v += g;
+	}
+	v += mates_landing_by(left);
+	return ldf_v = static_cast<int>(std::min(v, 1L << 20));
+}
