+// b2442 LDF (caller read the flag; GR:29, INT:120; RC C1453 state form, no round window): a foe bag g that lands by r2000 (its
+// fastest channel, Tribute emblem) after which we cannot retake the lead by r2000: econ::ldf_our_reach() (ours + bags landing by
+// 2000 + our projected gain) <= them + g, while without it we could (reach > them). A tie counts as lost (gold tiebreak unknown).
+__attribute__((noinline)) bool ldf_late_flip(int g)
+{
+	if (g <= 0 || W.round + rs::tribute_turns(g, true) > DDL_END)
+		return false;
+	const int reach = econ::ldf_our_reach();
+	return reach > W.tributed_them && reach <= W.tributed_them + g;
+}
