diff --git b/src/feat_kim.cpp b/src/feat_kim.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_kim.cpp
@@ -0,0 +1,29 @@
+#ifdef NOVA_UNITY_ALL // unity build: compiled only through nova_all.cpp
+// feat_kim.cpp (KIM, b1603): see feat_kim.h. Reached only when KIM_ON(...) is true at the hook.
+#include "feat_kim.h"
+namespace nova::feat::kim
+{
+void hit()
+{
+}
+bool imm_only(const Body& b)
+{
+	if (b.type != cambc::champion_type::ryth && b.type != cambc::champion_type::heart_of_ruin)
+		return false;
+	if (!b.ally && b.h != W.me.h)
+		return false; // our bodies only
+	int n = 0;
+	for (const auto& e : W.enemies)
+		if (cheb(e.pos, b.pos) <= KIM_D)
+		{
+			if (!::nova::marcella_layer::body(e))
+				return false; // a foe my stun holds (or an unknown kit)
+			++n;
+		}
+	if (n == 0)
+		return false;
+	hit();
+	return true;
+}
+} // namespace nova::feat::kim
+#endif
diff --git b/src/feat_kim.h b/src/feat_kim.h
new file mode 100644
--- /dev/null
+++ b/src/feat_kim.h
@@ -0,0 +1,19 @@
+#pragma once
+// feat_kim (KIM, b1603; Combat, correct by rule, 04gap climb W1): kit_fight_value (combat.cpp kit_rules) credits our Ryth (+0.39)
+// and Heart of Ruin (+1.43) with stun value (applied as exp(.25 v) on dps, dps_kit_scaled), also when the only foes near are
+// stun-immune Marcellas (her passive, kit_marcella.h). Flag KIM_BITS, 0 = v613.
+//   1 IMM  dps_kit_scaled: our Ryth / HoR whose every visible foe within KIM_D (at least one) is a known Marcella takes
+//          exp(.25 min(v, 0)) = 1, no kit factor
+// Flag first: 0 does no work.
+#include "common.h"
+#include "world.h"
+#define KIM_BITS 0
+inline const volatile int KIM_TAB[2] = { 0x4b494d31, KIM_BITS }; // slot 0 magic keeps it out of .bss
+#define KIM_ON(b) ((KIM_TAB[1] & (b)) != 0)
+constexpr int KIM_B_IMM = 1;
+inline constexpr int KIM_D = 8; // the foes that count: visible, within this of the body
+namespace nova::feat::kim
+{
+bool imm_only(const Body& b); // IMM: b is our Ryth / HoR and every visible foe within KIM_D is a Marcella (counted on true through hit())
+void hit();                   // IMM: counted entry, the factor dropped
+} // namespace nova::feat::kim
diff --git b/src/feat_pgh.cpp b/src/feat_pgh.cpp
