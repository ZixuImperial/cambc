+// TOQ (b2017, RC X468): the turn order from the foes' completed-turn bits. Callers read TOQ_ON first.
+namespace nova::combat::toq
+{
+namespace {
+struct Seen { std::uint32_t h = 0; int r = -1000, pr = -1000, p = 0, pp = 0; bool a = false, pa = false, stn = false; };
+std::array<Seen, 16> seen{};
+int my_r = -1000, my_pr = -1000, my_k = 0, my_pk = 0, obs_round = -1000;
+std::uint32_t obs_me = 0;
+bool my_stn = false; // no priority change pending for next round (me and mates in sight)
+Seen& note(const Body& e)
+{
+	Seen* old = &seen[0];
+	for (auto& d : seen)
+	{
+		if (d.h == e.h)
+		{
+			old = &d;
+			break;
+		}
+		if (d.r < old->r)
+			old = &d;
+	}
+	if (old->h != e.h)
+	{
+		*old = Seen{};
+		old->h = e.h;
+	}
+	if (old->r != W.round)
+	{
+		const int p = burst::ed_prio_hdt(e.h, false);
+		old->pr = old->r;
+		old->pa = old->a;
+		old->pp = old->p;
+		old->r = W.round;
+		old->a = (e.state & FLEE_FIX_ST_ACTED) != 0;
+		old->p = p;
+		old->stn = burst::ed_prio_hdt(e.h, true) == p;
+	}
+	return *old;
+}
+} // namespace
+// Once a turn: my order key and every foe in sight's bit and priority.
+void observe()
+{
+	if (obs_round == W.round && obs_me == W.me.h)
+		return;
+	obs_round = W.round;
+	obs_me = W.me.h;
+	const int p = PRA_DEC(burst::ed_prio_hdt(W.me.h, false)), p2 = PRA_DEC(burst::ed_prio_hdt(W.me.h, true));
+	int ra = 0;
+	bool st = p == p2;
+	for (const auto& al : W.allies)
+	{
+		const int q = PRA_DEC(burst::ed_prio_hdt(al.h, false)), q2 = PRA_DEC(burst::ed_prio_hdt(al.h, true));
+		ra += (q > p || (q == p && al.h < W.me.h)) ? 1 : 0;
+		st = st && q == q2;
+	}
+	my_pr = my_r;
+	my_pk = my_k;
+	my_r = W.round;
+	my_k = p * 64 + ra;
+	my_stn = st;
+	for (const auto& e : W.enemies)
+		note(e);
+	for (const auto& e : W.enemies_far)
+		note(e);
+}
+// 0 not at my place (order constant), 1 at my place (order flips each round), 2 unknown.
+int paired(const Body& e)
+{
+	observe();
+	const Seen& d = note(e);
+	if (!my_stn || !d.stn)
+		return 2; // a priority change lands next round
+	if (d.a != enemy_starts(W.round))
+		return 0; // the pair at my place goes starting team first (GR:128, INT:22)
+	if (d.pr == W.round - 1 && my_pr == W.round - 1 && my_pk == my_k && d.pp == d.p)
+		return d.pa != d.a ? 1 : 0;
+	return 2;
+}
+// e acts before me in round now + j: 1, 0, or -1 unknown.
+int before(const Body& e, int j)
+{
+	const int a = (e.state & FLEE_FIX_ST_ACTED) != 0 ? 1 : 0;
+	if (j <= 0)
+		return a;
+	const int pr = paired(e);
+	return pr == 2 ? -1 : (pr == 1 ? (a ^ (j & 1)) : a);
+}
+} // namespace nova::combat::toq
