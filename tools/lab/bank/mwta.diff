+// b2363 MWT bit 2 (caller read the flag; RC C1335: camp kills destroy carried gems, GR:375): a bag carrier may join a big op and bank after
+// it only when (a) it is not the crew's tank (best camp tank of me + the mates near the anchor, TM.by_tank order), (b) its per-trip share of
+// the crew's estimated damage fits its own camp budget at the call margin, (c) no foe danger is shared within 8 of the anchor (6 rounds), and
+// (d) its walk + the group's altar walk fit the clear time + MWT_TAB[3] (20). Otherwise live's bank-first.
+static __attribute__((noinline)) bool mwt_bank_after(int gi, int walk)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	if (g.d_altar == UNREACH || intel::danger_shared_any(g.anchor, 8, 6))
+		return false;
+	const int rad = (g.reach_max > 0 ? g.reach_max : 1) + 4;
+	std::array<bool, 8> in{};
+	in[static_cast<std::size_t>(my_slot())] = true;
+	for (const auto& al : W.allies)
+		if (al.slot >= 0 && al.slot < 8 && cheb(al.pos, g.anchor) <= rad)
+			in[static_cast<std::size_t>(al.slot)] = true;
+	Crew cc;
+	int first = -1;
+	for (int i = 0; i < TM.n && i < 8; ++i)
+	{
+		const int s = TM.by_tank[static_cast<std::size_t>(i)];
+		if (s < 0 || s >= 8 || !in[static_cast<std::size_t>(s)])
+			continue;
+		if (first < 0)
+			first = s;
+		cc.add(ECX_TM(static_cast<std::size_t>(s)));
+	}
+	if (first == my_slot() || cc.n < 1)
+		return false; // (a) the tank keeps live's bank-first
+	const ClearEst e = estimate_cx(2, g, mem[static_cast<std::size_t>(gi)], cc);
+	if (!e.feasible)
+		return false;
+	const float share = e.dmg / std::max(1.0f, e.trips) / static_cast<float>(cc.n);
+	if (share > SG_MARGIN_CALL * ECX_TM(static_cast<std::size_t>(my_slot())).budget)
+		return false; // (b)
+	return walk + static_cast<int>(g.d_altar) <= static_cast<int>(e.t) + MWT_TAB[3]; // (d)
+}
