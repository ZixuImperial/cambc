+		return false; // a tile a wolf reaches has a wolf in my range (ranged 3 >= wolf reach 3)
+	if (fuel() < static_cast<long>(SWG_TAB[3]) + (swg_have(gi) ? 0L : 600L * static_cast<long>(g.members.size())))
+		return false; // the first build would not fit this turn: live's turn
+	SwgGrid& s = swg_grid(gi);
+	if (s.gi != gi || s.alive <= 0)
+		return false; // box too big, or no living wolf left in the grid: live's turn (capture, focus checks)
+	const vec2 me = W.me.pos;
+	if (!swg_stand_valid(s))
+	{
+		if (fuel() < static_cast<long>(SWG_TAB[3]) + 10L * s.w * s.h)
+			return false; // the re-pick would not fit this turn: live's turn
+		swg_pick_stand(s);
+	}
+	if (s.sx < 0)
+	{
+		// no tile cheap enough: no hit; out of the wolves' reach if I am in it (the 7 x 7 around me only)
+		if (swg_cnt_at(s, me) > 0 && W.can_move())
+		{
+			static bitboard swg_goals{ cambc::uninitialized };
+			nchk(cambc::detail::sdk_Bitboard_Zero(swg_goals.ptr()));
+			bool any = false;
+			for (int dy = -3; dy <= 3; ++dy)
