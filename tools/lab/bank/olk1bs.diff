+// b2387 RTC (OLK bit 1; callers read the flag). One writer helper for the field (WBX bit 1 reuses it): every body, every turn, dead too.
+static bool rtc_mine = false;
+static std::uint32_t rtc_v = 0;
+static int rtc_since = -1000, rtc_trib0 = -1;
+int rtc_band_of_need(int need)
+{
+	return need <= 0 ? 1 : need <= 10 ? 2 : need <= 20 ? 3 : need <= 35 ? 4 : need <= 50 ? 5 : need <= 80 ? 6 : 7;
+}
+void rtc_turn()
+{
+	if (!comms::rtc_f.ok())
+		return;
+	std::uint32_t want = 0;
+	if (W.alive && (W.me.state & ST_TRIBUTE))
+		for (int i = 0; i < M.na; ++i)
+			if (cheb(M.altars[static_cast<std::size_t>(i)].pos, W.me.pos) <= 1)
+			{
+				const int need = std::max(0, rs::WIN_TRIBUTE - W.tributed_us - static_cast<int>(W.me.gems));
+				want = static_cast<std::uint32_t>(rtc_band_of_need(need)) | (static_cast<std::uint32_t>(i) << 3);
+				break;
+			}
+	const std::uint32_t cur = comms::spare_get(comms::rtc_f);
+	if (want != 0)
+	{
+		// two channellers: the smaller band stays; the other re-writes when it clears
+		if (cur != want && (cur == 0 || rtc_mine || (want & 7u) <= (cur & 7u)))
+			comms::spare_put(comms::rtc_f, want);
+		rtc_mine = comms::spare_get(comms::rtc_f) == want;
+	}
+	else if (rtc_mine)
+	{
+		if (cur != 0)
+			comms::spare_put(comms::rtc_f, 0);
+		rtc_mine = false;
+	}
+	const std::uint32_t v = comms::spare_get(comms::rtc_f);
+	if (v != rtc_v)
+	{
+		rtc_v = v;
+		rtc_since = now();
+		rtc_trib0 = W.tributed_us;
+	}
+}
+// the field's value with the stale guard applied (0: no channel known)
+std::uint32_t rtc_value()
+{
+	if (!comms::rtc_f.ok() || (rtc_v & 7u) == 0)
+		return 0;
+	if (W.tributed_us > rtc_trib0 || now() - rtc_since > rs::tribute_rounds(rs::WIN_TRIBUTE, false) + OLK_TAB[2]) // the longest channel: no Tribute emblem (GR:312)
+		return 0;
+	return rtc_v;
+}
+// OLK reader: a mate's running tribute named by RTC stands at altar
+bool olk_blocks(vec2 altar)
+{
+	const std::uint32_t v = rtc_mine ? 0 : rtc_value();
+	if (v == 0)
+		return false;
+	const std::uint32_t ai = v >> 3;
+	return ai < static_cast<std::uint32_t>(M.na) && M.altars[static_cast<std::size_t>(ai)].pos == altar;
+}
 } // namespace nova::econ
