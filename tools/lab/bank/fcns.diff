+bool fcn_enough_down(int t)
+{
+	if (!foes_read)
+		return false;
+	int down = 0, cassi = -1, issac = -1;
+	for (std::size_t i = 0; i < foes.size(); ++i)
+	{
+		const auto& f = foes[i];
+		const bool dn = !(f.alive || (f.died + (rs::rules().respawn)) <= t);
+		down += dn ? 1 : 0;
+		if (i < tk_tab.size() && tk_tab[i].type == cambc::champion_type::cassi)
+			cassi = dn ? 1 : 0;
+		if (i < tk_tab.size() && tk_tab[i].type == cambc::champion_type::issac)
+			issac = dn ? 1 : 0;
+	}
+	const bool pair = cassi >= 0 && issac >= 0;
+	const int picks = static_cast<int>(foes.size()) - (pair ? 1 : 0);
+	const int dn = down - (pair && cassi == 1 && issac == 1 ? 1 : 0);
+	return picks >= 5 ? dn >= 2 : dn * 5 >= 2 * picks;
+}
