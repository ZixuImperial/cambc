+// The visible foes' next-turn damage on a body of mine standing at t (two turns for a foe with two before my next; a stunned foe 0).
+static float dny_foe_sum(vec2 t)
+{
+	float s = 0.0f;
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, t);
+		if (d > 9)
+			continue;
+		float h = burst::lethal_burst_hit(e, d, 0, nullptr);
+		h = burst::stun_takes_next_turn(e) ? 0.0f : burst::reach_burst_turns(e) >= 2 ? burst::lethal_burst_two_turn_hit(e, d, h) : h;
+		s += std::max(0.0f, h);
+	}
+	return s;
+}
+// A foe that can hit a body at p or q still acts this round (before the camp phase): the worst rank for the unseen foes.
+static bool dny_foe_before_camp(vec2 p, vec2 q)
+{
+	const auto r = burst::turn_order_ranks();
+	const int miss = std::max(0, P.n - static_cast<int>(W.enemies.size()));
+	for (std::size_t x = 0; x < W.enemies.size(); ++x)
+	{
+		const Body& e = W.enemies[x];
+		const int d = std::min(cheb(e.pos, p), cheb(e.pos, q));
+		if (d > 9 || burst::lethal_burst_hit(e, d, 0, nullptr) <= 0.0f)
+			continue;
+		if (x >= r.m)
+			return true;
+		int rb = 0, rb2 = 0;
+		r.foe_rank(x, rb, rb2);
+		if (r.still_to_act(rb + miss))
+			return true;
+	}
+	return false;
+}
+// The awake attacking camps' hit on me at q at the next camp phase, counting only camps (HP > 2 x my Strength) of which I am strictly the
+// nearest champion (a foe counts 1 closer, 3 with a dash kit; a mate at the same distance or nearer takes it).
+static float dny_camp_kill_at(vec2 q)
+{
+	float s = 0.0f;
+	for (const auto& vc : W.camps)
+	{
+		if (!vc.awake || vc.ci < 0)
+			continue;
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (!c.attacks() || vc.hp <= 2.0f * W.me.str)
+			continue;
+		const int d = cheb(q, c.pos);
+		if (d > c.reach)
+			continue;
+		bool nearest = true;
+		for (const auto& o : W.allies)
+			if (cheb(o.pos, c.pos) <= d)
+				nearest = false;
+		for (const auto* v : { &W.enemies, &W.enemies_far })
+			for (const auto& e : *v)
+				if (cheb(e.pos, c.pos) - ((e.kit && e.kit->slot_dash >= 0) ? 3 : 1) <= d)
+					nearest = false;
+		if (nearest)
+			s += c.str;
+	}
+	return s * mu::ct_k;
+}
+// An awake attacking camp whose reach a step of mine enters (the cheapest test).
+static bool dny_camp_near()
+{
+	for (const auto& vc : W.camps)
+		if (vc.awake && vc.ci >= 0 && M.camps[static_cast<std::size_t>(vc.ci)].attacks() &&
+			cheb(M.camps[static_cast<std::size_t>(vc.ci)].pos, W.me.pos) <= M.camps[static_cast<std::size_t>(vc.ci)].reach + 1)
+			return true;
+	return false;
+}
+// Certain death for body b (mine or my partner): off spawn, not channeling, no ready dash / shield / heal, no other mate within 5 and no
+// mate healer within 8 (skip: slot `skip` and b itself), and the visible foes kill it on its tile and on every free tile one step away.
+static bool dny_doomed(const Body& b, bool me, int skip)
+{
+	if (!b.kit || bbget(M.my_spawn, b.pos) || b.channeling())
+		return false;
+	const Kit& k = *b.kit;
+	auto rdy = [&](int s) { return s >= 0 && (me ? ready(s) : foe_cd(b, s) == 0); };
+	if (rdy(k.slot_dash) || rdy(k.slot_shield) || rdy(k.slot_heal))
+		return false;
+	for (const auto& o : W.allies)
+	{
+		if (o.slot == skip || (!me && o.slot == b.slot))
+			continue;
+		const int d = cheb(o.pos, b.pos);
+		if (d <= 5 || (d <= 8 && o.kit && o.kit->slot_heal >= 0))
+			return false;
+	}
+	const float eff = b.hp + std::max(0.0f, b.shield);
+	if (dny_foe_sum(b.pos) < eff)
+		return false;
+	for (int dy = -1; dy <= 1; ++dy)
+		for (int dx = -1; dx <= 1; ++dx)
+		{
+			const vec2 q{ b.pos.x + dx, b.pos.y + dy };
+			if ((dx || dy) && inb(q) && mv::free_tile(q) && dny_foe_sum(q) < eff)
+				return false;
+		}
+	return true;
+}
+// The step tile (or my tile, stay_ok) where the camps kill me first; x < 0: none. `other`: the partner's tile (else my own).
+static vec2 dny_camp_tile(bool stay_ok, vec2 other)
+{
+	const float eff = W.me.hp + std::max(0.0f, W.me.shield);
+	vec2 best{ -1, -1 };
+	float bs = 0.0f;
+	for (int dy = -1; dy <= 1; ++dy)
+		for (int dx = -1; dx <= 1; ++dx)
+		{
+			const vec2 q{ W.me.pos.x + dx, W.me.pos.y + dy };
+			if (!inb(q) || (!(dx || dy) && !stay_ok) || ((dx || dy) && !mv::free_tile(q)))
+				continue;
+			const float cs = dny_camp_kill_at(q);
+			if (cs >= eff && cs > bs && !dny_foe_before_camp(other, q))
+			{
+				bs = cs;
+				best = q;
+			}
+		}
+	return best;
+}
+bool doomed_die_to_camp()
+{
+	if (!W.alive || !W.me.kit || W.on_spawn || W.me.channeling() || !W.can_move() || W.tributed_us + static_cast<int>(W.me.gems) >= 1000)
+		return false;
+	if (!dny_camp_near() || !dny_doomed(W.me, true, P.my_slot))
+		return false;
+	const vec2 q = dny_camp_tile(false, W.me.pos);
+	return q.x >= 0 && mv::try_move(q);
+}
+bool dny_pair_die()
+{
+	if (!W.alive || W.on_spawn || W.me.channeling() || !W.can_move() || !dny_camp_near())
+		return false;
+	const int ls = linked_slot();
+	const Body* p = ls >= 0 ? W.ally_by_slot(ls) : nullptr;
+	if (!p || W.tributed_us + static_cast<int>(W.me.gems + p->gems) >= 1000 || !dny_doomed(*p, false, P.my_slot))
+		return false;
+	const vec2 q = dny_camp_tile(true, p->pos);
+	if (q.x < 0)
+		return false;
+	return q == W.me.pos ? true : mv::try_move(q);
+}
