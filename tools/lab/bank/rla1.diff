 inline constexpr int LDS_TAB[2] = { 0x4C445331, LDS_BITS }; // slot 0 magic keeps it out of .bss
+// RLA (b2417, Planner; owner 13 Nov "Bottleneck is currently ideas"): the race-lead stance. Race state once a round: ours = tributed_us +
+// our bags (mine + every living mate's, exact engine reads), theirs = tributed_them + the foe bags in my team table not banked since the
+// read (prism::fsb_banked). One landing = the enemy's mean tribute so far (tributed_them / landings seen in prism::track's history), else
+// RLA_TAB[4] before their first landing. Ahead by more than one landing: the fight-entry bar (c.engage, after every bar term) x RLA_TAB[2]
+// / 100 (avoid even fights, bank first); behind by more: x RLA_TAB[3] / 100 (take even fights), except when the known foe bags end
+// the game (theirs >= WIN_TRIBUTE or lbn_foe_end_bag() > 0: the deny case, RC C1371). Runtime data flag, read first; 0 = v907.
+// Bits: 1 both sides, 2 lead side only, 4 trail side only.
+#define RLA_BITS 0
+inline const volatile int RLA_TAB[5] = { 0x524C4131, RLA_BITS, 115, 85, 100 }; // magic, bits, lead x100, trail x100, landing before theirs
+#define RLA_ON(m) ((RLA_TAB[1] & (m)) != 0)
+namespace nova::econ {
+int rla_side(); // b2417 RLA (combat_race_lead.cc; caller read the flag): +1 we lead by more than one landing, -1 we trail, 0 else
