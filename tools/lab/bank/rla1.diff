diff --git b/src/combat_race_lead.cc b/src/combat_race_lead.cc
new file mode 100644
--- /dev/null
+++ b/src/combat_race_lead.cc
@@ -0,0 +1,50 @@
+// b2417 RLA: the race state for the race-lead stance (combat_flags.h). After econ and prism in the unity order: it reads
+// prism::track's per-round enemy tribute history, prism::fsb_banked and the mates' bags.
+namespace nova::econ {
+__attribute__((noinline)) int rla_side()
+{
+	static int r_at = -1, side = 0, scan = 0, lastv = 1, landings = 0;
+	if (W.round == r_at)
+		return side;
+	r_at = W.round;
+	const int top = std::min(W.round, 2047);
+	for (; scan <= top; ++scan) // enemy landings so far: each rise of tributed_them in the history (0 = round not recorded)
+	{
+		const int v = static_cast<int>(nova::prism::fsb_them[scan]);
+		if (v == 0)
+			continue;
+		if (v > lastv)
+			++landings;
+		lastv = v;
+	}
+	int us = W.tributed_us + static_cast<int>(W.me.gems);
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == my_slot() || !siege_ally_alive(s))
+			continue;
+		std::uint32_t g = 0;
+		if (cambc::detail::sdk_champion_gems(P.handle[static_cast<std::size_t>(s)], &g) == 0)
+			us += static_cast<int>(g);
+	}
+	int them = W.tributed_them;
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		if (!tt[i].alive || tt[i].round <= -1000)
+			continue;
+		const Body* b = intel::team_body(i);
+		if (b && b->gems > 0 && !nova::prism::fsb_banked(static_cast<int>(b->gems), intel::team_body_round(i)))
+			them += static_cast<int>(b->gems);
+	}
+	const int land = landings > 0 ? W.tributed_them / landings : RLA_TAB[4];
+	side = 0;
+	if (land > 0)
+	{
+		if (us - them > land)
+			side = 1;
+		else if (them - us > land && them < rs::WIN_TRIBUTE && nova::combat::lbn_foe_end_bag() == 0) // RC C1371: not when their known bags end it (the deny case)
+			side = -1;
+	}
+	return side;
+}
+} // namespace nova::econ
