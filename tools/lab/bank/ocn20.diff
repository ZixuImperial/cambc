 // b2390 ODM1 (econ_flags.h; the callers read the flag): the draft loop's non-self sim rows, by sim position.
+// b2443 OCN bit 1 (callers read the flag): the largest d_home among this body's opening candidates, and the closeness bonus.
+int ocn_D = 0;
+__attribute__((noinline)) void ocn_prep()
+{
+	ocn_D = 0;
+	const float top = 1.0f + static_cast<float>(OCN_TAB[2]) / 100.0f;
+	for (auto& c : OP.cand)
+	{
+		if (c.second >= 0 && c.second < M.ng)
+		{
+			const int d = static_cast<int>(M.groups[static_cast<std::size_t>(c.second)].d_home);
+			if (d != UNREACH)
+				ocn_D = std::max(ocn_D, d);
+		}
+		c.first *= top;
+	}
+}
+__attribute__((noinline)) float ocn_mul(int gi)
+{
+	if (ocn_D <= 0 || gi < 0 || gi >= M.ng)
+		return 1.0f;
+	const int d = static_cast<int>(M.groups[static_cast<std::size_t>(gi)].d_home);
+	const float x = static_cast<float>(std::min(d == UNREACH ? ocn_D : d, ocn_D)) / static_cast<float>(ocn_D);
+	return 1.0f + static_cast<float>(OCN_TAB[2]) / 100.0f * (1.0f - x);
+}
