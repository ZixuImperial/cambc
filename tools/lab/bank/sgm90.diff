+// v8xx SGM bit 1 (callers read the flag): an own-half group (contest <= .40) with no foe seen or reported within 15 in 20 rounds takes
+// a looser margin: the call SGM_CALL / 100 (start = false), the start SG_MARGIN raised by the same step (start = true, RC C965).
+__attribute__((noinline)) void sgmc_fc_1() { __asm__ volatile(""); }
+__attribute__((noinline)) void sgmc_fc_2() { __asm__ volatile(""); }
+__attribute__((noinline)) void sgmc_fc_3() { __asm__ volatile(""); }
+__attribute__((noinline)) bool sgmc_quiet_margin(const GroupI& g, const ClearEst& e, bool start)
+{
+	const float call = static_cast<float>(SGM_TAB[2]) / 100.0f;
+	const float m = start ? SG_MARGIN + (call - SG_MARGIN_CALL) : call;
+	if (g.contest > 0.40f || e.dmg > m * e.budget || intel::danger(g.anchor, 15, 20) >= 0.5f)
+		return false;
+	if (start)
+		sgmc_fc_3();
+	else
+		sgmc_fc_1();
+	return true;
+}
