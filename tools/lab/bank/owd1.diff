 namespace {
 // an init landing also needs an engine-legal dash middle and no NO_WAKE veto.
+// v7xx OWD1 (owner replay 01a1cd24 r152): a landing whose walk home (UNREACH = far) is OWD_STEPS or more longer than mine
+// is a one-way engage. The walk field: M.f_home_cb (camps blocked) when the map stages built it (skipped when distances come from draft
+// memory), else the move layer's camps-blocked home field, else M.f_home; never a Chebyshev estimate (it reads across holes).
+static bool owd_one_way(vec2 t)
+{
+	const distance_field* hf = M.has_home_cb ? &M.f_home_cb : mv::home_field_cb();
+	if (!hf && M.has_home)
+		hf = &M.f_home;
+	if (!hf)
+		return false;
+	const int ht = static_cast<int>(dfget(*hf, t));
+	const int hm = static_cast<int>(dfget(*hf, W.me.pos));
+	return ht - hm >= OWD_STEPS;
+}
 bool init_dash_landing_bad(vec2 t)
 {
 	if (cheb(t, W.me.pos) == 2 && !dash_middle_tile_ok(W.me.pos, t))
 		return true;
+	if (OWD_ON(1) && owd_one_way(t))
+		return true;
 	return static_cast<bool>(camps::wakes_other_group(t, 1, t, -1, 0.0f));
 }
 static bool dash_middle_ok(vec2 a, vec2 b)
 {
 	return dash_legal_between(a, b);
 }
