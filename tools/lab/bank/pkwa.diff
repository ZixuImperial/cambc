+// b1761 PKW: a slot's per-kit gold weight K x100 (100 when out of range).
+static int pkw_k(int slot)
+{
+	if (slot < 0 || slot >= P.n)
+		return 100;
+	const int t = static_cast<int>(P.type[static_cast<std::size_t>(slot)]);
+	if (t == static_cast<int>(cambc::champion_type::prism) && PKW_TAB[16] > 0) // her Health shards past the threshold: the after value
+	{
+		const Body* b = slot == P.my_slot ? &W.me : W.ally_by_slot(slot);
+		if (b && b->kit && b->kit->valid && b->kit->hp_g > 0 && (b->maxhp - b->kit->hp) / b->kit->hp_g >= static_cast<float>(PKW_TAB[16]))
+			return PKW_TAB[17];
+	}
+	return (t >= 0 && t < 13) ? PKW_TAB[3 + t] : 100;
+}
