 // True when no foe was seen within CU_HOLD_D (6) in the last CU_HOLD_AGE (2) rounds: camp spells are free (no spell hold).
 // Prism skips it (her spell-free rule). CU_WALK / CU_HOLD are not read.
+// v7xx PBH (pb2f) trigger F (spec_pdh_1110, owner replay 01a1c7cc): a foe in `seen` within PDH-age 8 rounds, last seen within 8 tiles,
+// not recalling, whose remembered one-turn burst on me reaches the lethal-burst cap (lb_cap).
+static bool pdh_one_shot_seen()
+{
+	const float cap = eff_hp(W.me) * static_cast<float>(LETHAL_BURST_TAB[2]) / 100.0f;
+	for (const auto& s : seen)
+		if (W.round - s.round <= 8 && !s.rec && cheb(s.foe.pos, W.me.pos) <= 8 && s.foe.burst >= cap)
+			return true;
+	return false;
+}
 bool cast_uptime_walk_in_free()
 {
+	if (PBH_ON(1) && W.me.kit && prism_layer::fight_skip_cu() && !pdh_one_shot_seen()) // v7xx PBH: her old hold stays while a one-shot foe is near (trigger F)
+		return nearest_foe_distance_seen(CAST_UPTIME_TAB[4]) > PBH_TAB[2]; // v7xx PBH bit 1 (PB2): her hold is the other kits' test
 	if (!W.me.kit || prism_layer::fight_skip_cu())
 		return false;
 	return nearest_foe_distance_seen(CAST_UPTIME_TAB[4]) > CAST_UPTIME_TAB[3];
 }
