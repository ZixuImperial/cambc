+// b1761 PZF bit 1: the Prism body pb is safe enough to stop weighting gold: eff_hp >= PZF_K/100 x the largest known single-turn foe burst.
+// Once a round per body.
+bool pzf_done(const Body& pb)
+{
+	static int r = -1000;
+	static float worst = 0.0f;
+	if (r != now())
+	{
+		r = now();
+		worst = 0.0f;
+		for (const auto& e : W.enemies)
+		{
+			bool c = false;
+			worst = std::max(worst, nova::combat::burst::lethal_burst_hit(e, 0, 0, &c));
+		}
+		for (const auto& s : nova::combat::seen)
+			if (now() - s.round <= 30)
+				worst = std::max(worst, s.foe.burst);
+		if (worst > 0.0f) // unseen foes at their draft kit's base burst as the floor (once a game)
+		{
+			static float base_floor = -1.0f;
+			if (base_floor < 0.0f)
+			{
+				base_floor = 0.0f;
+				for (const auto& re : roster(cambc::team::enemy))
+				{
+					const Kit& k = kit_of(re.type);
+					if (!k.valid)
+						continue;
+					Body mb{};
+					mb.kit = &k;
+					mb.type = re.type;
+					mb.maxhp = mb.hp = k.hp;
+					mb.str = k.str;
+					mb.foc = k.foc;
+					mb.range = k.range;
+					bool c = false;
+					base_floor = std::max(base_floor, nova::combat::burst::lethal_burst_hit(mb, 0, 0, &c));
+				}
+			}
+			worst = std::max(worst, base_floor);
+		}
+	}
+	if (worst <= 0.0f)
+		return false; // no foe known: not yet safe (keep weighting gold)
+	return nova::combat::eff_hp(pb) >= static_cast<float>(PZF_TAB[2]) / 100.0f * worst;
+}
