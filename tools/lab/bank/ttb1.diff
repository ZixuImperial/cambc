+namespace {
+constexpr int TTB_LO3[8] = { 0, 1, 20, 40, 60, 90, 120, 160 };
+constexpr int TTB_LO2[4] = { 0, 1, 40, 90 };
+constexpr int TTB_LO1[2] = { 0, 40 };
+const int* ttb_lo() { return ttb_w == 3 ? TTB_LO3 : (ttb_w == 2 ? TTB_LO2 : TTB_LO1); }
+} // namespace
+void ttb_alloc(int n, int carrier)
+{
+	ttb_w = 0;
+	if (n <= 1 || n > 8)
+		return;
+	const int m = n - ((carrier >= 0 && carrier < n) ? 1 : 0); // every slot but the gem carrier's
+	const int b = spare_bits();
+	const int w = b >= 3 * m ? 3 : (b >= 2 * m ? 2 : (b >= m ? 1 : 0));
+	if (w == 0)
+		return; // absent: the reader keeps the remembered bag
+	ttb_w = w;
+	for (int s = 0; s < n; ++s)
+		if (s != carrier)
+			ttb_f[s] = spare_alloc(w);
+}
+void ttb_write(int slot, bool alive, int gems)
+{
+	if (slot < 0 || slot >= 8 || !ttb_f[slot].ok())
+		return;
+	const int* lo = ttb_lo();
+	const int nb = 1 << ttb_w;
+	int b = 0;
+	if (alive)
+		while (b + 1 < nb && gems >= lo[b + 1])
+			++b;
+	spare_put(ttb_f[slot], static_cast<std::uint32_t>(b)); // writes only on a change
+}
+int ttb_lower(int slot)
+{
+	if (slot < 0 || slot >= 8 || !ttb_f[slot].ok())
+		return -1;
+	return ttb_lo()[spare_get(ttb_f[slot]) & ((1u << ttb_w) - 1u)];
+}
 
