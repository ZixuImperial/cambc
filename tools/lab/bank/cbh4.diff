+// CBH 4 RFE1 (callers read the flag): the round a foe seen recalling can land at the earliest (now + ticks left + 1: it may act after me
+// this round). A recaller whose tile empties before that cancelled (by hand, damage or stun) and walked off: it is still near.
+static std::uint32_t cbh_rfe_h[16] = { 0 };
+static int cbh_rfe_land[16] = { 0 };
+static void cbh_rfe_note(std::uint32_t h, int now)
+{
+	std::int32_t left = 0;
+	if (cambc::detail::sdk_champion_channel_time(h, &left) != 0 || left < 0)
+		left = 0;
+	int slot = -1;
+	for (int i = 0; i < 16 && slot < 0; ++i)
+		if (cbh_rfe_h[i] == h)
+			slot = i;
+	for (int i = 0; i < 16 && slot < 0; ++i)
+		if (cbh_rfe_h[i] == 0 || cbh_rfe_land[i] < now - 20)
+			slot = i;
+	if (slot < 0)
+		slot = static_cast<int>(h % 16u);
+	cbh_rfe_h[slot] = h;
+	cbh_rfe_land[slot] = now + static_cast<int>(left) + 1;
+}
+static __attribute__((noinline)) int cbh_rfe_land_of(std::uint32_t h)
+{
+	for (int i = 0; i < 16; ++i)
+		if (cbh_rfe_h[i] == h)
+			return cbh_rfe_land[i];
+	return -1000;
+}
+static __attribute__((noinline)) void cbh_rfe_forget(int now)
+{
+	auto gone = [&](const Seen& s) { return s.rec && s.round < now && now >= cbh_rfe_land_of(s.h) && bbget(W.vis, s.foe.pos) && !bbget(W.occ_units, s.foe.pos); };
+	bool any = false;
+	for (const auto& s : seen)
+		any |= gone(s);
+	if (any)
+		seen.erase(std::remove_if(seen.begin(), seen.end(), gone), seen.end());
+}
 // a recaller whose last tile I see empty has gone home.
 static __attribute__((always_inline)) inline void observe_forget_recalled(int now)
 {
+	if (CBH_ON(4))
