diff --git b/src/feat_rck.cpp b/src/feat_rck.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_rck.cpp
@@ -0,0 +1,279 @@
+#ifdef NOVA_UNITY_ALL // unity build: compiled only through nova_all.cpp
+// feat_rck.cpp (RCK, b1583): see feat_rck.h. Unity build: combat.cpp comes first, so its helpers are in scope. Every function is
+// reached only when its bit is on at the hook.
+#include "feat_rck.h"
+namespace nova::combat::cast
+{
+// hkl_cast_kill's test (a copy, so that one keeps its single caller and its inlining at flag 0): f dies to my burst this turn,
+// and not to the basic hit alone, so the burst needs the turn's one cast.
+static bool rck_kill_needs_cast(const Body& f, int d)
+{
+	return burst::kills(f, d, KQ_RAW) && !burst::kills(f, d, KQ_STEP) && burst::dash_kill_reachable(f, d);
+}
+} // namespace nova::combat::cast
+namespace nova::feat::rck
+{
+namespace
+{
+namespace st = nova::combat::stance;
+using nova::combat::eff_hp;
+// A visible foe's ready, uncast self-shield in eff HP units (add_friend's own term); 0 without FSH.
+float foe_shield(const nova::combat::Foe& f)
+{
+	if (!RCK_ON(RCK_BIT_FSH) || f.idx < 0 || f.remembered)
+		return 0.0f;
+	const Body& e = st::as_enemy(f.idx);
+	if (!e.kit || !e.kit->valid)
+		return 0.0f;
+	const Kit& k = *e.kit;
+	if (k.slot_shield < 0 || e.shield > 0 || !nova::combat::kit_rules::slot_ready(e, k.slot_shield))
+		return 0.0f;
+	return mu::mfx_shield(e, k.shield_mod * e.foc);
+}
+// The foe Cassi and Issac (indices into a.foes), both visible and in the fight; -1 when not both.
+void foe_pair(const nova::combat::Assessment& a, vec2 me, int& ic, int& ii)
+{
+	ic = ii = -1;
+	if (!RCK_ON(RCK_BIT_CIF))
+		return;
+	for (std::size_t i = 0; i < a.foes.size(); ++i)
+	{
+		const auto& f = a.foes[i];
+		if (f.idx < 0 || f.remembered || cheb(f.pos, me) > st::tune::FIGHT_R)
+			continue;
+		const auto t = st::as_enemy(f.idx).type;
+		if (ci_layer::cassi(t))
+			ic = static_cast<int>(i);
+		else if (ci_layer::issac(t))
+			ii = static_cast<int>(i);
+	}
+	if (ic < 0 || ii < 0)
+		ic = ii = -1;
+}
+} // namespace
+bool stun_yields(const Body& stb, const Body& f, int d)
+{
+	const Kit& k = *W.me.kit;
+	if (k.cc_mod > 0 || (stb.state & ST_TRIBUTE) != 0)
+		return false;
+	const bool y = nova::combat::cast::rck_kill_needs_cast(f, d);
+	RCK_CNT(csk, y);
+	return y;
+}
+bool heal_yields(const Body& f, int d)
+{
+	const Kit& k = *W.me.kit;
+	if (k.slot_heal < 0 || !nova::combat::ready(k.slot_heal)) // no heal to hold
+		return false;
+	const bool y = nova::combat::cast::rck_kill_needs_cast(f, d);
+	RCK_CNT(whk, y);
+	return y;
+}
+bool dar_cast(const std::vector<nova::mv::Threat>& zs, vec2 me, int r, int now, vec2 best)
+{
+	namespace g = nova::combat::geom;
+	const int slot = W.me.kit->slot_dash;
+	if (nova::combat::cast_at(slot, best))
+		return true;
+	std::array<vec2, 2> ex{ best, vec2{ -1, -1 } };
+	for (int n = 1; n <= 2 && nova::combat::ready(slot); ++n) // the next landing, at most 3 in all (Q51: a refused cast keeps the slot)
+	{
+		vec2 b{ -1, -1 };
+		int best_s = now * g::tune::DASH_DANGER_WEIGHT + mv::home_steps(me);
+		for (int dx = -r; dx <= r; ++dx)
+			for (int dy = -r; dy <= r; ++dy)
+			{
+				const vec2 t{ me.x + dx, me.y + dy };
+				if (t == me || t == ex[0] || t == ex[1] || !mv::free_tile(t))
+					continue;
+				const int hs = mv::home_steps(t);
+				if (!g::dash_beats(zs, t, hs, best_s) || !g::dash_path_ok(me, t))
+					continue;
+				best_s = g::dash_danger(zs, t) * g::tune::DASH_DANGER_WEIGHT + hs;
+				b = t;
+			}
+		if (b.x < 0 || g::dash_danger(zs, b) >= now)
+			return false;
+		RCK_CNT(dar, true);
+		if (nova::combat::cast_at(slot, b))
+			return true;
+		if (n == 1)
+			ex[1] = b;
+	}
+	return false;
+}
+int camp_steps_out(vec2 p)
+{
+	int o = 0;
+	for (const auto& c : nova::econ::fb_awake())
+		if (const int d = cheb(p, c.pos); d <= c.reach)
+			o = std::max(o, c.reach - d + 1);
+	return o;
+}
+bool trib_camp_bad(vec2 me, int gems)
+{
+	const float inc = nova::econ::incoming_at(me, nullptr);
+	if (inc <= 0.0f)
+		return false;
+	const int ticks = rs::tribute_turns(gems, prism::has_family(rs::F_TRIBUTE));
+	const bool bad = inc * static_cast<float>(ticks + std::max(0, camp_steps_out(me) - 1)) >= 0.5f * W.me.hp;
+	RCK_CNT(tcc, bad);
+	return bad;
+}
+bool hd_land_bad(vec2 L, int ch)
+{
+	if (ch > 0 && W.me.frac() < 0.6f) // di_ok's own-HP bar for a dash onto champions
+	{
+		RCK_CNT(hdg, true);
+		return true;
+	}
+	const float thr = mv::camp_threat(L);
+	if (thr <= 0.0f)
+		return false;
+	const bool bad = W.me.hp <= thr * static_cast<float>(std::max(0, camp_steps_out(L) - 1)); // the walk out once the stun ends
+	RCK_CNT(hdg, bad);
+	return bad;
+}
+bool ftd_in2(const std::vector<nova::mv::Threat>& zones, std::size_t nf)
+{
+	for (std::size_t i = 0; i < zones.size() && i < nf; ++i)
+		if (zones[i].reach >= 0 && cheb(W.me.pos, zones[i].pos) <= zones[i].reach)
+		{
+			RCK_CNT(ftd, true);
+			return true;
+		}
+	return false;
+}
+template <class F> bool lwd_scan(F& consider, vec2& out, vec2& step)
+{
+	const vec2 me = W.me.pos;
+	const int r = std::max(1, static_cast<int>(W.me.kit->dash_range));
+	auto land_of = [&](vec2 t)
+	{
+		for (const vec2 dd : DIRS)
+		{
+			const vec2 l = t + dd;
+			const int c = cheb(l, me);
+			if (c >= 1 && c <= r && mv::free_tile(l) && (c != 2 || nova::combat::geom::hd_mid_ok(me, l)) && !mv::foe_guarded(l))
+				return l;
+		}
+		return vec2{ -1, -1 };
+	};
+	const int rr = r + 1;
+	for (int dx = -rr; dx <= rr; ++dx)
+		for (int dy = -rr; dy <= rr; ++dy)
+		{
+			const vec2 t{ me.x + dx, me.y + dy };
+			if (std::max(std::abs(dx), std::abs(dy)) == rr && inb(t) && mv::free_tile(t) && land_of(t).x >= 0)
+				consider(t);
+		}
+	if (out.x < 0)
+		return false;
+	RCK_CNT(lwd, true);
+	step = out;
+	out = land_of(out);
+	return true;
+}
+} // namespace nova::feat::rck
+namespace nova::combat::stance
+{
+template <class C> void rck_assess(C& c)
+{
+	namespace r = nova::feat::rck;
+	Assessment& a = c.a;
+	int ic, ii;
+	r::foe_pair(a, c.me, ic, ii);
+	float e_h = 0;
+	for (std::size_t i = 0; i < a.foes.size(); ++i)
+	{
+		const auto& f = a.foes[i];
+		const int d = cheb(f.pos, c.me);
+		if (d > tune::FIGHT_R)
+			continue;
+		const float sh = r::foe_shield(f);
+		const bool pc = static_cast<int>(i) == ic || static_cast<int>(i) == ii;
+		if (!pc)
+			e_h += std::max(1.0f, f.ehp + sh);
+		if (sh <= 0.0f && !pc)
+			continue;
+		const float fw = as_foe_weight(a, f, d);
+		const bool near = as_soon_in_reach(f, d);
+		const float v0 = fw * as_power(f.ehp, f.dps), v0_fc = fw * as_power(f.ehp, f.dps_fc); // the term as_sum_foes added
+		float v1 = 0.0f, v1_fc = 0.0f;
+		if (!pc)
+		{
+			v1 = fw * as_power(f.ehp + sh, f.dps);
+			v1_fc = fw * as_power(f.ehp + sh, f.dps_fc);
+			RCK_CNT(fsh, true);
+		}
+		else if (static_cast<int>(i) == ic) // the pair's one term goes in at Cassi's index
+		{
+			const auto& g = a.foes[static_cast<std::size_t>(ii)];
+			const int dg = cheb(g.pos, c.me);
+			const float fwp = 0.5f * (fw + as_foe_weight(a, g, dg));
+			const float hp = std::min(f.ehp + sh, g.ehp + r::foe_shield(g));
+			v1 = fwp * as_power(hp, f.dps + g.dps);
+			v1_fc = fwp * as_power(hp, f.dps_fc + g.dps_fc);
+			e_h += std::max(1.0f, hp);
+			RCK_CNT(cif, true);
+			if (!near && as_soon_in_reach(g, dg)) // the pair joins soon if either does
+				c.e_near += v1;
+		}
+		c.e_sq += v1 - v0;
+		c.e_sq_fc += v1_fc - v0_fc;
+		if (near)
+			c.e_near += v1 - v0;
+	}
+	if (RCK_ON(RCK_BIT_CIO)) // our pair: the same terms as_sum_me / as_sum_allies added, folded into one body
+	{
+		float w2[2] = { 0, 0 }, h2[2] = { 0, 0 }, d2[2] = { 0, 0 };
+		bool got[2] = { false, false };
+		if (ci_layer::type(W.me.type))
+		{
+			const int j = ci_layer::cassi(W.me.type) ? 0 : 1;
+			mates::add_friend(W.me, h2[j], d2[j]);
+			mates::ofs_d(OFS_BIT_ASSESS, W.me, true, c.oe, d2[j], 1.0f);
+			h2[j] = as_drained(h2[j], mu::mfx_camp(mv::camp_threat(c.me)));
+			w2[j] = 1.0f;
+			got[j] = true;
+		}
+		for (const auto& al : W.allies)
+		{
+			if (!ci_layer::type(al.type) || al.channeling() || cheb(al.pos, c.me) > c.join_r)
+				continue;
+			const int j = ci_layer::cassi(al.type) ? 0 : 1;
+			if (got[j])
+				continue;
+			mates::add_friend(al, h2[j], d2[j]);
+			const float ch = mu::mfx_mate(al, mates::en_camp_hits(al, true));
+			if (ch > 0)
+				h2[j] = as_drained(h2[j], ch);
+			w2[j] = mates::ally_commit(al, a);
+			mates::ofs_d(OFS_BIT_ASSESS, al, false, c.oe, d2[j], w2[j]);
+			got[j] = true;
+		}
+		if (got[0] && got[1])
+		{
+			RCK_CNT(cio, true);
+			const float wp = 0.5f * (w2[0] + w2[1]);
+			const float hp = std::min(h2[0], h2[1]);
+			c.f_sq += wp * as_power(hp, d2[0] + d2[1]) - w2[0] * as_power(h2[0], d2[0]) - w2[1] * as_power(h2[1], d2[1]);
+			c.f_h += wp * std::max(1.0f, hp) - w2[0] * std::max(1.0f, h2[0]) - w2[1] * std::max(1.0f, h2[1]);
+		}
+	}
+	// as_ratios again on the recounted sums (its own lines, e_h as recounted above)
+	float hp_us = support_heal_pool(c.me, tune::HEAL_HORIZON);
+	if (!(c.f_h > c.me_h) && W.me.kit && W.me.kit->slot_heal >= 0)
+		hp_us -= dmg::heal_of(W.me, W.cd[static_cast<std::size_t>(W.me.kit->slot_heal)], c.me, tune::HEAL_HORIZON);
+	hp_us = std::max(0.0f, hp_us);
+	const float hp_them = dmg::foe_heal_on_others(c.me, tune::HEAL_HORIZON, a);
+	const float heal_us = 1.0f + (hp_us) / std::max(1.0f, c.f_h);
+	const float heal_them = 1.0f + (hp_them) / std::max(1.0f, e_h);
+	const float f_sq = c.f_sq;
+	auto balance = [&](float e) { return (f_sq * f_sq) * heal_us / std::max(1.0f, e * e * heal_them); };
+	a.ratio = balance(c.e_sq);
+	a.ratio_near = balance(c.e_near);
+	a.ratio_fc = balance(c.e_sq_fc);
+}
+} // namespace nova::combat::stance
+#endif
