+#pragma once
+// feat_rck (RCK, b1583): the Rule Checker's open combat rule errors (docs/bot_errors.md, Rule Checker rows), one bit each.
+// Runtime data flag RCK_TAB[1], read first at every hook; 0 = nova_base_v613 and no work.
+//   1 CIF: a foe Cassi & Issac pair counts as ONE body in assess (GameRules.md:434, :442: if either dies both die): the weaker eff
+//          HP with both damages, in place of two independent terms (as_sum_foes e_sq / e_near / e_sq_fc, as_ratios e_h).
+//   2 CIO: our own C&I pair the same way (as_sum_me / as_sum_allies f_sq, f_h): the two sides stay alike.
+//   4 FSH: a visible foe's ready, uncast self-shield adds to its eff HP in assess, as add_friend adds ours (GameRules.md:794, :820).
+//   8 CSK: a zero-damage stun (Cassi) waits when this turn's kill of the focus needs the turn's one cast (GameRules.md:430;
+//          fight_stun), unless it stops a tribute.
+//  16 WHK: a heal (Willow) waits when this turn's kill of the focus needs the turn's one cast (GameRules.md:430; fight).
+//  32 TCC (Econ, 00anvil 01a1b8e8-3cf9 r1004): every kit prices awake-camp damage over the tribute channel AND the walk out of reach
+//         after it (Prism's PC_CHAN test, all kits): bank's gate tries the CHAN_CAMP step / leave, else refuses; the bank-step returns.
+//  64 HDG (Combat/Econ, 00anvil r995, r671): Heart's camp/foe landing (hd_try_cast_best) needs >= 60% HP onto champions (di_ok's
+//         bar) and HP above the camp threat at the landing x (steps out of reach - 1), the walk out once the landing's stun ends.
+// The restored BH81 bits 16 FTD, 32 LWD, 64 DAR, 512 BGK (Rule Checker flee_cb15 #5, #6, #7, #10; code from nova_bh81_all) read
+// BH81_TAB through BH81X_ON. The flag-off ports of SIM bit 8 read SIM_ON (combat.h).
+#include "common.h"
+#include "world.h"
+#include <vector>
+#define RCK_BITS 0
+inline const volatile int RCK_TAB[2] = { 0x52434B31, RCK_BITS }; // slot 0 magic keeps it out of .bss
+#define RCK_ON(b) ((RCK_TAB[1] & (b)) != 0)
+constexpr int RCK_BIT_CIF = 1, RCK_BIT_CIO = 2, RCK_BIT_FSH = 4, RCK_BIT_CSK = 8, RCK_BIT_WHK = 16, RCK_BIT_TCC = 32, RCK_BIT_HDG = 64;
+#define RCK_CNT(k, c) ((void)0) // fire count: the diag copy records site k when c; release: nothing, c unevaluated
+#define BH81X_ON(b) ((BH81_TAB[1] & (b)) != 0) // b1583: the restored BH81 bits (16 FTD, 32 LWD, 64 DAR, 512 BGK)
+namespace nova::combat
+{
+struct Assessment;
+}
+namespace nova::mv
+{
+struct Threat;
+}
+namespace nova::combat::stance
+{
+// CIF / CIO / FSH: recount the two sides' sums and the three ratios after as_ratios (C = AssessCtx).
+template <class C> void rck_assess(C& c);
+}
+namespace nova::feat::rck
+{
+// CSK: the stun on st waits for the kill of the focus f at d.
+bool stun_yields(const Body& st, const Body& f, int d);
+// WHK: the heal waits for the kill of the focus f at d.
+bool heal_yields(const Body& f, int d);
+// BH81 DAR: the flee dash to best; a refused landing is retried on the next best (at most 3 in all).
+bool dar_cast(const std::vector<nova::mv::Threat>& zs, vec2 me, int r, int now, vec2 best);
+// TCC / HDG
+bool trib_camp_bad(vec2 me, int gems);
+bool hd_land_bad(vec2 L, int ch);
+// BH81 FTD: a foe zone (two-turn widened) covers me.
+bool ftd_in2(const std::vector<nova::mv::Threat>& zones, std::size_t nf);
+// BH81 LWD: tiles one step past a dash landing; consider(t) on each, true if out was set (out = the landing, step = the tile).
+template <class F> bool lwd_scan(F& consider, vec2& out, vec2& step);
+} // namespace nova::feat::rck
