+// BB8 bit 1: foe e's own turns before the recall lands (INT:20-23: only the foe at my place gets 2 or 0 a gap).
+static int bb8_foe_turns_recall(const Body& e, bool prefired = false)
+{
+	return std::max(1, combat::stance::foe_turns_within_rounds(e, rs::recall_rounds(prism::has_family(rs::F_HOME), prefired) + 1));
+}
