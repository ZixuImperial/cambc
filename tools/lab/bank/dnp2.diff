+// b2418 DNP (Prism Planner, death census pfatal_tab: her deny walk dies .255/g v the foe Prism's .092; caller read DNP_TAB first):
+// a Prism body of ours carrying >= DNP_TAB[2] (bit 1) or DNP_TAB[3] (bit 2) gems is no lock-walker in game_deny.
+static int dnp_bag()
+{
+	return DNP_ON(1) ? DNP_TAB[2] : DNP_TAB[3];
+}
+// my tile p is outside every visible, acting foe's next-turn reach (a channelling foe cannot act)
+static bool dnp_safe(const Assessment& a, vec2 p)
+{
+	for (const auto& f : a.foes)
+	{
+		if (f.idx < 0)
+			continue;
+		if (W.enemies[static_cast<std::size_t>(f.idx)].channeling())
+			continue;
+		if (cheb(f.pos, p) <= f.reach)
+			return false;
+	}
+	return true;
+}
+// DNP: a rich Prism denies only by cast from range: s0 (1.5 x Focus + a one-round stun, range 4, GR:566-570; a stun stops the channel,
+// GR:275) from a tile outside every visible foe's next-turn reach, or a kill (2.5 x Focus >= the channeller's HP + shield: s0 then s1).
+// No lock walk, no deny hold, no follow / memory walk; else the deny is left to the others (game_deny_mates_ahead skips her).
+static __attribute__((noinline)) bool dnp_deny(const Assessment& a)
+{
+	bool ending = false;
+	const Body* t = game_deny_pick(ending);
+	if (!t || !W.me.kit)
+		return false;
+	const Body tgt = *t;
+	const bool stunnable = !marcella_layer::fight_stun_wasted(tgt);
+	const bool kill = 2.5f * W.me.foc * mu::pair(W.me, tgt) >= eff_hp(tgt); // s0 1.5F + s1 1F over two turns (RC C1398: eff_hp, mu::pair)
+	const int d = cheb(tgt.pos, W.me.pos);
+	const int rng = static_cast<int>(W.me.kit->cc_range);
+	bool acted = false;
+	if (!W.cast && d <= rng && (kill || (stunnable && dnp_safe(a, W.me.pos))))
+	{
+		if (stunnable)
+			acted = game_deny_stun_channeler(tgt);
+		else if (ready(0))
+			acted = cast_on_champion(0, tgt);
+		else if (kill && ready(1))
+			acted = cast_at(1, tgt.pos);
+	}
+	if (!acted && !W.cast && stunnable && W.can_move() && ready(0))
+	{
+		// one step to a safe tile in s0 range; s0 excludes walking, so the cast is next turn
+		for (int dx = -1; dx <= 1 && !acted; ++dx)
+			for (int dy = -1; dy <= 1 && !acted; ++dy)
+			{
+				const vec2 L{ W.me.pos.x + dx, W.me.pos.y + dy };
+				if (L == W.me.pos || !inb(L) || !mv::free_tile(L) || cheb(L, tgt.pos) > rng || !dnp_safe(a, L))
+					continue;
+				if (d <= rng && dnp_safe(a, W.me.pos))
+					continue; // already in place: wait for the cooldown elsewhere
+				acted = mv::step_to(L, 0, 4);
+			}
+	}
+	if (acted && !W.attacked)
+		game_deny_hit_after();
+	return acted;
+}
