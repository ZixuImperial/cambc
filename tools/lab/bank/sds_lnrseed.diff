+bool in_sim();    // the draft's opening pass is running (opening_pick's S hooks)
+} // namespace nova::feat::sds
+namespace nova::feat::lnr
+{
+void sds_pick(int* gi, int* crew, float* r); // the sim body's pick: argmax S over its rated candidates
+} // namespace nova::feat::lnr
