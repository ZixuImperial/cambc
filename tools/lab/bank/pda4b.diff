+// PDA: a foe Prism with a bigger remembered bag (not banked since) whose one-shot plus one basic from her nearest mate is at least my
+// effective HP (see econ_flags.h). Its age, -1 with none.
+int pda_foe(vec2* pos)
+{
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		const Body* b = intel::team_body(i);
+		if (!tt[i].alive || !b || !b->kit || !b->kit->gem_focus)
+			continue;
+		const int age = now() - tt[i].round;
+		if (age > PDA_TAB[3] || static_cast<int>(b->gems) <= static_cast<int>(W.me.gems) + PDA_TAB[2])
+			continue;
+		if (prism::pda_banked(static_cast<int>(b->gems), intel::team_body_round(i)))
+			continue; // her bag went in
+		float hit = 1.5f * b->foc * combat::kit_rules::passive_mult(*b);
+		float mate = 0.0f;
+		for (std::size_t j = 0; j < tt.size(); ++j)
+		{
+			const Body* m = intel::team_body(j);
+			if (j != i && tt[j].alive && m && now() - tt[j].round <= PDA_TAB[3] && cheb(tt[j].pos, tt[i].pos) <= 4)
+				mate = std::max(mate, m->str * combat::kit_rules::passive_mult(*m));
+		}
+		hit += mate;
+		if (hit < mu::ehp(W.me))
+			continue;
+		*pos = tt[i].pos;
+		return age;
+	}
+	return -1;
+}
