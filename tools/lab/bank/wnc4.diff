+	const Body& fo = assess_enemy(a.focus);
+	if (cheb(fo.pos, c.me) <= W.me.range || wnc_full.r_fc >= c.engage || wnc_full.r * 100.0f >= static_cast<float>(B467_INREACH_X100))
+		return false;
+	if (WNC_ON(1))
+		return true;
+	if (WNC_ON(2))
+		for (const int q : memory::awake_slots())
+			if (cheb(M.camps[static_cast<std::size_t>(W.camps[static_cast<std::size_t>(q)].ci)].pos, fo.pos) <= tune::CAMP_BUSY_R)
+				return true;
+	if (WNC_ON(4))
+	{
+		bool al6 = false;
+		for (const auto& al : W.allies)
+			al6 = al6 || cheb(al.pos, c.me) <= 6;
+		if (!al6)
+			return true;
+	}
+	return false;
+}
