+// WNC (b1931): a 'stronger' start on a focus beyond my range that passes only on the far-foe discount and whose full-weight ratio is below
+// the in-reach bar (the arrival test) is refused. Bit 1 always; bit 2 with the focus beside an awake camp; bit 4 with no ally within 6.
+static __attribute__((noinline)) bool wnc_refuse_start(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	if (a.focus < 0)
