 #ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
 // feat_gdb.cpp (GDB, b1542): see feat_gdb.h. Reached only when GDB_ON(...) is true at the hook (combat.cpp game_deny_slow).
 #include "feat_gdb.h"
 namespace nova::feat::gdb
 {
 namespace dn = ::nova::combat::deny;
+// firecount markers (entered only when the branch changes a decision)
+static bool big_yes() { return true; } // PICK_BIG: a big channel is a pick candidate
+static bool cs_yes() { return true; }  // CHANNEL_STUN: an area / landing stun reaches a foe tribute
+static bool cs_done() { return true; } // CHANNEL_STUN: fight's stun went out
+bool big_ok(const Body& e, int g, bool wdb, const Body* t)
+{
+	if (wdb || g < GDB_BAG || (t && !tbig))
+		return false; // a ward-read bag, a small one, or an end / flip pick already
+	std::int32_t left = -1;
+	if (cambc::detail::sdk_champion_channel_time(e.h, &left) != 0 || left < 0)
+		return false;
+	return static_cast<int>(left) + ((e.state & BH76_ST_ACTED) != 0 ? 1 : 0) >= GDB_T && big_yes(); // else too late to walk anywhere
+}
+bool cs_reach(const Body& e, int d)
+{
+	if (!W.me.kit || e.stunned || !marcella_layer::fight_stun_holds(e))
+		return false;
+	const Kit& k = *W.me.kit;
+	if (k.aoe_stun && k.slot_aoe >= 0 && combat::ready(k.slot_aoe) && d <= static_cast<int>(k.aoe_range + k.aoe_radius))
+		return cs_yes();
+	return k.dash_stun && k.slot_dash >= 0 && combat::ready(k.slot_dash) && d <= static_cast<int>(k.dash_range + k.dash_radius) && cs_yes();
+}
+bool cs_fight()
+{
+	const Body* bt = nullptr;
+	for (const auto& e : W.enemies)
+		if ((e.state & ST_TRIBUTE) && (!bt || e.gems > bt->gems) && cs_reach(e, cheb(e.pos, W.me.pos)))
+			bt = &e;
+	return bt && dn::gd_stun_now(*bt) && cs_done();
+}
