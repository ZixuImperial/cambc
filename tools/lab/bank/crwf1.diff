+// b2326 CRWF1 (RC X725; caller reads CRWF_ON(1)): each group's stun cover once, in background fuel, with stun_cover_slow's own bar
+// (cost + OWN_KIT_RULES_COVER_FUEL), so a deep rating turn reads a kept entry. Only when the team view has an area or landing stunner
+// (the only readers). A group short of fuel stops the pass; the next background slot resumes there.
+void crwf_bg()
+{
+	static int next = 0;
+	if (next >= M.ng || TM.n <= 0)
+		return;
+	bool need = false;
+	for (int i = 0; i < TM.n && i < static_cast<int>(TM.m.size()); ++i)
+		need = need || TM.m[static_cast<std::size_t>(i)].ko1_area + TM.m[static_cast<std::size_t>(i)].ko1_land > 0;
+	if (!need)
+		return;
+	for (; next < M.ng; ++next)
+	{
+		const std::size_t i = static_cast<std::size_t>(next);
+		if (i < ko1_cov.size() && ko1_cov[i].any >= 0)
+			continue;
+		if (i < ko1_cov.size())
+			ko1_cov[i].skip_r = -1000; // a turn-path skip earlier this turn: the background slot tries again
+		if (stun_cover_slow(M.groups[i]).any < 0)
+			return; // short of fuel: resume here next time
+	}
+}
 } // namespace nova::econ
