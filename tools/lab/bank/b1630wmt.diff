+#pragma once
+// feat_wmt (WMT v2, b1630; spec condor-work/reports/analysts/spec_willow_meet_1108.md, Rule Checker 8 Nov; owner: no fixed roles,
+// Willow's heal replaces heal recalls). Rules: GameRules.md :714-736 (heal an ally, range 4, up to 3 x Focus, cooldown 8), :381-389
+// (recall 5 own turns, 3 with Home). Flag WMT_BITS, 0 = live v618.
+// Bit 1 CHOOSE (her body, from WF_FROM): each round she serves the seen mate (or her last choice, seen <= 3 rounds ago) with the best
+//   gold-equivalent per round, or FARMs: recall avoided (recall + walk back) x WMT_INC x tmp::tempo_scale(), healed HP x WMT_HPG
+//   (x1 engaged / fight, x.5 travelling), her damage while contested, minus her farm rate while travelling; WMT_HYS % hysteresis.
+//   Replaces the fixed partner order and WILLOW_FARM on her body.
+// Bit 2 SIGNAL (other bodies): partner_slot() = the mate whose claim (group + engaged bit) equals hers (lowest slot); none: she farms.
+// Bit 4 MEET (mate side): a hurt mate that sees her skips its heal recall and walks to within 4 of her when max(t_meet, her cooldown)
+//   + 1 < recall + walk back, her heal lifts it over its recall line and no foe can reach it in that time (WR_HOLD gives up as before).
+// Bit 8 CANCEL: a heal recall in progress is cancelled when she is within 4 with her heal ready and the meet test passes.
+// WMT_DRAFT (TEST ONLY, 0 = off): forced lineup, forceteam encoding (champion index + 1, 4 bits each, first pick in the low bits).
+#include "common.h"
+#include "world.h"
+#define WMT_BITS 0
+#define WMT_DMAX 12    // MEET: farthest Willow (Chebyshev)
+#define WMT_HYS 15     // CHOOSE: % a new option must beat the current one by
+#define WMT_INC10 30   // CHOOSE: a mate's income, gold x10 per round (recall avoided)
+#define WMT_HPG1000 50 // CHOOSE: gold x1000 per healed HP
+#define WMT_DMG100 5   // CHOOSE: gold x100 per point of her Strength per round beside a contested mate
+#define WMT_FARM10 20  // CHOOSE: her own farm, gold x10 per round
+#define WMT_DRAFT 0
+inline const volatile int WMT_TAB[9] = { 0x574d5432, WMT_BITS, WMT_DMAX, WMT_HYS, WMT_INC10, WMT_HPG1000, WMT_DMG100, WMT_FARM10, WMT_DRAFT };
+constexpr int WMT_BIT_CHOOSE = 1, WMT_BIT_SIGNAL = 2, WMT_BIT_MEET = 4, WMT_BIT_CANCEL = 8;
+#define WMT_ON(b) ((WMT_TAB[1] & (b)) != 0)
+namespace nova::combat
+{
+struct Assessment;
+}
+namespace nova::feat::wmt
+{
+const Body* meet(const combat::Assessment& a); // MEET: her body when the meet test passes (nullptr: as live)
+void meet_note(int phase);                      // MEET counters: 0 start, 1 heal landed, 2 give up, 3 a hold round
+bool cancel_ok(const combat::Assessment& a);    // CANCEL
+void repartner(int healer, bool healer_alive, int& partner, int& support); // CHOOSE / SIGNAL (support.cpp refresh_slow)
+void dead_note();                               // a dead turn: a death during a meet
+}
