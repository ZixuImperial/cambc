--- /dev/null
+++ b/src/feat_wmt.cpp
@@ -0,0 +1,294 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+#include "feat_wmt.h"
+#include "combat.h"
+#include "comms.h"
+#include "econ.h"
+#include "mapinfo.h"
+#include "move.h"
+#include "prism.h"
+#include "rs.h"
+#include "support.h"
+#include "tmp_scale.h"
+#include <algorithm>
+#include <limits>
+
+namespace nova::feat::wmt
+{
+namespace
+{
+// econ::wants_heal's line for a body hd walk from home (far > 20 / near; HPL is off on live).
+float line_at(int hd) { return static_cast<float>(hd > 20 ? B438_HEALF_X100 : B438_HEALN_X100) / 100.0f; }
+int hd_of(vec2 p)
+{
+	if (M.has_home)
+	{
+		const std::uint16_t v = dfget(M.f_home, p);
+		if (v != UNREACH)
+			return v;
+	}
+	return cheb(p, M.home_anchor);
+}
+float heal_amt(const Body& h) { return h.kit->heal_mod * h.foc; }
+// Below its recall line, and her heal (capped at the missing HP) lifts it to the line or above.
+bool lifts(const Body& m, float amt, float line)
+{
+	const float miss = m.maxhp - m.hp;
+	return m.frac() < line && m.hp + std::min(amt, miss) >= line * m.maxhp;
+}
+// A visible healer's heal cooldown (support::wr_healer's read; -1 unknown).
+int cd_of(const Body& h)
+{
+	const auto sl = static_cast<std::size_t>(h.kit->slot_heal);
+	if (sl >= h.cd.size())
+		return -1;
+	std::int32_t cd = h.cd[sl];
+	if (cd < 0)
+	{
+		std::int32_t c2 = -1;
+		if (cambc::detail::sdk_champion_cooldown(h.h, static_cast<std::uint32_t>(sl), &c2) == 0)
+			cd = c2;
+	}
+	return cd;
+}
+int meet_last = -1000; // the last round of a meet hold (deaths during a meet)
+
+// Counter sites (firecount counts each function's entries per game).
+int c_n = 0;
+void c_meet_start()
+{
+	meet_last = W.round;
+}
+void c_meet_healed()
+{
+	meet_last = W.round;
+}
+void c_meet_giveup()
+{
+	++c_n;
+}
+void c_meet_death()
+{
+	meet_last = -1000;
+}
+void c_cancel()
+{
+	++c_n;
+}
+void c_switch()
+{
+	++c_n;
+}
+void c_serve_round()
+{
+	++c_n;
+}
+void c_farm_round()
+{
+	++c_n;
+}
+void c_infer_ambig()
+{
+	++c_n;
+}
+void c_infer_farm()
+{
+	++c_n;
+}
+
+// ---- CHOOSE (her body) ----
+int ch_cur = -2; // chosen slot, -1 farm, -2 none yet
+Body ch_mem{};   // the chosen mate as last seen
+int ch_seen = -1000;
+constexpr float CH_OUT = -1.0e9f;
+
+float serve_value(const Body& m)
+{
+	if (m.hp <= 0 || m.channeling() || !mv::home_walkable(m.pos))
+		return CH_OUT;
+	const float F = static_cast<float>(WMT_TAB[7]) / 10.0f;
+	const int gap = std::max(0, cheb(m.pos, W.me.pos) - 4);
+	const int hd = hd_of(m.pos);
+	const float line = line_at(hd);
+	const float amt = heal_amt(W.me);
+	const bool below = m.frac() < line;
+	const int t_reach = (below && WMT_ON(WMT_BIT_MEET)) ? (gap + 1) / 2 : gap; // a hurt mate walks to her (MEET)
+	const int H = std::max(8, t_reach + 1);
+	const auto sl = static_cast<std::size_t>(W.me.kit->slot_heal);
+	const int mycd = sl < W.cd.size() ? W.cd[sl] : 99;
+	bool foe8 = false, foe5 = false;
+	for (const auto& e : W.enemies)
+	{
+		const int dd = cheb(e.pos, m.pos);
+		foe8 |= dd <= 8;
+		foe5 |= dd <= 5;
+		if (W.me.frac() < 0.35f && dd <= e.range + 1)
+			return CH_OUT; // RISK: a foe in reach of its tile and I am low
+	}
+	float v = 0;
+	if (below && lifts(m, amt, line) && mycd <= t_reach)
+		v += static_cast<float>(rs::recall_rounds(false, false) + hd) * static_cast<float>(WMT_TAB[4]) / 10.0f * tmp::tempo_scale();
+	const bool eng = comms::cengaged(m.slot) || foe5;
+	const float miss = m.maxhp - m.hp;
+	if (miss >= 1.0f)
+		v += std::min(amt, miss) * static_cast<float>(WMT_TAB[5]) / 1000.0f * (eng ? 1.0f : 0.5f);
+	if (eng && foe8)
+		v += W.me.str * static_cast<float>(WMT_TAB[6]) / 100.0f * static_cast<float>(H);
+	v -= static_cast<float>(t_reach) * F;
+	return v / static_cast<float>(H);
+}
+
+int choose()
+{
+	const float F = static_cast<float>(WMT_TAB[7]) / 10.0f;
+	int best = -1;
+	float best_v = F, cur_v = ch_cur == -1 ? F : CH_OUT;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0)
+			continue;
+		const float v = serve_value(al);
+		if (al.slot == ch_cur)
+		{
+			cur_v = v;
+			ch_mem = al;
+			ch_seen = W.round;
+		}
+		if (v > best_v)
+		{
+			best_v = v;
+			best = al.slot;
+		}
+	}
+	if (ch_cur >= 0 && ch_seen < W.round && W.round - ch_seen <= 3)
+	{
+		cur_v = serve_value(ch_mem); // out of sight: its last-seen tile and health
+		if (cur_v > best_v)
+		{
+			best_v = cur_v;
+			best = ch_cur;
+		}
+	}
+	if (best != ch_cur)
+	{
+		const bool gone = ch_cur == -2 || cur_v <= CH_OUT;
+		const float pad = std::abs(cur_v) * static_cast<float>(WMT_TAB[3]) / 100.0f;
+		if (gone || best_v > cur_v + pad)
+		{
+			if (ch_cur != -2)
+				c_switch();
+			ch_cur = best;
+			if (best >= 0)
+				if (const Body* b = W.ally_by_slot(best))
+				{
+					ch_mem = *b;
+					ch_seen = W.round;
+				}
+		}
+	}
+	return ch_cur;
+}
+} // namespace
+
+const Body* meet(const combat::Assessment& a)
+{
+	const int hs = support::healer_slot();
+	if (hs < 0 || hs == P.my_slot)
+		return nullptr;
+	const Body* h = W.ally_by_slot(hs);
+	if (!h || h->hp <= 0 || !h->kit || h->kit->slot_heal < 0 || h->channeling())
+		return nullptr;
+	const int d = cheb(h->pos, W.me.pos);
+	if (d > WMT_TAB[2] || !mv::home_walkable(h->pos))
+		return nullptr;
+	const int cd = cd_of(*h);
+	if (cd < 0)
+		return nullptr;
+	const int gap = std::max(0, d - 4);
+	const int th = std::max(WMT_ON(WMT_BIT_CHOOSE) ? (gap + 1) / 2 : gap, cd); // she walks to me too under CHOOSE
+	const int hd = econ::home_dist();
+	if (th + 1 >= rs::recall_rounds(prism::has_family(rs::F_HOME), false) + hd)
+		return nullptr;
+	if (!lifts(W.me, heal_amt(*h), line_at(hd)) || !support::wr_foe_clear(a, std::max(2, th)))
+		return nullptr;
+	return h;
+}
+
+void meet_note(int phase)
+{
+	if (phase == 0)
+		c_meet_start();
+	else if (phase == 1)
+		c_meet_healed();
+	else if (phase == 2)
+		c_meet_giveup();
+	else
+		meet_last = W.round;
+}
+
+bool cancel_ok(const combat::Assessment& a)
+{
+	const Body* h = meet(a);
+	if (!h || cheb(h->pos, W.me.pos) > 4 || cd_of(*h) != 0)
+		return false;
+	c_cancel();
+	return true;
+}
+
+void repartner(int healer, bool healer_alive, int& partner, int& support)
+{
+	if (W.round < WF_FROM)
+		return;
+	if (P.my_slot == healer)
+	{
+		if (!WMT_ON(WMT_BIT_CHOOSE) || !W.alive || W.me.channeling() || !W.me.kit || W.me.kit->slot_heal < 0)
+			return;
+		const int c = choose();
+		if (c >= 0)
+		{
+			partner = c;
+			support = healer;
+			c_serve_round();
+		}
+		else
+		{
+			support = -1;
+			c_farm_round();
+		}
+		return;
+	}
+	if (!WMT_ON(WMT_BIT_SIGNAL) || !healer_alive)
+		return;
+	const int hg = comms::cgroup(healer);
+	if (hg < 0 || hg >= M.ng)
+		return; // her claim names nothing: as live
+	const bool he = comms::cengaged(healer);
+	int found = -1, n = 0;
+	for (int s = 0; s < P.n; ++s)
+		if (s != healer && comms::cgroup(s) == hg && comms::cengaged(s) == he && (s != P.my_slot || W.alive))
+		{
+			if (found < 0)
+				found = s;
+			++n;
+		}
+	if (n >= 2)
+		c_infer_ambig();
+	if (found >= 0)
+	{
+		partner = found;
+		support = healer;
+	}
+	else
+	{
+		support = -1;
+		c_infer_farm();
+	}
+}
+
+void dead_note()
+{
+	if (W.round - meet_last <= 2)
+		c_meet_death();
+}
+} // namespace nova::feat::wmt
+
+#endif // NOVA_UNITY_ALL
