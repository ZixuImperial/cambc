+			const std::uint16_t d = dfget(*f, t);
+			if (d >= cur)
+				continue;
+			int k = n++;
+			while (k > 0 && dv[k - 1] > d) // insertion by field value, stable (spawn_step's scan order on ties)
+			{
+				dv[k] = dv[k - 1];
+				out[k] = out[k - 1];
+				--k;
+			}
+			dv[k] = d;
+			out[k] = t;
+		}
+	return n;
+}
