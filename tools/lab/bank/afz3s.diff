+// b2255 AFZ: the per-slot cache of on-demand mate reads, stamped with the round and the handle.
+namespace {
+struct AfzCache
+{
+	int round = -1000;
+	std::uint32_t h = 0;
+	std::uint8_t have = 0; // 1 gems, 2 cd0, 4 cd1, 8 buffs
+	std::uint32_t gems = 0;
+	std::array<int, 2> cd{ -1, -1 };
+	AllyBuffs bf{};
+};
+std::array<AfzCache, 8> afz_c{};
+AfzCache* afz_slot(const Body& al)
+{
+	if (al.slot < 0 || al.slot >= 8 || al.h == 0)
+		return nullptr;
+	AfzCache& c = afz_c[static_cast<std::size_t>(al.slot)];
+	if (c.round != W.round || c.h != al.h)
+	{
+		c.round = W.round;
+		c.h = al.h;
+		c.have = 0;
+	}
+	return &c;
+}
+} // namespace
+
+std::uint32_t ally_gems(const Body& al)
+{
+	if (al.afz || !al.ally || al.h == W.me.h)
+		return al.gems;
+	AfzCache* c = afz_slot(al);
+	if (!c)
+		return al.gems;
+	if (!(c->have & 1))
+	{
+		c->have |= 1;
+		std::uint32_t g = 0;
+		c->gems = cambc::detail::sdk_champion_gems(al.h, &g) == 0 ? g : al.gems;
+	}
+	return c->gems;
+}
+
+int ally_cd(const Body& al, int s)
+{
+	if (s < 0 || s > 1)
+		return -1;
+	if (al.afz || !al.ally || al.h == W.me.h)
+		return al.cd[static_cast<std::size_t>(s)];
+	AfzCache* c = afz_slot(al);
+	if (!c)
+		return al.cd[static_cast<std::size_t>(s)];
+	const std::uint8_t bit = static_cast<std::uint8_t>(2 << s);
+	if (!(c->have & bit))
+	{
+		c->have |= bit;
+		std::int32_t cd = -1;
+		c->cd[static_cast<std::size_t>(s)] = cambc::detail::sdk_champion_cooldown(al.h, static_cast<std::uint32_t>(s), &cd) == 0 ? cd : -1;
+	}
+	return c->cd[static_cast<std::size_t>(s)];
+}
+
+AllyBuffs ally_buffs(const Body& al)
+{
+	if (al.afz || !al.ally || al.h == W.me.h)
+		return { al.shield, al.shield_turns, al.stunned };
+	AfzCache* c = afz_slot(al);
+	if (!c)
+		return { al.shield, al.shield_turns, al.stunned };
+	if (!(c->have & 8))
+	{
+		c->have |= 8;
+		Body t; // read_buffs adds onto zeroed fields; a failed read leaves them zero (the default)
+		t.h = al.h;
+		read_buffs(t);
+		c->bf = { t.shield, t.shield_turns, t.stunned };
+	}
+	return c->bf;
+}
