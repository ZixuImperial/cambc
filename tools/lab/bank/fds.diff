+// v675 FDS bit 1: the landing whose best end tile after this turn's step (the landing itself or a free tile next to it) scores lowest
+// (danger * weight + home steps) and beats staying; *end_danger: that end tile's danger. x < 0: none.
+static vec2 fds_landing(const std::vector<mv::Threat>& zs, vec2 me, int r, int now, int* end_danger)
+{
+	// v675 FDS: only end tiles out of every zone count (one cheap pass per tile within r + 1, stopping at the first zone that covers it);
+	// the landing whose free neighbour (or itself) is such a tile, nearest home, wins. *end_danger 0 on a pick.
+	(void)now;
+	constexpr int FDS_RMAX = 5, FDS_N = 2 * FDS_RMAX + 3;
+	r = std::min(r, FDS_RMAX);
+	const int R = r + 1, n = 2 * R + 1;
+	std::array<int, FDS_N * FDS_N> hs;
+	for (int y = 0; y < n; ++y)
+		for (int x = 0; x < n; ++x)
+		{
+			const vec2 u{ me.x - R + x, me.y - R + y };
+			int v = BIG;
+			if (u != me && inb(u) && mv::free_tile(u))
+			{
+				bool out = true;
+				for (const auto& t : zs)
+					if (cheb(u, t.pos) <= t.reach)
+					{
+						out = false;
+						break;
+					}
+				if (out)
+					v = mv::home_steps(u);
+			}
+			hs[static_cast<std::size_t>(y * n + x)] = v;
+		}
+	vec2 best{ -1, -1 };
+	int best_s = BIG;
+	for (int dy = -r; dy <= r; ++dy)
+	{
+		AF_CHECK();
+		for (int dx = -r; dx <= r; ++dx)
+		{
+			const int x = dx + R, y = dy + R;
+			const vec2 t{ me.x + dx, me.y + dy };
+			if (t == me || !mv::free_tile(t))
+				continue;
+			int ts = BIG;
+			for (int ey = y - 1; ey <= y + 1; ++ey)
+				for (int ex = x - 1; ex <= x + 1; ++ex)
+					ts = std::min(ts, hs[static_cast<std::size_t>(ey * n + ex)]);
+			if (ts >= best_s || !dash_path_ok(me, t)) // the legality test is the dear part, so it comes last
+				continue;
+			best_s = ts;
+			best = t;
+		}
+	}
+	if (best.x >= 0 && end_danger)
+		*end_danger = 0;
+	return best;
+}
