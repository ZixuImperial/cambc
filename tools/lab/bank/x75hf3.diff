 // avoid zone (step_open's test). Bit 32 (row 1004): opportunity_factor's free-camp bonus also when no foe is alive. Bit 64 (row 241):
 // a hurt me (frac <= .35) hands the camp tank job to the best healthy mate here even if its tank order is worse.
 // v693 BE2: 4 fixes be2b8f,fsb4,qms1,prb4f
 #define BE2_BITS 8
 inline constexpr int BE2_TAB[2] = { 0x42453231, BE2_BITS }; // slot 0 magic keeps it out of .bss
+
+// X75 (b1813, Combat + Rule Checker X75): runtime data flag, 0 = off, one bit per row. Bit 1 (HF3): help_join drops a HELP call
+// whose cell is visible and empty (no mate within 2, no foe within 4). Bit 2 (TB2): crew_bail::skip counts a claimant mate at my
+// distance from the attacker as nearer when it takes the camp tie (acts before me, mv::takes_tie). Bit 4 (TB1): tank_bail_out adds
+// each visible foe's one-turn burst on me (within its reach + 1) to incoming and walk_inc.
+#define X75_BITS 0
+inline const volatile int X75_TAB[2] = { 0x58373531, X75_BITS }; // slot 0 magic keeps it out of .bss
+#define X75_ON(b) ((X75_TAB[1] & (b)) != 0)
