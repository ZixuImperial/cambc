diff --git a/src/combat_flags.h b/src/combat_flags.h
--- a/src/combat_flags.h
+++ b/src/combat_flags.h
@@ -806,6 +806,19 @@ inline constexpr int TDP_TAB[2] = { 0x54445031, TDP_BITS }; // slot 0 magic keep
 // v7xx LDS (b2120; PF's LHS, postrecall_walkback_1112.md section 4; RC C550: any own spawn tile keeps the heal, GR:124/153/387): bit 1,
 // on the spawn heal hold (retreat_to_spawn_to_heal_slow), after its hit-back and siege turn, step to the own spawn tile nearest my target
 // (spawn_step's tiles) whose danger is no higher than here and under the refuge cap. Runtime data flag, read first; 0 = off.
 // v904 LDS: LDS spawn-to-spawn landing step (fp)
 #define LDS_BITS 1
 inline constexpr int LDS_TAB[2] = { 0x4C445331, LDS_BITS }; // slot 0 magic keeps it out of .bss
+
+// PBC (b2405; Aggression spec_pbc_1113, owner: "Use the shared buffer to support aggression, if we have enough allies nearby, prepare to push
+// the enemy"). Runtime data flag PBC_TAB[1], read first; 0 = v907. Bit 1 COUNT CLAIMED MATES: assess() also counts each mate I do NOT see
+// whose team-word claim names a group (engaged or not) whose anchor lies within PBC_R of my own claimed group's anchor (I within 8 of that
+// anchor), placed at that anchor with last-seen stats and full health (Shared Mem: no HP band in the slim layout), at weight PBC_W_X100 / 100,
+// and in n_friends. A claim is a group OR a code: dead, fight-state (retreat included) and FL3a's coming codes carry no group (no double count).
+// RC C1389: a heading claim counts only at ETA bucket 0 (cval, comms.h:91) or when engaged (slim layout,
+// no bucket sent: engaged only). Claims carry no age stamp. Bits 2 (rally/commit) and 4 (camp caution): not built yet.
+#define PBC_BITS 0
+#define PBC_W_X100 75
+#define PBC_R 6
+inline const volatile int PBC_TAB[4] = { 0x50424331, PBC_BITS, PBC_W_X100, PBC_R }; // slot 0 magic keeps it out of .bss
+#define PBC_ON(b) ((PBC_TAB[1] & (b)) != 0)
