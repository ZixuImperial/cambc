+++ b/src/combat_assess_power.cc
@@ -560,9 +560,43 @@ static __attribute__((always_inline)) inline void assess_sum_coming_mates(Assess
 		mates::add_friend(mb, h, dd);
 		const float w = static_cast<float>(comms::FL_TAB[5]) / 100.0f;
 		mates::scale_by_focus_share(OFS_BIT_ASSESS, mb, false, c.oe, dd, w);
 		assess_add_power(c, w, h, dd);
 	}
 }
+// b2405 PBC bit 1 (the caller read the flag; Shared Mem ruling): unseen living mates whose claim names a group near my own claimed group count
+// as present (FL3a's extension: a claim is a group or a code, never both, so FL3a's coming mates are never counted twice).
+__attribute__((noinline)) void assess_sum_claimed_mates(AssessCtx& c)
+{
+	const int tg = econ::claim_target();
+	if (tg < 0 || tg >= M.ng)
+		return;
+	const vec2 ta = M.groups[static_cast<std::size_t>(tg)].anchor;
+	if (cheb(ta, c.me) > 8)
+		return;
+	const float w = static_cast<float>(PBC_TAB[2]) / 100.0f;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+	{
+		if (s == P.my_slot || W.ally_by_slot(s) || comms::ckind(s) == tune::COMING_CLAIM)
+			continue; // a coming code is FL3a's (no double count); a code carries no group
+		if (!comms::cengaged(s) && (comms::slim_layout() || comms::cval(s) != 0))
+			continue; // RC C1389: a heading claim counts only at ETA bucket 0 (FL3a's ETA <= 2 rule) or engaged; the slim layout sends no bucket: engaged only
+		const int g = comms::cgroup(s);
+		if (g < 0 || g >= M.ng)
+			continue;
+		const vec2 p = M.groups[static_cast<std::size_t>(g)].anchor;
+		if (cheb(p, ta) > PBC_TAB[3] || hp2s_dead_ca(s))
+			continue;
+		const Kit& k = kit_of(P.type[static_cast<std::size_t>(s)]);
+		Body mb{};
+		assess_coming_body(mb, s, k, p);
+		mb.hp = mb.maxhp; // Shared Mem ruling: no HP band in the slim layout; assumed healthy
+		float h = 0, dd = 0;
+		mates::add_friend(mb, h, dd);
+		mates::scale_by_focus_share(OFS_BIT_ASSESS, mb, false, c.oe, dd, w);
+		assess_add_power(c, w, h, dd);
+		++c.a.n_friends;
+	}
+}
 } // namespace
 } // namespace stance
 } // namespace nova::combat
