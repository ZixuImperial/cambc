+// v858 TBM bit 8 (econ_flags.h): the UNDISCOUNTED local power at c, assess_rule_local_power's form (as EQR bit 2): ours = sum eff_hp x
+// sum (str + foc) over me (unless channelling) and the mates within r of c (not channelling; a retreating mate counts 0); theirs = the same over the visible foes
+// within r plus the foes seen 1-4 rounds ago (CTH's loop), an unseen foe's str + foc being the visible foes' mean (else mine).
+void local_power_at(vec2 c, int r, float& ours, float& theirs)
+{
+	float uh = 0, us = 0;
+	if (W.alive && !W.me.channeling()) // RC C901c: me always (the body deciding to push), mates within r
+	{
+		uh += eff_hp(W.me);
+		us += W.me.str + W.me.foc;
+	}
+	for (const auto& al : W.allies)
+		if (!al.channeling() && cheb(al.pos, c) <= r && !retreating_mates::retreating(al))
+		{
+			uh += eff_hp(al);
+			us += al.str + al.foc;
+		}
+	float th = 0, ts = 0, vs = 0;
+	int vn = 0;
+	for (const auto& e : W.enemies)
+	{
+		vs += e.str + e.foc;
+		++vn;
+		if (cheb(e.pos, c) > r)
+			continue;
+		th += std::max(1.0f, eff_hp(e));
+		ts += e.str + e.foc;
+	}
+	const float avg = vn > 0 ? vs / static_cast<float>(vn) : W.me.str + W.me.foc;
+	const int now = W.round;
+	for (const auto& s : seen)
+	{
+		if (s.round == now || now - s.round > 4 || cheb(s.foe.pos, c) > r)
+			continue;
+		bool visible = false;
+		for (const auto& e : W.enemies)
+			if (e.h == s.h)
+			{
+				visible = true;
+				break;
+			}
+		if (visible)
+			continue;
+		th += std::max(1.0f, s.foe.ehp);
+		ts += avg;
+	}
+	ours = uh * us;
+	theirs = th * ts;
+}
