+// b2245 BFT (combat.h): the qualifying test. Labels from the ward analysis (an unlabelled tile does not qualify); one foe-ward label
+// list a round; mode 1 asks the engine's hypothetical vision from p (one call per candidate, only on a tie fill).
+bool bft_qualifies(vec2 p, int mode, vec2 focus, int range)
+{
+	const int lab = ward::bush_label(p);
+	if (lab <= 0 || !mv::free_tile(p))
+		return false;
+	static int fw_r = -1000, fw_n = 0;
+	static int fw_l[8];
+	if (fw_r != W.round)
+	{
+		fw_r = W.round;
+		fw_n = 0;
+		const bitboard& fw = fight_turn::bush_foe_wards();
+		bbforeach(fw,
+			[&](vec2 q)
+			{
+				const int l = ward::bush_label(q);
+				if (l > 0 && fw_n < 8)
+					fw_l[fw_n++] = l;
+			});
+	}
+	for (int i = 0; i < fw_n; ++i)
+		if (fw_l[i] == lab)
+			return false;
+	for (const auto& e : W.enemies)
+		if (ward::bush_label(e.pos) == lab)
+			return false;
+	for (const auto& s : seen)
+		if (W.round - s.round <= 2 && ward::bush_label(s.foe.pos) == lab)
+			return false;
+	if (mode == 2)
+		return !(mv::pfa_prev_round() == W.round && mv::pfa_prev_pos() == p); // not the tile of my last 2 turns
+	if (focus.x < 0 || ward::bush_label(focus) == lab || cheb(p, focus) > range)
+		return false;
+	bitboard v{ cambc::uninitialized };
+	return cambc::detail::sdk_hypothetical_vision(static_cast<std::int32_t>(W.me.type), p.x, p.y, v.ptr()) == 0 && bbget(v, focus);
+}
