+// SRO (econ_flags.h; callers read SRO_ON(5) first): the team-ratio bar for a big group's call.
+float sro_bar(const GroupI& g)
+{
+	float b = SRO_ON(4) ? 1.0f : SG_SR;
+	if (SRO_ON(1) && g.contest <= 0.45f && intel::count_near(g.anchor, 15, 10) == 0 && intel::danger(g.anchor, 15, 10) < 0.5f)
+		b = std::min(b, static_cast<float>(SRO_TAB[2]) / 100.0f);
+	return b;
+}
+// SRO bit 8 CREW-SOON (econ_flags.h; caller read the flag): n free bodies plus, added to the free crew c, each healthy mate busy on another group whose capture
+// finishes soon (the group cleared, or alive with <= SRO_SOON_HP% of its HP left), arriving SRO_SOON_T rounds after its walk.
+int sro_n_soon(int n, int gi, Crew& c, int& eta, bool skip)
+{
+	if (skip)
+		return n; // a crew group, or foes near the group: the live gate
+	for (int i = 0; i < TM.n; ++i)
+	{
+		const int s = TM.by_tank[static_cast<std::size_t>(i)];
+		if (s < 0 || s >= 8 || s == my_slot() || !siege_ally_alive(s))
+			continue;
+		const auto ss = static_cast<std::size_t>(s);
+		const int cg = TM.claim[ss];
+		if (!TM.busy[ss] || cg == gi || cg < 0 || cg >= M.ng)
+			continue; // free mates are already in c; only a busy one finishing its capture is added
+		if (const Body* b = W.ally_by_slot(s))
+		{
+			if (b->frac() < SG_HP || (b->state & ST_RECALL))
+				continue;
+		}
+		else if (!hvb_slot_ok(s))
+			continue;
+		const auto& cm = mem[static_cast<std::size_t>(cg)];
+		const float ghp = M.groups[static_cast<std::size_t>(cg)].hp;
+		const bool soon = cm.status == GS_CLEARED || (cm.status == GS_ALIVE && cm.hp_left >= 0 && ghp > 0 && cm.hp_left * 100.0f <= static_cast<float>(SRO_TAB[4]) * ghp);
+		if (!soon)
+			continue;
+		const int e = siege_slot_arrival_eta(s, gi) + SRO_TAB[3];
+		if (e > SG_ETA_MAX)
+			continue;
+		c.add(ECX_TM(ss));
+		++n;
+		eta = std::max(eta, e);
+	}
+	return n;
+}
