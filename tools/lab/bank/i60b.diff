+// EMP bit 2 (caller read the flag): the richest group (most gems, the lower index on a tie) has a golem, monolith or elk, or >= 3
+// wolves (mapclass_heavy_1109: HC or HS). Map data only.
+static bool emp_heavy_map()
+{
+	int r = -1;
+	for (int gi = 0; gi < M.ng; ++gi)
+		if (r < 0 || M.groups[static_cast<std::size_t>(gi)].gems > M.groups[static_cast<std::size_t>(r)].gems)
+			r = gi;
+	if (r < 0)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(r)];
+	return g.n_golem > 0 || g.n_mono > 0 || g.n_elk > 0 || g.n_wolf >= 3;
+}
