+// b2426 RBG (callers read RBG_ON first): a body's bag. The SDK read works only in sight (INT:22: rc 97 on 96% of out-of-sight ally
+// reads), so: a read bag this round (b.gems > 0: perceive's bubble read or intel's copy), else sdk_champion_gems, else the last bag
+// read for that handle (kept across rounds; 0 once the body is seen dead), never a blind 0. One SDK read per body per round.
+inline std::uint32_t rbg_bag(const Body& b)
+{
+	static int r = -1;
+	static std::array<std::uint32_t, 12> hh{}, gg{}, mh{}, mg{};
+	static std::size_t n = 0, mn = 0;
+	if (r != W.round)
+	{
+		r = W.round;
+		n = 0;
+	}
+	for (std::size_t i = 0; i < n; ++i)
+		if (hh[i] == b.h)
+			return gg[i];
+	std::size_t m = 0;
+	while (m < mn && mh[m] != b.h)
+		++m;
+	if (m == mn && mn < mh.size())
+	{
+		mh[mn] = b.h;
+		mg[mn] = 0;
+		++mn;
+	}
+	std::uint32_t g = 0;
+	if (!(b.state & ST_ALIVE))
+		g = 0; // dead: the bag is gone
+	else if (b.gems > 0)
+		g = b.gems;
+	else if (cambc::detail::sdk_champion_gems(b.h, &g) != 0)
+		g = m < mn ? mg[m] : 0; // out of sight: the last bag read
+	if (m < mn)
+		mg[m] = g;
+	if (n < hh.size())
+	{
+		hh[n] = b.h;
+		gg[n] = g;
+		++n;
+	}
+	return g;
+}
