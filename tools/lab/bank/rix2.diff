+// RIX bit 1 (the caller read the bit): the foe spells live's 5-turn window drops (cooldown 5..RIX_CD), at their value over the horizon,
+// for the initiation read only (an engage prices a fight to the death, one full 8-turn cycle; GR:822, :828).
+float rix_late_spells(const Body& b)
+{
+	if (!b.kit || !b.kit->valid)
+		return 0.0f;
+	const Kit& k = *b.kit;
+	constexpr int H = tune::DPS_HORIZON;
+	auto late = [&](int s) { if (s < 0 || s > 1) return false; const int c = foe_cd(b, s); return c > H - 1 && c <= RIX_TAB[2]; };
+	float add = 0.0f;
+	if (late(k.slot_dmg))
+		add += k.dmg_mod * b.foc;
+	if (late(k.slot_cc))
+		add += k.cc_mod * b.foc;
+	if (late(k.slot_aoe))
+		add += k.aoe_mod * b.foc * tune::DPS_AREA_HITS;
+	if (late(k.slot_dash) && k.dash_mod > 0)
+		add += k.dash_mod * b.foc * tune::DPS_AREA_HITS;
+	if (add <= 0.0f)
+		return 0.0f;
+	float d = add / static_cast<float>(H) * kit_rules::passive_mult(b);
+	if (b.stunned)
+		d *= tune::DPS_STUNNED;
+	return d * kit_fight_factor(b.type);
+}
 float horizon_dps_k(const Body& b, bool me, bool one)
 {
 	if (!b.kit || !b.kit->valid)
 		return 50.0f;
 	return horizon_fit(b, me, one, 0, 99, false);
 }
