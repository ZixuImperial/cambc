@@ -46,21 +47,29 @@ void shop()
 			me.buy(sh, static_cast<std::uint32_t>(n));
 			gold -= static_cast<std::uint32_t>(n) * 30;
 			W.gold = gold; // X02 bit 1: booked now, so a later throw cannot leave it unspent
 			emb_pgold = static_cast<int>(gold);
 			own.checked = -1000;
