+// FRS, caller read the flag: a foe beyond FIGHT_R, left out of the fight's strength and count.
+static __attribute__((noinline)) void frs_far_foe(AssessCtx& c, const Foe& f, int d)
+{
+	Assessment& a = c.a;
+	if (FRS_ON(2) && assess_soon_in_reach(f, d))
+		c.e_near += assess_foe_weight(a, f, d) * assess_foe_power(f);
+	if (!FRS_ON(1))
+		return;
+	if (d <= f.reach && !bb13_spawn_shield(f, c.me))
+	{
+		a.in_reach = true;
+		a.incoming += (f.burst);
+	}
+	if (!f.remembered && f.melee && d + 1 <= f.reach)
+		a.caught = true;
+}
 // Fight strength of a side: (sum of sqrt(health x damage))^2. This sums the foes' side, counts them, and reads who has me in reach.
 static __attribute__((always_inline)) inline void assess_sum_foes(AssessCtx& c)
 {
 	Assessment& a = c.a;
 	for (const auto& f : a.foes)
 	{
 		const int d = cheb(f.pos, c.me);
 		if (d > tune::FIGHT_R)
+		{
+			if (FRS_ON(3)) // FRS: a far foe's reach still counts
+				frs_far_foe(c, f, d);
 			continue;
+		}
 		++a.n_foes;
 		const float fw = assess_foe_weight(a, f, d);
 		const float v = fw * assess_foe_power(f);
 		c.e_h += fw * std::max(1.0f, f.ehp);
 		const float v_fc = fw * assess_power(f.ehp, f.dps_fc); // the refit foe kits (and unseen reinforcements)
 		c.e_sq += v;
diff --git a/src/combat_dps.cc b/src/combat_dps.cc
--- a/src/combat_dps.cc
+++ b/src/combat_dps.cc
@@ -187,23 +187,34 @@ float heal_of(const Body& b, int cd, vec2 at, int horizon, int margin = 3) // ma
 	const int c = std::max(0, cd);
 	if (c > horizon - 1)
 		return 0.0f;
 	const int casts = 1 + (horizon - 1 - c) / 8;
 	return kp->heal_mod * b.foc * static_cast<float>(casts);
 }
+// FRS bit 4 FHR1, caller read the flag: another foe than j within FIGHT_R of `at` (the ones assess counts).
+static __attribute__((noinline)) bool frs_fhr1_other(const Assessment& a, int j, vec2 at)
+{
+	for (const auto& f : a.foes)
+		if (f.idx != j && cheb(f.pos, at) <= FRS_FIGHT_R)
+			return true;
+	return false;
+}
 // a foe healer heals ANOTHER foe only: counted only with another foe within 8 of `at`.
 static float foe_heal_on_others(vec2 at, int horizon, const Assessment& a)
 {
 	float pool = 0;
 	for (const auto& e : W.enemies)
 		if (e.kit && e.kit->slot_heal >= 0)
 		{
 			const int j = static_cast<int>(&e - W.enemies.data());
 			bool other = false;
-			for (const auto& f : a.foes)
-				other |= f.idx != j && cheb(f.pos, at) <= 8;
+			if (FRS_ON(4)) // FRS FHR1: within FIGHT_R
+				other = frs_fhr1_other(a, j, at);
+			else
+				for (const auto& f : a.foes)
+					other |= f.idx != j && cheb(f.pos, at) <= 8;
 			if (other)
 				pool += heal_of(e, foe_cd(e, e.kit->slot_heal), at, horizon);
 		}
 	return pool;
 }
 } // namespace dmg
