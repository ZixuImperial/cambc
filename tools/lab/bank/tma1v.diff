+// b2307 TMA (caller read the flag): every candidate is a goal tile next to the focus. Each score becomes (score, foe reaches at the tile),
+// so a tie of equal score goes to the tile inside fewer foe reaches (melee foe 2, ranged foe its range) before the centroid tie; a
+// higher score never moves ahead. True when the tied best tiles differ in reach count (the tie-break can change the step).
+__attribute__((noinline)) bool tma_reach_tie(CandList& cands)
+{
+	int best = BIG, lo = BIG, hi = -1;
+	for (const auto& c : cands)
+		best = std::min(best, c.score);
+	for (auto& c : cands)
+	{
+		int n = 0;
+		for (const auto& e : W.enemies)
+			n += cheb(e.pos, c.p) <= (e.range <= 1 ? 2 : e.range);
+		n = std::min(n, 15);
+		if (c.score == best)
+		{
+			lo = std::min(lo, n);
+			hi = std::max(hi, n);
+		}
+		c.score = c.score * 16 + n;
+	}
+	return hi > lo;
+}
