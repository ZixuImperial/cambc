+}
+static int pty_code_now = 0, pty_tgt = -1, pty_below = 0, pty_ban_g = -1, pty_ban_until = -1000, pty_turn_r = -1;
+static int pty_units[2] = { -1, -1 }, pty_nun = 0;
+static void pty_put(int c)
+{
+	if (c != pty_code_now)
+		comms::spare_put(pty_f, static_cast<std::uint32_t>(c));
+	pty_code_now = c;
+	if (c <= 1)
+		pty_nun = 0, pty_tgt = -1, pty_below = 0;
+}
+static void pty_lead_turn(int lead)
+{
+	if (!W.alive)
+	{
+		pty_put(0); // her first dead turn
+		return;
+	}
+	const bool recall = (W.me.state & (ST_RECALL | ST_TRIBUTE)) != 0;
+	const bool bankw = pcf_calm >= now() - 1;
+	if (recall || bankw || pty_foe_near(W.me.pos) || T.target < 0)
+	{
+		pty_put(0);
+		return;
+	}
+	if (pty_nun > 0)
+	{
+		bool brk = false;
+		for (int i = 0; i < pty_nun && !brk; ++i)
+		{
+			int us[2];
+			const int nu = pty_unit_slots(lead, pty_units[i], us);
+			for (int j = 0; j < nu; ++j)
+			{
+				const Body* b = W.ally_by_slot(us[j]);
+				brk = brk || !siege_ally_alive(us[j]) || (b && b->frac() < 0.5f);
+			}
+		}
+		if (brk || !pty_scope(T.target))
+		{
+			pty_put(0);
+			return;
+		}
+		pty_tgt = T.target; // a new target in scope: the party re-rates there as a unit
+	}
+	if (now() % std::max(1, static_cast<int>(PTY_TAB[2])) != 0 || fuel() < static_cast<long>(PTY_TAB[8]))
+		return;
+	build_team(false);
+	if (pty_nun > 0)
+	{
+		float pr = -1.0f, ss = 0.0f;
+		pty_eval(lead, pty_tgt, pty_units, pty_nun, &pr, &ss);
+		if (pr < ss * (1.0f - static_cast<float>(PTY_TAB[4]) / 100.0f))
+		{
+			if (++pty_below >= 2)
+			{
+				pty_ban_g = pty_tgt;
+				pty_ban_until = now() + PTY_TAB[5];
+				pty_put(0);
+			}
+		}
+		else
+			pty_below = 0;
+		return;
+	}
+	const int gi = T.target;
+	if (!pty_scope(gi) || (gi == pty_ban_g && now() < pty_ban_until))
+	{
+		pty_put(0);
+		return;
+	}
+	if (PTY_ON(4))
+	{
+		const int me1[1] = { lead };
+		if (pty_solo_ok(gi, me1, 1)) // S1b: she can clear it alone: no party
+		{
+			pty_put(1);
+			return;
+		}
+	}
+	// the available units, nearest to the target first
+	int cu[4], cd[4], nc = 0;
+	for (int u = 0; u < 4; ++u)
+	{
+		int us[2];
+		const int nu = pty_unit_slots(lead, u, us);
+		vec2 p{ -1, -1 };
+		if (nu <= 0 || !pty_unit_pos(us, nu, &p))
+			continue;
+		if (PTY_ON(4) && pty_solo_ok(gi, us, nu))
+			continue; // S1b: a unit that clears it alone farms as live
+		cu[nc] = u;
+		cd[nc] = cheb(p, M.groups[static_cast<std::size_t>(gi)].anchor);
+		++nc;
+	}
+	for (int i = 1; i < nc; ++i)
+		for (int j = i; j > 0 && cd[j] < cd[j - 1]; --j)
+			std::swap(cd[j], cd[j - 1]), std::swap(cu[j], cu[j - 1]);
+	int best = 0;
+	float bm = 0.0f;
+	for (int k = 1; k <= std::min(2, nc); ++k)
+	{
+		float pr = -1.0f, ss = 0.0f;
+		pty_eval(lead, gi, cu, k, &pr, &ss);
+		if (pr > ss * static_cast<float>(PTY_TAB[3]) / 100.0f && pr - ss > bm)
+			bm = pr - ss, best = k;
+	}
+	if (best == 0)
+	{
+		pty_put(1);
+		return;
+	}
+	const int a = std::min(cu[0], best > 1 ? cu[1] : cu[0]), b = std::max(cu[0], best > 1 ? cu[1] : cu[0]);
+	pty_fc_form();
+	pty_units[0] = a;
+	pty_units[1] = b;
+	pty_nun = best;
+	pty_tgt = gi;
+	pty_below = 0;
+	pty_put(pty_code(best, a, b));
+}
+// the escort side: the group the lead's party names me for (-1 none); the one accessor of the field
+static int pty_named_target(int lead)
+{
+	if (!pty_f.ok() || lead < 0 || lead == my_slot() || !siege_ally_alive(lead))
+		return -1;
+	const int c = static_cast<int>(comms::spare_get(pty_f));
+	int a = -1, b = -1;
+	pty_decode(c, &a, &b);
+	if (a < 0)
+		return -1;
+	bool me = false;
+	for (int u : { a, b })
+	{
+		if (u < 0)
+			continue;
+		int us[2];
+		const int nu = pty_unit_slots(lead, u, us);
+		for (int j = 0; j < nu; ++j)
+			me = me || us[j] == my_slot();
+	}
+	if (!me)
+		return -1;
+	const int gi = comms::cgroup(lead);
+	if (gi < 0 || gi >= M.ng || mem[static_cast<std::size_t>(gi)].status == GS_RESPAWN || M.groups[static_cast<std::size_t>(gi)].access != ACC_WALK)
+		return -1;
+	if (!W.alive || W.me.frac() < 0.5f || W.me.channeling() || pty_foe_near(W.me.pos))
+		return -1;
+	return gi;
+}
+bool pty_escort_pick(float* out_rate, int* out_crew)
+{
+	const int gi = pty_named_target(pty_lead_slot());
+	if (gi < 0 || T.capturing || engaged_now())
+		return false;
+	pty_g = gi;
+	*out_rate = std::max(T.rate, 0.0f);
+	*out_crew = 1;
+	return true;
+}
+// RC C1027 (a)+(b): every other body of the said party (the lead, every named unit's bodies) in sight within PTY_NEAR of me, and the
+// crew of me + them clears gi by estimate_cx(4) (the live start test on the bodies actually present).
+bool pty_side_near_i(int gi)
+{
+	if (!pty_f.ok() || gi < 0 || gi >= M.ng)
+		return false;
+	const int lead = pty_lead_slot();
+	int ua = -1, ub = -1;
+	if (lead == my_slot())
+	{
+		if (!(pty_nun > 0 && pty_tgt == gi && pty_code_now >= 2))
+			return false;
+		ua = pty_units[0];
+		ub = pty_nun > 1 ? pty_units[1] : -1;
+	}
+	else
+	{
+		if (pty_named_target(lead) != gi)
+			return false;
+		pty_decode(static_cast<int>(comms::spare_get(pty_f)), &ua, &ub);
+	}
+	int sl[6], n = 0;
+	sl[n++] = my_slot();
+	auto need = [&](int s) -> bool
+	{
+		if (s == my_slot())
+			return true;
+		const Body* b = W.ally_by_slot(s);
+		if (!b || cheb(b->pos, W.me.pos) > PTY_TAB[9])
+			return false;
+		if (n < 6)
+			sl[n++] = s;
+		return true;
+	};
+	if (lead != my_slot() && !need(lead))
+		return false;
+	for (int u : { ua, ub })
+	{
+		if (u < 0)
+			continue;
+		int us[2];
+		const int nu = pty_unit_slots(lead, u, us);
+		for (int j = 0; j < nu; ++j)
+			if (!need(us[j]))
+				return false;
+	}
+	Crew c;
+	for (int i = 0; i < TM.n; ++i)
+	{
+		const int s = TM.by_tank[static_cast<std::size_t>(i)];
+		for (int j = 0; j < n; ++j)
+			if (sl[j] == s)
+				c.add(ECX_TM(static_cast<std::size_t>(s)));
+	}
+	return c.n == n && estimate_cx(4, M.groups[static_cast<std::size_t>(gi)], mem[static_cast<std::size_t>(gi)], c).feasible;
+}
+void pty_turn_i()
+{
+	if (pty_turn_r == W.round || !pty_f.ok())
+		return;
+	pty_turn_r = W.round;
+	const int lead = pty_lead_slot();
+	if (lead < 0)
+		return;
+	if (lead == my_slot())
+	{
+		pty_lead_turn(lead);
+		return;
+	}
+	const int gi = pty_named_target(lead);
+	if (gi < 0 || gi == T.target || T.capturing || engaged_now())
+		return;
+	pty_fc_move();
+	set_target(gi, std::max(T.rate, 0.0f), 1);
+}
+} // namespace (b2383 PTY: the two entry points econ.h names)
+void pty_alloc() { pty_alloc_i(); }
+void pty_turn() { pty_turn_i(); }
+bool pty_side_near(int gi) { return pty_side_near_i(gi); }
+namespace {
 template <int DM>
 int choose_target(float* out_rate, int* out_crew)
 {
 	fg_pre_f0 = fuel();
 	fg_pre_r0 = fg::rnd();
 	fg_bw_used = 0;
 	build_team(false);
 	if (!stage_ready() && !bounds_resume_ready()) // a staged list keeps the travel it was built with (same tile)
 	if (travel_round != now() || travel_from != W.me.pos)
