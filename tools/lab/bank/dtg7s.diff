+// b2422 DTG bit 1 (combat_flags.h; the caller read the flag): wait on the ring at DTG_RING for a second denier. True when the rule holds
+// me this turn (held in place, or stepped toward the ring); `stepped` tells which.
+static __attribute__((noinline)) bool dtg_wait(const Body& tgt, int L, int need, int dme, bool& stepped)
+{
+	stepped = false;
+	if (tgt.type != cambc::champion_type::prism || !(foe_ready(tgt, 0) || foe_ready(tgt, 1)))
+		return false;
+	if (L <= need + 2)
+		return false; // last chance: the channel would land
+	const int ring = DTG_TAB[2];
+	if (dme < ring)
+		return false; // already inside her reach: the live walk decides
+	for (const auto& al : W.allies)
+		if (al.hp > 0 && !al.channeling() && cheb(al.pos, W.me.pos) <= 3 && cheb(al.pos, tgt.pos) <= dme + 2)
+			return false; // a second body is with me: go together
+	if (dme == ring)
+		return true;
+	if (!W.can_move())
+		return true;
+	bitboard goals;
+	bool any = false;
+	for (int dy = -ring; dy <= ring; ++dy)
+		for (int dx = -ring; dx <= ring; ++dx)
+		{
+			const vec2 q{ tgt.pos.x + dx, tgt.pos.y + dy };
+			if (cheb(q, tgt.pos) != ring || !inb(q) || !mv::free_tile(q))
+				continue;
+			bbset(goals, q);
+			any = true;
+		}
+	stepped = any && mv::step_to_set(goals, GD_RAD);
+	return true;
+}
