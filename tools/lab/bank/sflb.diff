 // combat_memory.cc: Observe and the per-round combat trackers.
 #include "combat_internal.h"
+namespace nova::econ { namespace { static int foe_reach_in_turns(const Body& e, int n); } } // SFL bit 1 (econ_threat_sense.cc)
 namespace nova::combat {
+namespace stance { static int foe_turns_within_rounds(const Body& e, int k); } // SFL bit 1 (combat_assess_contact.cc)
+// SFL bit 4: the nearest visible foe's one-turn reach + 2 (3 with none visible).
+static __attribute__((noinline)) int sfl_reach_margin(const Assessment& a)
+{
+	int bd = 1 << 20, m = 3;
+	for (const auto& f : a.foes)
+	{
+		if (f.idx < 0 || f.idx >= static_cast<int>(W.enemies.size()))
+			continue;
+		const Body& e = W.enemies[static_cast<std::size_t>(f.idx)];
+		const int d = cheb(e.pos, W.me.pos);
+		if (d < bd)
+		{
+			bd = d;
+			m = econ::foe_reach_in_turns(e, 1) + 2;
+		}
+	}
+	return m;
+}
+// SFL bit 1: a visible foe with two turns before my next one has me within its two-turn reach.
+static __attribute__((noinline)) bool sfl_double_turn_reach(const Assessment& a)
+{
+	for (const auto& f : a.foes)
+	{
+		if (f.idx < 0 || f.idx >= static_cast<int>(W.enemies.size()))
+			continue; // a remembered foe has no turn-order read
+		const Body& e = W.enemies[static_cast<std::size_t>(f.idx)];
+		if (cheb(e.pos, W.me.pos) <= econ::foe_reach_in_turns(e, 2) && stance::foe_turns_within_rounds(e, 2) >= 2)
+			return true;
+	}
+	return false;
+}
