+// b2368 PGN bit 1 (caller read the flag): a hold by a kit with no single-target damage spell (the Prism) casts its damage stun on the
+// channeller first (a deny hold keeps it for the channeller only), else on the weakest foe in range; else its area spell on that foe.
+// Guards as hold_shot: no foe on its own spawn, no Ren whose retaliation kills me; the area spell wakes no other camp.
+static bool pgn_hold_alt(bool keep_reset_stun, const Body* pref)
+{
+	const Kit& k = *W.me.kit;
+	auto ok = [&](const Body& e, float r) {
+		return !foe_model::unreachable(e) && cheb(e.pos, W.me.pos) <= static_cast<int>(r) && !bbget(M.enemy_spawn, e.pos) && !ren_layer::kills_me(e);
+	};
+	auto weakest = [&](auto&& good) -> const Body* {
+		const Body* best = nullptr;
+		float bh = 1e9f;
+		for (const auto& e : W.enemies)
+			if (good(e) && eff_hp(e) < bh)
+			{
+				bh = eff_hp(e);
+				best = &e;
+			}
+		return best;
+	};
+	if (k.slot_cc >= 0 && k.cc_mod > 0 && ready(k.slot_cc) && (!k.cc_excl || !W.moved))
+	{
+		auto okc = [&](const Body& e) { return ok(e, k.cc_range) && !e.stunned && !marcella_layer::fight_stun_wasted(e); };
+		if (pref && okc(*pref))
+			return cast_on_champion(k.slot_cc, *pref);
+		const Body* t = keep_reset_stun ? nullptr : weakest(okc);
+		if (t && cast_on_champion(k.slot_cc, *t))
+			return true;
+	}
+	if (!W.cast && k.slot_aoe >= 0 && k.aoe_mod > 0 && ready(k.slot_aoe) && (!k.aoe_excl || !W.moved))
+	{
+		auto oka = [&](const Body& e) { return ok(e, k.aoe_range); };
+		const Body* t = pref && oka(*pref) ? pref : weakest(oka);
+		if (t && kit_rules::ren_retaliation_of_cast(k.slot_aoe, 0u, 0u, t->pos) < eff_hp(W.me) && !AreaGrid::wakes_other(t->pos, static_cast<int>(k.aoe_radius), -1))
+			return cast_at(k.slot_aoe, t->pos);
+	}
+	return false;
