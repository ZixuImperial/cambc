+// combat_jvd_tail.cc: b2237 JVD, the keyed priority tail (spec_jvd_1112 builds, spec_pky_1110 carrier). Every entry is behind its bit.
+// Message (20 bits, xor a per-game, per-slot key, constant all game (form A, b2271); written only while a foe champion is within 9, else 0): seen foe mask 6 (roster order) | summed foe mask 6 | friend mask 5 (the
+// other slots I counted, my slot skipped) | verdict 2 (0 calm, 1 fight, 2 flee, 3 latched flee) | taken 1.
+#include "combat_internal.h"
+namespace nova::combat::jvt {
+namespace {
+std::uint32_t key_k = 0;
+int last_raw = 0, last_full = 0;
+bool raw_set = false;
+int wrote_r = -1000, note_r = -1000, asm_r = -1000, tail_r = -1000, solo_r = -1000;
+std::uint32_t msg = 0, sum_m = 0, fr_m = 0, my_seen_last = 0;
+bool taken_last = false, solo_ok = false, force_sets = false;
+int taken_last_r = -1000;
+struct Tail
+{
+	int slot = -1;
+	bool fresh = false;
+	std::uint32_t seen = 0, sum = 0, fr = 0; // fr: our slots it counted (decoded to slot bits)
+	int verdict = 0;
+	bool taken = false;
+};
+std::array<Tail, 8> tails{};
+int tail_n = 0;
+std::uint32_t mix32(std::uint32_t x)
+{
+	x ^= x >> 16;
+	x *= 0x7FEB352Du;
+	x ^= x >> 15;
+	x *= 0x846CA68Bu;
+	x ^= x >> 16;
+	return x;
+}
+std::uint32_t key()
+{
+	if (key_k == 0)
+	{
+		// Our draft memory (unreadable to the foe) + the board + our lineup; the same on every body of the team.
+		std::uint32_t k = 0x4A564431u ^ static_cast<std::uint32_t>(G.w * 131 + G.h);
+		for (int id : { 7, 8, 10, 14 })
+			k = mix32(k ^ dmem::extra(id, 0x5A17u + static_cast<std::uint32_t>(id)));
+		for (int s = 0; s < P.n && s < 8; ++s)
+			k = mix32(k ^ (static_cast<std::uint32_t>(P.type[static_cast<std::size_t>(s)]) + 977u * static_cast<std::uint32_t>(s)));
+		key_k = k ? k : 0x1234567u;
+	}
+	return key_k;
+}
+// Form A (Shared Mem, after the .463 carrier read): constant per body per game, so the value changes only when the order or the message does.
+std::uint32_t key20(int slot)
+{
+	return mix32(key() ^ (static_cast<std::uint32_t>(slot) * 0x85EBCA6Bu)) & 0xFFFFFu;
+}
+int roster_of(std::uint32_t h)
+{
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size() && i < 6; ++i)
+		if (tt[i].h == h)
+			return static_cast<int>(i);
+	return -1;
+}
+std::uint32_t seen_now()
+{
+	std::uint32_t m = 0;
+	for (const auto& e : W.enemies)
+	{
+		const int k = roster_of(e.h);
+		if (k >= 0)
+			m |= 1u << k;
+	}
+	return m;
+}
+int popc(std::uint32_t m) { return __builtin_popcount(m); }
+// The visible mates' tails, read once a round (one host read each; rc 97 or a slot field that does not match = no tail).
+void read_tails()
+{
+	if (tail_r == W.round)
+		return;
+	tail_r = W.round;
+	tail_n = 0;
+	if (!jvd_carrier)
+		return;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0 || al.slot >= P.n || tail_n >= 8)
+			continue;
+		std::int32_t v = 0;
+		if (cambc::detail::sdk_bc_champion_priority(al.h, 1, &v) != 0)
+			continue;
+		const std::uint32_t u = static_cast<std::uint32_t>(v);
+		if (((u >> 20) & 7u) != 7u - static_cast<std::uint32_t>(al.slot))
+			continue;
+		const bool fresh = (al.state & FLEE_FIX_ST_ACTED) != 0; // its turn this round is done: this round's write (b2236)
+		const std::uint32_t m = (u ^ key20(al.slot)) & 0xFFFFFu;
+		Tail t;
+		t.slot = al.slot;
+		t.fresh = fresh;
+		t.seen = m & 63u;
+		t.sum = (m >> 6) & 63u;
+		const std::uint32_t f5 = (m >> 12) & 31u;
+		for (int i = 0; i < 5; ++i)
+			if (f5 & (1u << i))
+				t.fr |= 1u << (i < al.slot ? i : i + 1);
+		t.verdict = static_cast<int>((m >> 17) & 3u);
+		t.taken = ((m >> 19) & 1u) != 0;
+		// RC C707 JVD1-F1: a tail that cannot be ours (a stale key) is dropped: summed within seen, no bit past the rosters, taken only with FIGHT
+		const std::uint32_t nr = static_cast<std::uint32_t>(std::min<std::size_t>(6, intel::team_table().size()));
+		const std::uint32_t fm = (1u << nr) - 1u, om = (1u << static_cast<std::uint32_t>(std::min(P.n, 8))) - 1u;
+		if ((t.sum & ~t.seen) != 0 || (t.seen & ~fm) != 0 || (t.fr & ~om) != 0 || (t.taken && t.verdict != 1))
+			continue;
+		tails[static_cast<std::size_t>(tail_n++)] = t;
+	}
+}
+// A mate that counted me this turn (its friend mask holds my slot): mutual sight, the same fight.
+bool counts_me(const Tail& t) { return P.my_slot >= 0 && (t.fr & (1u << P.my_slot)) != 0; }
+} // namespace
+int compose(int raw)
+{
+	if (!jvd_carrier)
+		return raw;
+	const std::uint32_t m = note_r == W.round ? msg : 0u; // no message this turn: the constant message-0 value
+	const int s = P.my_slot;
+	if (m == 0) // b2271 A': message 0 = one team-wide value per raw (equal raws tie as at flag 0: live foe_rank has no tie-break; slot field 0 = no tail)
+		return static_cast<int>((static_cast<std::uint32_t>(raw) << 23) | (key() & 0xFFFFFu));
+	return static_cast<int>((static_cast<std::uint32_t>(raw) << 23) | ((7u - static_cast<std::uint32_t>(s)) << 20) | ((m ^ key20(s)) & 0xFFFFFu));
+}
+int wire(int raw)
+{
+	wrote_r = W.round;
+	last_raw = raw;
+	raw_set = true;
+	last_full = compose(raw);
+	return last_full;
+}
+// Nothing to write: the value I hold is the one this turn would publish (form A: writes only on a change of order or message).
+bool wrote_this_round() { return !raw_set || compose(last_raw) == last_full; }
+bool last_raw_written(int& v)
