+		taken = true;
+		read_tails();
+		for (int i = 0; i < tail_n; ++i)
+		{
+			const Tail& t = tails[static_cast<std::size_t>(i)];
+			if (t.slot == linked_slot())
+				continue; // RC C707 JVD2-F1: my C&I partner is not another taker
+			if (t.taken && t.verdict == 1 && t.seen == seen && (t.fresh || t.slot < P.my_slot))
+				taken = false; // a mate already holds it (this round's, or last round's at a lower slot)
+		}
+	}
+	taken_last = taken;
+	taken_last_r = W.round;
+	my_seen_last = seen;
+	msg = (seen & 63u) | ((sm & 63u) << 6) | ((f5 & 31u) << 12) | (static_cast<std::uint32_t>(vd) << 17) | ((taken ? 1u : 0u) << 19);
+}
+bool sets_on() { return JVD_ON(4) || force_sets; }
+bool mate_sums(int idx)
+{
+	if (idx < 0 || idx >= static_cast<int>(W.enemies.size()))
+		return false;
+	const int k = roster_of(W.enemies[static_cast<std::size_t>(idx)].h);
+	if (k < 0)
+		return false;
+	read_tails();
+	for (int i = 0; i < tail_n; ++i)
+		if (counts_me(tails[static_cast<std::size_t>(i)]) && (tails[static_cast<std::size_t>(i)].sum & (1u << k)))
+			return true;
+	return false;
+}
+bool mate_counts(int slot)
+{
+	read_tails();
+	for (int i = 0; i < tail_n; ++i)
+	{
+		const Tail& t = tails[static_cast<std::size_t>(i)];
+		if (counts_me(t) && (t.slot == slot || (t.fr & (1u << slot))))
+			return true;
+	}
+	return false;
+}
+bool mate_fights_my_foe()
+{
+	const std::uint32_t sm = asm_r == W.round ? sum_m : 0u;
+	if (sm == 0)
+		return false;
+	read_tails();
+	for (int i = 0; i < tail_n; ++i)
+	{
+		const Tail& t = tails[static_cast<std::size_t>(i)];
+		if (t.fresh && counts_me(t) && t.verdict == 1 && (t.sum & sm)) // RC C707 JVD8-F1: this round's verdict only
+			return true;
+	}
+	return false;
+}
+bool taken_yield(const Assessment& a, bool kill_now)
+{
+	if (kill_now || a.stance != FIGHT || !jvd_carrier)
+		return false;
+	const std::uint32_t seen = seen_now();
+	if (popc(seen) < 1 || popc(seen) > 2)
+		return false;
+	read_tails();
+	for (int i = 0; i < tail_n; ++i)
+	{
+		const Tail& t = tails[static_cast<std::size_t>(i)];
+		if (!(t.taken && t.verdict == 1 && t.seen == seen))
+			continue;
+		if (t.slot == linked_slot())
+			continue; // RC C707 JVD2-F1: never yield to my C&I partner
+		// last round's tail of a mate that has not acted yet: if I held it too last round, the lower slot keeps it
+		if (!t.fresh && taken_last && taken_last_r == W.round - 1 && my_seen_last == seen && P.my_slot < t.slot)
+			continue;
+		return true;
+	}
+	return false;
+}
+bool reassess_flee(Assessment& a)
+{
+	if (a.stance != FLEE || JVD_ON(4) || lethal_spot.round == W.round || fuel() < 45000 || !mate_fights_my_foe()) // fuel: the re-assess ran into cut-offs (prearm fault 29 v 5)
+		return false;
+	force_sets = true;
+	Assessment b = assess();
+	force_sets = false;
+	apply_flee_latch_and_history(b);
+	a = b;
+	return true;
+}
+} // namespace nova::combat::jvt
