+		if (s != P.my_slot && (fm & (1u << s)))
+			f5 |= 1u << (s < P.my_slot ? s : s - 1);
+	const bool latched = a.stance == FLEE && (W.round <= memory::bc_until || W.round <= memory::sf_until);
+	const int vd = a.stance == FIGHT ? 1 : a.stance == FLEE ? (latched ? 3 : 2) : 0;
+	bool taken = false;
+	if (JVD_ON(2) && a.stance == FIGHT && a.in_reach && popc(seen) >= 1 && popc(seen) <= 2 && (!JVD_ON(16) || (solo_r == W.round && solo_ok)))
