+void begin_assess()
+{
+	asm_r = W.round;
+	sum_m = 0;
+	fr_m = 0;
+}
+void mark_summed(int idx)
+{
+	if (idx >= 0 && idx < static_cast<int>(W.enemies.size()))
+	{
+		const int k = roster_of(W.enemies[static_cast<std::size_t>(idx)].h);
+		if (k >= 0)
+			sum_m |= 1u << k;
+	}
+}
+void mark_friend(int slot)
+{
+	if (slot >= 0 && slot < 8 && slot != P.my_slot)
+		fr_m |= 1u << slot;
+}
+void note_solo(float solo_fc, float engage)
+{
+	solo_r = W.round;
+	solo_ok = solo_fc >= engage;
+}
+void note(const Assessment& a)
+{
+	if (!jvd_carrier)
+		return;
+	note_r = W.round;
+	bool near9 = false;
+	for (const auto& e : W.enemies)
+		near9 = near9 || cheb(e.pos, W.me.pos) <= 9;
+	if (!near9 || !JVD_ON(2 | 4 | 8)) // form A: a message only while a foe champion is within 9, and only for a bit that reads it (bit 1 alone = message 0)
+	{
+		msg = 0;
+		taken_last = false;
+		taken_last_r = W.round;
+		my_seen_last = 0;
+		return;
+	}
+	const std::uint32_t seen = seen_now();
+	const std::uint32_t sm = asm_r == W.round ? sum_m : 0u, fm = asm_r == W.round ? fr_m : 0u;
+	std::uint32_t f5 = 0;
