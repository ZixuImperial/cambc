+// SCE: CORR(g)'s adj_free (1-2) for a corridor-attacker group, else 0 (static map data; econ_clear_estimate.cc caches it per group).
+int sce_group_corr(const nova::GroupI& g)
+{
+	using namespace nova;
+	if (g.att.empty())
+		return 0;
+	std::array<vec2, 3> adj{};
+	int na = 0;
+	for (int ci : g.members)
+	{
+		const vec2 cp = M.camps[static_cast<std::size_t>(ci)].pos;
+		for (int dx = -1; dx <= 1; ++dx)
+			for (int dy = -1; dy <= 1; ++dy)
+			{
+				const vec2 t{ cp.x + dx, cp.y + dy };
+				if ((dx == 0 && dy == 0) || !inb(t) || bbget(M.block, t) || bbget(M.camp_tiles, t))
+					continue;
+				bool seen = false;
+				for (int k = 0; k < na; ++k)
+					seen |= adj[static_cast<std::size_t>(k)] == t;
+				if (seen)
+					continue;
+				if (na >= 2)
+					return 0; // three or more free tiles: not a corridor group
+				adj[static_cast<std::size_t>(na++)] = t;
+			}
+	}
+	for (int k = 0; k < na; ++k)
+	{
+		const vec2 t = adj[static_cast<std::size_t>(k)];
+		int w = 0;
+		for (int dx = -1; dx <= 1; ++dx)
+			for (int dy = -1; dy <= 1; ++dy)
+			{
+				const vec2 u{ t.x + dx, t.y + dy };
+				w += ((dx || dy) && inb(u) && !bbget(M.block, u)) ? 1 : 0;
+			}
+		if (w > 2)
+			return 0;
+	}
+	return na;
+}
+static bool sce_map_any()
