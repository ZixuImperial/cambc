+// SCE: CORR(g)'s adj_free, cached per group (reached only on an SCE-class map with the flag on).
+std::vector<std::int8_t> sce_cache;
+int sce_corr(const GroupI& g)
+{
+	if (g.idx < 0)
+		return 0;
+	const auto gi = static_cast<std::size_t>(g.idx);
+	if (sce_cache.size() < static_cast<std::size_t>(M.ng))
+		sce_cache.assign(static_cast<std::size_t>(M.ng), -1);
+	if (gi >= sce_cache.size())
+		return 0;
+	if (sce_cache[gi] < 0)
+		sce_cache[gi] = static_cast<std::int8_t>(sce_group_corr(g));
+	return sce_cache[gi];
+}
+// SCE (a): melee damage from at most adj_free melee bodies (equal shares per body: the crew keeps no per-body melee split).
