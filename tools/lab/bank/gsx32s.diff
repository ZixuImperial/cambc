+static int gsx_vg_last[8] = { -1, -1, -1, -1, -1, -1, -1, -1 }, gsx_vg_spent[8] = {};
+void gsx_vjn_tick()
+{
+	for (int s = 0; s < P.n && s < 8; ++s)
