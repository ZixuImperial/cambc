+			std::uint32_t v = 0;
+			if (cambc::detail::sdk_champion_gold(P.handle[static_cast<std::size_t>(s)], &v) == 0)
+				g = static_cast<int>(v);
+		}
+		if (g < 0)
+			continue;
+		if (gsx_vg_last[s] > g)
+			gsx_vg_spent[s] += gsx_vg_last[s] - g;
+		gsx_vg_last[s] = g;
+	}
