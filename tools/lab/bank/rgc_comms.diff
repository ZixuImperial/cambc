+static int rga_img_r = -1000;
+static void rga_lq_push(int subject, int type, int stamp)
+{
+	if (lq.r != cur_round)
+	{
+		lq.r = cur_round;
+		lq.n = 0;
+	}
+	if (lq.n >= static_cast<int>(lq.e.size()))
+		return;
+	auto& e = lq.e[static_cast<std::size_t>(lq.n++)];
+	e.subject = subject;
+	e.type = type;
+	e.stamp = stamp & STAMP_MASK;
+}
+static bool rga_legacy_in(int subject, int type, int round)
+{
+	const bool taken = rga_img_r == cur_round && V.ev.subject >= 0;
+	rga_img_r = cur_round;
+	if (!taken)
+		return false; // the image is free: as the base
+	if (V.ev.type < EV_TYPE_HELP && type < EV_TYPE_HELP)
+		rga_lq_push(V.ev.subject, V.ev.type, V.ev.stamp); // two news: the first drains, the second takes the image (as the base)
+	else if (V.ev.type < EV_TYPE_HELP)
+		rga_lq_push(V.ev.subject, V.ev.type, V.ev.stamp); // a HELP or CREW displaces a news event: the news drains
+	else if (type < EV_TYPE_HELP)
+	{
+		rga_lq_push(subject, type, round); // the image keeps its HELP
+		return true;
+	}
+	return false;
+}
+void rga_lq_drain_begin(int t)
+{
+	if (lq.r != t)
+		lq.n = 0;
+}
