diff --git a/src/combat_flee.cc b/src/combat_flee.cc
--- a/src/combat_flee.cc
+++ b/src/combat_flee.cc
@@ -915,8 +915,53 @@ bool spz_b_refuse(vec2 dest)
 }
 bool spz_b_scope(bool in)
 {
 	spz_b_in_r = in ? W.round : -1;
 	return false;
 }
+// b2390 PNC bit 1 (combat_flags.h): a fight_stage step into an awake camp's hits, with a free outside tile one step away, is refused.
+bool pnc_step(vec2 dest, vec2* alt)
+{
+	if (spz_b_in_r != W.round || mv::camp_threat(dest) <= 0)
+		return false;
+	const Body* foe = nullptr;
+	for (const auto& e : W.enemies)
+		if (!foe || cheb(e.pos, dest) < cheb(foe->pos, dest))
+			foe = &e;
+	const Body* mate = nullptr;
+	if (foe)
+		for (const auto& al : W.allies)
+			if (!mate || cheb(al.pos, foe->pos) < cheb(mate->pos, foe->pos))
+				mate = &al;
+	bool any = false;
+	float best = 2.0f;
+	vec2 bq{ -1, -1 };
+	for (const vec2 dd : DIRS)
+	{
+		const vec2 q = W.me.pos + dd;
+		if (!inb(q) || !mv::free_tile(q) || mv::camp_threat(q) > 0)
+			continue;
+		any = true;
+		if (!foe || cheb(q, foe->pos) > cheb(dest, foe->pos))
+			continue; // the substitute keeps the approach: no farther from the foe than the refused tile
+		float c = 0.0f; // the cosine of the angle at the foe between q and the mate (lower = wider)
+		if (mate)
+		{
+			const float ax = static_cast<float>(q.x - foe->pos.x), ay = static_cast<float>(q.y - foe->pos.y);
+			const float bx = static_cast<float>(mate->pos.x - foe->pos.x), by = static_cast<float>(mate->pos.y - foe->pos.y);
+			const float na = std::sqrt(ax * ax + ay * ay), nb = std::sqrt(bx * bx + by * by);
+			c = (na > 0.0f && nb > 0.0f) ? (ax * bx + ay * by) / (na * nb) : 0.0f;
+		}
+		if (c < best)
+		{
+			best = c;
+			bq = q;
+		}
+	}
+	if (!any)
+		return false; // no tile outside the reach within a step: live
+	if (alt)
+		*alt = bq;
+	return true;
+}
 } // namespace nova::combat
 
