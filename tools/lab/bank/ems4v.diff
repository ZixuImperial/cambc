+// b2454 EMS bit 4 (caller read the flag): Marcella's stun is attack, reset, armed hit in one turn (INT:179, GR:652-662); a stun stops a tribute
+// (GR:275). end_stun's targets (a winning bag first, else the richest bag >= the CS floor when cs) within her step + melee reach: step if
+// needed, then attack, reset, armed hit.
+static __attribute__((noinline)) bool ems_reset_stun(bool st, bool cs)
+{
+	const Kit& k = *W.me.kit;
+	if (W.cast || !W.can_attack() || !ready(k.slot_reset))
+		return false;
+	const int reach = W.me.range + (W.can_move() ? 1 : 0);
+	auto ok = [&](const Body& e) {
+		return (e.state & ST_TRIBUTE) && !e.stunned && marcella_layer::fight_stun_holds(e) && cheb(e.pos, W.me.pos) <= reach && !ren_layer::kills_me(e) &&
+			!foe_model::unreachable(e);
+	};
+	const Body* t = nullptr;
+	if (st)
+		for (const auto& e : W.enemies)
+			if (ok(e) && W.tributed_them + static_cast<int>(e.gems) >= rs::WIN_TRIBUTE)
+			{
+				t = &e;
+				break;
+			}
+	if (!t && cs)
+		for (const auto& e : W.enemies)
+			if (ok(e) && e.gems >= static_cast<unsigned>((EMS_ON(8) && W.tributed_them > W.tributed_us) ? CS_BAG / 2 : CS_BAG) && (!t || e.gems > t->gems))
+				t = &e;
+	if (!t)
+		return false;
+	const Body tb = *t;
+	if (cheb(tb.pos, W.me.pos) > W.me.range && !mv::step_to(tb.pos, W.me.range, 8))
+		return false;
+	if (cheb(tb.pos, W.me.pos) > W.me.range)
+		return true; // stepped, still out of reach
+	if (!attack_via_sdk(KIND_CHAMPION, tb.h))
+		return W.moved;
+	if (!W.cast && ready(k.slot_reset) && cast_self(k.slot_reset))
+		attack_via_sdk(KIND_CHAMPION, tb.h); // the armed hit stuns
+	NLOG("r%d slot %d ems-stun gems %u\n", W.round, P.my_slot, tb.gems);
+	return true;
+}
