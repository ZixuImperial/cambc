+// NRF (b2029, spec_nrf_1111): a no-route fallback, called only when the approach / tank walk moved nothing: the target group's ready
+// walk field when I stand beyond the search radius on it, else one search at radius 2R (fuel allowing). Once a turn.
+namespace {
+int nrf_round = -10; // the turn the fallback last ran
+} // namespace
+bool nrf_fallback(const bitboard& goals, int rad, int gi, long cost)
+{
+	if (!W.alive || !W.can_move() || W.moved || nrf_round == static_cast<int>(W.round))
+		return false;
+	const vec2 me = W.me.pos;
+	if (bbget(goals, me))
+		return false;
+	nrf_round = static_cast<int>(W.round);
+	if (gi >= 0)
+		if (const distance_field* gf = group_field_ready(gi))
+		{
+			const std::uint16_t v = dfget(*gf, me);
+			if (v != UNREACH && v > static_cast<std::uint16_t>(rad) && step_field(*gf, gi))
+				return true;
+		}
+	const long left = fuel();
+	if (left <= cost * 4 + NRF_TAB[2])
+		return false;
+	const int r2 = std::min(2 * rad, 80);
+	if (r2 <= rad)
+		return false;
+	static bitboard nw, nr, nd, nv;
+	static distance_field nf;
+	nw = dynamic_walls();
+	if (avoid_on)
+		nw |= avoid_bb;
+	bbset(nw, me, false);
+	nr = goals;
+	nr &= ~nw;
+	if (!bbany(nr))
+		return false;
+	nd.clear();
+	bbset(nd, me);
+	nv.clear();
+	nf.compute_to(nw, nr, nd, nv, static_cast<std::uint16_t>(r2));
+	const std::uint16_t cur = dfget(nf, me);
+	if (cur == UNREACH)
+		return false;
+	CandList cands;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!inb(n) || bbget(nw, n))
+			continue;
+		const std::uint16_t v = dfget(nf, n);
+		if (v == UNREACH || v >= cur)
+			continue;
+		cands.push_back({ n, static_cast<int>(v) * tune::STEP_TILE + static_cast<int>(camp_threat(n, gi)) });
+	}
+	return !cands.empty() && move_best(cands);
+}
+bool nrf_fallback_to(vec2 target, int stop, int rad, int gi, long cost)
+{
+	if (!inb(target) || cheb(W.me.pos, target) <= stop)
+		return false;
+	static bitboard g;
+	g.clear();
+	g.draw_chebyshev(target, static_cast<float>(std::max(0, stop)));
+	return nrf_fallback(g, rad, gi, cost);
+}
