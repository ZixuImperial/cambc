diff --git b/src/feat_shp.cpp b/src/feat_shp.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_shp.cpp
@@ -0,0 +1,75 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_shp.cpp (b1506): SHP, short shop trips and Greed by match tempo (SHP_BITS, feat_shp.h). Unity build: econ.cpp comes first,
+// so its build list, S, make_build and fxm_my_items are in scope.
+#include "feat_shp.h"
+namespace nova::econ::shp
+{
+namespace
+{
+int lead_r0 = 0, lead_v0 = 0, lead_r1 = 0, lead_v1 = 0; // bit 2: the tribute lead at two shop visits, SHP_WIN+ rounds apart
+bool passive(std::uint32_t si)
+{
+	const std::uint32_t f = si / 6u;
+	return f != 1u && f != 6u && f != 12u; // Power, Bruiser and Greed have no passive (GameRules.md:303-320)
+}
+} // namespace
+int need()
+{
+	if (build_ready && upitm_stale())
+		build_ready = false;
+	if (!build_ready)
+		make_build();
+	try
+	{
+		FxmItems counts;
+		fxm_my_items(counts);
+		std::array<int, 96> nd;
+		vzero(nd);
+		for (const auto& sh : build)
+		{
+			const auto si = static_cast<std::uint32_t>(sh);
+			if (si + 1u >= nd.size())
+				continue;
+			++nd[si];
+			if (static_cast<int>(counts[cambc::item_type(si + 1u)]) >= nd[si])
+				continue;
+			if (!passive(si))
+				return 150; // a pure-stat buy: a trip buys five shards' worth
+			return 30 * std::max(1, 5 - static_cast<int>(counts[sh])); // finish this emblem
+		}
+		return 1 << 24;
+	}
+	catch (...)
+	{
+	}
+	return 150;
+}
+void note()
+{
+	skip = 0;
+	if (now() - lead_r1 >= SHP_TAB[4])
+	{
+		lead_r0 = lead_r1;
+		lead_v0 = lead_v1;
+		lead_r1 = now();
+		lead_v1 = W.tributed_us - W.tributed_them;
+	}
+}
+int gate(const decltype(cambc::self().item_count())& counts, float rl)
+{
+	std::array<int, 96> nd;
+	vzero(nd);
+	for (const auto& sh : build)
+	{
+		const auto si = static_cast<std::uint32_t>(sh);
+		if (si + 1u >= nd.size())
+			continue;
+		++nd[si];
+		if (passive(si) && static_cast<int>(counts[cambc::item_type(si + 1u)]) < nd[si])
+			return 1; // a passive emblem is still unfinished: buy it first
+	}
+	const bool long_game = rl >= static_cast<float>(SHP_TAB[2]) && W.tributed_us - W.tributed_them >= lead_v0 && now() - S.enemy_close > SHP_TAB[3];
+	return long_game ? 0 : 2;
+}
+} // namespace nova::econ::shp
+#endif
diff --git b/src/feat_shp.h b/src/feat_shp.h
new file mode 100644
--- /dev/null
+++ b/src/feat_shp.h
@@ -0,0 +1,26 @@
+#pragma once
+// SHP (b1506, owner 7 Nov: "recall less to shop when we have less than what we need for emblems"; "figure out the tempo of the
+// match before buying Greed"). One runtime data flag, read first; 0 = v604. Hooks in econ.cpp (want_shop, capture_recall, rts_due,
+// grt_gate, shop).
+// Bit 1 SHORT: a recall made only to shop (shop_recall's want_shop, the shop-only capture-timed recall, RT_SHOP's shop reason) needs
+//   gold >= the cost to finish the next emblem in the build; a pure-stat entry (Power, Bruiser, Greed: no passive) needs 150.
+//   Heal and bank recalls still shop whatever they can afford.
+// Bit 2 GREED: a Greed entry about to get its first shard waits while any passive emblem of the build is unfinished (the visit buys
+//   the others), and turns back into its source entries (as GRT's gate) unless the match looks long: race rounds left >= SHP_RL, our
+//   tribute lead not below its value SHP_WIN+ rounds ago, and no foe within recall reach of this body in the last SHP_QUIET rounds.
+#include <cstdint>
+#include "common.h"
+#define SHP_BITS 0
+#define SHP_RL 350
+#define SHP_QUIET 30
+#define SHP_WIN 60
+inline const volatile int SHP_TAB[5] = { 0x53485031, SHP_BITS, SHP_RL, SHP_QUIET, SHP_WIN };
+#define SHP_ON(b) ((SHP_TAB[1] & (b)) != 0)
+namespace nova::econ::shp
+{
+inline std::uint32_t skip = 0; // bit 2: Greed stats (1 << stat) skipped on this shop visit
+int need();                    // bit 1: the gold a shop-only trip needs
+void note();                   // bit 2: the tribute-lead snapshot, once a shop visit
+int gate(const decltype(cambc::self().item_count())& counts, float rl); // bit 2: 0 buy Greed, 1 skip it this visit, 2 turn it back
+inline bool skipped(std::uint32_t si) { return si / 6u == 12u && ((skip >> ((si % 6u) / 2u)) & 1u) != 0u; }
+} // namespace nova::econ::shp
