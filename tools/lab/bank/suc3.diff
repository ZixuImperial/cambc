diff --git a/src/common_flags.h b/src/common_flags.h
--- a/src/common_flags.h
+++ b/src/common_flags.h
@@ -1030,6 +1030,17 @@ __attribute__((noinline)) inline void wfl_fc_2() { __asm__ volatile(""); }
 #define SRL_BITS 6
 // v7xx RKB (b1912 bug-bar bundle): bit 1 R2B 8192 E6, my or an allied Capture holder on the group prices its capture 1 + 3 (GameRules:196) in finish_target_before_shop
 // v761 RKB: allied Capture holder prices capture 1+3
 #define RKB_BITS 1
 inline constexpr int RKB_TAB[2] = { 0x524B4231, RKB_BITS }; // slot 0 magic keeps it out of .bss
 inline constexpr int SRL_TAB[2] = { 0x53524C31, SRL_BITS }; // slot 0 magic keeps it out of .bss
+// SUC (b1951, RC X396 /data/zw4424/rulecheck/p6/x396_skipped.md, C376): first-turn cut-offs. Runtime data flag SUC_TAB[1], read first; 0 = v766.
+// Bit 1 SUC1: setup() starts only with SUC_TAB[2] left (measured setup cost max 62k; 50k cut all 6 bodies on many-group maps, GR:401).
+// Bit 2 SUC2: SPD SPLIT rebuilt (setter dead-stripped in ds19k): a body's first turn() ends after econ::observe when the fuel left is
+// below the measured rest of a first turn: SUC_TAB[3] when start..observe cost below SUC_TAB[5], else SUC_TAB[4].
+#define SUC_BITS 0
+inline const volatile int SUC_TAB[6] = { 0x53554331, SUC_BITS, 63000, 58000, 82000, 40000 }; // slot 0 magic keeps it out of .bss
+#define SUC_ON(b) ((SUC_TAB[1] & (b)) != 0)
+inline bool suc_done = false;  // SUC bit 2: the body's first turn() has started (one flag for every DM instantiation, C376)
+inline bool suc_first = false; // SUC bit 2: this turn() is the body's first
+inline long suc_f0 = 0;        // fuel and round when that turn() began
+inline int suc_r0 = 0;
