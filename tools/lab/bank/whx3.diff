+#define WHX_HEAL_X100 75
+#define WHX_DEAD_PCT 0 // unused slot (bit 1 uses crew dps x walk)
+#define WHX_NEAR 8
+inline const volatile int WHX_TAB[5] = { 0x57485832, WHX_BITS, WHX_HEAL_X100, WHX_DEAD_PCT, WHX_NEAR };
+#define WHX_ON(b) ((WHX_TAB[1] & (b)) != 0)
 
