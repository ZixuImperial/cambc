+// WHX bit 4 (b1815, caller read the flag): crew c (members: self, gi's claimants, extras ex) cannot clear heavy group gi; our free
+// Willow near the evaluating body or the anchor (or claiming gi) adds her heal (x WHX_HEAL_X100 / 100, no damage or stuns) as
+// support. Kept only when the credited crew clears it in one trip (dmg <= budget); then e = the credited estimate.
+static __attribute__((noinline)) bool whx_credit(int gi, int self, const Claims& cl, const GroupI& g, const GroupMem& m, const Crew& c,
+	const Claims& ex, ClearEst& e)
+{
+	if (!(g.n_golem > 0 || g.n_elk >= 2) || g.n_mono > 0 || g.n_att <= 0 || g.access != ACC_WALK || c.n < 1)
+		return false;
+	int w = -1;
+	for (int s = 0; s < P.n && s < 8 && s < TM.n; ++s)
+		if (willow_layer::type(P.type[static_cast<std::size_t>(s)]))
+		{
+			w = s;
+			break;
+		}
+	const auto ws = static_cast<std::size_t>(w);
+	if (w < 0 || w == self || !siege_ally_alive(w) || cl[ws] == gi || (TM.busy[ws] && TM.claim[ws] != gi))
+		return false;
+	for (int i = 0; i < 8; ++i)
+		if (ex[static_cast<std::size_t>(i)] == w)
+			return false; // she is already in the crew
+	vec2 wp{}, sp{};
+	bool wv = false, sv = false;
+	if (w == my_slot())
+	{
+		wp = W.me.pos;
+		wv = W.alive;
+	}
+	if (self == my_slot())
+	{
+		sp = W.me.pos;
+		sv = true;
+	}
+	for (const auto& al : W.allies)
+	{
+		if (al.slot == w && !wv && !al.channeling())
+		{
+			wp = al.pos;
+			wv = true;
+		}
+		if (al.slot == self && !sv)
+		{
+			sp = al.pos;
+			sv = true;
+		}
+	}
+	const int nr = WHX_TAB[4];
+	if (!(TM.claim[ws] == gi || (wv && (cheb(wp, g.anchor) <= nr || (sv && cheb(wp, sp) <= nr)))))
+		return false;
+	if (siege_enemies_near_group(gi, 15) != 0)
+		return false;
+	Member hx = TM.m[ws];
+	hx.dps1 = hx.dps3 = hx.stuns = hx.ko1_area = hx.ko1_land = hx.ko1_cc = hx.ko1_ccp = 0;
+	hx.heal *= static_cast<float>(WHX_TAB[2]) * 0.01f;
+	Crew c2 = c;
+	c2.add_support(hx);
+	const ClearEst e2 = estimate_cx(1, g, m, c2);
+	if (!(e2.feasible && e2.dmg <= e2.budget))
+		return false;
+	e = e2;
+	return true;
+}
