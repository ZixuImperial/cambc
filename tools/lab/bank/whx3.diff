 // ---- WL2, decision 3: a soft pull toward a working mate. Her own rate of group gi x (1 + WL2_PULL_X100 / 100) when another living
 // body claims it (the buffer: works out of sight) or a visible mate stands within 6 of its anchor.
 // WHV bit 4/8 (caller read the flag): gi is a heavy group that enough mates work for her to make a crew of 3+ (4+ with bit 8).
+// WHX bit 8 (b1815, caller read the flag): one mate works golem group gi; its claimants' crew cannot clear it without me and clears
+// it in one trip with me in it.
+static __attribute__((noinline)) bool whx_join(int gi, const GroupI& g, const nova::econ::GroupMem& m)
+{
+	if (g.n_golem <= 0 || P.my_slot < 0 || P.my_slot >= 8 || P.my_slot >= nova::econ::TM.n)
+		return false;
+	nova::econ::Crew c = nova::econ::crew_of_claimants(gi, P.my_slot, nova::econ::TM.claim);
+	if (c.n < 1 || nova::econ::estimate_cx(1, g, m, c).feasible)
+		return false;
+	c.add(nova::econ::TM.m[static_cast<std::size_t>(P.my_slot)]);
+	const auto e = nova::econ::estimate_cx(1, g, m, c);
+	return e.feasible && e.dmg <= e.budget;
+}
