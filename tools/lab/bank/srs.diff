+// SRS bit 1 (econ_flags.h): an engaged claimant I see within SRS_R of one of group g's camps: the clear has really started this round.
+static __attribute__((noinline)) bool srs_real_start(int gi, const GroupI& g)
+{
+	const int r = SRS_TAB[2];
+	for (const auto& a : W.allies)
+	{
+		if (a.slot < 0 || a.slot >= TM.n || a.slot >= 8 || !claims(a.slot, gi) || !TM.busy[static_cast<std::size_t>(a.slot)])
+			continue;
+		for (int ci : g.members)
+			if (cheb(a.pos, M.camps[static_cast<std::size_t>(ci)].pos) <= r)
+				return true;
+	}
+	return false;
+}
