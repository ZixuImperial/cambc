+		const auto su = static_cast<std::size_t>(s);
+		dca_sv_cg[s] = comms::V.cg[su];
+		dca_sv_ce[s] = comms::V.ce[su];
+		dca_sv_ck[s] = comms::V.ck[su];
+		dca_sv_cv[s] = comms::V.cv[su];
+		dca_masked[s] = true;
+		dca_ahead[s] = g;
+		comms::V.cg[su] = -1;
+		comms::V.ce[su] = 0;
+		comms::V.ck[su] = 1;
+		comms::V.cv[su] = 3;
+	}
+}
