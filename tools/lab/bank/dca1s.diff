+// build_team. The view is put back before the next read, so comms decodes from the same state as without the mask.
+static int dca_dead0[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+static bool dca_masked[8] = {};
+static std::int8_t dca_sv_cg[8] = {};
+static std::uint8_t dca_sv_ce[8] = {}, dca_sv_ck[8] = {}, dca_sv_cv[8] = {};
+static __attribute__((noinline)) void dca_unmask()
+{
+	for (int s = 0; s < comms::CLAIM_SLOTS; ++s)
+		if (dca_masked[s])
+		{
+			const auto su = static_cast<std::size_t>(s);
+			comms::V.cg[su] = dca_sv_cg[s];
+			comms::V.ce[su] = dca_sv_ce[s];
+			comms::V.ck[su] = dca_sv_ck[s];
+			comms::V.cv[su] = dca_sv_cv[s];
+			dca_masked[s] = false;
+		}
+}
+static __attribute__((noinline)) void dca_mask()
+{
+	for (int s = 0; s < 8; ++s)
+		dca_ahead[s] = -1;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
