+		if (!dead)
+		{
+			dca_dead0[s] = -1;
+			continue;
+		}
+		if (dca_dead0[s] < 0)
+			dca_dead0[s] = W.round;
+		const int g = comms::cgroup(s);
+		if (g < 0 || W.round - dca_dead0[s] < rs::champ_respawn_rounds() - DCA_TAB[2] - 2)
