+// b2373 SMT (the callers read the flag): ARR, 2 bits per slot, allocated after the front fields only at P.n <= 4 and only all together
+std::array<comms::Spare, 8> smt_f{};
+bool smt_ok = false;
+void smt_alloc()
+{
+	smt_ok = false;
+	if (P.n < 1 || P.n > 4 || comms::spare_bits() < 2 * P.n)
+		return;
+	for (int s = 0; s < P.n; ++s)
+		smt_f[static_cast<std::size_t>(s)] = comms::spare_alloc(2);
+	smt_ok = true;
+	for (int s = 0; s < P.n; ++s)
+		smt_ok = smt_ok && smt_f[static_cast<std::size_t>(s)].ok();
+}
+void smt_put_arr()
+{
+	const int me = my_slot();
+	if (!smt_ok || me < 0 || me >= P.n)
+		return;
+	int b = 3;
+	const int gi = claim_target();
+	if (gi >= 0 && gi < M.ng)
+	{
+		if (claim_engaged())
+			b = 0;
+		else
+		{
+			const bool tfresh = travel_round == now() && travel_from == W.me.pos && travel.size() == static_cast<std::size_t>(M.ng);
+			const int w = tfresh ? static_cast<int>(travel[static_cast<std::size_t>(gi)]) : cheb(W.me.pos, M.groups[static_cast<std::size_t>(gi)].anchor);
+			b = w <= 3 ? 0 : w <= 8 ? 1 : w <= 15 ? 2 : 3;
+		}
+	}
+	const comms::Spare f = smt_f[static_cast<std::size_t>(me)];
+	if (comms::spare_get(f) != static_cast<std::uint32_t>(b))
+		comms::spare_put(f, static_cast<std::uint32_t>(b));
+}
+int smt_arr(int slot)
+{
+	if (!smt_ok || slot < 0 || slot >= P.n)
+		return -1;
+	return static_cast<int>(comms::spare_get(smt_f[static_cast<std::size_t>(slot)]));
+}
+} // namespace nova::econ
