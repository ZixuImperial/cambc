+// MCT (draft.h): the map-type terms. Reads M.groups only, so no fuel worth counting.
+void mct_terms()
+{
+	long gems = 0, gold = 0, top = 0;
+	float sup = 0.0f;
+	for (const auto& g : M.groups)
+	{
+		gems += g.gems;
+		gold += g.gold;
+		top = std::max<long>(top, g.gems);
+		sup += static_cast<float>(g.gems) * 2000.0f / static_cast<float>(g.respawn + 6);
+	}
+	if (gems <= 0)
+		return;
+	const auto ramp = [](float v, float lo, float hi) { return std::clamp((v - lo) / (hi - lo), 0.0f, 1.0f); };
+	const float xt = ramp(100.0f * static_cast<float>(top) / static_cast<float>(gems), static_cast<float>(MCT_TAB[5]), static_cast<float>(MCT_TAB[6]));
+	const float xs = 1.0f - ramp(sup, static_cast<float>(MCT_TAB[7]), static_cast<float>(MCT_TAB[8]));
+	const float y = ramp(static_cast<float>(gold), static_cast<float>(MCT_TAB[9]), static_cast<float>(MCT_TAB[10]));
+	if (MCT_TAB[1] & MCT_BIT_VESPER)
+	{
+		const float d = static_cast<float>(MCT_TAB[2]) * std::max(xt, xs) * y;
+		S.base[VV] += d;
+		if (DF_MT_HAND)
+			S.mt[VV] += d;
+	}
+	if (MCT_TAB[1] & MCT_BIT_PRISM)
+	{
+		const float d = static_cast<float>(MCT_TAB[3]) * xt;
+		S.base[PR] -= d;
+		if (DF_MT_HAND)
+			S.mt[PR] -= d;
+		if (100.0f * xt >= static_cast<float>(MCT_TAB[4]))
+			S.pz_viable = false;
+	}
+}
