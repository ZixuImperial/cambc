+// MCT (b1401, owner 6 Nov: the drafter notices map types; smooth terms, no hard classes). Features from the camp groups at draft:
+// top = largest group's gem share, sup = sum gems x 2000 / (respawn + 6) (gems the map gives over a game), gold = gold of one capture of
+// every camp. x = max(ramp(top, LO, HI), falling ramp(sup, LO, HI)) says the gems sit in one place or are few; y = ramp(gold, LO, HI) says
+// there is gold to earn beside them. Bit 1 VESPER: Vesper gains MCT_V_PP x x x y (forced Vesper-first read .50-.56 there on v567, .42 elsewhere).
+// Bit 2 PRISM: Prism loses MCT_P_PP x ramp(top), and her carry plan's first pick stops at MCT_PV_PCT % of that ramp (forced Prism-out .58 on
+// top .7-.95, .42 on other maps). Map features only. 0 = live.
+#define MCT_BITS 0
+#define MCT_V_PP 12
+#define MCT_P_PP 12
+#define MCT_PV_PCT 50
+#define MCT_TOP_LO 60
+#define MCT_TOP_HI 90
+#define MCT_SUP_LO 3000
+#define MCT_SUP_HI 12000
+#define MCT_GOLD_LO 800
+#define MCT_GOLD_HI 1600
+inline const volatile int MCT_TAB[11] = { 0x4D435431, MCT_BITS, MCT_V_PP, MCT_P_PP, MCT_PV_PCT, MCT_TOP_LO, MCT_TOP_HI, MCT_SUP_LO, MCT_SUP_HI, MCT_GOLD_LO, MCT_GOLD_HI };
+constexpr int MCT_BIT_VESPER = 1;
+constexpr int MCT_BIT_PRISM = 2;
 
