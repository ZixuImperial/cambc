diff --git b/src/feat_aho.cpp b/src/feat_aho.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_aho.cpp
@@ -0,0 +1,56 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_aho.cpp (ALH member, b1600): ALTAR_HOLD's gate and channel assumption (feat_aho.h). Unity build: after econ.cpp.
+#include "feat_aho.h"
+namespace nova::feat::aho
+{
+namespace
+{
+// Firing counters (firecount puts one at each function entry): the gate opened below 300; a channel was assumed started.
+void open_fire()
+{
+}
+void chan_fire()
+{
+}
+int open_r = -1, open_v = 0; // one table walk a round
+} // namespace
+bool open()
+{
+	if (open_r == W.round)
+		return open_v != 0;
+	open_r = W.round;
+	int big = 0;
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+	{
+		if (!tt[i].alive || tt[i].round <= -1000 || tt[i].src == 4)
+			continue;
+		const Body* b = intel::team_body(i);
+		if (b && static_cast<int>(b->gems) > big)
+			big = static_cast<int>(b->gems);
+	}
+	open_v = W.tributed_them + big >= 1000 ? 1 : 0;
+	if (open_v)
+		open_fire();
+	return open_v != 0;
+}
+int fin_eta(int base, vec2 p, int age, int ticks, vec2 ap)
+{
+	if (age <= 0 || cheb(p, ap) > cambc::constants::submit_gems_range)
+		return base;
+	int g = 0; // the bag: the table entry seen at p, age rounds ago
+	const auto& tt = intel::team_table();
+	for (std::size_t i = 0; i < tt.size(); ++i)
+		if (tt[i].pos == p && W.round - tt[i].round == age)
+			if (const Body* b = intel::team_body(i))
+				g = std::max(g, static_cast<int>(b->gems));
+	if (g < AHO_BAG)
+		return base;
+	const int e = std::max(0, ticks - age);
+	if (e < base)
+		chan_fire();
+	return std::min(base, e);
+}
+} // namespace nova::feat::aho
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_aho.h b/src/feat_aho.h
new file mode 100644
--- /dev/null
+++ b/src/feat_aho.h
@@ -0,0 +1,21 @@
+#pragma once
+// feat_aho (ALH member of small-fix bundle 2, b1600; Deep 00quadrants 01a1b922-6300-754d r271-320: their Prism banked a 723 bag from
+// 287 and won while our stunner farmed). ALTAR_HOLD (alh_note / alh_turn / alh_turn_slow) never runs while tributed_them < 300 (a fuel
+// early-out). Flag AHO_BITS, 0 = nova_b2630_fpr4. Bit 1 OPEN: the gate also opens when tributed_them + the largest known foe bag
+// >= 1000. Bit 2 CHAN: a known 300+ foe bag last seen within tribute reach of an altar is assumed to have started its channel when
+// last seen (finish in ticks - age, not arrival + ticks). Hooks: econ.cpp alh_note, alh_turn, alh_turn_slow (gate), the eta loop of
+// alh_turn_slow (CHAN); flag first.
+#include "common.h"
+#define AHO_BITS 0
+#define AHO_BAG 300
+inline const volatile int AHO_TAB[2] = { 0x41484F31, AHO_BITS }; // slot 0 magic keeps it out of .bss
+#define AHO_ON(b) ((AHO_TAB[1] & (b)) != 0)
+constexpr int AHO_BIT_OPEN = 1;
+constexpr int AHO_BIT_CHAN = 2;
+namespace nova::feat::aho
+{
+// OPEN: true when tributed_them + the largest known foe bag reaches 1000 (the gate below 300 opens). Caller read the flag.
+bool open();
+// CHAN: the finish eta of a known bag last seen at p, age rounds ago, ticks long, for the altar at ap (base = the caller's).
+int fin_eta(int base, vec2 p, int age, int ticks, vec2 ap);
+} // namespace nova::feat::aho
diff --git b/src/feat_alt2.cpp b/src/feat_alt2.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_alt2.cpp
@@ -0,0 +1,97 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_alt2.cpp (ALT2, b1600): the walk to a free twin altar instead of a lock hit (feat_alt2.h). Unity build: after econ.cpp.
+#include "feat_alt2.h"
+namespace nova::feat::alt2
+{
+namespace
+{
+// Firing counter (firecount puts one at each function entry): the walk to the free twin replaces a lock hit.
+void twin_fire()
+{
+}
+void walk_fire()
+{
+}
+// An enemy lock stands on the altar (the engine's read; both teams' locks may stand, so theirs is read directly too).
+bool enemy_locked(vec2 p)
+{
+	try
+	{
+		if (!cambc::vision::has_altar_lock(p))
+			return false;
+		return cambc::vision::altar_lock_at(p).is_enemy() || nova::econ::enemy_lock_on(p);
+	}
+	catch (...)
+	{
+		return true; // unread: not free
+	}
+}
+} // namespace
+bool twin_walk(vec2 me)
+{
+	if (W.me.gems == 0u || W.attacked || W.moved || !W.can_move() || !W.alive || !M.has_altar)
+		return false;
+	const int r = std::max(1, W.me.range);
+	bool lk = false; // lock_hit would hit an enemy lock from here
+	for (const auto& a : M.altars)
+		if (cheb(a.pos, me) <= r && enemy_locked(a.pos))
+			lk = true;
+	if (!lk)
+		return false;
+	vec2 best{ -1, -1 };
+	int bd = 1 << 20;
+	for (const auto& a : M.altars)
+	{
+		const int c = cheb(a.pos, me);
+		if (c <= 1 || c > ALT2_R || c >= bd || !bbget(W.own_vis, a.pos) || enemy_locked(a.pos))
+			continue;
+		best = a.pos;
+		bd = c;
+	}
+	if (best.x < 0)
+		return false;
+	bitboard goals;
+	goals.draw_chebyshev(best, 1.0f);
+	goals &= M.altar_adj;
+	if (!mv::step_to_set(goals, 30))
+		return false;
+	twin_fire();
+	return true;
+}
+bool free_walk(vec2 me)
+{
+	if (W.me.gems == 0u || W.moved || !W.can_move() || !W.alive || !M.has_altar || M.altars.size() < 2)
+		return false;
+	vec2 na{ -1, -1 };
+	int nd = 1 << 20;
+	for (const auto& a : M.altars)
+		if (cheb(a.pos, me) < nd)
+		{
+			na = a.pos;
+			nd = cheb(a.pos, me);
+		}
+	if (na.x < 0 || nd <= 1 || !bbget(W.own_vis, na) || !enemy_locked(na))
+		return false;
+	vec2 best{ -1, -1 };
+	int bd = 1 << 20;
+	for (const auto& a : M.altars)
+	{
+		const int c = cheb(a.pos, me);
+		if (a.pos == na || c > nd + ALT2_D || c >= bd || !bbget(W.own_vis, a.pos) || enemy_locked(a.pos))
+			continue;
+		best = a.pos;
+		bd = c;
+	}
+	if (best.x < 0)
+		return false;
+	bitboard goals;
+	goals.draw_chebyshev(best, 1.0f);
+	goals &= M.altar_adj;
+	if (!mv::step_to_set(goals, 60))
+		return false;
+	walk_fire();
+	return true;
+}
+} // namespace nova::feat::alt2
+
+#endif // NOVA_UNITY_ALL
