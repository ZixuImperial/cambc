new file mode 100644
--- /dev/null
+++ b/src/feat_flv.cpp
@@ -0,0 +1,70 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_flv.cpp (FLV, b1600): the least-danger fallback step (feat_flv.h). Unity build: after combat.cpp and move.cpp.
+#include "feat_flv.h"
+namespace nova::feat::flv
+{
+namespace
+{
+// Firing counters (firecount puts one at each function entry): a step refused (the step changed); the least-veto tile taken
+// after every step was refused; stayed instead.
+void refuse_fire()
+{
+}
+void least_fire()
+{
+}
+void stay_fire()
+{
+}
+bool flv_on = false, flv_hit = false;
+float flv_lim = 0.0f;
+const nova::combat::Assessment* flv_a = nullptr;
+} // namespace
+bool block(vec2 dest)
+{
+	if (!flv_on || nova::combat::geom::danger_veto(*flv_a, dest) <= flv_lim)
+		return false;
+	flv_hit = true;
+	return true;
+}
+bool escape(const nova::combat::Assessment& a, const std::vector<mv::Threat>& zones, vec2 rally)
+{
+	if ((FLV_ON(FLV_BIT_BAG) && static_cast<int>(W.me.gems) < FLV_BAG) || !W.can_move())
+		return mv::escape_toward(zones, rally);
+	const vec2 me = W.me.pos;
+	float vmin = nova::combat::geom::danger_veto(a, me);
+	vec2 best = me;
+	for (const vec2 d : DIRS)
+	{
+		const vec2 n = me + d;
+		if (!mv::free_tile(n))
+			continue;
+		const float v = nova::combat::geom::danger_veto(a, n);
+		if (v < vmin)
+		{
+			vmin = v;
+			best = n;
+		}
+	}
+	flv_lim = vmin + nova::combat::eff_hp(W.me) * static_cast<float>(FLV_PCT) / 100.0f;
+	flv_a = &a;
+	flv_hit = false;
+	flv_on = true;
+	const bool moved = mv::escape_toward(zones, rally);
+	flv_on = false;
+	if (!flv_hit)
+		return moved;
+	refuse_fire();
+	if (moved)
+		return true;
+	if (best != me && mv::try_move(best))
+	{
+		least_fire();
+		return true;
+	}
+	stay_fire();
+	return false;
+}
+} // namespace nova::feat::flv
+
+#endif // NOVA_UNITY_ALL
