@@ -0,0 +1,25 @@
+#pragma once
+// feat_alt2 (ALT2, b1600 small-fix bundle 2; Econ 03membrane 01a1b937-adaa r235-237: our Vesper with 53 gems hit B's lock on
+// (18,13) from 3 tiles for 3 turns while the twin altar (18,14), 2 steps away, stood free). Locks are per altar (GameRules :236-244).
+// Flag ALT2_BITS, 0 = nova_b2630_fpr4. Bit 1 TWIN: in bank_i, where lock_hit would hit an enemy lock in my attack range, a carrier
+// first walks toward another visible altar within ALT2_R (Chebyshev; its side tiles 2-3 steps away) that the engine reads with no
+// enemy lock, and banks there. Bit 2 WALK (Econ spec_lkf_1108.md bit 2; 04horseshoes 01a1b94a W2/W3): before the bank walk
+// (bank_field leads to the nearest altar, locks unread), when the nearest altar has a seen enemy lock and another seen free altar is
+// within its distance + ALT2_D, the carrier walks to the free one. (Econ's LKF spec is this idea: LKF bit 1 = TWIN, bit 2 = WALK.)
+// Both maps' cases are two altar entities (replay g.altars: 03membrane (18,13),(18,14); 04horseshoes (15,14),(15,15)).
+// Hooks: econ.cpp bank_i before lock_hit (TWIN) and before the bank_field step (WALK); flag first.
+#include "common.h"
+#define ALT2_BITS 0
+#define ALT2_R 4
