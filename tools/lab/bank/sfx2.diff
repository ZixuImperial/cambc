@@ -0,0 +1,55 @@
+#ifdef NOVA_UNITY_ALL // b1066 unity build: compiled only through nova_all.cpp
+// feat_lhs.cpp (LHS, b1600): leave a lock under a coming spell (feat_lhs.h). Unity build: after combat.cpp and econ.cpp.
+#include "feat_lhs.h"
+namespace nova::feat::lhs
+{
+namespace
+{
+// Firing counters (firecount puts one at each function entry): stepped away from the lock; held the hit (could not step).
+void step_fire()
+{
+}
+void hold_fire()
+{
+}
+} // namespace
+int leave(int hits_left)
+{
+	if (W.me.gems == 0u || W.me.channeling() || !W.can_attack())
+		return 0; // base returns false there itself; never step out of a channel
+	const int h = std::max(0, hits_left - 1);
+	const float eff = W.me.hp + std::max(0.0f, W.me.shield);
+	static std::vector<mv::Threat> lhs_th;
+	lhs_th.clear();
+	for (const auto& e : W.enemies)
+	{
+		const int d = cheb(e.pos, W.me.pos);
+		if (d > 9)
+			continue;
+		bool cast = false;
+		const float v = nova::combat::burst::lb_hit(e, d, h, &cast);
+		if (!cast || v < eff * static_cast<float>(LHS_PCT) / 100.0f)
+			continue;
+		int reach = d;
+		for (int k = d + 1; k <= 9; ++k)
+		{
+			bool c2 = false;
+			if (nova::combat::burst::lb_hit(e, k, h, &c2) <= 0.0f || !c2)
+				break;
+			reach = k;
+		}
+		lhs_th.push_back(mv::Threat{ e.pos, reach });
+	}
+	if (lhs_th.empty())
+		return 0;
+	if (!W.moved && W.can_move() && mv::retreat_step(lhs_th, 1))
+	{
+		step_fire();
+		return 1;
+	}
+	hold_fire();
+	return 2;
+}
+} // namespace nova::feat::lhs
+
+#endif // NOVA_UNITY_ALL
