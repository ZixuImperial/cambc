+// CAS bit 1 (caller read the flag): Cassi's arrival stun after a walk, with camp_spells' stun picker.
+void cas_arrival_stun()
+{
+	if (!ci_layer::me_cassi() || !W.me.kit)
+		return;
+	const Kit& k = *W.me.kit;
+	if (W.cast || !k.cc_on_camps || !combat::slot_up(k.slot_cc) || foe_within(STUN_HOLD_R))
+		return;
+	int best = -1;
+	float bs = 0;
+	for (const auto& vc : W.camps)
+	{
+		const auto& c = M.camps[static_cast<std::size_t>(vc.ci)];
+		if (vc.awake && c.attacks() && cheb(c.pos, W.me.pos) <= static_cast<int>(k.cc_range) && c.str > bs && combat::camps::cst_hits_us(vc.ci))
+		{
+			bs = c.str;
+			best = vc.ci;
+		}
+	}
+	if (best >= 0)
+		combat::cast_on_camp(k.slot_cc, best);
+}
