+// PHL bit 16 (caller read the flag): my effective health covers my target group's estimated camp damage x 1.3 plus its exit (its
+// strongest camp's hits over reach + .5 tiles), with the sighting guard.
+static bool phl_job_ok()
+{
+	if (T.target < 0 || T.target >= M.ng || !phl_quiet())
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(T.target)];
+	const auto& m = mem[static_cast<std::size_t>(T.target)];
+	const Claims cl = claims_for_me();
+	const ClearEst e = estimate_cx(1, g, m, crew_for(T.target, my_slot(), 0, cl));
+	if (!e.feasible)
+		return false;
+	const float exit_cost = g.str_max * (static_cast<float>(g.reach_max) + 0.5f);
+	return combat::eff_hp(W.me) >= 1.3f * e.dmg + exit_cost;
+}
