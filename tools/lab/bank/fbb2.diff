+// FBB: the foes' summed next-turn burst on tile t (lethal_burst_damage_sum at LB_CDH).
+static __attribute__((noinline)) float fbb_burst(vec2 t) { return burst::lethal_burst_damage_sum(t, LETHAL_BURST_TAB[5], nullptr); }
+// FBB: the larger burst of my tile and my first step toward p (a walkable tile; the entry step is where their burst lands).
+static __attribute__((noinline)) float fbb_burst_entry(vec2 p)
+{
+	const float here = fbb_burst(W.me.pos);
+	vec2 s = W.me.pos;
+	s.x += (p.x > s.x) - (p.x < s.x);
+	s.y += (p.y > s.y) - (p.y < s.y);
+	if ((s.x == W.me.pos.x && s.y == W.me.pos.y) || bbget(M.block, s))
+		return here;
+	return std::max(here, fbb_burst(s));
+}
+static bool fbb_bursty(float b) { return b >= static_cast<float>(FBB_TAB[2]) / 100.0f * eff_hp(W.me); }
+static bool fbb_worst_low(const Assessment& a) { return std::min(a.ratio, a.ratio_near) < static_cast<float>(FBB_TAB[4]) / 100.0f; }
