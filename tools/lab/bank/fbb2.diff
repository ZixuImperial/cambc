+// FBB bit 1: true = the prism guard does not fight. It fires only with a foe within its reach + 1 of the Prism, and the Prism off her
+// spawn or the burst on her tile >= her eff HP; then only at worst ratio >= FBB_WR or with no foe's burst reaching me (my tile or my
+// first step toward the foe).
+static __attribute__((noinline)) bool fbb_prism_hold(const Assessment& a, int ps, vec2 pz, int fi)
+{
+	bool near = false;
+	for (const auto& f : a.foes)
+		near = near || (f.idx >= 0 && cheb(f.pos, pz) <= f.reach + 1);
+	if (!near)
+		return true;
+	if (bbget(M.my_spawn, pz))
+	{
+		const Body* pb = W.ally_by_slot(ps);
+		if (pb && fbb_burst(pz) < eff_hp(*pb))
+			return true;
+	}
+	if (!fbb_worst_low(a))
+		return false;
+	return fbb_burst_entry(assess_enemy(fi).pos) > 0.0f;
+}
