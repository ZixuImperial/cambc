+// b2423 WGS (econ_flags.h; the caller read the flag): a weak gold-scaling body leaves a gold-only group to our carry.
+static __attribute__((noinline)) bool wgs_close(int gi, int self, const GroupI& g, const Claims& cl)
+{
+	if (g.gold <= 0 || g.gems > 0 || self < 0 || self >= P.n || self >= 8 || cl[static_cast<std::size_t>(self)] == gi || (self == my_slot() && gi == T.target))
+		return false;
+	using CT = cambc::champion_type;
+	const CT t = P.type[static_cast<std::size_t>(self)];
+	const bool weak = t == CT::cassi || t == CT::issac || t == CT::heart_of_ruin || t == CT::ryth;
+	if (!(WGS_ON(1) && weak) && !(WGS_ON(2) && t == CT::vendetta))
+		return false;
+	int car = -1, rank = 9;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		const CT u = P.type[static_cast<std::size_t>(s)];
+		const int rk = u == CT::prism ? 0 : u == CT::vesper_vale ? 1 : (weak && u == CT::marcella) ? 2 : (weak && u == CT::vendetta) ? 3 : 9;
+		if (rk < rank)
+		{
+			rank = rk;
+			car = s;
+		}
+	}
+	if (car < 0 || car == self || (t == CT::vendetta && rank > 1) || comms::ckind(car) == 1)
+		return false;
+	const int hg = TM.claim[static_cast<std::size_t>(car)];
+	if (hg < 0 || hg >= M.ng || hg == gi)
+		return false;
+	const GroupI& h = M.groups[static_cast<std::size_t>(hg)];
+	if (cheb(h.anchor, g.anchor) > WGS_TAB[2])
+		return false;
+	return group_value(h, hg, car) < group_value(g, gi, car);
+}
