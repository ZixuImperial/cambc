+// v8xx BFT (spec_bft_1112 Arm E, RC C855; caller read BFT_ON first): a hidden shooter within 5 of me (area spells: ground 4 + radius 1)
+// stands on an unlit bush tile that sees my tile (sight is symmetric; it sees out of its cluster, I cannot see in). Candidate clusters:
+// labelled, not mine, no camp tile in them (a bush camp is not a hidden foe, F1). Up to 24 nearest candidate tiles are tested with a
+// ward-sight shadowcast from the tile. The cluster with the most such tiles wins (ties: the nearer tile); exactly_one (bit 128): none
+// unless one cluster qualifies. *at = its seeing tile nearest me. Returns the label, 0 none.
+int bft_label_at(vec2 p) { return inb(p) ? bush_lbl.get(p) : 0; }
+int bft_pick_cluster(bool exactly_one, bool need_ward, vec2* at)
+{
+	if (!W.alive || !bbany(M.bushes) || fuel() < BSX_TAB[4] || (need_ward && now() < ready_round)) // RC C855b G1: no scan without a use
+		return 0;
+	const vec2 me = W.me.pos;
+	const std::int16_t mine = bbget(M.bushes, me) ? bush_lbl.get(me) : static_cast<std::int16_t>(0);
+	static std::vector<std::int16_t> camp_l;
+	camp_l.clear();
+	for (int ci = 0; ci < M.nc; ++ci)
+	{
+		const vec2 p = M.camps[static_cast<std::size_t>(ci)].pos;
+		if (bbget(M.bushes, p) && bush_lbl.get(p) != 0)
+			camp_l.push_back(bush_lbl.get(p));
+	}
+	const bitboard& lit = my_current_vision();
+	vec2 cand[24];
+	int cd[24];
+	int n = 0;
+	for (int k = 1; k <= 5 && n < 24; ++k)
+		for (int dy = -k; dy <= k && n < 24; ++dy)
+			for (int dx = -k; dx <= k && n < 24; ++dx)
+			{
+				if (std::max(std::abs(dx), std::abs(dy)) != k)
+					continue;
+				const vec2 p{ me.x + dx, me.y + dy };
+				if (!inb(p) || !bbget(M.bushes, p) || bbget(lit, p) || bbget(M.camp_tiles, p))
+					continue;
+				const std::int16_t l = bush_lbl.get(p);
+				if (l == 0 || l == mine || std::find(camp_l.begin(), camp_l.end(), l) != camp_l.end())
+					continue;
+				cand[n] = p;
+				cd[n] = k;
+				++n;
+			}
+	std::int16_t lab[24];
+	int cnt[24];
+	vec2 near[24];
+	int nl = 0;
+	static bitboard sc;
+	for (int i = 0; i < n; ++i)
+	{
+		cambc::ward::visible_tiles_from_into(cand[i], sc);
+		if (!bbget(sc, me))
+			continue;
+		const std::int16_t l = bush_lbl.get(cand[i]);
+		int j = 0;
+		while (j < nl && lab[j] != l)
+			++j;
+		if (j == nl)
+		{
+			lab[nl] = l;
+			cnt[nl] = 0;
+			near[nl] = cand[i]; // rings run outward: the first is the nearest
+			++nl;
+		}
+		++cnt[j];
+	}
+	(void)cd;
+	if (nl == 0 || (exactly_one && nl != 1))
+		return 0;
+	int b = 0;
+	for (int j = 1; j < nl; ++j)
+		if (cnt[j] > cnt[b])
+			b = j;
+	*at = near[b];
+	return lab[b];
+}
