 // Fight strength of a side: (sum of sqrt(health x damage))^2. This sums the foes' side, counts them, and reads who has me in reach.
+// SHR (combat_flags.h): scale (on) or restore (off) the health of foes within SHR_N of their own spawn, around the sum below.
+__attribute__((noinline)) static void shr_scale(Assessment& a, bool on)
+{
+	static float shr_old[16];
+	static int shr_x0 = 1 << 20, shr_y0 = 1 << 20, shr_x1 = -(1 << 20), shr_y1 = -(1 << 20);
+	static bool shr_rect = false;
+	if (!shr_rect)
+	{
+		shr_rect = true;
+		bbforeach(M.enemy_spawn, [&](vec2 p) { shr_x0 = std::min(shr_x0, p.x); shr_y0 = std::min(shr_y0, p.y); shr_x1 = std::max(shr_x1, p.x); shr_y1 = std::max(shr_y1, p.y); });
+	}
+	if (shr_x1 < shr_x0)
+		return;
+	const float k = static_cast<float>(SHR_TAB[2]) / 100.0f;
+	for (std::size_t i = 0; i < a.foes.size() && i < 16; ++i)
+	{
+		auto& f = a.foes[i];
+		if (on)
+		{
+			shr_old[i] = f.ehp;
+			const int dx = std::max({ shr_x0 - f.pos.x, 0, f.pos.x - shr_x1 }), dy = std::max({ shr_y0 - f.pos.y, 0, f.pos.y - shr_y1 });
+			if (std::max(dx, dy) <= SHR_TAB[1])
+				f.ehp *= k;
+		}
+		else
+			f.ehp = shr_old[i];
+	}
+}
