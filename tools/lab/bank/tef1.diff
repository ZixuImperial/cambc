+// TEF bit 1: an entry before i has shards but no emblem yet.
+template <class C>
+static __attribute__((noinline)) bool tef_part_before(const C& counts, std::size_t i)
+{
+	for (std::size_t j = 0; j < i; ++j)
+	{
+		const auto sj = static_cast<std::uint32_t>(build[j]);
+		if ((sj & 1u) == 0 && static_cast<int>(counts[cambc::item_type(sj)]) >= 1 && static_cast<int>(counts[cambc::item_type(sj + 1)]) == 0)
+			return true;
+	}
+	return false;
+}
 // the first build entry of the Tribute family (7) whose emblem is not owned moves to the front.
 template <class C>
 static void tribute_emblem_to_front(const C& counts)
 {
 	for (std::size_t i = 0; i < build.size(); ++i)
 	{
 		const auto si = static_cast<std::uint32_t>(build[i]);
 		if (si / 6 != 7)
 			continue;
 		if (static_cast<int>(counts[cambc::item_type(si + 1)]) >= 1 || i == 0)
 			return;
+		if (TEF_ON(1) && tef_part_before(counts, i)) // v697 TEF: a part-bought emblem keeps its place
+			return;
 		std::rotate(build.begin(), build.begin() + static_cast<std::ptrdiff_t>(i), build.begin() + static_cast<std::ptrdiff_t>(i) + 1);
 		return;
 	}
 }
