+// FEH: rounds left = min(GAME_END - r, our linear pace, the foe-finish ETA (rate + seen bags, champ_prism.cc)), once per round.
+float feh_rounds_left()
+{
+	static int fr = -1;
+	static float fv = 0.0f;
+	if (fr == now())
+		return fv;
+	fr = now();
+	const int r = std::max(1, now());
+	const int us = W.tributed_us;
+	const float lu = us <= 0 ? GAME_END_F : static_cast<float>(rs::WIN_TRIBUTE - us) * static_cast<float>(r) / static_cast<float>(us);
+	const double fe = prism::foe_finish_eta();
+	fv = std::max(0.0f, std::min({ static_cast<float>(GAME_END - r), lu, static_cast<float>(std::min(fe, 1e6)) }));
+	return fv;
+}
