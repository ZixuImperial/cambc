+// b2273 BSG (caller read the flag): assess_rule_local_power's undiscounted power, (our eff_hp x str+foc) / (theirs) within LOCAL_POWER_R.
+__attribute__((noinline)) float bsg_local_power(const Assessment& a)
+{
+	const vec2 me = W.me.pos;
+	float uh = eff_hp(W.me), us = W.me.str + W.me.foc;
+	for (const auto& al : W.allies)
+		if (!al.channeling() && cheb(al.pos, me) <= stance::tune::LOCAL_POWER_R && !nova::combat::retreating_mates::retreating(al))
+		{
+			uh += eff_hp(al);
+			us += al.str + al.foc;
+		}
+	float th = 0, ts = 0, vis_s = 0;
+	int vis_n = 0;
+	for (const auto& f : a.foes)
+		if (f.idx >= 0)
+		{
+			const auto& e = stance::assess_enemy(f.idx);
+			vis_s += e.str + e.foc;
+			++vis_n;
+		}
+	const float avg_s = vis_n > 0 ? vis_s / static_cast<float>(vis_n) : (W.me.str + W.me.foc);
+	for (const auto& f : a.foes)
+	{
+		if (cheb(f.pos, me) > stance::tune::LOCAL_POWER_R)
+			continue;
+		th += std::max(1.0f, f.ehp);
+		ts += f.idx >= 0 ? stance::assess_enemy(f.idx).str + stance::assess_enemy(f.idx).foc : avg_s;
+	}
+	if (th <= 0)
+		return 99.0f;
+	return (uh * us) / std::max(1.0f, th * ts);
