 // MCL4 (Shared Mem skeleton, b1866): the second owners' class byte (bits in common_flags.h at MCL4_XID).
+// b2273 BSG bit 16 ALT4POCKET (Path Finding chokepoints_1112.md 0A; caller read the flag): our spawn reaches the altars' tribute tiles only
+// through a layer of <= 4 walkable tiles near the altar, and the altar side of it is <= 25% of the walkable tiles. Layer form, no cut search:
+// with D = f_home at the nearest tribute tile, width(k) = tiles with f_home == k and f_home + f_altar <= D + 12, k in [3, D - 2]; POCKET when
+// the narrowest layer is <= 4 wide, lies at 2k >= D, and tiles with f_altar <= D - k are <= 25% of the walkable ones. f_home is camps
+// passable; f_altar is one static-wall field to altar_adj_all built here (camps passable), so the value depends on the map only.
+// Draft-time, our seat, once (mcl4_compute); fuel-short -> off.
+static bool bsg_alt4_pocket()
+{
+	using namespace nova;
+	if (!M.done() || M.na <= 0 || fuel() < 9L * G.w * G.h + 412000L) // 3 x MapInfo::field_cost + the passes
+		return false;
+	static distance_field bp_fa;
+	bitboard visited;
+	bp_fa.compute(M.block, M.altar_adj_all, visited);
+	const int n = G.w * G.h;
+	int D = UNREACH, walk = 0;
+	for (int y = 0; y < G.h; ++y)
+		for (int x = 0; x < G.w; ++x)
+		{
+			const vec2 p{ x, y };
+			const std::uint16_t fh = dfget(M.f_home, p), fa = dfget(bp_fa, p);
+			if (fh == UNREACH || fa == UNREACH)
+				continue;
+			++walk;
+			if (fa == 0 && fh < D)
+				D = fh;
+		}
+	if (D == UNREACH || D < 6 || walk <= 0)
+		return false;
+	std::vector<int> width(static_cast<std::size_t>(D + 1), 0), fa_hist(static_cast<std::size_t>(D + 1), 0);
+	for (int y = 0; y < G.h; ++y)
+		for (int x = 0; x < G.w; ++x)
+		{
+			const vec2 p{ x, y };
+			const std::uint16_t fh = dfget(M.f_home, p), fa = dfget(bp_fa, p);
+			if (fh == UNREACH || fa == UNREACH)
+				continue;
+			if (fh <= D && static_cast<int>(fh) + static_cast<int>(fa) <= D + 12)
+				++width[fh];
+			if (fa <= D)
+				++fa_hist[fa];
+		}
+	int wmin = n + 1, kmin = -1;
+	for (int k = 3; k <= D - 2; ++k)
+		if (width[static_cast<std::size_t>(k)] <= wmin) // ties: the layer nearer the altar
+		{
+			wmin = width[static_cast<std::size_t>(k)];
+			kmin = k;
+		}
+	if (kmin < 0 || wmin < 1 || wmin > 4 || 2 * kmin < D)
+		return false;
+	int side = 0;
+	for (int v = 0; v <= D - kmin; ++v)
+		side += fa_hist[static_cast<std::size_t>(v)];
+	return 4 * side <= walk;
+}
