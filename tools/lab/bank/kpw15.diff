+	std::vector<cambc::vec2> out;
+	for (int i = 0; best >= 0 && i < na; ++i)
+		if (lab[static_cast<std::size_t>(i)] == best)
+			out.push_back(M.altars[static_cast<std::size_t>(i)].pos);
+	return out;
+}
+std::uint32_t keys(std::array<bitboard, 2>* out);
+void load()
+{
+	kst = 0;
+	if ((map_class() & MCL_BIT_KEYBLIND) == 0 || G.w <= 0)
+		return;
+	const std::uint32_t v = keys(&kbb); // map data only; draft memory holds the class bit (no size change, so no tail blob is pushed out)
+	kn = static_cast<int>(v & 3u);
+	if (kn <= 0 || kn > 2 || M.altars.empty())
+		return;
+	for (int i = 0; i < kn; ++i)
+	{
+		const int id = static_cast<int>((v >> (2 + 14 * i)) & 0x3FFFu);
+		kt[static_cast<std::size_t>(i)] = cambc::vec2{ id % G.w, id / G.w };
+	}
+	int bd = BIG; // the key altar: its tile nearest the first key cluster's tile
+	for (const auto& a : M.altars)
+		if (cheb(a.pos, kt[0]) < bd)
+		{
+			bd = cheb(a.pos, kt[0]);
+			kalt_p = a.pos;
+		}
+	kst = 1;
+}
+// The key clusters' value (pack_keys's bits); with out, each cluster's tiles go into (*out)[i] in the same pass.
+std::uint32_t keys(std::array<bitboard, 2>* out)
+{
+	if (G.w <= 0 || G.w * G.h > 0x3FFF)
+		return 0;
+	const std::vector<cambc::vec2> ab = key_altar();
+	if (ab.empty())
+		return 0;
+	const int br = KPW_TAB[3];
+	int x0 = G.w, x1 = -1, y0 = G.h, y1 = -1;
+	for (const auto q : ab)
+	{
+		x0 = std::min(x0, q.x);
+		x1 = std::max(x1, q.x);
+		y0 = std::min(y0, q.y);
+		y1 = std::max(y1, q.y);
+	}
+	// The bush tiles within KPW_BR of the block as (distance, y, x), in that order: one bucket per distance, scan order inside (measured: a
+	// std::sort here cost up to 29k fuel).
+	std::array<std::vector<std::array<int, 3>>, 7> bk;
+	const int brc = std::min(br, 6);
+	for (int y = std::max(0, y0 - brc); y <= std::min(G.h - 1, y1 + brc); ++y)
+		for (int x = std::max(0, x0 - brc); x <= std::min(G.w - 1, x1 + brc); ++x)
+		{
+			if (!bbget(M.bushes, cambc::vec2{ x, y }))
+				continue;
+			int d = BIG;
+			for (const auto q : ab)
+				d = std::min(d, cheb(q, cambc::vec2{ x, y }));
+			if (d <= brc)
+				bk[static_cast<std::size_t>(d)].push_back({ d, y, x });
+		}
+	std::vector<std::array<int, 3>> cand;
+	for (const auto& b : bk)
+		cand.insert(cand.end(), b.begin(), b.end());
+	std::optional<bitboard> vis; // draft: one scratch board; play: the clusters go into (*out)
+	if (!out)
+		vis.emplace();
+	std::uint32_t v = 0;
+	int n = 0;
+	for (const auto& c : cand) // distance order (bucketed, no sort): each cluster's first tile is its tile nearest the altar
+	{
+		const cambc::vec2 p{ c[2], c[1] };
+		if (n >= 2 || (vis && bbget(*vis, p)) || (out && n > 0 && bbget((*out)[0], p)))
+			continue;
+		if (out)
+			(*out)[static_cast<std::size_t>(n)] = bitboard{};
+		flood(p, out ? (*out)[static_cast<std::size_t>(n)] : *vis);
+		v |= static_cast<std::uint32_t>(c[1] * G.w + c[2]) << (2 + 14 * n);
+		++n;
+	}
+	return n == 0 ? 0 : (v | static_cast<std::uint32_t>(n));
+}
+} // namespace
+std::uint32_t pack_keys() { return keys(nullptr); }
+bool load_on()
+{
+	if (kst < 0)
+		load();
+	return kst > 0;
+}
+void load_late()
+{
+	if (KPW_TAB[1] != 0 && kst < 0)
+		load();
+}
+int nkeys() { return on_map() ? kn : 0; }
+cambc::vec2 key_tile(int i) { return kt[static_cast<std::size_t>(i & 1)]; }
+int cluster_of(cambc::vec2 p)
+{
+	if (!on_map() || !inb(p))
+		return -1;
+	return bbget(kbb[0], p) ? 0 : (kn > 1 && bbget(kbb[1], p) ? 1 : -1);
+}
+cambc::vec2 altar() { return on_map() ? kalt_p : cambc::vec2{ -1, -1 }; }
