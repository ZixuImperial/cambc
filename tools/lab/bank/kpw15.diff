+static void kpw_use(int now)
+{
+	if (!prism::me_prism())
+		return;
+	const auto& tt = intel::team_table();
+	const std::size_t n = std::min<std::size_t>(tt.size(), kpw::told.size());
+	for (std::size_t i = 0; i < n; ++i)
