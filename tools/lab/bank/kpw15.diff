+std::vector<cambc::vec2> key_altar()
+{
+	const int na = static_cast<int>(M.altars.size());
+	std::vector<int> lab(static_cast<std::size_t>(std::max(0, na)), -1);
+	int nb = 0;
+	for (int i = 0; i < na; ++i)
+	{
+		if (lab[static_cast<std::size_t>(i)] >= 0)
+			continue;
