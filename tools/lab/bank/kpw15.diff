+// v6xx KPW bit 1 WATCH: on a KEYBLIND map, while our Prism's last-seen bag >= KPW_BAG, a mate keeps its ward in a key bush cluster (a
+// ward inside a bush sees its whole cluster; from outside nobody sees in). True: my ward stays there (charge kept), or I placed it now.
+int kpw_fail_r[2] = { -1000, -1000 }; // a mate's ward holds the tile I tried (rc 117)
+static bool kpw_watch(const Self& self, int t)
+{
+	if (prism::me_prism())
+		return false;
+	const int ps = prism::prism_slot();
+	if (ps < 0 || nova::kpw::prism_bag() < KPW_TAB[4])
+		return false;
+	if (my_ward.x >= 0 && nova::kpw::cluster_of(my_ward) >= 0)
+		return true; // it watches a key cluster: keep it and the charge
+	const vec2 me = W.me.pos, ap = nova::kpw::altar();
+	for (int i = 0; i < nova::kpw::nkeys(); ++i)
+	{
+		if (t < kpw_fail_r[i])
+			continue;
+		bool held = false;
+		for (const auto& a : ally)
+			held = held || nova::kpw::cluster_of(a.pos) == i;
+		if (held)
+			continue;
+		vec2 best{ -1, -1 };
+		int bd = BIG;
+		for (int dy = -reach_r; dy <= reach_r; ++dy)
+		for (int dx = -reach_r; dx <= reach_r; ++dx)
+		{
+			const vec2 q{ me.x + dx, me.y + dy };
+			if (nova::kpw::cluster_of(q) != i || camp_tile_blocks_ward(q) || bad_tile(q))
+				continue;
+			const int d = cheb(q, ap);
+			if (d < bd)
+			{
+				bd = d;
+				best = q;
+			}
+		}
+		if (best.x < 0)
+			continue;
+		bool other = false; // a visible mate (not Prism) nearer the tile takes it, slot order on ties
+		for (const auto& al : W.allies)
+			other = other || (al.slot != ps && (cheb(al.pos, best) < cheb(me, best) || (cheb(al.pos, best) == cheb(me, best) && al.slot < P.my_slot)));
+		if (other)
+			continue;
+		bool okw = false;
+		try
+		{
+			cancel_spin_before_action();
+			okw = self.place_ward(best);
+		}
+		catch (...)
+		{
+		}
+		if (okw)
+		{
+			placed_at(best);
+			return true;
+		}
+		kpw_fail_r[i] = t + 20;
+	}
+	return false;
+}
