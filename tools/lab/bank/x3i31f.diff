+		g.h = lcw[i];
+		g.gold = lcw[i + 1];
+		g.gems = lcw[i + 2];
+		g.respawn = static_cast<std::int32_t>(lcw[i + 3]);
+		const std::uint32_t size = lcw[i + 4];
+		i += 5;
+		const std::size_t first = fx_camps_.size();
+		for (std::uint32_t m = 0; m < size && i + 4 <= count; ++m, i += 4)
