+		fx_camps_.reserve(count / 4);
+	}
+	else
+	{
+	std::size_t ng = 0, nc = 0;
+	for (std::size_t i = 0; i + 5 <= count;)
+	{
+		const std::uint32_t size = wp[i + 4];
+		i += 5;
+		++ng;
+		for (std::uint32_t m = 0; m < size && i + 4 <= count; ++m, i += 4)
+			++nc;
+	}
+	fx_groups_.reserve(ng);
+	fx_camps_.reserve(nc); // no reallocation below, so the spans stay valid
+	}
+	const std::uint32_t* const lcw = wp;
+	for (std::size_t i = 0; i + 5 <= count;)
