+		lcx_w.reset(new std::uint32_t[count > 0 ? count : 1]);
+		if (count > 0)
+			cambc::detail::check(cambc::detail::sdk_map_camp_layout(lcx_w.get(), count, &count));
+		wp = lcx_w.get();
+	}
+	else
+	{
+	words.resize(256);
+	cambc::detail::check(cambc::detail::sdk_map_camp_layout(words.data(), static_cast<std::uint32_t>(words.size()), &count));
+	if (count > words.size())
+	{
+		words.resize(count);
+		cambc::detail::check(cambc::detail::sdk_map_camp_layout(words.data(), count, &count));
+	}
