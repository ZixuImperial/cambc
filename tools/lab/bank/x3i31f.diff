+			c.h = lcw[i];
+			c.t = lcw[i + 1];
+			c.x = static_cast<std::int32_t>(lcw[i + 2]);
+			c.y = static_cast<std::int32_t>(lcw[i + 3]);
+			fx_camps_.push_back(c);
+		}
