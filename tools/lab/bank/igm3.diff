 // PASSIVE Issac: his dash (2 steps, walk-compatible, no landing effect) closes the gap a walk cannot: from 3 tiles it lands next to
 // the focus and the basic attack follows this turn (fewest other enemies around the landing). Vendetta's closes the gap the same way
 // for a focus she can finish, a stunned one or a weak one, any melee plain dash (Ren, Vendetta) for a kill, each onto a landing
 // no more crowded than the kill dash's bar. When those gates refuse: a focus my mate is hitting (only the weak-focus gate is dropped).
+// IGM (spec_igm_1110), caller read IGM_ON(1): who follows plain Issac's no-kill gap dash. 1 = a mate other than Cassi within 2 of the
+// landing, or one still to act this round (turn order: mv::tie_prio, then draft order) whose walk plus its own ready dash brings the
+// focus into its attack range; 2 = Cassi within 4 of the focus (her spell range, GameRules.md:450-458), not stunned, a spell ready.
+// IGM bit 16 IGO1 (Rule Checker C36): a body's priority in THIS round's queue (sdk_bc_champion_priority(h, 0), as move_turn_order.cc
+// reads it); mv::tie_prio is next round's, and the FTR tier moves in fights.
+int igm_cur_prio(std::uint32_t h)
+{
+	std::int32_t v = 0;
+	return (h != 0 && cambc::detail::sdk_bc_champion_priority(h, 0, &v) == 0) ? PRA_DEC(v) : 0;
+}
+static __attribute__((noinline)) int igm_follow(const Body& f, vec2 land)
+{
+	const int me = P.my_slot;
+	const int pm = me >= 0 ? ((IGM_ON(16)) ? igm_cur_prio(static_cast<std::uint32_t>(cambc::detail::cached_my_champion)) : mv::tie_prio(me)) : 0; // IGO1
+	const int ls = cassi_issac_partner_slot();
+	int r = 0;
+	for (const auto& al : W.allies)
+	{
+		if (al.stunned || al.channeling() || !al.kit)
+			continue;
+		if (al.slot == ls)
+		{
+			const Kit& ak = *al.kit;
+			if (cheb(al.pos, f.pos) <= 4 && ((ak.slot_dmg >= 0 && foe_cd(al, ak.slot_dmg) <= 0) || (ak.slot_cc >= 0 && foe_cd(al, ak.slot_cc) <= 0)))
+				r |= 2;
+			continue;
+		}
+		if (cheb(al.pos, land) <= 2)
+		{
+			r |= 1;
+			continue;
+		}
+		const int ps = (IGM_ON(16)) ? igm_cur_prio(al.h) : mv::tie_prio(al.slot); // IGO1: this round's queue (GR:118, :130)
+		if (me < 0 || al.slot < 0 || ps > pm || (ps == pm && al.slot < me))
+			continue; // acted before me this round
+		int reach = 1;
+		const Kit& ak = *al.kit;
+		if (ak.slot_dash >= 0 && foe_cd(al, ak.slot_dash) <= 0)
+			reach = ak.dash_range <= 2.0f ? 1 + static_cast<int>(ak.dash_range) : static_cast<int>(ak.dash_range); // a long dash excludes the walk
+		if (cheb(al.pos, f.pos) <= reach + al.range)
+			r |= 1;
+	}
+	return r;
+}
+// IGM, caller read IGM_ON(1): refuse plain Issac's no-kill gap dash. Bit 2: before round 300 only; bit 4: also refuse a follow-up
+// dash onto a focus above 60% of its HP (shield counted).
+static __attribute__((noinline)) bool igm_refuse(const Body& f, vec2 land)
+{
+	if (IGM_ON(2) && W.round >= 300)
+		return false;
+	if ((igm_follow(f, land) & (IGM_ON(8) ? 1 : 3)) == 0) // b1819 igm2 bit 8: Cassi alone is no follow-up
+		return true;
+	if (!IGM_ON(4))
+		return false;
+	Body full = f; // the same body at full HP, no shield: the multiplier cancels
+	full.hp = f.maxhp;
+	full.shield = 0;
+	return eff_hp(f) > 0.6f * eff_hp(full);
+}
