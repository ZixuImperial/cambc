@@ -134,13 +193,13 @@ static __attribute__((always_inline)) inline void fight_gap_dash(FightCtx& c)
 	const bool crowd_bar = ve_dash || fr_dash || md_dash; // plain Issac alone takes any landing
 	if (!issac && !crowd_bar)
 		return;
 	int best_s = 1 << 30;
 	const vec2 best = geom::plain_land(f, ve_init, best_s);
 	const int kdg_here = cast::kill_dash_crowd_bar(f, fr_dash, best, best_s);
-	if (best.x >= 0 && (!crowd_bar || best_s <= kdg_here) && cast_at(k.slot_dash, best))
+	if (best.x >= 0 && (!crowd_bar || best_s <= kdg_here) && !(IGM_ON(1) && !crowd_bar && igm_refuse(f, best)) && cast_at(k.slot_dash, best)) // IGM: a lone no-kill dash needs a follow-up
 		fight_moved(c);
 }
