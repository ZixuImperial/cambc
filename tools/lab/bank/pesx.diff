+// v8xx PESR1 (caller reads PESX_ON(2)): the global table is recent and near enough for the starved pass.
+static __attribute__((noinline)) bool pesx_reuse()
+{
+	return travel.size() == static_cast<std::size_t>(M.ng) && travel_round >= 0 && now() - travel_round <= PESX_TAB[2] &&
+		   cheb(travel_from, W.me.pos) <= PESX_TAB[2];
+}
+// v8xx PESB1 (caller reads PESX_ON(1)): the starved pass on a local travel: the PESX_TAB[3] cheb-nearest valued walk groups priced as
+// compute_travel prices them (walk field, island skip, open-field fallback, spawn-crystal pricing; no stored travel), then the top PES_N
+// rated as live. Writes nothing global but the pick.
+template <int DM>
+__attribute__((noinline)) void pesx_choose(const std::array<std::uint8_t, 8>& now_claims)
+{
+	constexpr int PC = 32;
+	const int nc = std::max(PES_N, std::min(PC, static_cast<int>(PESX_TAB[3])));
+	std::array<int, PC> cg{};
+	std::array<int, PC> cd{};
+	int cn = 0;
+	for (std::size_t gj = 0; gj < static_cast<std::size_t>(M.ng) && gj < gmem_size(mem); ++gj)
+	{
+		const auto& h = M.groups[gj];
+		if (h.access != ACC_WALK || h.gems + h.gold == 0 || mem[gj].fail_until > now())
+			continue;
+		int d = cheb(W.me.pos, h.anchor);
+		if (cn == nc && d >= cd[static_cast<std::size_t>(cn - 1)])
+			continue;
+		int b = cn < nc ? cn++ : cn - 1;
+		for (; b > 0 && cd[static_cast<std::size_t>(b - 1)] > d; --b)
+		{
+			cd[static_cast<std::size_t>(b)] = cd[static_cast<std::size_t>(b - 1)];
+			cg[static_cast<std::size_t>(b)] = cg[static_cast<std::size_t>(b - 1)];
+		}
+		cd[static_cast<std::size_t>(b)] = d;
+		cg[static_cast<std::size_t>(b)] = static_cast<int>(gj);
+	}
+	const int sc_mode = spawn_crystal_travel_mode();
+	const bool strand = stranded();
+	std::array<int, PES_N> ng{};
+	std::array<int, PES_N> nd{};
+	ng.fill(-1);
+	nd.fill(BIG);
+	for (int c = 0; c < cn; ++c)
+	{
+		const int gi = cg[static_cast<std::size_t>(c)];
+		std::uint16_t v = mv::group_dist_here_inl(gi);
+		if (v == UNREACH && strand)
+			continue;
+		if (v == UNREACH)
+			v = static_cast<std::uint16_t>(std::min(60000, cheb(W.me.pos, M.groups[static_cast<std::size_t>(gi)].anchor) * 4 / 3 + 2));
+		if (sc_mode)
+			v = spawn_crystal_travel(gi, v, sc_mode);
+		if (v == UNREACH)
+			continue;
+		int d = static_cast<int>(v);
+		int k = gi;
+		for (int i = 0; i < PES_N; ++i)
+			if (d < nd[static_cast<std::size_t>(i)])
+			{
+				std::swap(d, nd[static_cast<std::size_t>(i)]);
+				std::swap(k, ng[static_cast<std::size_t>(i)]);
+			}
+	}
+	const Claims cl = claims_for_me();
+	const int fn = free_near();
+	float best_r = 0;
+	int best = -1, best_c = 1;
+	nova::econ::linear_score::begin();
+	for (int i = 0; i < PES_N; ++i)
+	{
+		const int k = ng[static_cast<std::size_t>(i)];
+		if (k < 0 || fuel() < PES_FLOOR)
+			break;
+		if (!reachable_target(k))
+			continue;
+		int cc = 1;
+		const float rr = rate_for<DM>(k, my_slot(), static_cast<std::uint16_t>(nd[static_cast<std::size_t>(i)]), cl, fn, &cc);
+		if (rr > 0)
+			nova::econ::linear_score::cand(k, cc, rr);
+		if (rr > best_r)
+		{
+			best_r = rr;
+			best = k;
+			best_c = cc;
+		}
+	}
+	nova::econ::linear_score::pick(-1, &best, &best_c, &best_r);
+	if (best < 0)
+		return;
+	eval_claims = now_claims;
+	opened = true;
+	set_target(best, best_r, best_c);
+}
