 // CHO (b2402, RC X909 CHO3; bug bar): capture_pay_in returned max(1, k) = 1 at k == 0 (the pay round: the capture phase paid the region
 // before champion turns, GR:124 / INT:120) without the engine check, so a calm orphan hold stood one extra round on a paid region.
 // Runtime data flag CHO_TAB[1], read first; 0 = v893. Bit 1: the engine check (engine_capture_countdown, cps_cps2_dead) also runs at k == 0.
 // v896 CHO: 7 verified bug fixes (TTCX TDP EAF OLK RFV NTG CHO)
 #define CHO_BITS 1
 inline constexpr int CHO_TAB[2] = { 0x43484F33, CHO_BITS }; // slot 0 magic keeps it out of .bss
+
+// PESX (b2381 -> b2394, RC X835): the starved-choice pass (econ_opening_finish.cc choose_target_when_starved) without its stale-table cut.
+// Runtime data flag PESX_TAB[1], read first; 0 = v863. Bit 1 PESB1: a local, bounded travel for the PESX_TAB[3] cheb-nearest valued
+// walk groups (compute_travel's per-group value; no global write), then the usual top-PES_N rating. Bit 2 PESR1: reuse the global table
+// when now() - travel_round <= PESX_TAB[2] and cheb(travel_from, me) <= PESX_TAB[2]. Bit 4 DNBF1: compute_travel prices dash-only
+// groups without the 40k fuel term (econ_travel_gates.cc; route lengths are memoised).
+#define PESX_BITS 0
+#define PESX_AGE 5
+#define PESX_C 12
+inline const volatile int PESX_TAB[4] = { 0x50455358, PESX_BITS, PESX_AGE, PESX_C }; // slot 0 magic keeps it out of .bss
+#define PESX_ON(b) ((PESX_TAB[1] & (b)) != 0)
