+// b2393 TCQ (spec_tcq_1113; RC C1099 election): in a SPLIT engagement (a mate within 6 posting an in-fight stance, comms ckind 4, whose
+// commit/hold v retreat differs from my FIGHT v FLEE) ONE body decides: the roster's lead carry among the members (Prism, then Vesper,
+// then Marcella), else the lowest slot. The decider computes S = local power at the members' centroid from its own view (ours: bodies
+// within LOCAL_POWER_R, not channelling, not retreating; theirs: the foes it knows there) and sets its stance; the others adopt the
+// decider's POSTED stance (commit/hold = FIGHT, retreat = FLEE). Returns the wanted stance: 1 FIGHT, 2 FLEE, 0 none.
+static int tcq_carry_rank(int slot)
+{
+	if (slot < 0 || slot >= P.n)
+		return 9;
+	const auto t = P.type[static_cast<std::size_t>(slot)];
+	return t == cambc::champion_type::prism ? 0 : t == cambc::champion_type::vesper_vale ? 1 : t == cambc::champion_type::marcella ? 2 : 9;
+}
+static int tcq_want(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	if (a.stance != FIGHT && a.stance != FLEE)
+		return 0;
+	const bool me_fight = a.stance == FIGHT;
+	const int my = P.my_slot;
+	int n = 1, dec = my, dec_rank = tcq_carry_rank(my);
+	float cx = static_cast<float>(c.me.x), cy = static_cast<float>(c.me.y);
+	bool split = false;
+	for (const auto& al : W.allies)
+	{
+		if (al.slot < 0 || cheb(al.pos, c.me) > 6 || comms::ckind(al.slot) != 4)
+			continue;
+		const int st = comms::cval(al.slot) / 4; // 0 commit, 1 hold, 2 retreat
+		split |= (st == 2) == me_fight;
+		cx += static_cast<float>(al.pos.x);
+		cy += static_cast<float>(al.pos.y);
+		++n;
+		const int rk = tcq_carry_rank(al.slot);
+		if (rk < dec_rank || (rk == dec_rank && al.slot < dec))
+		{
+			dec = al.slot;
+			dec_rank = rk;
+		}
+	}
+	if (!split)
+		return 0;
+	if (dec != my)
+		return comms::cval(dec) / 4 == 2 ? 2 : 1; // follow the decider's posted stance
+	const vec2 ctr{ static_cast<int>(cx / static_cast<float>(n) + 0.5f), static_cast<int>(cy / static_cast<float>(n) + 0.5f) };
+	float uh = 0, us = 0;
+	if (cheb(c.me, ctr) <= tune::LOCAL_POWER_R)
+	{
+		uh += eff_hp(W.me);
+		us += W.me.str + W.me.foc;
+	}
+	for (const auto& al : W.allies)
+		if (!al.channeling() && cheb(al.pos, ctr) <= tune::LOCAL_POWER_R && !nova::combat::retreating_mates::retreating(al))
+		{
+			uh += eff_hp(al);
+			us += al.str + al.foc;
+		}
+	float th = 0, ts = 0;
+	for (const auto& f : a.foes)
+	{
+		if (cheb(f.pos, ctr) > tune::LOCAL_POWER_R)
+			continue;
+		th += std::max(1.0f, f.ehp);
+		ts += f.idx >= 0 ? assess_enemy(f.idx).str + assess_enemy(f.idx).foc : (W.me.str + W.me.foc);
+	}
+	if (th <= 0)
+		return 0;
+	const float S = (uh * us) / std::max(1.0f, th * ts);
+	return S >= static_cast<float>(TCQ_TAB[2]) / 100.0f ? 1 : S < static_cast<float>(TCQ_TAB[3]) / 100.0f ? 2 : 0;
+}
+// b2393 TCQ bit 4 (Builder 13 Nov, form B; shared memory holds no positions, GameRules.md:411): ONE team-wide decider, the lowest slot
+// posting an in-fight claim (ckind 4; me when my stance is FIGHT or FLEE), the same key on every body. The decider keeps its live stance;
+// a follower adopts its posted stance (commit/hold = FIGHT, retreat = FLEE) only when it is a visible ally within 8, else nothing.
+inline int tcq_undecided_r = -1; // b2393 TCQ bit 4: a round I was in a fight while the decider was away (cost row)
+static int tcq_follow(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	if (a.stance != FIGHT && a.stance != FLEE)
+		return 0;
+	const int my = P.my_slot;
+	int dec = my;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS && s < my; ++s)
+		if (comms::ckind(s) == 4)
+		{
+			dec = s;
+			break;
+		}
+	if (dec == my)
+		return 0; // I decide: the live stance stands
+	for (const auto& al : W.allies)
+		if (al.slot == dec && cheb(al.pos, c.me) <= 8)
+			return comms::cval(dec) / 4 == 2 ? 2 : 1;
+	tcq_undecided_r = static_cast<int>(W.round);
+	return 0;
+}
+// b2393 TCQ bit 16 SETTLE LATCH (Planner 13 Nov): the team-wide decider changes only after a new lowest in-fight slot has posted in-fight
+// for 2 consecutive rounds; the current one is released after 2 rounds posting not in-fight, or at once when it posts dead. The latch
+// reads claims only, so every body that sees the same rounds holds the same decider. A body that can't see the team decider within 8
+// latches its own: the lowest in-fight slot it can see within 8 (or me), with the same 2-round rule. -1: no decider.
+struct TcqLatch // RC C1100d: round-based, so a body that misses a round stays in step with its mates
+{
+	int dec = -1, cand = -1, cand_since_r = -1000, dec_last_in_r = -1000;
+	void step(int lowest, bool dec_dead, bool dec_in, int r)
+	{
+		if (dec >= 0)
+		{
+			if (dec_in)
+				dec_last_in_r = r;
+			if (dec_dead || r - dec_last_in_r >= 2)
+				dec = -1;
+		}
+		if (lowest >= 0 && lowest != dec)
+		{
+			if (lowest != cand)
+			{
+				cand = lowest;
+				cand_since_r = r;
+			}
+			if (r - cand_since_r >= 1)
+			{
+				dec = cand;
+				dec_last_in_r = r;
+				cand = -1;
+			}
+		}
+		else
+			cand = -1;
+	}
+};
+inline TcqLatch tcq_team, tcq_local;
+inline int tcq_latch_r = -1;
+// b2393 TCQ bit 32 STAY WITH FIGHTERS (Planner 13 Nov, after the selection table: in splits the fleers die 1.4-1.9x the fighters at
+// equal power): body-level, no decider. My FLEE stays FIGHT only when >= 2 visible mates within 6 post an in-fight commit/hold, my own
+// local power (me + allies within 8, not channelling, not retreating, v the foes I know within 8) is >= TCQ_STAY_X100 / 100, my HP is
+// >= 60% and not low, I am not stunned, my bag < 60, no visible foe kills me next turn and the known foes' two-turn damage is below my
+// eff_hp. Otherwise the live stance stands.
+static __attribute__((noinline)) void tcq_stay(const AssessCtx& c)
+{
+	Assessment& a = c.a;
+	if (a.stance != FLEE || a.focus < 0 || c.low || W.me.stunned || c.bag >= 60 || W.me.frac() < 0.6f || a.caught)
+		return;
+	if ((linked_slot() >= 0 && !CI2_FIGHT()) || (c.efc.allies4 == 0 && c.efc.near5 >= tune::LONE_NEAR5_MIN) ||
+		(memory::team_dead() > 0 && a.n_foes >= tune::MATE_DEAD_FOES))
+		return; // RC C1100e: the hard-flee exclusions tcq_apply uses
+	int mates = 0;
+	for (const auto& al : W.allies)
+		if (al.slot >= 0 && cheb(al.pos, c.me) <= 6 && comms::ckind(al.slot) == 4 && comms::cval(al.slot) / 4 != 2)
+			++mates;
+	if (mates < 2)
+		return;
+	float uh = eff_hp(W.me), us = W.me.str + W.me.foc;
+	for (const auto& al : W.allies)
+		if (!al.channeling() && cheb(al.pos, c.me) <= tune::LOCAL_POWER_R && !nova::combat::retreating_mates::retreating(al))
+		{
+			uh += eff_hp(al);
+			us += al.str + al.foc;
+		}
+	float th = 0, ts = 0;
+	for (const auto& f : a.foes)
+	{
+		if (cheb(f.pos, c.me) > tune::LOCAL_POWER_R)
+			continue;
+		th += std::max(1.0f, f.ehp);
+		ts += f.idx >= 0 ? assess_enemy(f.idx).str + assess_enemy(f.idx).foc : (W.me.str + W.me.foc);
+	}
+	if (th <= 0 || (uh * us) / std::max(1.0f, th * ts) < static_cast<float>(TCQ_ON(64) ? TCQ_STAY64_X100 : TCQ_STAY_X100) / 100.0f)
+		return;
+	if (visible_foes_lethal_next_turn() || foe_damage_over_ticks(2, 2) >= eff_hp(W.me))
+		return;
+	a.stance = FIGHT;
+}
+static __attribute__((noinline)) void tcq_latch_update()
+{
+	const int my = P.my_slot;
+	if (tcq_latch_r != static_cast<int>(W.round)) // once a round, from claims only
+	{
+		tcq_latch_r = static_cast<int>(W.round);
+		int lowest = -1;
+		for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS; ++s)
+			if (comms::ckind(s) == 4)
+			{
+				lowest = s;
+				break;
+			}
+		const int d = tcq_team.dec;
+		tcq_team.step(lowest, d >= 0 && comms::ckind(d) == 1, d >= 0 && comms::ckind(d) == 4, static_cast<int>(W.round));
+		int vis = -1; // the lowest in-fight slot I can see within 8, or me
+		for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS && vis < 0; ++s)
+		{
+			if (comms::ckind(s) != 4)
+				continue;
+			if (s == my)
+				vis = s;
+			for (const auto& al : W.allies)
+				if (al.slot == s && cheb(al.pos, W.me.pos) <= 8)
+					vis = s;
+		}
+		const int dl = tcq_local.dec;
+		tcq_local.step(vis, dl >= 0 && comms::ckind(dl) == 1, dl >= 0 && comms::ckind(dl) == 4, static_cast<int>(W.round));
+	}
+}
+static int tcq_follow_latched(const AssessCtx& c)
+{
+	const Assessment& a = c.a;
+	const int my = P.my_slot;
+	if (a.stance != FIGHT && a.stance != FLEE)
+		return 0;
+	int dec = tcq_team.dec;
+	bool near = dec == my;
+	for (const auto& al : W.allies)
+		near |= dec >= 0 && al.slot == dec && cheb(al.pos, c.me) <= 8;
+	if (!near)
+	{
+		dec = tcq_local.dec;
+		near = dec == my;
+		for (const auto& al : W.allies)
+			near |= dec >= 0 && al.slot == dec && cheb(al.pos, c.me) <= 8;
+	}
+	if (dec < 0 || !near)
+	{
+		tcq_undecided_r = static_cast<int>(W.round);
+		return 0;
+	}
+	if (dec == my)
+		return 0; // I decide: the live stance stands
+	return comms::cval(dec) / 4 == 2 ? 2 : 1;
+}
+static __attribute__((noinline)) void tcq_apply(const AssessCtx& c)
+{
+	Assessment& a = c.a;
+	const int w = TCQ_ON(16) ? tcq_follow_latched(c) : TCQ_ON(4) ? tcq_follow(c) : tcq_want(c);
+	if (w == 1 && TCQ_ON(21) && a.stance == FLEE && !a.caught && !c.low && c.bag < (BSF_TAB[2]) && a.focus >= 0 &&
+		!(linked_slot() >= 0 && !CI2_FIGHT()) && !(c.efc.allies4 == 0 && c.efc.near5 >= tune::LONE_NEAR5_MIN) &&
+		!(memory::team_dead() > 0 && a.n_foes >= tune::MATE_DEAD_FOES)) // RC C1099/C1049b: never a hard flee
+		a.stance = FIGHT;
+	else if (w == 2 && TCQ_ON(22) && a.stance == FIGHT && !a.caught && !c.kill_now && !a.in_reach)
+		a.stance = FLEE;
+}
 } // namespace stance
 // The priority-message channel. Every function here runs only with its PRA bit set. msg17: bit 16 ASSIST (I am in FIGHT and count a
