+++ b/src/combat_flags.h
@@ -737,6 +737,26 @@ inline constexpr int PDK_TAB[2] = { 0x50444B31, PDK_BITS }; // slot 0 magic keep
 inline constexpr int PTD_TAB[2] = { 0x50544431, PTD_BITS }; // slot 0 magic keeps it out of .bss
 // RRZ (b2337, RC X779 RRZN1, behaviour): flee's escape_toward rally (react_rally) skips an ally inside flee()'s zones, as rally_ally
 // does. Runtime data flag, read first; 0 = v845. Bit 1 only.
 // v850 RRZ: RRZN1 rally point zone test
 #define RRZ_BITS 1
 inline constexpr int RRZ_TAB[2] = { 0x52525A31, RRZ_BITS }; // slot 0 magic keeps it out of .bss
+
+// b2393 TCQ (spec_tcq_1113, Combat; OWNER 13 Nov: "one math formula so everyone has the same output of combat score -> attack/retreat
+// together"): one shared score per engagement. At assess's end, in a SPLIT engagement (a mate within 6 posting an in-fight stance that
+// differs from mine: commit/hold v retreat), S = local power at the centroid of me and those mates (ours: bodies within LOCAL_POWER_R of
+// it, not channelling, not retreating; theirs: the foes I know within it; sum eff_hp x sum (str + foc)). Bit 1 TOGETHER-UP: S >= TCQ_HI
+// turns my FLEE into FIGHT (not caught, not low, no carry bag, a focus to hit). Bit 2 TOGETHER-DOWN: S < TCQ_LO turns my FIGHT into
+// FLEE (not caught, not kill_now, not in reach). Bit 4 SHARED DECIDER (form B): the decider is the lowest slot posting an in-fight
+// claim team-wide; a follower within 8 of it (visible) adopts its posted stance under the same exceptions; else nothing. Bits 1/2 use the
+// C1099 election instead. Bit 16 SETTLE LATCH: bit 4's decider through a 2-round latch (hand-over after 2 rounds of the new lowest
+// in-fight slot; release after 2 rounds not in-fight or on death), plus a local latched decider (lowest in-fight slot I see within 8)
+// for a second fight. Bit 32 STAY WITH FIGHTERS: body-level; a FLEE stays FIGHT with >= 2 visible in-fight mates within 6, own power
+// >= TCQ_STAY_X100 / 100, HP >= 60% and not low, not stunned, bag < 60, not lethal within 2 turns. Bit 64: bit 32 with the power gate at
+// TCQ_STAY64_X100 / 100 (1.00). Runtime data flag, read first; 0 = live.
+#define TCQ_BITS 0
+#define TCQ_HI_X100 100
+#define TCQ_LO_X100 72
+#define TCQ_STAY64_X100 100 // b2393 TCQ bit 64: bit 32 with the own-power gate at 1.00 (the only change)
+#define TCQ_STAY_X100 130 // b2393 TCQ bit 32: the own-view local power a fleer needs to stay with >= 2 fighting mates
+inline const volatile int TCQ_TAB[4] = { 0x54435131, TCQ_BITS, TCQ_HI_X100, TCQ_LO_X100 }; // slot 0 magic keeps it out of .bss
+#define TCQ_ON(b) ((TCQ_TAB[1] & (b)) != 0)
