 #define PCM_R 400
 inline constexpr int PCM_TAB[4] = { 0x50434D31, PCM_BITS, PCM_G, PCM_R }; // slot 0 magic keeps it out of .bss
+// b2430 RVP (Planner RCG, Econ CSO count): the lead carry (combat::crk_is_carry: Prism > Vesper > Marcella) prices an uncontested
+// group's value as value^a / time (a = RVP_A_X100 / 100), so among similar rates she takes the richer group; scaled as
