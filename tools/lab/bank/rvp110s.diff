+#define RVP_BITS 0
+#define RVP_A_X100 120
+#define RVP_V 30
+#define RVP_DR 10
+#define RVP_DAGE 25
+inline const volatile int RVP_TAB[6] = { 0x52565031, RVP_BITS, RVP_A_X100, RVP_V, RVP_DR, RVP_DAGE }; // slot 0 magic keeps it out of .bss
