+// b2430 RVP (econ_flags.h; the caller read the flag): the carry's value power factor (value / RVP_V)^(a - 1); 1 for no value.
+__attribute__((noinline)) float rvp_factor(float v)
+{
+	if (!(v > 0.0f))
+		return 1.0f;
+	return std::pow(v / static_cast<float>(RVP_TAB[3]), static_cast<float>(RVP_TAB[2] - 100) / 100.0f);
