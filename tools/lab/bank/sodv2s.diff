+// b2245 SOD (econ_flags.h): per group, the round of the last enemy_capturing read and its countdown. Reached only with the flag on.
+static std::vector<int> sod_rv, sod_kv, sod_lv;
+static int sod_lr = -1000;
+void sod_note(int gi, int k)
+{
+	if (gi < 0 || gi >= M.ng)
+		return;
+	if (static_cast<int>(sod_rv.size()) != M.ng)
+	{
+		sod_rv.assign(static_cast<std::size_t>(M.ng), -1000);
+		sod_kv.assign(static_cast<std::size_t>(M.ng), -1);
+	}
+	if (sod_lr != now())
+	{
+		sod_lr = now();
+		sod_lv.clear();
+	}
+	const auto u = static_cast<std::size_t>(gi);
+	if (sod_rv[u] != now())
+		sod_lv.push_back(gi);
+	sod_rv[u] = now();
+	sod_kv[u] = k;
+}
+int sod_k(int gi)
+{
+	if (gi < 0 || gi >= static_cast<int>(sod_rv.size()) || sod_rv[static_cast<std::size_t>(gi)] != now())
+		return -1;
+	return sod_kv[static_cast<std::size_t>(gi)];
+}
+const std::vector<int>& sod_list()
+{
+	if (sod_lr != now())
+		sod_lv.clear();
+	return sod_lv;
+}
+bool sod_class_ok(int gi)
+{
+	return !SOD_ON(8) || M.groups[static_cast<std::size_t>(gi)].members.size() < 20;
+}
+bool sod_value_ok(int gi)
+{
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	return static_cast<float>(g.gems) + static_cast<float>(g.gold) * gold_weight_in_gems_for_slot(P.my_slot) >= static_cast<float>(SOD_TAB[3]);
+}
+bool sod_gave_up(int gi)
+{
+	return sod_gave_gi == gi && now() - sod_gave_r <= 15; // the give-up's own drop_target(15) window
+}
+bool sod_tile(vec2 p)
+{
+	if (sod_lr != now() || sod_lv.empty())
+		return false;
+	const int ci = M.camp_index(p);
+	if (ci < 0 || ci >= M.nc)
+		return false;
+	const int gi = M.camps[static_cast<std::size_t>(ci)].group;
+	return gi >= 0 && gi < M.ng && sod_k(gi) >= 1 && sod_class_ok(gi);
+}
