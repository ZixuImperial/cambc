diff --git a/src/econ_flags.h b/src/econ_flags.h
--- a/src/econ_flags.h
+++ b/src/econ_flags.h
@@ -1528,6 +1528,19 @@ inline constexpr int BWLR_TAB[2] = { 0x42574C52, BWLR_BITS };
 // crystal, yet her crystal casts ran the foe gates. Bit 1: crystal_step's ready-stun bar (econ_crystal_plan.cc) skipped for her
 // (marcella_layer::chan_stun_proof). Bit 2: the "no crystal channel with a foe within 4 of me" gates (crystal_step's foe bar and
 // the spawn crystal trip's cxf_me) skipped for her; foe-near landing filters stay. 0 = v841.
 #define MCKS_BITS 0
 inline const volatile int MCKS_TAB[2] = { 0x4D434B53, MCKS_BITS };
 #define MCKS_ON(b) ((MCKS_TAB[1] & (b)) != 0)
+// CKX (b2355, RC X792 K1 K2 K3 + C946 leads 5 and 4: live CLTF carry-code bugs). Runtime data flag CKX_TAB[1], read first; 0 = v848.
+// Bit 1 K1: cltf_fallback's latch expires: after lr + le + 20 the left group is no longer 'mine to take again' (cltf_leave's
+// re-record then runs; claimed()'s exemption no longer lifts every mate's claim for the rest of the game).
+// Bit 2 K3: cltf_exempt's carry branch also needs my travel to the group <= CLTF_WAIT.
+// Bit 4 K2: an unseen carry is not 'gone': with her out of my sight, the fallback reads team state (alive, her claim on gi, claim kind
+// not dead / fight / coming) plus the time and foe clauses; the member-tile test needs sight and is skipped.
+// Bit 16 lead 5: cltf_carry_pick's crew trail (bit 4) skips a group under a fail mark (m.fail_until > now), as bit 2 does.
+// Bit 8 lead 4 (behaviour): cap_rank ranks a CLTF level-1 carry of the group first (CKX_RANK), so the carry the helpers left for is
+// not refused at the hand-over.
+#define CKX_BITS 0
+#define CKX_RANK 2000
+inline const volatile int CKX_TAB[3] = { 0x434B5831, CKX_BITS, CKX_RANK }; // slot 0 magic keeps it out of .bss
+#define CKX_ON(b) ((CKX_TAB[1] & (b)) != 0)
