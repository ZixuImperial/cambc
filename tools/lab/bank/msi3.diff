+}
+bool msi8_any()
+{
+	msi8_build();
+	return msi8_on;
+}
+bool msi4_group(int gi)
+{
+	if (gi < 0 || gi >= M.ng)
+		return false;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	if (g.gold <= 0 || g.gems <= 0)
+		return false; // mixed groups (owner via RC: a fielded Prism leads every group she shares)
+	if (!msi_team_marcella() || !prism::prism_alive() || (MSI_ON(8) && msi8_group(gi)))
+		return false;
+	const int ps = prism::prism_slot();
+	return (ps >= 0 && ps < comms::CLAIM_SLOTS && comms::cgroup(ps) == gi) || prism::pc_group(gi);
+}
+} // namespace nova::marcella_layer
