+static int msi8_stun_roster = -1; // the enemy draft fields a stun kit (cc / aoe stun / dash stun / reset stun): 1, 0, -1 unknown
+static void msi8_build()
+{
+	if (msi8_round == W.round && msi8_g.size() == static_cast<std::size_t>(M.ng))
+		return;
+	msi8_round = W.round;
+	msi8_on = false;
+	msi8_g.assign(static_cast<std::size_t>(std::max(0, M.ng)), 0);
+	// Team-agreed inputs only (Planner/VV 12 Nov): no living Prism of ours, our Marcella alive, the enemy roster, the team event
+	// channel's enemy reports at our altars (intel::msi_altar_enemy_round), and static map distances.
+	if (msi_slot_alive(prism::prism_slot()) || !M.done())
+		return; // RC C884c: engine-based, not sight
+	int ms = -1;
+	for (int i = 0; i < P.n; ++i)
+		if (P.type[static_cast<std::size_t>(i)] == cambc::champion_type::marcella)
+			ms = i;
+	if (!msi_slot_alive(ms))
+		return;
+	if (msi8_stun_roster < 0)
+	{
+		msi8_stun_roster = 0;
+		for (const auto& e : roster(team::enemy))
+		{
+			const Kit& k = kit_of(e.type);
+			if (k.slot_cc >= 0 || k.aoe_stun || k.dash_stun || k.reset_enhanced)
+				msi8_stun_roster = 1;
+		}
+	}
+	if (msi8_stun_roster != 1)
+		return;
+	for (int ai = 0; ai < M.na; ++ai)
+	{
+		const auto& a = M.altars[static_cast<std::size_t>(ai)];
+		if (a.d_home == UNREACH || a.d_home > a.d_enemy)
+			continue; // an altar on our side: one we bank at
+		const int age = W.round - intel::msi_altar_enemy_round(ai);
+		if (age < 0 || age > PC_KNOWN_AGE)
+			continue;
+		msi8_on = true;
+		for (int gi = 0; gi < M.ng; ++gi)
+		{
+			const auto& g = M.groups[static_cast<std::size_t>(gi)];
+			if (g.gems > 0 && cheb(g.anchor, a.pos) <= 12 && dfget(M.f_altar, g.anchor) <= 12)
+				msi8_g[static_cast<std::size_t>(gi)] = 1; // static map distances: the same on every body
+		}
+	}
+}
+bool msi8_group(int gi)
+{
+	msi8_build();
