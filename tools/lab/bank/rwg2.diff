+// b2383 RWG bit 1 (caller read the flag): the roster carry at g does not camp a respawn: her wait budget is RWG_CK % of the crew's.
+void rwg_fc_carry()
+{
+}
+float rwg_wait_limit(const GroupI& g, int s)
+{
+	const float lim = crew_wait_limit(g);
+	if (cltf_level(s, g) != RWG_TAB[3])
+		return lim;
+	rwg_fc_carry();
+	return lim * (static_cast<float>(RWG_TAB[2]) / 100.0f);
+}
+// b2383 RWG bit 1 (caller read the flag): the wait filler opens from RWG_FRL rounds left for her, FRL_MIN for the rest.
+int rwg_filler_min(const GroupI& g)
+{
+	return cltf_level(my_slot(), g) == RWG_TAB[3] ? RWG_TAB[4] : FRL_TAB[2];
+}
+// b2383 RWG bit 2 (caller read the flag; RC C971 F5): foes seen this turn or last (my sight / ward, team_table src 1-3) within RWG_R of
+// g's anchor: at least 2 and more than our bodies there (me, mates in sight within RWG_R, unseen live mates claiming gi on comms).
+void rwg_fc_out()
+{
+}
+bool rwg_outnumbered(int gi, const GroupI& g)
+{
+	const int r = RWG_TAB[5];
+	int foes = 0;
+	for (const auto& ts : intel::team_table())
+		if (ts.alive && ts.src >= 1 && ts.src <= 3 && ts.round >= now() - 1 && cheb(ts.pos, g.anchor) <= r)
+			++foes;
+	if (foes < 2)
+		return false;
+	int ours = 1;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == my_slot())
+			continue;
+		if (const Body* b = W.ally_by_slot(s))
+			ours += cheb(b->pos, g.anchor) <= r ? 1 : 0;
+		else if (comms::cgroup(s) == gi && siege_ally_alive(s))
+			++ours;
+	}
+	if (foes <= ours)
+		return false;
+	rwg_fc_out();
+	return true;
+}
