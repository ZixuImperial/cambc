diff --git b/src/feat_bun6.cpp b/src/feat_bun6.cpp
new file mode 100644
--- /dev/null
+++ b/src/feat_bun6.cpp
@@ -0,0 +1,69 @@
+#ifdef NOVA_UNITY_ALL // unity build: compiled only through nova_all.cpp
+// feat_bun6.cpp (BN6, b1627): see feat_bun6.h. Unity build: after econ.cpp.
+#include "feat_bun6.h"
+namespace nova::feat::bn6
+{
+namespace
+{
+// Fire functions, one per bit (a firecount entry each): grg_fire = GRG turned back a Greed entry live's gate passed; ptb2_fire = a paid
+// capture settled before the stage chain; dcd_fire = a visible foe's dash margin dropped.
+void grg_fire()
+{
+}
+void ptb2_fire()
+{
+}
+void dcd_fire()
+{
+}
+} // namespace
+float grg_rounds_left()
+{
+	using namespace nova::econ;
+	const int r = std::max(1, now());
+	auto left = [&](int trib) { return trib <= 0 ? GAME_END_F : static_cast<float>(1000 - trib) * static_cast<float>(r) / static_cast<float>(trib); };
+	return std::max(0.0f, std::min({ static_cast<float>(GAME_END - r), left(W.tributed_us), left(W.tributed_them) }));
+}
+bool grg_fits(int g, int earned)
+{
+	using namespace nova::econ;
+	if (g >= 750)
+		return true;
+	const float rate = static_cast<float>(earned) / static_cast<float>(std::max(1, now()));
+	const float rl = grg_rounds_left();
+	const bool fits = rate > 0.0f && static_cast<float>(750 - g) / rate * 1.3f <= rl;
+	if (!fits && static_cast<float>(g) + rate * rl >= 750.0f)
+		grg_fire();
+	return fits;
+}
+void ptb2_settle()
+{
+	using namespace nova::econ;
+	if (!T.capturing || T.target < 0 || !W.alive)
+		return;
+	const int gi = T.target;
+	const auto& m = mem[static_cast<std::size_t>(gi)];
+	const bool gain = W.me.gems > T.cap_gems || W.gold > T.cap_gold;
+	if (!gain && m.status != GS_RESPAWN)
+		return;
+	if (gain && m.status != GS_RESPAWN)
+	{
+		const int gs = group_state_now(gi); // CAP_CONFIRM: alive or unpaid: not the capture; capture() handles it later
+		if (gs == 1 || gs == 2)
+			return;
+	}
+	ptb2_fire();
+	const int la = last_act;
+	capture(gi); // straight into its pay branch: bookkeeping, mark_respawn, drop_target(0)
+	last_act = la;
+}
+bool dcd_dash_live(const Body& e, int slot, int n)
+{
+	if (slot < 0 || slot > 1 || foe_cd(e, slot) <= n)
+		return true;
+	dcd_fire();
+	return false;
+}
+} // namespace nova::feat::bn6
+
+#endif // NOVA_UNITY_ALL
diff --git b/src/feat_bun6.h b/src/feat_bun6.h
new file mode 100644
--- /dev/null
+++ b/src/feat_bun6.h
@@ -0,0 +1,28 @@
+#pragma once
+// feat_bun6 (BN6, b1627 bundle 6). Flag BN6_BITS, 0 = nova_b2703_gds1 (v618). Runtime data flag, read first.
+// Bit 1 GRG (Planner/Econ greed.py 8 Nov: 44% of our Greed starts never complete): grt_gate commits a Greed entry only when
+//   (750 - gold in hand) / my gold rate x 1.3 <= rounds left (grg_rounds_left: race pace both sides, r2000), else the Power/Bruiser
+//   entries stay. Hook: econ.cpp grt_gate.
+// Bit 2 PTB2 (Combat, 02gift_wrapping 01a1b9eb r137-174): a capture already paid at turn start is settled (capture()'s own pay
+//   branch) before the stage chain, so want_bank sees no stale T.capturing. Hook: brain.cpp before the stage chain.
+// Bit 4 DCD (Combat, 01boss_battle 01a1b9e2): rc_foe_reach adds a dash kit's +2 only when its dash is unseen or ready within n.
+//   Hook: econ.cpp rc_foe_reach.
+#include "common.h"
+#define BN6_BITS 0
+inline const volatile int BN6_TAB[2] = { 0x424E3631, BN6_BITS }; // slot 0 magic keeps it out of .bss
+#define BN6_ON(b) ((BN6_TAB[1] & (b)) != 0)
+constexpr int BN6_BIT_GRG = 1;
+constexpr int BN6_BIT_PTB2 = 2;
+constexpr int BN6_BIT_DCD = 4;
+struct Body;
+namespace nova::feat::bn6
+{
+// GRG: rounds left in the game (one place, so a predicted end round can replace it).
+float grg_rounds_left();
+// GRG: true when gold in hand g plus my gold rate (gold earned so far / round) finishes a 750-gold Greed within rounds left / 1.3.
+bool grg_fits(int g, int earned);
+// PTB2: settle a capture paid before this turn (T.capturing with the reward in). Caller read the flag.
+void ptb2_settle();
+// DCD: the foe's dash adds reach within n turns (slot unseen, or cooldown <= n). Caller read the flag.
+bool dcd_dash_live(const Body& e, int slot, int n);
+} // namespace nova::feat::bn6
