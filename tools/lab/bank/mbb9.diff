+// v785 MBB9 CDM1: an awake camp of strength >= min_str within its reach + 2 of me reaches neither me nor `spare`.
+bool cdm_heavy_near(float min_str, vec2 spare);
 struct AvoidCampReach
 {
 	explicit AvoidCampReach(bool on = true);
+	// v785 MBB9 CDM1: only awake camps of strength >= min_str whose reach does not hold `spare` (the focus: its own camp's target)
+	AvoidCampReach(float min_str, vec2 spare);
 	~AvoidCampReach();
 	AvoidCampReach(const AvoidCampReach&) = delete;
 	AvoidCampReach& operator=(const AvoidCampReach&) = delete;
 	bool active = false; // true: this guard set the zone (I am outside every awake camp's reach, and one is near)
