+bool cdm_heavy_near(float min_str, vec2 spare)
+{
+	for (const auto& e : camp_threat_entries())
+		if (e.str >= min_str && e.reach >= 0 && cheb(e.pos, W.me.pos) > e.reach && cheb(e.pos, W.me.pos) <= e.reach + 2 && cheb(e.pos, spare) > e.reach)
+			return true;
+	return false;
+}
+// v785 MBB9 CDM1 (X491, GR:192): the fight walk-in's guard: the reach of each awake camp of strength >= min_str that does not
+// cover the focus. I stand outside them all, else it is off (escape's job); the rest as the plain guard.
+AvoidCampReach::AvoidCampReach(float min_str, vec2 spare)
+{
+	if ((avoid_on && !avoid_foe) || !W.alive)
+		return;
+	bitboard z;
+	bool any = false;
+	for (const auto& e : camp_threat_entries())
+		if (e.str >= min_str && e.reach >= 0 && cheb(e.pos, spare) > e.reach)
+		{
+			z.draw_chebyshev(e.pos, static_cast<float>(e.reach));
+			any = true;
+		}
+	if (!any || bbget(z, W.me.pos))
+		return;
+	if (avoid_on && avoid_foe)
+	{
+		prev = std::make_unique<bitboard>(avoid_bb);
+		avoid_bb |= z;
+		merged = true;
+		return;
+	}
+	avoid_bb = z;
+	avoid_on = true;
+	active = true;
+}
 AvoidCampReach::~AvoidCampReach()
 {
 	if (merged && prev)
