 // This fight would be started by me: no foe reaches me, I am not caught, I was not hit, and no ally of mine is in contact.
 static __attribute__((always_inline)) inline bool assess_nothing_started(const Assessment& a)
 {
 	return !a.in_reach && !a.caught && !took_damage(tune::RECENT_HIT_ROUNDS) && !memory::ally_in_contact(a);
 }
+// EDG (b2427): the headcount edge, our living bodies - the enemy's, once a round (visible allies are alive).
+__attribute__((noinline)) int edg_edge()
+{
+	static int r = -1, e = 0;
+	if (r == W.round)
+		return e;
+	r = W.round;
+	int ours = 0;
+	for (int s = 0; s < P.n && s < 8; ++s)
+	{
+		if (s == P.my_slot || W.ally_by_slot(s))
+		{
+			++ours;
+			continue;
+		}
+		std::int32_t alive = 1;
+		if (cambc::detail::sdk_champion_is_alive(P.handle[static_cast<std::size_t>(s)], &alive) != 0 || alive != 0)
+			++ours;
+	}
+	e = ours - intel::enemies_alive();
+	return e;
+}
+// EDG guards: not near their spawn, no big bag, not the roster carry who would not survive the seen foes' two turns.
+__attribute__((noinline)) bool edg_guards_ok(const AssessCtx& c)
+{
+	if (cheb(W.me.pos, M.enemy_anchor) <= EDG_TAB[4] || bbget(M.enemy_spawn, W.me.pos))
+		return false;
+	if (c.bag >= EDG_TAB[5])
+		return false;
+	if (crk_is_carry() && W.me.hp + std::max(0.0f, W.me.shield) < econ::rhf_two_turn_damage(c.a))
+		return false;
+	return true;
+}
+__attribute__((noinline)) void edg_fc_1() { __asm__ volatile(""); }
+__attribute__((noinline)) void edg_fc_2() { __asm__ volatile(""); }
+// EDG bit 1: the mate-dead flee is kept only when we are short (EDGE < 0) or a guard fails.
+__attribute__((noinline)) bool edg_mate_dead_keep(const AssessCtx& c)
+{
+	if (edg_edge() < 0 || !edg_guards_ok(c))
+		return false;
+	edg_fc_1();
+	return true;
+}
+// EDG bit 2: the solo-strike bar while EDGE >= 2 and no dead foe can be back on my tile within EDG_BACK rounds.
+__attribute__((noinline)) float edg_solo_bar(const AssessCtx& c)
+{
+	if (edg_edge() < 2)
+		return SQ_STRIKE_SOLO;
+	const int back = intel::earliest_respawn() + cheb(M.enemy_anchor, W.me.pos);
+	if (back <= W.round + EDG_TAB[3] || !edg_guards_ok(c))
+		return SQ_STRIKE_SOLO;
+	return static_cast<float>(EDG_TAB[2]) / 100.0f;
+}
 // Clearly stronger: engage what we see; never chase a foe we cannot see. The initiation balance (refit foe kits, unseen
 // reinforcements in the middle/enemy third); with an ally in contact, from 8 tiles.
 static __attribute__((always_inline)) inline void assess_stance_stronger(const AssessCtx& c)
 {
 	Assessment& a = c.a;
 	a.stance = (a.nearest <= tune::ENGAGE_SIGHT_R) ? FIGHT : CALM;
 	// This rule STARTS fights. Unless nothing would be started it needs a committed squad mate in the fight: a visible mate by
 	// objective within its attack range + 1 of the focus, or a healthy ally within 3 of me. Otherwise CALM, never FLEE:
 	// initiation only (no giving way to equal foes).
 	if (a.stance == FIGHT && a.focus >= 0 && assess_nothing_started(a) && (a.ratio_fc) < SQ_STRIKE_SOLO)
 	{
-		if (!memory::squad_mate_covers_focus(assess_enemy(a.focus).pos))
+		if (!memory::squad_mate_covers_focus(assess_enemy(a.focus).pos) && !(EDG_ON(2) && a.ratio_fc >= edg_solo_bar(c) && (edg_fc_2(), true))) // b2427 EDG bit 2
 			a.stance = CALM;
 	}
 	// a Ryth body starts a fight only at a near balance of RYTH_START_NEAR (kill_now took the branch above); else CALM.
 	if (a.stance == FIGHT && ryth_layer::fight_calm_start() && assess_nothing_started(a) && a.ratio_near < ryth_layer::RYTH_START_NEAR)
 		a.stance = CALM;
 }
