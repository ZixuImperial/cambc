diff --git b/src/combat_hcb.cc b/src/combat_hcb.cc
new file mode 100644
--- /dev/null
+++ b/src/combat_hcb.cc
@@ -0,0 +1,265 @@
+// combat_hcb.cc: b2390 HCB (combat_flags.h; Aggression spec_hcb_1113): a foe that heals on its spawn and comes back.
+// GameRules.md:124/153/389: a champion on its own spawn heals to full at its turn end, opponents cannot enter; a recall takes 5 owner turn ends
+// and damage or stun breaks it (:275, :387). Every entry point is called only behind HCB_TAB (the caller reads the flag).
+#include "combat_internal.h"
+namespace nova::combat {
+namespace {
+struct HcbFoe
+{
+	std::uint32_t h = 0;
+	int heal_r = -1000; // last round seen on its spawn below full HP, or the round a seen recaller's tile was empty
+	int seen_r = -1000; // last sighting
+	bool home = false;  // on its spawn at that sighting
+	bool rec = false;   // channelling a recall at that sighting
+	vec2 pos{};         // last seen tile
+	Foe foe;            // that sighting's record (a stun read off)
+	float ehp_full = 0; // its effective HP at full health, no shield
+	int r1 = 1;         // one-turn reach to a tile: 1 walk + its kit's dash (assumed ready) + its longest damage range
+	Body body;          // that sighting's body (the recall-reach test)
+};
+std::array<HcbFoe, 8> hcb_foes{};
+std::array<std::uint32_t, 8> hcb_priced{}; // the handles the last hcb_gather priced
+int hcb_np = 0;
+int hcb_r1_of(const Body& e)
+{
+	int rg = std::max(1, e.range);
+	int dash = 0;
+	if (e.kit && e.kit->valid)
+	{
+		rg = std::max({ rg, static_cast<int>(e.kit->dmg_range + 0.5f), static_cast<int>(e.kit->cc_range + 0.5f) });
+		dash = e.kit->slot_dash >= 0 ? std::max(1, static_cast<int>(e.kit->dash_range + 0.5f)) : 0;
+	}
+	return 1 + dash + rg;
+}
+bool hcb_active(const HcbFoe& s)
+{
+	return s.h != 0 && W.round - s.heal_r <= HCB_TAB[2] && (s.home || s.seen_r <= s.heal_r);
+}
+// Their spawn tile nearest p ({-1, -1} when unknown).
+// RC C1017: econ's foe_turns_during_recall / foe_reach_in_turns (econ_threat_sense.cc, file-local there), same arithmetic.
+int hcb_recall_turns()
+{
+	const int ch = rs::recall_rounds(prism::has_family(rs::F_HOME), false);
+	const int R = W.round;
+	return std::max(1, ch - 1 + (enemy_starts(R) ? 0 : 1) + (enemy_starts(R + ch) ? 1 : 0));
+}
+int hcb_reach_in_turns(const Body& e, int n)
+{
+	const Kit* k = e.kit;
+	int r = std::max(e.range, 1) + n + 2;
+	if (k && k->valid)
+	{
+		r = k->ranged ? std::max(e.range, 1) + n - (k->slot_reset >= 0 ? 0 : 1) : std::max(e.range, 1) + n;
+		auto sp = [&](int slot, float range, float radius, bool excl)
+		{
+			if (slot >= 0)
+				r = std::max(r, static_cast<int>(range + radius) + n - (excl ? 1 : 0));
+		};
+		sp(k->slot_dmg, k->dmg_range, 0.0f, k->dmg_excl);
+		sp(k->slot_cc, k->cc_range, 0.0f, k->cc_excl);
+		sp(k->slot_aoe, k->aoe_range, k->aoe_radius, k->aoe_excl);
+		if (k->slot_dash >= 0)
+			r += 2;
+	}
+	return r;
+}
+vec2 hcb_edge(vec2 p)
+{
+	vec2 best{ -1, -1 };
+	int bd = BIG;
+	bbforeach(M.enemy_spawn, [&](vec2 q)
+	{
+		const int d = cheb(q, p);
+		if (d < bd)
+		{
+			bd = d;
+			best = q;
+		}
+	});
+	return best;
+}
+} // namespace
+void hcb_note()
+{
+	for (const auto& e : W.enemies)
+	{
+		const bool home = bbget(M.enemy_spawn, e.pos);
+		const bool hurt = e.maxhp > 0 && e.hp < e.maxhp;
+		HcbFoe* s = nullptr;
+		for (auto& x : hcb_foes)
+			if (x.h == e.h)
+				s = &x;
+		if (!s && hurt && (home || (e.state & ST_RECALL) != 0))
+		{
+			for (auto& x : hcb_foes)
+				if (!s || x.h == 0 || (s->h != 0 && x.seen_r < s->seen_r))
+					s = &x; // a free slot, else the oldest sighting
+			*s = HcbFoe{};
+			s->h = e.h;
+		}
+		if (!s)
+			continue;
+		s->seen_r = W.round;
+		s->home = home;
+		s->rec = (e.state & ST_RECALL) != 0;
+		s->pos = e.pos;
+		s->foe = e.stunned ? foe_of_unstunned(e, -1) : foe_of(e, -1);
+		Body c = e;
+		c.hp = c.maxhp;
+		c.shield = 0;
+		s->ehp_full = eff_hp(c);
+		s->r1 = hcb_r1_of(e);
+		s->body = e;
+		if (home && hurt)
+			s->heal_r = W.round;
+	}
+	// a recaller whose last tile I see empty has gone home (observe_forget_recalled's test)
+	for (auto& x : hcb_foes)
+		if (x.h != 0 && x.rec && x.seen_r < W.round && bbget(W.vis, x.pos) && !bbget(W.occ_units, x.pos))
+		{
+			x.rec = false;
+			x.home = true;
+			x.heal_r = W.round;
+		}
+}
+bool hcb_dup(std::uint32_t h)
+{
+	for (int i = 0; i < hcb_np; ++i)
+		if (hcb_priced[static_cast<std::size_t>(i)] == h)
+			return true;
+	return false;
+}
+void hcb_gather(Assessment& a, vec2 me)
+{
+	hcb_np = 0;
+	vec2 edge{ -2, -2 };
+	for (const auto& s : hcb_foes)
+	{
+		if (!hcb_active(s))
+			continue;
+		bool in = false;
+		for (std::size_t i = 0; i < W.enemies.size(); ++i)
+			if (W.enemies[i].h == s.h)
+				for (const auto& f : a.foes)
+					in = in || f.idx == static_cast<int>(i); // in sight and already in the assessment with its real record
+		if (in)
+			continue;
+		if (edge.x == -2)
+			edge = hcb_edge(me);
+		if (edge.x < 0)
+			return;
+		const int r2 = s.r1 + 1; // its two turns: a walk off the spawn, then its one-turn reach
+		if (cheb(edge, me) > r2)
+			continue;
+		if (HCB_ON(4) && W.me.frac() >= 0.8f)
+		{
+			int ours = 1;
+			for (const auto& al : W.allies)
+				ours += cheb(al.pos, me) <= 8 ? 1 : 0;
+			if (ours >= static_cast<int>(a.foes.size()) + 1)
+				continue; // bit 4 HOLD: a healthy body at level count is not moved by the pricing alone
+		}
+		Foe f = s.foe;
+		f.pos = edge;
+		f.ehp = s.ehp_full;
+		f.idx = -1;
+		f.remembered = true;
+		f.reach = r2;
+		a.foes.push_back(f);
+		if (hcb_np < static_cast<int>(hcb_priced.size()))
+			hcb_priced[static_cast<std::size_t>(hcb_np++)] = s.h;
+	}
+}
+int hcb_plan(const Assessment& a, vec2* dest)
+{
+	(void)a;
+	if (!W.alive || W.on_spawn || W.me.channeling() || W.moved || W.me.frac() >= 0.5f)
+		return 0;
+	const vec2 me = W.me.pos;
+	vec2 org[10];
+	int rch[10];
+	int n = 0;
+	vec2 edge{ -2, -2 };
+	for (const auto& s : hcb_foes)
+	{
+		if (!hcb_active(s))
+			continue;
+		if (edge.x == -2)
+			edge = hcb_edge(me);
+		if (edge.x >= 0 && cheb(edge, me) <= 8 && n < 10)
+		{
+			org[n] = edge;
+			rch[n++] = s.r1;
+		}
+	}
+	for (const auto& e : W.enemies)
+	{
+		const bool home = bbget(M.enemy_spawn, e.pos);
+		const int d = cheb(e.pos, me);
+		if (!home && d <= foe_next_turn_reach(e))
+			return 0; // a live threat off its spawn is flee's and fight's
+		if (!home && d <= 8 && e.maxhp > 0 && e.hp < e.maxhp && n < 10)
+		{
+			const vec2 q = hcb_edge(e.pos);
+			if (q.x >= 0 && cheb(q, e.pos) <= 2) // about to heal: within 2 of its spawn
+			{
+				org[n] = e.pos;
+				rch[n++] = hcb_r1_of(e);
+			}
+		}
+	}
+	if (n == 0 || econ::capture_pay_in() >= 0)
+		return 0;
+	bool rok = false;
+	if (econ::recall_safe())
+	{
+		rok = true; // RC C1017: damage cancels a recall (GR:275): every healed foe's spawn edge beyond its reach over the channel
+		const int nt = hcb_recall_turns();
+		for (const auto& s : hcb_foes)
+			if (rok && hcb_active(s) && edge.x >= 0 && cheb(edge, me) <= hcb_reach_in_turns(s.body, nt))
+				rok = false;
+	}
+	if (rok)
+		return 1;
+	bool inside = false;
+	for (int i = 0; i < n; ++i)
+		inside = inside || cheb(org[i], me) <= rch[i];
+	if (!inside || !W.can_move())
+		return 0; // outside their one-turn reach: wait for recall_safe
+	const distance_field* hf = mv::home_field();
+	vec2 best{ -1, -1 };
+	int bd = BIG;
+	for (const vec2 dd : DIRS)
+	{
+		const vec2 q = me + dd;
+		if (!inb(q) || M.camp_index(q) >= 0 || !mv::free_tile(q))
+			continue;
+		bool out = true;
+		for (int i = 0; i < n && out; ++i)
+			out = cheb(org[i], q) > rch[i];
+		if (!out)
+			continue;
+		const int d = hf ? static_cast<int>(dfget(*hf, q)) : 0;
+		if (d < bd)
+		{
+			bd = d;
+			best = q;
+		}
+	}
+	if (best.x < 0)
+		return 0;
+	if (dest)
+		*dest = best;
+	return 2;
+}
+bool hcb_turn(const Assessment& a)
+{
+	vec2 q{ -1, -1 };
+	const int p = hcb_plan(a, &q);
+	if (p == 1)
+		return econ::start_recall();
+	if (p == 2)
+		return mv::try_move(q);
+	return false;
+}
+} // namespace nova::combat
