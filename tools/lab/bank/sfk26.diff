+	if (cambc::detail::sdk_champion(m.h, &ci) != 0 || (static_cast<std::uint32_t>(ci.state) & (ST_RECALL | ST_TRIBUTE | ST_TELEPORT)) != 0)
+		return false; // never to a mate with any channel, a fresh recall start included (the owner: never stop her recall)
+	const float vh = eff_hp(v);
+	for (const auto& e : W.enemies)
+		if (e.h != v.h && eff_hp(e) < vh && mate_kills(m, e))
+			return false; // RC C733 F2: her own pick takes the lowest eff_hp kill, so she would take that one and the victim walks
+	return mate_sees(m, v);
+}
+static void mask(std::uint32_t h)
+{
+	if (m_round != W.round || m_who != W.me.h)
+	{
+		m_round = W.round;
+		m_who = W.me.h;
+		m_n = 0;
+	}
+	for (int i = 0; i < m_n; ++i)
+		if (m_h[static_cast<std::size_t>(i)] == h)
+			return;
+	if (m_n < 4)
+		m_h[static_cast<std::size_t>(m_n++)] = h;
+}
+static bool active() { return m_n > 0 && m_round == W.round && m_who == W.me.h; }
+} // namespace
+bool masked(std::uint32_t h)
+{
+	if (!active())
+		return false;
+	for (int i = 0; i < m_n; ++i)
+		if (m_h[static_cast<std::size_t>(i)] == h)
+			return true;
+	return false;
+}
+// My kill_now on v: leave it to a stacker mate (then v is masked for this turn). Every guard of the spec's bit 1 point 4.
+bool yield(const Body& v)
+{
+	if (!W.me.kit || stacker(W.me) || W.allies.empty() || !v.kit)
+		return false;
+	if ((!SFK_ON(8) && (v.state & FLEE_FIX_ST_ACTED) == 0) || v.channeling() || v.kit->retaliation || bbget(M.enemy_spawn, v.pos))
+		return false; // RC SFK4 (the victim has acted; bit 8: order_ok per mate), recall / tribute, Ren (not priced: never), RC SFK8 spawn
