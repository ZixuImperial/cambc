+		return false; // a ready dash / heal; a winning bag is denied first
+	if (burst::lethal_burst_hit(v, cheb(v.pos, W.me.pos), 0, nullptr) >= eff_hp(W.me))
+		return false;
+	for (const auto& al : W.allies)
+		if (cheb(al.pos, v.pos) <= 9 && burst::lethal_burst_hit(v, cheb(al.pos, v.pos), 0, nullptr) >= eff_hp(al))
+			return false; // its next hit kills a mate
+	if (!healers_clear(v))
+		return false; // RC SFK7: an unacted foe's ready heal or shield reaches the victim first
+	if (visible_foes_lethal_next_turn())
+		return false; // the kill makes me safe
+	const float mine = kill_value(W.me, v);
+	const bool guard = !SFK_ON(2);
+	for (const auto& m : W.allies)
+		if (mate_takes(m, v, guard, mine))
+		{
+			mask(v.h);
+			return true;
+		}
+	return false;
