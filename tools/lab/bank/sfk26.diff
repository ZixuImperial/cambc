+// Prism, Marcella, Vesper Vale (Vendetta is no receiver: GR:626, her kill is tempo, not a stack).
+static bool stacker(const Body& b) { return b.kit && (b.kit->bonus_gold || b.kit->gem_focus || marcella_layer::type(b.type)); }
+// RC SFK1: kill gold with the taker's own Hunter / Treasure / Vesper terms (rules.h kill_gold), + Marcella 2 gold per victim gem she
+// tributes (GR:658), + Prism 1.5 Focus per carried gem (GR:564). An empty victim bag adds nothing.
+static float kill_value(const Body& b, const Body& v)
+{
+	float x = static_cast<float>(rs::kill_gold(rs::families(b.h, W.round), vesper_layer::gold_pct(b.kit)));
+	if (marcella_layer::type(b.type))
+		x += 2.0f * static_cast<float>(v.gems);
+	else if (b.kit && b.kit->gem_focus)
+		x += 1.5f * static_cast<float>(v.gems);
+	return x;
+}
+// b2300 SFK bit 32 (Amendment 1, REACH; RC C762 F10-F12): the receiver's own beyond-range kill test (kills_ranged_knr,
+// combat_burst.cc) run for her: Vesper (vesper_layer: fight_dash is hers only; Marcella and Prism have no dash, GR:650+) kills with ONE
+// basic hit (the dash or the reset is the turn's one cast, GR:262) after (i) the walk + reset one tile out, or (ii) her dash to a landing
+// with v in range and at most VV_LANDING_CROWD other enemies able to reach it (ktb_vesper_landing_ok, from HER tile). Cooldowns read 0
+// only (unknown -1 = not ready, RC SFK3).
+static bool dash_kills(const Body& m, const Body& v, float pm)
+{
+	const Kit& k = *m.kit;
+	if (m.type != cambc::champion_type::vesper_vale || !k.ranged || m.str <= 0.0f || eff_hp(v) > m.str * pm)
+		return false;
+	auto rdy = [&](int sl) { return sl >= 0 && sl <= 1 && m.cd[static_cast<std::size_t>(sl)] == 0; };
+	const int d = cheb(m.pos, v.pos);
+	if (d == m.range + 1 && rdy(k.slot_reset))
+	{
+		for (const vec2 dd : DIRS)
+		{
+			const vec2 u = m.pos + dd;
+			if (inb(u) && mv::free_tile(u) && cheb(u, v.pos) <= m.range)
+				return true; // her walk-in step exists
+		}
+	}
+	if (!rdy(k.slot_dash) || d > m.range + static_cast<int>(k.dash_range))
+		return false;
+	const int r = std::max(1, static_cast<int>(k.dash_range));
+	int sc = 1 << 30;
+	const vec2 L = geom::dash_landing_search<true>(m.pos, v, -r, r, -r, r, m.range, false, sc);
+	return L.x >= 0 && sc <= vesper_layer::VV_LANDING_CROWD;
+}
+// RC SFK2/3: the mate's own burst from her readable stats: a basic hit from her tile (no walk) plus one damaging spell whose cooldown
+// reads 0 (an unknown -1 is NOT ready).
+static bool mate_kills(const Body& m, const Body& v)
+{
+	const Kit& k = *m.kit;
+	const int d = cheb(m.pos, v.pos);
+	const float pm = kit_rules::passive_mult(m) * mu::pair(m, v);
+	auto rdy = [&](int s) { return s >= 0 && s <= 1 && m.cd[static_cast<std::size_t>(s)] == 0; };
+	float sp = 0.0f;
+	if (k.dmg_mod > 0 && rdy(k.slot_dmg) && d <= static_cast<int>(k.dmg_range))
+		sp = std::max(sp, k.dmg_mod);
+	if (k.cc_mod > 0 && rdy(k.slot_cc) && d <= static_cast<int>(k.cc_range) && !v.stunned) // RC C733 F3: her stun goes only on an unstunned foe
+		sp = std::max(sp, k.cc_mod);
+	if (k.aoe_mod > 0 && rdy(k.slot_aoe) && d <= static_cast<int>(k.aoe_range))
+		sp = std::max(sp, k.aoe_mod);
+	const float dmg = (d <= m.range ? m.str * pm : 0.0f) + sp * m.foc * pm;
+	if (dmg > 0.0f && eff_hp(v) <= dmg)
+		return true;
+	return SFK_ON(32) && d > m.range && dash_kills(m, v, pm); // b2300 SFK bit 32: her dash + hit (a receiver 3-5 tiles away)
+}
+// RC SFK5: her own sight (her ward included) holds the victim.
+static bool mate_sees(const Body& m, const Body& v)
+{
+	bitboard vb;
+	if (cambc::detail::sdk_bc_champion_vision(m.h, vb.ptr()) != 0)
+		return false;
+	return bbget(vb, v.pos);
+}
+// b2300 SFK bit 8 (Amendments 1-3, ORDER BY PARITY; RC C762): does the receiver m take her next turn before the victim v? Exact
+// cases only: (c) she has not acted and v has: yes (bit 1's case, no priority read); (b) NEITHER has acted: this round's values in force
+// (prev_priority(), set in R-1, fixed for R: GR:130, INT:19) with this round's starter (GR:128): the teams interleave one body at a time,
+// starter first, so she precedes v iff (we start) her rank <= v's rank, (they start) her rank < v's rank; surplus bodies act after the
+// interleave (INT:15). Within a team: higher value first, a tie to the lower id (INT:16; ours by slot = draft order, foes by handle, never
+// by W.enemies order). Values are compared as written (no PRA_DEC: with a JVD tail on, the full value orders, Shared Mem rule b). Safe side: her rank counts every mate (me included) above her value, plus every mate whose value I cannot read
+// (rc 97: out of my sight or dead, RC F2); v's rank counts only the foes I see. Both-acted (case a) is not built (Amendment 3: after RC's
+// foe-priority probe); 'v not acted, she acted': no (v acts first in R).
+static bool sfk_prio(std::uint32_t h, int& v)
+{
+	std::int32_t x = 0;
+	if (cambc::detail::sdk_bc_champion_priority(h, 0, &x) != 0)
+		return false;
+	v = static_cast<int>(x);
+	return true;
+}
+static bool order_ok(const Body& m, const Body& v)
+{
+	const bool ma = (m.state & FLEE_FIX_ST_ACTED) != 0, va = (v.state & FLEE_FIX_ST_ACTED) != 0;
+	if (!ma && va)
+		return true; // (c)
+	if (!SFK_ON(8) || ma || va || m.slot < 0)
+		return false;
+	int pm = 0, pv = 0; // (b)
+	if (!sfk_prio(m.h, pm) || !sfk_prio(v.h, pv))
+		return false;
+	int ra = 0;
+	for (int i = 0; i < P.n && i < 8; ++i)
+	{
+		const std::uint32_t h = P.handle[static_cast<std::size_t>(i)];
+		if (h == m.h)
+			continue;
+		int x = 0;
+		if (!sfk_prio(h, x))
+		{
+			++ra; // unseen or dead mate: above her (RC F2)
+			continue;
+		}
+		ra += (x > pm || (x == pm && i < m.slot)) ? 1 : 0; // RC F3: ties to the lower id
+	}
+	int rb = 0;
+	for (const auto& e : W.enemies)
+	{
+		int x = 0;
+		if (e.h != v.h && sfk_prio(e.h, x))
+			rb += (x > pv || (x == pv && e.h < v.h)) ? 1 : 0;
+	}
+	return !enemy_starts(W.round) ? ra <= rb : ra < rb;
+}
+// RC SFK7: no foe that may act before the receiver (the unacted ones) holds a ready heal or shield that reaches v.
+static bool healers_clear(const Body& v)
+{
+	for (const auto& e : W.enemies)
+	{
+		if (e.h == v.h || (e.state & FLEE_FIX_ST_ACTED) != 0 || !e.kit)
+			continue;
+		const int de = cheb(e.pos, v.pos);
+		if ((foe_ready(e, e.kit->slot_heal) && de <= static_cast<int>(e.kit->heal_range) + 1) || (foe_ready(e, e.kit->slot_shield) && de <= 4))
+			return false;
+	}
+	return true;
+}
+// One mate: may she take it? guard_other: bit 1's 'she sees no other enemy within 8' (from my sight).
+static bool mate_takes(const Body& m, const Body& v, bool guard_other, float my_val)
+{
+	if (!stacker(m) || (m.state & ST_ALIVE) == 0 || m.channeling() || m.stunned || (!SFK_ON(8) && (m.state & FLEE_FIX_ST_ACTED) != 0))
+		return false; // RC SFK4: she has not acted this round (so she acts later this round, before the victim's next turn); bit 8: order_ok
+	if (cheb(m.pos, W.me.pos) > 8 || m.frac() < 0.5f || retreating_mates::retreating(m))
+		return false; // her stun, bag and cooldowns are read only within 8 (world.cc read_allies); RC SFK6: low or posting FLEE
+	if (comms::ckind(m.slot) == 4 && comms::cval(m.slot) % 4 >= 2)
+		return false; // her posted HP band is below half
+	if (kill_value(m, v) <= my_val || !mate_kills(m, v))
+		return false;
+	if (!order_ok(m, v))
+		return false; // b2300 SFK bit 8 (bit 1 alone: the (c) case only, as before)
+	if (burst::lethal_burst_hit(v, cheb(v.pos, m.pos), 0, nullptr) >= eff_hp(m))
+		return false;
+	// The owner's condition (RC SFK9): her kill_now turns her flee rules off, so yield only when she would not flee without it: no
+	// lethal sum and no outnumbering from the other foes at her tile, and no unacted foe's ready stun on her (RC SFK7).
+	float other = 0.0f;
+	int foes6 = 0, ours6 = 1 + (cheb(W.me.pos, m.pos) <= 6 ? 1 : 0);
+	for (const auto& e : W.enemies)
+	{
+		if (e.h == v.h)
+			continue;
+		const int de = cheb(e.pos, m.pos);
+		if (guard_other && de <= 8)
+			return false;
+		if ((e.state & FLEE_FIX_ST_ACTED) == 0 && e.kit && !m.kit->stun_immune)
+		{
+			const Kit& ek = *e.kit;
+			if ((foe_ready(e, ek.slot_cc) && de <= static_cast<int>(ek.cc_range) + 1) ||
+				(ek.dash_stun && foe_ready(e, ek.slot_dash) && de <= static_cast<int>(ek.dash_range + ek.dash_radius) + 1) ||
+				(ek.aoe_stun && foe_ready(e, ek.slot_aoe) && de <= static_cast<int>(ek.aoe_range + ek.aoe_radius) + 1))
+				return false;
+		}
+		if (de <= 6)
+			++foes6;
+		if (de <= 9)
+			other += std::max(0.0f, burst::lethal_burst_hit(e, de, 0, nullptr));
+	}
+	for (const auto& al : W.allies)
+		if (al.h != m.h && cheb(al.pos, m.pos) <= 6)
