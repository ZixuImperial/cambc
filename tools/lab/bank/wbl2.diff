+	if (WBL_TAB[1] != 0)
+		return wbl_damage_doomed(ticks, eff) || static_cast<bool>(foe_banks_winning_bag_first(ticks)); // v8xx WBL (champ_prism.h)
 	PFB_CNT(16, combat::foe_damage_over_ticks(WKH_TAB[3], std::max(1, ticks)) * 100.0f >= static_cast<float>(WKH_TAB[4]) * eff && mu::mult_foe_hit_to_real_hp_alt(combat::foe_damage_over_ticks(WKH_TAB[3], std::max(1, ticks))) * 100.0f < static_cast<float>(WKH_TAB[4]) * eff);
 	if ((mu::mult_foe_hit_to_real_hp_alt(combat::foe_damage_over_ticks(WKH_TAB[3], std::max(1, ticks)))) * 100.0f >= static_cast<float>(WKH_TAB[4]) * eff) // v7xx PFB bit 16 PF9: Durability (INT:71)
