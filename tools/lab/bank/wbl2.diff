+// v8xx WBL bit 2 (champ_prism.h; the caller read the flag): tribute_stop_possible's stun and lock legs only (GR:226/:275), no damage sum:
+// a visible foe holding a lock it can bring within the ticks, or a stun that lands within them; a remembered unseen foe within a lock
+// reach (+ a dash) of the ticks, or of a stun kit (or an unknown kit).
+bool wbl_stun_or_lock_possible(int left)
+{
+	const vec2 me = W.me.pos;
+	const int span = std::max(1, left);
+	const bool immune = W.me.kit && W.me.kit->stun_immune;
+	const auto body = [&](const Body& e, int idx) -> bool {
+		const int dist = cheb(e.pos, me);
+		const int ch = foe_channel_act_delay(e);
+		const int fs = stance::foe_turns_within_rounds(e, span + 1);
+		if (recall::rgf_foe_lock_within(e, dist, fs))
+			return true;
+		return !immune && e.kit && e.kit->valid && recall::foe_stun_landing_round(e, foe_of(e, idx), dist, ch) <= fs;
+	};
+	for (std::size_t i = 0; i < W.enemies.size(); ++i)
+		if (body(W.enemies[i], static_cast<int>(i)))
+			return true;
+	for (const auto& e : W.enemies_far)
+		if (body(e, -1))
+			return true;
+	for (const auto& s : seen)
+	{
+		const int age = W.round - s.round;
+		if (age <= 0 || age > recall::tune::BUS_SIGHTING_ROUNDS)
+			continue;
+		bool known = false;
+		for (const auto& e : W.enemies)
+			known = known || e.h == s.h;
+		for (const auto& e : W.enemies_far)
+			known = known || e.h == s.h;
+		if (known)
+			continue;
+		const int dist = std::max(0, cheb(s.foe.pos, me) - age);
+		if (std::max(0, dist - 3 - 2) <= span)
+			return true;
+		const int expo = span - (1 + std::max(0, dist - s.foe.reach)) + 1;
+		if (expo <= 0 || immune)
+			continue;
+		const auto& tt = intel::team_table();
+		for (const auto& ts : tt)
+			if (ts.h == s.h)
+			{
+				const Kit* k = &kit_of(ts.type);
+				if (!k || !k->valid || k->slot_cc >= 0 || k->reset_enhanced || k->aoe_stun || k->dash_stun)
+					return true;
+			}
+	}
+	return false;
+}
