 // WKH bit 1: (a) the known foes can kill her before it lands (foe_damage_over_ticks(ticks) = burst + dps x ticks: ticks + 1 foe turns, the extra
 // one for the swapped first mover), or (bit 2) foe_banks_winning_bag_first.
+// WBL (champ_prism.h; the caller read the flag): the damage line of winning_channel_doomed under the WBL bits. Bit 4 first (not doomed over
+// the absolute line), then bit 2 (stun/lock in the ticks, or two-turn lethal), then bit 1 (two-turn lethal); no bit deciding: live's test.
+static bool wbl_damage_doomed(int ticks, float eff)
+{
+	const float two = combat::foe_damage_over_ticks_deliver(WKH_TAB[3], WCK_TURNS); // econ_bank_win.cc foe_burst_lethal_to_healer
+	if (WBL_ON(4) && eff >= static_cast<float>(WBL_TAB[2]) * two)
+		return false;
+	const bool lethal2 = two * 100.0f >= static_cast<float>(WKH_TAB[4]) * eff;
+	if (WBL_ON(2))
+		return lethal2 || combat::wbl_stun_or_lock_possible(std::max(1, std::min(ticks, WCK_TURNS + 1))); // RC C1221: rolling horizon, the keep re-tests each turn
+	if (WBL_ON(1))
+		return lethal2;
+	return mu::mult_foe_hit_to_real_hp_alt(combat::foe_damage_over_ticks(WKH_TAB[3], std::max(1, ticks))) * 100.0f >= static_cast<float>(WKH_TAB[4]) * eff;
+}
 static bool winning_channel_doomed(int ticks)
