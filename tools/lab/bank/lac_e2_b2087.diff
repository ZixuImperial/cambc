+bool lac_tiles_done = false;
+void lac_tiles_build()
+{
+	lac_tiles_done = true;
+	for (const auto& a : M.altars)
+		for (const vec2 d : DIRS)
+		{
+			const vec2 q{ a.pos.x + d.x, a.pos.y + d.y };
+			if (q.x < 0 || q.y < 0 || q.x >= M.w || q.y >= M.h || bbget(M.block, q))
+				continue;
+			bool dup = false;
+			for (auto& t : lac_tiles)
+				if (t.p == q)
+				{
+					t.de = std::min(t.de, static_cast<int>(a.d_enemy));
+					dup = true;
+				}
+			if (!dup)
+				lac_tiles.push_back(LacTile{ q, static_cast<int>(a.d_enemy), 0 });
+		}
+	for (auto& t : lac_tiles)
+		for (const auto& u : lac_tiles)
+			t.cover += (cheb(t.p, u.p) <= 4) ? 1 : 0;
+}
+int lac_altar_d(vec2 p) // Chebyshev to the nearest altar tile
+{
+	int b = BIG;
+	for (const auto& a : M.altars)
+		b = std::min(b, cheb(a.pos, p));
+	return b;
+}
+// RC C504 LCX1 (DSX semantics, b2084): one stand episode per body (one altar group). It starts on a stand turn and resumes on a
+// re-entry within LAC_BAN rounds of the last stand. Exit (a) LOSING: LAC_LOSS % of max HP lost since it began while dealing under half
+// that; (b) STALE: LAC_STALE rounds with no seen foe within 10 of the altars and no rise of W.tributed_them. An exit bans the stand for
+// LAC_BAN rounds (farm as live) and ends my camper latch; a losing ban lifts while our bodies within 6 of the altars outnumber theirs, a
+// stale ban when a foe is seen within 10 of them or they land gems.
+int lac_r0 = 0, lac_last = -1000, lac_foe_r = 0, lac_tt0 = 0, lac_ban_until = -1000, lac_ban_kind = 0;
+float lac_hp0 = 0, lac_dealt = 0;
+bool lac_camper = false;
+bool lac_foe_near_altars()
+{
+	for (const auto& e : W.enemies)
+		if (lac_altar_d(e.pos) <= 10)
+			return true;
+	return false;
+}
+bool lac_banned()
+{
+	if (now() >= lac_ban_until)
+		return false;
+	if (lac_ban_kind == 2)
+		return !(lac_foe_near_altars() || W.tributed_them > lac_tt0);
+	int nu = lac_altar_d(W.me.pos) <= 6 ? 1 : 0, nt = 0;
+	for (const auto& a : W.allies)
+		nu += lac_altar_d(a.pos) <= 6 ? 1 : 0;
+	for (const auto& e : W.enemies)
+		nt += lac_altar_d(e.pos) <= 6 ? 1 : 0;
+	return !(nu > nt);
+}
+// Notes this stand round; true when an exit fires (the ban is set).
+bool lac_episode_exit()
+{
+	if (lac_r0 <= 0 || now() - lac_last > LAC_TAB[7])
+	{
+		lac_r0 = now();
+		lac_hp0 = W.me.hp + W.me.shield;
+		lac_dealt = 0;
+		lac_foe_r = now();
+		lac_tt0 = W.tributed_them;
+	}
+	lac_last = now();
+	if (lac_foe_near_altars() || W.tributed_them > lac_tt0)
+	{
+		lac_foe_r = now();
+		lac_tt0 = W.tributed_them;
+	}
+	const float loss = lac_hp0 - (W.me.hp + W.me.shield);
+	int kind = 0;
+	if (loss * 100.0f >= static_cast<float>(LAC_TAB[8]) * W.me.maxhp && lac_dealt < 0.5f * loss)
+		kind = 1;
+	else if (now() - lac_foe_r >= LAC_TAB[6])
+		kind = 2;
+	if (kind == 0)
+		return false;
+	lac_ban_until = now() + LAC_TAB[7];
+	lac_ban_kind = kind;
+	lac_camper = false;
+	lac_r0 = 0; // the next stand after the ban opens a new episode
+	return true;
+}
+} // namespace
+// LCX1: my damage while an episode is open: a basic hit counts my Strength (as DSX's dsx_hit); a cast of my damage or aoe damage slot
+// counts its modelled damage (mod x Focus, RC C504c); heals, shields and dashes count nothing and never touch the stale clock (C509
+// DXA2). Turn end; the caller read LAC_TAB[1].
+void lac_turn_end()
+{
+	if (lac_r0 > 0 && now() - lac_last <= 1 && W.alive)
+		lac_dealt += (W.attacked ? W.me.str : 0.0f) + lac_cast_dmg;
+	lac_cast_dmg = 0;
+}
+// Bits 1/4: a calm body (calm_walk_ok, read by the caller) with no bag that errand_stage banked and no target camp within LAC_D of an
+// altar walks to, and holds, an altar-adjacent stand tile: the tile of the altar nearest the foe's approach (Prism under bit 4: the tile
+// whose range 4 covers the most other stand tiles), not one a mate stands on or is nearer to, and not in an awake camp's reach. Fights,
+// flees and escapes run before this stage as today. Bit 4: Prism with a bag banks first when no seen foe is within 6, else today's rules.
+bool lac_stand_turn()
+{
+	if (!lac_g() || !W.alive || W.me.channeling() || !M.ready() || M.altars.empty())
+		return false;
+	const bool prism = LAC_ON(4) && W.me.kit && W.me.kit->gem_focus;
+	if (prism && W.me.gems > 0)
+	{
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, W.me.pos) <= 6)
+				return false;
+		return bank();
+	}
+	const int tg = claim_target();
+	if (tg >= 0 && tg < M.ng && static_cast<int>(M.groups[static_cast<std::size_t>(tg)].d_altar) <= LAC_TAB[4])
+		return false; // a camp within LAC_D of an altar stays legal
+	if (lac_banned())
+		return false; // LCX1: an exit's ban (farm as live)
+	if (lac_camper && now() - lac_last > LAC_TAB[7])
+		lac_camper = false; // the episode lapsed
+	if (LAC_TAB[5] > 0 && !lac_camper) // LAC_N (RC C504 LCF1): campers = mates within 2 of an altar (channelling ones too); the free bodies
+	{                                   // nearest the altars fill the remaining places; my role is latched until an exit
+		const int dme = lac_altar_d(W.me.pos);
+		int standing = 0, nearer = 0;
+		for (const auto& al : W.allies)
+		{
+			const int da = lac_altar_d(al.pos);
+			if (da <= 2)
+				++standing;
+			else if (!al.channeling() && (da < dme || (da == dme && al.h < W.me.h)))
+				++nearer;
+		}
+		if (standing + nearer >= LAC_TAB[5])
+			return false;
+	}
+	if (lac_episode_exit())
+		return false;
+	lac_camper = true;
+	if (!lac_tiles_done)
+		lac_tiles_build();
+	int best = -1;
+	long bs = 0;
+	bool bad[64] = {};
+	for (int tries = 0; tries < 3; ++tries)
+	{
+		best = -1;
+		for (std::size_t i = 0; i < lac_tiles.size() && i < 64; ++i)
+		{
+			if (bad[i])
+				continue;
+			const LacTile& t = lac_tiles[i];
+			const int dm = cheb(t.p, W.me.pos);
+			bool taken = false;
+			for (const auto& al : W.allies)
+			{
+				const int da = cheb(t.p, al.pos);
+				if (da == 0 || da < dm || (da == dm && al.h < W.me.h))
+				{
+					taken = true;
+					break;
+				}
+			}
+			if (taken)
+				continue;
+			const long sc = prism ? (64L * t.cover - t.de) : (-64L * t.de + t.cover);
+			if (best < 0 || sc > bs)
+			{
+				bs = sc;
+				best = static_cast<int>(i);
+			}
+		}
+		if (best < 0)
+			return false;
+		if (mv::camp_threat(lac_tiles[static_cast<std::size_t>(best)].p) <= 0.0f)
+			break;
+		bad[best] = true;
+		best = -1;
+	}
+	if (best < 0)
+		return false;
+	const vec2 tp = lac_tiles[static_cast<std::size_t>(best)].p;
+	if (!(W.me.pos == tp) && !mv::step_to(tp, 0, 40))
+		return false;
+	last_act = ACT_WALK;
+	return true;
+}
+// Bit 1: no heal recall while I stand within 4 of the altars, a seen foe is within 10 of them, and no mate is within 4 of them
+// (combat's flee, escape and low-HP recalls run before as today).
+bool lac_heal_hold()
+{
+	if (!lac_g() || W.enemies.empty())
+		return false;
+	if (lac_altar_d(W.me.pos) > 4)
+		return false;
+	// RC C504 LCH1: only a body in an open stand episode (stood last round, not banned), at >= 40% HP, with no lethal visible burst
+	if (lac_r0 <= 0 || now() - lac_last > 1 || lac_banned() || W.me.frac() < 0.40f || combat::visible_foes_lethal_next_turn())
+		return false;
+	bool foe = false;
+	for (const auto& e : W.enemies)
+		foe = foe || lac_altar_d(e.pos) <= 10;
+	if (!foe)
+		return false;
+	for (const auto& al : W.allies)
+		if (lac_altar_d(al.pos) <= 4)
+			return false;
+	return true;
+}
 } // namespace nova::econ
