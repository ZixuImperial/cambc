+			for (int k = 0; k < 8; ++k)
+			{
+				const std::size_t ni = static_cast<std::size_t>(c + n8[k]);
+				if (st[ni] == 0)
+				{
+					st[ni] = 1;
+					q.push_back(static_cast<int>(ni));
+					if (stop[ni])
+					{
+						hit = true;
+						return true;
+					}
+				}
+			}
+			const std::uint8_t m = nw8[static_cast<std::size_t>(c)];
+			for (int k = 0; k < 16; ++k)
+			{
+				const std::size_t ni = static_cast<std::size_t>(c + dk[k]);
+				if (st[ni] != 0 || (m & dm[k]) == 0)
+					continue;
+				st[ni] = 1;
+				q.push_back(static_cast<int>(ni));
+				if (stop[ni])
+				{
+					hit = true;
+					return true;
+				}
+			}
+		}
+		return true;
+	};
+	for (const int c : q)
+		if (stop[static_cast<std::size_t>(c)])
+		{
+			hit = true;
+			return true;
+		}
+	if (!close(0))
+		return false;
+	if (hit)
+		return true;
+	std::vector<std::uint8_t> r1(st.size(), 0), hop(st.size(), 0);
+	for (const int c : q)
