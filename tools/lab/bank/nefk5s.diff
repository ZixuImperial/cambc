+	bbforeach(M.my_spawn,
+		[&](vec2 p)
+		{
+			const std::size_t i = at(p.x, p.y);
+			stA[i] = 1;
+			q.push_back(static_cast<int>(i));
+		});
+	if (fuel() < floor)
+		return done(5, false);
+	// 2. our flood, stopped near the enemy spawn (always in their reach)
+	nef_dilate(es, stop, pw, ph, gap);
+	if (nef_out)
+		return done(5, false);
+	bool hit = false;
+	if (!nef_reach(stA, q, nw8, stop, pw, ph, floor, hit))
+		return done(5, false);
+	if (hit)
+		return done(2, false);
+	std::vector<std::uint8_t> ra(n, 0);
+	for (const int c : q)
+		ra[static_cast<std::size_t>(c)] = 1;
+	if (fuel() < floor)
+		return done(5, false);
