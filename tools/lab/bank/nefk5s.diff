+		return false;
+	const std::size_t head = q.size();
+	for (std::size_t i = 0; i < st.size(); ++i)
+	{
+		if ((i & 1023) == 0 && fuel() < floor)
+			return false;
+		if (hop[i] && st[i] == 0)
+		{
+			st[i] = 1;
+			q.push_back(static_cast<int>(i));
+			if (stop[i])
+			{
+				hit = true;
+				return true;
+			}
+		}
+	}
+	return close(head);
+}
+long nef_fuel_used = 0; // the last flood's fuel (diag)
