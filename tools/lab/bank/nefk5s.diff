+		int ox[8], oy[8], k = 0;
+		for (int dy = -1; dy <= 1; ++dy)
+			for (int dx = -1; dx <= 1; ++dx)
+				if (dx || dy)
+				{
+					ox[k] = dx;
+					oy[k++] = dy;
+				}
+		for (int y = 0; y < h && !(nef_out = nef_out || fuel() < floor); ++y)
