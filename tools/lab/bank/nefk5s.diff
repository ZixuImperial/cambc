+				}
+		if (nef_out)
+			return done(5, false);
+		return done(4, true);
+	}
+	// 3. no mirror found: their own flood, stopped near our reach
+	q.clear();
+	bbforeach(M.enemy_spawn,
+		[&](vec2 p)
+		{
+			const std::size_t i = at(p.x, p.y);
+			stB[i] = 1;
+			q.push_back(static_cast<int>(i));
+		});
+	if (!nef_reach(stB, q, nw8, stop, pw, ph, floor, hit))
+		return done(5, false);
+	if (hit)
+		return done(3, false);
+	if (nef_out || fuel() < floor)
+		return done(5, false);
+	return done(6, true);
+}
