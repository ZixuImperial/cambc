+// The flood from `q` (seeds, already marked in st): walk + dash, then one crystal jump from the whole set, then walk + dash.
+// st: 0 = landable and unreached, 1 = reached, 2 = not landable. nw8: per tile, bit k = neighbour k is in bounds and no wall.
+// Sets hit (and returns true) as soon as a reached tile has stop[i]; returns false when fuel runs below floor.
+static bool nef_reach(std::vector<std::uint8_t>& st, std::vector<int>& q, const std::vector<std::uint8_t>& nw8,
+	const std::vector<std::uint8_t>& stop, int pw, int ph, long floor, bool& hit)
+{
+	int n8[8], dk[16];
+	std::uint8_t dm[16];
+	{
+		int k = 0, ox[8], oy[8];
+		for (int dy = -1; dy <= 1; ++dy)
