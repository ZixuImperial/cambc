+static void nef_dilate(const std::vector<std::uint8_t>& src, std::vector<std::uint8_t>& dst, int pw, int ph, int r)
+{
+	std::vector<std::uint8_t> row(src.size(), 0);
+	for (int y = 0; y < ph; ++y)
+	{
+		if (fuel() < nef_floor)
+		{
+			nef_out = true;
+			return;
+		}
+		const int b = y * pw;
+		int cnt = 0;
+		for (int x = 0; x < std::min(r, pw); ++x)
+			cnt += src[static_cast<std::size_t>(b + x)];
+		for (int x = 0; x < pw; ++x)
+		{
+			if (x + r < pw)
+				cnt += src[static_cast<std::size_t>(b + x + r)];
+			if (x - r - 1 >= 0)
+				cnt -= src[static_cast<std::size_t>(b + x - r - 1)];
+			row[static_cast<std::size_t>(b + x)] = cnt > 0 ? 1 : 0;
+		}
+	}
+	for (int x = 0; x < pw; ++x)
+	{
+		if (fuel() < nef_floor)
+		{
+			nef_out = true;
+			return;
+		}
+		int cnt = 0;
+		for (int y = 0; y < std::min(r, ph); ++y)
+			cnt += row[static_cast<std::size_t>(y * pw + x)];
+		for (int y = 0; y < ph; ++y)
+		{
+			if (y + r < ph)
+				cnt += row[static_cast<std::size_t>((y + r) * pw + x)];
+			if (y - r - 1 >= 0)
+				cnt -= row[static_cast<std::size_t>((y - r - 1) * pw + x)];
+			dst[static_cast<std::size_t>(y * pw + x)] = cnt > 0 ? 1 : 0;
+		}
+	}
