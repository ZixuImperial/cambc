+	auto at = [&](int x, int y) { return static_cast<std::size_t>((y + NEF_PAD) * pw + x + NEF_PAD); };
+	if (static_cast<std::int64_t>(fuel()) < static_cast<std::int64_t>(floor) + 300LL * static_cast<std::int64_t>(n)) // RC C734: room for the grid work, else off
+		return done(5, false);
+	// The map's mirror (0 x-flip, 1 y-flip, 2 half turn): the one that maps walls to walls and our spawn onto theirs; -1 none.
+	auto mir = [&](int s2, int x, int y) { return s2 == 0 ? vec2{ w - 1 - x, y } : (s2 == 1 ? vec2{ x, h - 1 - y } : vec2{ w - 1 - x, h - 1 - y }); };
+	int sym = -1;
+	for (int s2 = 0; s2 < 3 && sym < 0; ++s2)
+	{
+		if (fuel() < floor)
+			return done(5, false);
+		bool ok = true;
+		bbforeach(M.my_spawn, [&](vec2 p) { ok = ok && bbget(M.enemy_spawn, mir(s2, p.x, p.y)); });
+		bbforeach(M.enemy_spawn, [&](vec2 p) { ok = ok && bbget(M.my_spawn, mir(s2, p.x, p.y)); });
+		bbforeach(M.altars_bb, [&](vec2 p) { ok = ok && bbget(M.altars_bb, mir(s2, p.x, p.y)); });
+		bbforeach(M.walls, [&](vec2 p) { ok = ok && bbget(M.walls, mir(s2, p.x, p.y)); });
