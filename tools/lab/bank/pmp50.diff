+// b2365 PMP (draft_flags.h): on the first draft turn (the 10M budget: a replan on later turns cannot afford the re-enumeration), when the plan
+// we would field holds both Prism and Marcella, the one picked SECOND gets its draft value scaled by PMP_TAB[1] / 100 (a negative value moves
+// down by the same share) and the plan is rebuilt. First = the turn's planned pick if it is one of them, else Prism when pz_viable forces her,
+// else the higher draft value. Our own lineup only (no enemy picks); once a draft.
+static bool pmp_done = false;
+static __attribute__((noinline)) void pmp_scale(DraftTurn& d, std::uint16_t)
+{
+	if (pmp_done || d.have != 0 || !S.values || !cached || !PL.ok || !M.done())
+		return;
+	pmp_done = true;
+	try
+	{
+		const std::uint16_t eff = static_cast<std::uint16_t>(PL.top_m | (S.pz_viable ? bit(PR) : 0));
+		if (!(eff >> PR & 1) || !(eff >> MA & 1))
+			return;
+		int first = (d.choice == PR || d.choice == MA) ? d.choice : (S.pz_viable ? PR : (S.base[PR] >= S.base[MA] ? PR : MA));
+		const bool hm = first == MA;
+		const int other = hm ? PR : MA;
+		if (fuel() <= enum_estimate() + replan_estimate() + 1500000) // fuel gate (Builder): a measured enumeration + replan + a 1.5M margin, else no scaling
+			return;
+		float& v = S.base[static_cast<std::size_t>(other)];
+		const float f = static_cast<float>(PMP_TAB[1]) / 100.0f;
+		v = v >= 0.0f ? v * f : v - (1.0f - f) * (-v);
+		if (other == PR)
+			S.pz_viable = false; // Prism scaled out of first place: her forced first pick no longer applies
+		replan_and_adopt(d);
+	}
+	catch (...)
+	{
+	}
+}
