+__attribute__((noinline)) bool pfj_stage(const combat::Assessment& a)
+{
+	if (!W.alive || !W.me.kit || !prism_layer::me() || a.stance != combat::CALM || W.me.frac() < 0.5f || W.me.channeling() || econ::busy_capturing())
+		return false;
+	const int R = PFJ_ON(2) ? PFJ_TAB[3] : PFJ_TAB[2];
+	// the fight: >= 2 mates each with a seen foe within 3 -> the foe nearest me among those foes
+	int mates = 0, fd = BIG;
+	vec2 foe{ -1, -1 };
+	for (const auto& al : W.allies)
+	{
+		if (al.hp <= 0)
+			continue;
+		bool hot = false;
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, al.pos) <= 3)
+			{
+				hot = true;
+				const int d = cheb(e.pos, W.me.pos);
+				if (d < fd)
+				{
+					fd = d;
+					foe = e.pos;
+				}
+			}
+		mates += hot ? 1 : 0;
+	}
+	const auto& fc = comms::fl_call;
+	const bool cell = fc.cell >= 0 && !fc.mine && W.round - fc.r <= comms::FL_TAB[2] && fc.call >= 0 && fc.call <= 2;
+	const vec2 ct = cell ? econ::fight_cell_tile(fc.cell) : vec2{ -1, -1 };
+	if (mates < 2 && cell)
+	{
+		fd = BIG; // a call cell alone: its nearest seen foe
+		foe = { -1, -1 };
+		for (const auto& e : W.enemies)
+			if (cheb(e.pos, ct) <= 6 && cheb(e.pos, W.me.pos) < fd)
+			{
+				fd = cheb(e.pos, W.me.pos);
+				foe = e.pos;
+			}
+	}
+	const bool fight = (mates >= 2 || cell) && foe.x >= 0 && fd <= R;
+	if (!fight)
+	{
+		if (pfj_r == W.round - 1)
+			for (const auto& e : W.enemies)
+				if (cheb(e.pos, W.me.pos) <= 4)
+				{
+					pfj_fc_hold();
+					pfj_r = W.round;
+					return true; // joined: one quiet round does not send her back to farming while a foe is in her range
+				}
+		return false;
+	}
+	if (fd <= 4)
+	{
+		pfj_r = W.round;
+		return false; // in her range: the live fight logic casts
+	}
+	const vec2 best = pfj_ring_tile(foe, cell, ct);
+	if (best.x < 0 || !mv::step_to(best, 0, 30))
+		return false;
+	pfj_fc_join();
+	pfj_r = W.round;
+	return true;
+}
