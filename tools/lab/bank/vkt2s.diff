+// VKT bit 2 (b1824, combat_flags.h): shoot, then dash to a safe landing. Callers read VKT_ON(2) first. act false: the test only.
+bool vkt_shot_dash(const Assessment& a, const std::vector<mv::Threat>& zones, bool act)
+{
+	if (!vesper_layer::me() || !W.me.kit || W.attacked || W.moved || W.cast || !W.can_attack() || W.me.channeling() || W.me.stunned)
+		return false;
+	const Kit& k = *W.me.kit;
+	if (k.slot_dash < 0 || !ready(k.slot_dash) || (lethal_spot.round == W.round))
+		return false;
+	const Body* t = weakest_foe_where([](const Body& e) { return in_my_range(e) && !foe_model::unreachable(e) && !ren_kills_me(e) && !kit_rules::skip_unkillable_foe_on_spawn(e, kit_rules::my_basic_hit); });
+	if (!t)
+		return false;
+	const vec2 me = W.me.pos;
+	auto mind = [&](vec2 p)
+	{
+		int d = BIG;
+		for (const auto& f : a.foes)
+			d = std::min(d, cheb(p, f.pos));
+		return d;
+	};
+	vec2 live_end = me; // live's own step tile: step_out_of_reach's choice when I stand in a zone
+	if (mv::in_threat(zones, me))
+	{
+		const vec2 rally = flee_rally(zones);
+		int bs = BIG;
+		for (const vec2 dd : DIRS)
+		{
+			const vec2 q = me + dd;
+			if (!flee_tile_out(a, zones, q))
+				continue;
+			const int sc = step_score(a, q, rally);
+			if (sc < bs)
+			{
+				bs = sc;
+				live_end = q;
+			}
+		}
+	}
+	const int d_live = mind(live_end);
+	const int r = std::max(1, static_cast<int>(k.dash_range));
+	struct VktL
+	{
+		vec2 p;
+		int d, tie;
+	};
+	std::array<VktL, 24> cand{};
+	int nc = 0;
+	for (int dx = -r; dx <= r; ++dx)
+		for (int dy = -r; dy <= r; ++dy)
+		{
+			const vec2 L{ me.x + dx, me.y + dy };
+			if ((dx == 0 && dy == 0) || !inb(L) || !flee_tile_out(a, zones, L) || (cheb(L, me) >= 2 && !dash_legal_between(me, L)))
+				continue;
+			const int dl = mind(L);
+			if (dl < d_live - 1 || nc >= static_cast<int>(cand.size()))
+				continue;
+			cand[static_cast<std::size_t>(nc++)] = { L, dl, cheb(L, live_end) };
+		}
+	std::sort(cand.begin(), cand.begin() + nc, [](const VktL& x, const VktL& y) { return x.d != y.d ? x.d > y.d : x.tie < y.tie; });
+	const vec2 best = nc > 0 ? cand[0].p : vec2{ -1, -1 };
+	if (best.x < 0)
+		return false;
+	if (!act)
+		return true;
+	const Body target = *t;
+	bh57_noreset = true; // the cast is the dash's
+	const bool hit = attack_champion(target);
+	bh57_noreset = false;
+	if (!hit)
+		return false;
+	// a refused landing (an unseen occupant: false at no cost, INT:136) tries the next one; a ranged body that shot cannot walk after
+	// it (INT:26, rc 36), so the ranked landings are the only way out this turn
+	for (int i = 0; i < nc && i < 4; ++i)
+		if (cast_at(k.slot_dash, cand[static_cast<std::size_t>(i)].p))
+			break;
+	return true;
+}
