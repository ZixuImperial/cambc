+// NFF bit 2: my target has no field yet: build it now when the turn has fuel for it, then walk it.
+static bool nff_build_step(int gi)
+{
+	if (mv::group_field_raw(gi) || fuel() <= NFF_TAB[2] || !mv::group_field_build(gi, NFF_TAB[3]))
+		return false;
+	const distance_field* f = mv::group_field(gi);
+	return f && dfget_me(*f) != UNREACH && mv::step_field(*f, gi);
+}
+// NFF bit 4: still no field and the short search failed: one greedy step that closes on the anchor (none when no neighbour does).
+static bool nff_greedy_step(int gi)
+{
+	if (mv::group_field_raw(gi))
+		return false;
+	return mv::step_greedy(M.groups[static_cast<std::size_t>(gi)].anchor, gi);
+}
+// NFF bit 8: I stand on another group's camp tile, a wall in my target's field: walk to the field's near side (tiles within 4 whose
+// value is within 4 of the window's best).
+static bool nff_off_camp(int gi)
+{
+	const distance_field* raw = mv::group_field_raw(gi);
+	const vec2 me = W.me.pos;
+	if (!raw || dfget(*raw, me) != UNREACH || !bbget(M.camp_tiles, me))
+		return false;
+	int m = UNREACH;
+	for (int dy = -4; dy <= 4; ++dy)
+		for (int dx = -4; dx <= 4; ++dx)
+		{
+			const vec2 t{ me.x + dx, me.y + dy };
+			if (inb(t))
+				m = std::min(m, static_cast<int>(dfget(*raw, t)));
+		}
+	if (m == UNREACH)
+		return false;
+	bitboard goals;
+	for (int dy = -4; dy <= 4; ++dy)
+		for (int dx = -4; dx <= 4; ++dx)
+		{
+			const vec2 t{ me.x + dx, me.y + dy };
+			if (inb(t) && static_cast<int>(dfget(*raw, t)) <= m + 4)
+				bbset(goals, t);
+		}
+	return mv::step_to_set(goals, 10, gi);
+}
