+			const vec2 tp = m->pos;
+			mv::step_to(tp, hr, 20);
+		}
+	}
+	return best && combat::cast_on_champion(k.slot_heal, *best);
+}
+// ---- WL2 PRX (bit 1048576): presence. A foe (mine or ward sight) within WL2_PRX_F of a visible mate sets the trigger for WL2_PRX_T
+// rounds; while it holds and I stand farther than WL2_PRX_R from that mate, I step to a tile within heal reach of it where it is nearer
+// the foe than the tile (a body between me and the foe), out of awake camps' reach. She never starts a fight: this is a CALM step.
+namespace {
+int prx_round = -1000, prx_slot = -1;
+vec2 prx_foe{ -1, -1 };
+}
+bool wl2_presence()
+{
+	const int F = WL2_TAB[10];
+	int bd = 1 << 20;
+	for (const auto& al : W.allies)
+	{
+		if (al.channeling() || al.hp <= 0)
+			continue;
+		auto scan = [&](const std::vector<Body>& v)
+		{
+			for (const auto& e : v)
+			{
+				const int d = cheb(e.pos, al.pos);
+				if (d <= F && d < bd)
+				{
+					bd = d;
+					prx_round = W.round;
+					prx_slot = al.slot;
+					prx_foe = e.pos;
+				}
+			}
+		};
+		scan(W.enemies);
+		scan(W.enemies_far);
+	}
+	if (W.round - prx_round > WL2_TAB[11] || !W.can_move() || W.moved || econ::busy_capturing())
+		return false;
+	const Body* m = W.ally_by_slot(prx_slot);
+	if (!m || m->channeling() || cheb(m->pos, W.me.pos) <= WL2_TAB[12])
+		return false;
+	const int hr = static_cast<int>(W.me.kit->heal_range);
+	const vec2 mp = m->pos, me = W.me.pos, fp = prx_foe;
+	vec2 best{ -1, -1 };
+	int bdist = 1 << 20;
+	for (int dx = -hr; dx <= hr; ++dx)
+		for (int dy = -hr; dy <= hr; ++dy)
+		{
+			const vec2 t{ mp.x + dx, mp.y + dy };
+			if ((dx == 0 && dy == 0) || cheb(t, fp) <= cheb(mp, fp) || !mv::home_walkable(t) || mv::camp_threat(t) > 0)
+				continue;
+			const int d = cheb(t, me);
+			if (d < bdist)
+			{
+				bdist = d;
+				best = t;
+			}
+		}
+	if (best.x >= 0 && mv::step_to(best, 0, 30))
+		return true;
+	return mv::step_to(mp, hr, 30);
+}
+// ---- WL2, decision 3: a soft pull toward a working mate. Her own rate of group gi x (1 + WL2_PULL_X100 / 100) when another living
+// body claims it (the buffer: works out of sight) or a visible mate stands within 6 of its anchor.
+float wl2_pull(int gi, float rate)
+{
+	const bool nog = WL2_ON(262144); // bit 262144: no cluster-only group alone (its gold is the carriers')
+	if (rate <= 0.0f || gi < 0 || gi >= M.ng || (WL2_TAB[2] <= 0 && !nog))
+		return rate;
+	const auto& g = M.groups[static_cast<std::size_t>(gi)];
+	bool work = false;
+	for (int s = 0; s < P.n && s < comms::CLAIM_SLOTS && !work; ++s)
+		work = s != P.my_slot && alive_slot(s) && comms::cgroup(s) == gi;
+	for (const auto& al : W.allies)
+		work = work || (!al.channeling() && cheb(al.pos, g.anchor) <= 6);
+	if (nog && g.n_att == 0 && !work)
+		return -1.0f;
+	return work ? rate * (1.0f + static_cast<float>(WL2_TAB[2]) / 100.0f) : rate;
+}
